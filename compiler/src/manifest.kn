// kiln.toml: the package name and path dependencies (subset of
// crates/kiln_parser/src/manifest.rs). Used by kilnc so packages with
// `[dependencies] name = { path = "..." }` build without the Rust compiler.

import std::fs
import std::os
import std::path

// A path dependency: its import name and its library root (`src/lib.kn`).
@derive(Clone)
pub struct Dep {
	pub name string,
	pub root string,
	pub uses Vec<string>,
	pub direct bool,
}

impl Dep {
	// Same as crates/kiln_parser/src/package.rs Dependency::mod_name.
	pub fun mod_name(&self) string {
		if self.direct {
			return self.name.clone()
		}
		return "__dep_{self.name}"
	}
}

@derive(Clone)
pub struct Manifest {
	pub name string,
	pub version string,
	pub dir string,
	pub deps Vec<(string, string)>,
	// Registry dependencies: (name, version requirement).
	pub reg Vec<(string, string)>,
}

fun unquote(v &str) option<string> {
	t := v.trim()
	inner := match t.strip_prefix("\"") {
		Some(s) => match s.strip_suffix("\"") {
			Some(u) => u,
			None => return None,
		},
		None => return None,
	}
	return Some(inner.replace("\\\\", "\\").replace("\\\"", "\""))
}

fun is_ident(s &str) bool {
	if s.is_empty() {
		return false
	}
	first mut := true
	for c in s.chars() {
		ok := if first {
			c.is_alphabetic() || c == '_'
		} else {
			c.is_alphanumeric() || c == '_'
		}
		if !ok {
			return false
		}
		first = false
	}
	return true
}

// Finds `kiln.toml` in `start` or a parent directory.
pub fun find(start &str) option<string> {
	d mut := start.to_string()
	seen mut := 0
	while seen < 64 {
		m := path::join(&d, "kiln.toml")
		if fs::is_file(&m) {
			return Some(m)
		}
		parent := path::dir(&d).to_string()
		if parent == d {
			return None
		}
		d = parent
		seen += 1
	}
	return None
}

// Parses the subset of TOML a manifest uses: `[package]` with `name` /
// `version`, and `[dependencies]` with `name = { path = "..." }`. Other
// sections (`[link]`, …) are skipped so kilnc can still load path deps from
// packages that also declare native link settings.
pub fun parse(path &str) result<Manifest, string> {
	text := match fs::read_to_string(path) {
		Ok(t) => t,
		Err(e) => return Err("cannot read {path}: {e}"),
	}
	dir := path::dir(path).to_string()
	m mut := Manifest {
		name: string::new(),
		version: "0.0.0".to_string(),
		dir: dir.clone(),
		deps: Vec::new(),
		reg: Vec::new(),
	}
	section mut := string::new()
	n mut := 0
	for raw in text.lines() {
		n += 1
		line0 := match raw.find("#") {
			Some(i) => {
				if !raw[..i].contains("\"") {
					&raw[..i]
				} else {
					raw
				}
			},
			None => raw,
		}
		line := line0.trim()
		if line.is_empty() {
			continue
		}
		if let Some(s) = line.strip_prefix("[") {
			sec := match s.strip_suffix("]") {
				Some(t) => t.trim().to_string(),
				None => return Err("{path}:{n}: expected `]`"),
			}
			section = sec
			continue
		}
		(k0, v0) := match line.split_once("=") {
			Some(kv) => kv,
			None => return Err("{path}:{n}: expected `key = value`"),
		}
		k := k0.trim()
		v := v0.trim()
		if section == "package" {
			match k {
				"name" => {
					m.name = match unquote(v) {
						Some(s) => s,
						None => return Err("{path}:{n}: `name` must be a string"),
					}
				},
				"version" => {
					m.version = match unquote(v) {
						Some(s) => s,
						None => return Err("{path}:{n}: `version` must be a string"),
					}
				},
				_ => {},
			}
		} else if section == "dependencies" {
			if !is_ident(k) {
				return Err("{path}:{n}: dependency name `{k}` must be an identifier")
			}
			// `name = "1.2"`: a registry dependency.
			if let Some(req) = unquote(v) {
				m.reg.push((k.to_string(), req))
				continue
			}
			inner0 := match v.strip_prefix("{{") {
				Some(s) => match s.strip_suffix("}}") {
					Some(t) => t,
					None => return Err("{path}:{n}: a dependency must be `\"<version>\"`, `{{ version = \"...\" }}`, or `{{ path = \"...\" }}`"),
				},
				None => return Err("{path}:{n}: a dependency must be `\"<version>\"`, `{{ version = \"...\" }}`, or `{{ path = \"...\" }}`"),
			}
			p mut := None
			ver mut := None
			for kv in inner0.split(",") {
				if let Some((a, b)) = kv.split_once("=") {
					if a.trim() == "path" {
						p = unquote(b)
					} else if a.trim() == "version" {
						ver = unquote(b)
					}
				}
			}
			match p {
				Some(rel) => m.deps.push((k.to_string(), path::join(&dir, &rel))),
				None => match ver {
					Some(req) => m.reg.push((k.to_string(), req)),
					None => return Err("{path}:{n}: a dependency needs `path = \"...\"` or `version = \"...\"`"),
				},
			}
		}
		// `[link]` and unknown sections: ignore keys (kilnc does not link natives yet).
	}
	if m.name.is_empty() {
		return Err("{path}: [package] needs a `name`")
	}
	return Ok(m)
}

// `$KILN_HOME`, or `~/.kiln`: downloaded packages and registry indexes.
pub fun kiln_home() string {
	if let Some(h) = os::getenv("KILN_HOME") {
		if !h.is_empty() {
			return h
		}
	}
	home := match os::getenv("HOME") {
		Some(h) => h,
		None => match os::getenv("USERPROFILE") {
			Some(h) => h,
			None => ".".to_string(),
		},
	}
	return path::join(&home, ".kiln")
}

// The unpacked source of registry package `name` at `version`.
pub fun registry_src(name &str, version &str) string {
	return path::join(&path::join(&path::join(&kiln_home(), "registry"), "src"), "{name}-{version}")
}

// The versions of the registry packages pinned in `dir/kiln.lock`.
pub fun locked_registry_versions(dir &str) Vec<(string, string)> {
	out mut := Vec::new()
	text := match fs::read_to_string(&path::join(dir, "kiln.lock")) {
		Ok(t) => t,
		Err(_) => return out,
	}
	let mut name option<string> = None
	let mut version option<string> = None
	lines mut := Vec::new()
	for l in text.lines() {
		lines.push(l.to_string())
	}
	lines.push("[[package]]".to_string())
	for raw in &lines {
		line := raw.trim()
		if line == "[[package]]" {
			if name.is_some() && version.is_some() {
				out.push((name.clone().unwrap(), version.clone().unwrap()))
			}
			name = None
			version = None
			continue
		}
		if let Some((k, v)) = line.split_once("=") {
			key := k.trim()
			if key == "name" {
				name = unquote(v)
			} else if key == "version" {
				version = unquote(v)
			} else if key == "source" {
				reg := match unquote(v) {
					Some(s) => s.starts_with("registry+"),
					None => false,
				}
				if !reg {
					name = None
				}
			}
		}
	}
	return out
}

// All dependencies of `m`, transitively (each library once), in order.
// Registry dependencies use the versions pinned in `m`'s `kiln.lock`.
pub fun all_deps(m &Manifest) result<Vec<Dep>, string> {
	locked := locked_registry_versions(&m.dir)
	out mut := Vec::new()
	names mut := Vec::new()
	stack mut := Vec::new()
	stack.push(m.clone())
	seen mut := Vec::new()
	seen.push(path::clean(&m.dir))
	first mut := true
	while stack.len() > 0 {
		cur := stack.pop().unwrap()
		direct := first
		first = false
		deps mut := cur.deps.clone()
		for (rname, _) in &cur.reg {
			let mut found option<string> = None
			for (ln, lv) in &locked {
				if *ln == *rname {
					found = Some(lv.clone())
				}
			}
			match found {
				Some(v) => deps.push((rname.clone(), registry_src(rname, &v))),
				None => return Err("registry dependency `{rname}` is not in kiln.lock; run `kiln update` to resolve it"),
			}
		}
		for (name, dir) in &deps {
			canon := path::clean(dir)
			dup mut := false
			for s in &seen {
				if *s == canon {
					dup = true
					break
				}
			}
			if dup {
				continue
			}
			seen.push(canon.clone())
			toml := path::join(dir, "kiln.toml")
			dm := match parse(&toml) {
				Ok(x) => x,
				Err(e) => return Err("dependency `{name}`: {e}"),
			}
			root := path::join(dir, "src/lib.kn")
			if !fs::is_file(&root) {
				return Err("dependency `{name}` is not a library: {root} is missing")
			}
			for n in &names {
				if *n == *name {
					return Err("two dependencies are named `{name}`")
				}
			}
			names.push(name.clone())
			uses mut := Vec::new()
			for (n, _) in &dm.deps {
				uses.push(n.clone())
			}
			for (n, _) in &dm.reg {
				uses.push(n.clone())
			}
			out.push(Dep { name: name.clone(), root: root, uses: uses, direct: direct })
			stack.push(dm)
		}
	}
	return Ok(out)
}

// Path dependencies of the package that owns `root_file` (`src/main.kn` or
// `src/lib.kn`), or an empty list when there is no kiln.toml.
pub fun deps_for_root(root_file &str) result<Vec<Dep>, string> {
	start := path::dir(root_file)
	mpath := match find(start) {
		Some(p) => p,
		None => return Ok(Vec::new()),
	}
	m := match parse(&mpath) {
		Ok(x) => x,
		Err(e) => return Err(e),
	}
	return all_deps(&m)
}
