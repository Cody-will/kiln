// kilnc: the beginnings of the self-hosted Kiln compiler.
//
// For now it is the lexer plus a driver that prints the canonical token
// dump (the format of `kiln lex --dump`, see crates/kiln_lexer/src/dump.rs)
// for each file given: `kilnc <file.kn>...`. `kilnc --ast <file.kn>...`
// parses instead and prints the canonical AST dump (the format of
// `kiln parse --dump`, see crates/kiln_parser/src/dump.rs). With several
// files, each dump is preceded by a line `== <path>`. `kilnc --derive`
// prints the source generated by derive expansion (`kiln parse
// --dump-derive`).

mod token
mod lexer
mod ast
mod debug
mod parser
mod escape
mod derive
mod resolve
mod ty
mod typeck
mod mir
mod sig
mod borrowck
mod lower
mod inline
mod codegen
mod manifest
mod testgen
mod index

import std::fs
import std::hash::Hasher
import std::os
import std::path
import std::time::Instant
import ast::{Ident, ImportTree, Item, ItemKind, Span, Visibility}
import token::{StrPart, TokenKind}

fun esc(b &[u8]) string {
	o mut := string::new()
	for x in b {
		c := *x
		if c > 32 && c < 127 && c != 92 {
			o.push_char(c as char)
		} else {
			o.push("\\x{c:02x}")
		}
	}
	if o.is_empty() {
		o.push("-")
	}
	return o
}

fun opt(s &option<string>) string {
	match s {
		Some(x) => return esc(x.as_bytes()),
		None => return "-".to_string(),
	}
}

fun dump(src &str) string {
	l := lexer::lex(src)
	o mut := string::new()
	for t in &l.tokens {
		o.push("tok {t.start} {t.end} ")
		match &t.kind {
			TokenKind::Ident(s) => o.push("ident {esc(s.as_bytes())}"),
			TokenKind::Keyword(s) => o.push("kw {s}"),
			TokenKind::Lifetime(s) => o.push("life {esc(s.as_bytes())}"),
			TokenKind::Int(v, s) => o.push("int {*v} {opt(s)}"),
			TokenKind::Float(text, s) => o.push("float {esc(text.as_bytes())} {opt(s)}"),
			TokenKind::Str(parts) => {
				o.push("str")
				for p in parts {
					match p {
						StrPart::Text(s) => o.push(" T{esc(s.as_bytes())}"),
						StrPart::Interp(src, off, spec) => {
							o.push(" I{esc(src.as_bytes())}@{off}")
							if let Some((s, at)) = spec {
								o.push(":{esc(s.as_bytes())}@{at}")
							}
						},
					}
				}
			}
			TokenKind::RawStr(s) => o.push("raw {esc(s.as_bytes())}"),
			TokenKind::ByteStr(b) => o.push("bytes {esc(b)}"),
			TokenKind::Char(c) => o.push("char {*c as u32}"),
			TokenKind::Semi(i) => o.push("semi {if *i { 1 } else { 0 }}"),
			TokenKind::Punct(p) => o.push("p {p}"),
			TokenKind::Eof => o.push("eof"),
		}
		o.push("\n")
	}
	for (s, e, text) in &l.docs {
		o.push("doc {s} {e} {esc(text.as_bytes())}\n")
	}
	for e in &l.errors {
		o.push("err {e.start} {e.end} {esc(e.message.as_bytes())}\n")
	}
	return o
}

fun dump_ast(src &str) string {
	p := parser::parse(src)
	o mut := debug::dump_file(&p.file)
	for e in &p.errors {
		o.push("error {e.start}..{e.end}: {e.message}\n")
	}
	return o
}

// The AST dump after derive expansion (`kiln parse --dump-expanded`).
fun dump_expanded(src &str) string {
	p mut := parser::parse(src)
	next mut := derive::DERIVE_BASE
	derive::expand(&mut p.file.items, &mut next, &mut p.errors)
	o mut := debug::dump_file(&p.file)
	for e in &p.errors {
		o.push("error {e.start}..{e.end}: {e.message}\n")
	}
	return o
}

fun dump_derive(src &str) string {
	p := parser::parse(src)
	texts mut := Vec::new()
	errors mut := Vec::new()
	derive::generate(&p.file.items, &mut texts, &mut errors)
	o mut := string::new()
	for t in &texts {
		o.push("-- derive\n")
		o.push(t)
	}
	for e in &errors {
		o.push("error {e.span.start}..{e.span.end}: {e.message}\n")
	}
	return o
}

// Loads a program made of several files (see crates/kiln_parser/src/package.rs):
// `mod name` without a body, in a file whose child modules live in `dir`,
// loads `dir/name.kn` or `dir/name/mod.kn`. The k-th file is parsed at span
// base `k << 32`.
struct Loader {
	files Vec<string>,
	texts Vec<string>,
	errors Vec<string>,
	// Parse errors with their (global) spans, for `--check`.
	diags Vec<(usize, usize, string)>,
	// `--overlay <path> <file>`: read `path` from `file` (unsaved editor buffers).
	overlays Vec<(string, string)>,
	next usize,
}

impl Loader {
	fun parse_file(&mut self, path &str, text &str) Vec<Item> {
		base := self.files.len() << 32
		self.files.push(path.to_string())
		self.texts.push(text.to_string())
		p := resolve::parse_at(text, base, &mut self.next)
		for e in &p.errors {
			self.diags.push((e.start, e.end, e.message.clone()))
			self.errors.push("{path}: parse error at {e.start - base}..{e.end - base}: {e.message}")
		}
		return p.file.items
	}

	// Reads `path`, or its overlay.
	fun read(&self, path &str) result<string, string> {
		for (p, f) in &self.overlays {
			if p == path {
				return match fs::read_to_string(f) {
					Ok(t) => Ok(t),
					Err(e) => Err("{e}"),
				}
			}
		}
		return match fs::read_to_string(path) {
			Ok(t) => Ok(t),
			Err(e) => Err("{e}"),
		}
	}

	fun expand(&mut self, items &mut Vec<Item>, dir &str) {
		for item in items.iter_mut() {
			(name, has_body) := match &item.kind {
				ItemKind::Mod { name, items: body } => (name.name.clone(), body.is_some()),
				_ => continue,
			}
			if has_body {
				if let ItemKind::Mod { name: _, items: Some(inner) } = &mut item.kind {
					self.expand(inner, "{dir}/{name}")
				}
				continue
			}
			flat := "{dir}/{name}.kn"
			nested := "{dir}/{name}/mod.kn"
			path := if fs::is_file(&flat) {
				flat
			} else if fs::is_file(&nested) {
				nested
			} else {
				self.errors.push("file not found for module `{name}`")
				continue
			}
			text := match self.read(&path) {
				Ok(t) => t,
				Err(e) => {
					self.errors.push("cannot read `{path}`: {e}")
					continue
				},
			}
			sub mut := self.parse_file(&path, &text)
			self.expand(&mut sub, "{dir}/{name}")
			if let ItemKind::Mod { name: _, items: body } = &mut item.kind {
				*body = Some(sub)
			}
		}
	}
}

// Drops `@test` items from a dependency (its tests are its own business).
fun strip_tests(items &mut Vec<Item>) {
	i mut := 0
	while i < items.len() {
		is_test mut := false
		for a in &items[i].attrs {
			if a.name.name == "test" {
				is_test = true
				break
			}
		}
		if is_test {
			items.remove(i)
			continue
		}
		if let ItemKind::Mod { name: _, items: Some(inner) } = &mut items[i].kind {
			strip_tests(inner)
		}
		i += 1
	}
}

// Adds `import super::<dep>` to a dependency's items for each dependency it
// declares and does not shadow (same as crates/kiln_parser/src/package.rs).
fun sibling_imports(items &mut Vec<Item>, uses &Vec<string>, deps &Vec<manifest::Dep>) {
	for name in uses {
		shadowed mut := false
		for i in &*items {
			if defines(i, name) {
				shadowed = true
			}
		}
		if shadowed {
			continue
		}
		let mut found option<manifest::Dep> = None
		for o in deps {
			if o.name == *name {
				found = Some(o.clone())
			}
		}
		o := match found {
			Some(x) => x,
			None => continue,
		}
		span := Span::new(0, 0)
		segs mut := Vec::new()
		segs.push(Ident { name: "super".to_string(), span: span })
		segs.push(Ident { name: o.mod_name(), span: span })
		let mut alias option<Ident> = None
		if !o.direct {
			alias = Some(Ident { name: name.clone(), span: span })
		}
		items.push(Item {
			kind: ItemKind::Import(ImportTree::Path { path: segs, alias: alias }),
			vis: Visibility::Private,
			attrs: Vec::new(),
			doc: None,
			span: span,
		})
	}
}

fun defines(item &Item, name &str) bool {
	return match &item.kind {
		ItemKind::Mod { name: n, items: _ } => n.name == name,
		ItemKind::Import(t) => import_binds(t, name),
		_ => false,
	}
}

fun import_binds(t &ImportTree, name &str) bool {
	return match t {
		ImportTree::Path { path, alias } => match alias {
			Some(a) => a.name == name,
			None => path.len() > 0 && path[path.len() - 1].name == name,
		},
		ImportTree::Glob { prefix: _ } => false,
		ImportTree::Group { prefix: _, items } => {
			found mut := false
			for i in items {
				if import_binds(i, name) {
					found = true
				}
			}
			found
		},
	}
}

// Loads path dependencies from the nearest `kiln.toml` as public top-level
// modules (same semantics as crates/kiln_parser/src/package.rs).
fun load_path_deps(l &mut Loader, items &mut Vec<Item>, root_file &str) result<(), string> {
	deps := match manifest::deps_for_root(root_file) {
		Ok(d) => d,
		Err(e) => return Err("{e}\n"),
	}
	for d in &deps {
		for item in &*items {
			if let ItemKind::Mod { name, items: _ } = &item.kind {
				if name.name == d.name {
					return Err("module `{d.name}` has the same name as a dependency\n")
				}
			}
		}
		text := match l.read(&d.root) {
			Ok(t) => t,
			Err(e) => return Err("dependency `{d.name}`: cannot read `{d.root}`: {e}\n"),
		}
		sub mut := l.parse_file(&d.root, &text)
		l.expand(&mut sub, path::dir(&d.root))
		if l.errors.len() > 0 {
			return Err("{l.errors[0]}\n")
		}
		strip_tests(&mut sub)
		sibling_imports(&mut sub, &d.uses, &deps)
		span := Span::new(0, 0)
		items.push(Item {
			kind: ItemKind::Mod {
				name: Ident { name: d.mod_name(), span: span },
				items: Some(sub),
			},
			vis: Visibility::Public,
			attrs: Vec::new(),
			doc: None,
			span: span,
		})
	}
	return Ok()
}

fun dir_of(path &str) string {
	b := path.as_bytes()
	i mut := b.len()
	while i > 0 {
		if b[i - 1] == 47 {
			return path[..i - 1].to_string()
		}
		i -= 1
	}
	return ".".to_string()
}

// Front end plus code generation: the program's LLVM IR, or its errors.
// `--time-passes`: prints the time since `t` for pass `name`, then restarts it.
fun pass_done(tp bool, t &mut Instant, name &str) {
	if tp {
		ms := t.elapsed().as_secs_f64() * 1000.0
		eprintln("time: {name:<12} {ms:>9.1} ms")
	}
	*t = Instant::now()
}

// Borrow-check cache keys, one per function (0: not cached). A key covers
// the function's body text and the program's interface: every source file
// with the function bodies cut out, the std text, and the kilnc binary. A
// body edit therefore re-checks only that function; any change outside
// bodies (a signature, a type, a const) re-checks everything.
fun bck_keys(r &resolve::Resolved, texts &Vec<string>, builtin &str) Vec<u64> {
	// Body spans per file, in order.
	spans mut := Vec::new()
	for _ in texts {
		spans.push(Vec::new())
	}
	for f in &r.fns {
		if f.is_prelude {
			continue
		}
		if let Some(b) = &f.decl.body {
			if b.span.start < resolve::BUILTIN_BASE {
				k := b.span.start >> 32
				if k < spans.len() {
					spans[k].push((b.span.start & 0xffffffff, b.span.end & 0xffffffff))
				}
			}
		}
	}
	h mut := Hasher::with_seed(0x6b696c6e63)
	h.write(builtin.as_bytes())
	// The compiler binary, by size and modification time (reading all of it
	// cost tens of milliseconds per build).
	if let Ok(m) = fs::metadata("/proc/self/exe") {
		h.write_u64(m.len())
		h.write_u64(m.modified().unix_nanos() as u64)
	}
	for k in 0..texts.len() {
		sp mut := spans[k].clone()
		sp.sort()
		t := texts[k].as_bytes()
		at mut := 0
		for (a, b) in &sp {
			if *a >= at && *b <= t.len() {
				h.write(&t[at..*a])
				h.write_u64(0xb0d1)
				at = *b
			}
		}
		h.write(&t[at..])
		h.write_u64(0xf11e)
	}
	iface := h.finish()
	keys mut := Vec::new()
	for i in 0..r.fns.len() {
		f := &r.fns[i]
		key mut := 0 as u64
		if !f.is_prelude {
			if let Some(b) = &f.decl.body {
				k := b.span.start >> 32
				if b.span.start < resolve::BUILTIN_BASE && k < texts.len() {
					t := texts[k].as_bytes()
					a := b.span.start & 0xffffffff
					e := b.span.end & 0xffffffff
					if a <= e && e <= t.len() {
						fh mut := Hasher::with_seed(iface)
						fh.write_u64(i as u64)
						fh.write(&t[a..e])
						key = fh.finish() | 1
					}
				}
			}
		}
		keys.push(key)
	}
	return keys
}

fun emit_llvm(path &str, dir &str, release bool, tp bool, cache &str, stream option<(string, string, usize)>, tests_out &str) result<codegen::Module, string> {
	t mut := Instant::now()
	l mut := new_loader(Vec::new())
	text := match l.read(path) {
		Ok(s) => s,
		Err(e) => return Err("error: cannot read {path}: {e}\n"),
	}
	items mut := l.parse_file(path, &text)
	l.expand(&mut items, &dir_of(path))
	if l.errors.len() > 0 {
		return Err("{l.errors[0]}\n")
	}
	if let Err(e) = load_path_deps(&mut l, &mut items, path) {
		return Err(e)
	}
	if tests_out.len() > 0 {
		// `kiln test`: the harness `main`, and the test list for the driver.
		tests mut := Vec::new()
		errs mut := Vec::new()
		src := testgen::harness(&mut items, &mut tests, &mut errs)
		if errs.len() > 0 {
			return Err("error at {errs[0].0}..{errs[0].1}: {errs[0].2}\n")
		}
		gen := l.parse_file("<test harness>", &src)
		if l.errors.len() > 0 {
			return Err("{l.errors[0]}\n")
		}
		for g in gen {
			items.push(g)
		}
		write_file(tests_out, &tests_text(&tests))
	}
	user := ast::File { items: items }
	builtin := resolve::builtin_text(dir)
	pre := resolve::parse_at(&builtin, resolve::BUILTIN_BASE, &mut l.next)
	pass_done(tp, &mut t, "parse")
	r := resolve::resolve(&user, &pre.file)
	if r.errors.len() > 0 {
		e := &r.errors[0]
		return Err("resolve error at {e.span.start}..{e.span.end}: {e.message}")
	}
	pass_done(tp, &mut t, "resolve")
	c mut := typeck::typeck_lazy(r)
	pass_done(tp, &mut t, "typeck")
	if c.errors.len() > 0 {
		e := &c.errors[0]
		return Err("type error at {e.span.start}..{e.span.end}: {e.message}")
	}
	keys := if cache.len() > 0 { bck_keys(&c.r, &l.texts, &builtin) } else { Vec::new() }
	lowered mut := Vec::new()
	ds := borrowck::check_cached(&mut c, &mut lowered, &keys, cache)
	pass_done(tp, &mut t, "borrowck")
	if ds.len() > 0 {
		return Err("borrow error at {ds[0].span.start}..{ds[0].span.end}: {ds[0].message}")
	}
	files mut := Vec::new()
	for i in 0..l.files.len() {
		files.push((abs_path(&l.files[i]), l.texts[i].clone()))
	}
	match codegen::compile(c, !release, lowered, files, stream) {
		Ok(ir) => {
			pass_done(tp, &mut t, "codegen")
			return Ok(ir)
		},
		Err(es) => {
			o mut := string::new()
			for (m, s) in &es {
				o.push("error at {s.start}..{s.end}: {m}\n")
			}
			return Err(o)
		},
	}
}

fun new_loader(overlays Vec<(string, string)>) Loader {
	return Loader { files: Vec::new(), texts: Vec::new(), errors: Vec::new(), diags: Vec::new(), overlays: overlays, next: derive::DERIVE_BASE }
}

// The test list `kiln test` reads: `name<TAB>ignore<TAB>should_panic` per
// line, should_panic being `-` (none), `*` (any message) or `=<text>`.
fun tests_text(tests &Vec<testgen::TestCase>) string {
	o mut := string::new()
	for t in tests {
		ig := if t.ignore { "1" } else { "0" }
		sp := match &t.should_panic {
			None => "-".to_string(),
			Some(None) => "*".to_string(),
			Some(Some(w)) => "={field(w)}",
		}
		o.push("{t.name}\t{ig}\t{sp}\n")
	}
	return o
}

// A message as one tab-separated field.
fun field(s &str) string {
	return s.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t")
}

fun put_diag(message &str, span Span, help &option<string>, notes &Vec<(string, option<Span>)>) {
	println("error\t{span.start}\t{span.end}\t{field(message)}")
	for (m, sp) in notes {
		match sp {
			Some(x) => println("note\t{x.start}\t{x.end}\t{field(m)}"),
			None => println("note\t-\t-\t{field(m)}"),
		}
	}
	if let Some(h) = help {
		println("help\t{field(h)}")
	}
}

// `kilnc --check <file.kn>`: the front end (parse, resolve, type check,
// borrow check) over a program, as `kiln check` and the language server run
// it. Prints `file<TAB>base<TAB>path` per loaded file, then the first failing
// phase's diagnostics as `error`/`note`/`help` lines with global spans.
// Returns whether the program is free of errors.
// Prints the navigation facts, each as `fact<TAB>...` (after `kilnc --check` lines).
fun print_facts(facts Vec<string>) {
	for l in index::finish(facts).lines() {
		println("fact\t{l}")
	}
}

fun check(path &str, dir &str, overlays Vec<(string, string)>, want_index bool) bool {
	l mut := new_loader(overlays)
	text := match l.read(path) {
		Ok(s) => s,
		Err(e) => {
			println("fatal\t{field("cannot read {path}: {e}")}")
			return false
		},
	}
	items mut := l.parse_file(path, &text)
	l.expand(&mut items, &dir_of(path))
	dep_err := if l.errors.len() == 0 {
		match load_path_deps(&mut l, &mut items, path) {
			Ok(_) => None,
			Err(e) => Some(e),
		}
	} else {
		None
	}
	for i in 0..l.files.len() {
		println("file\t{i << 32}\t{field(&l.files[i])}")
	}
	// The first failing phase is reported; `--index` still indexes the
	// recovered syntax tree (the editor shows half-typed code).
	bad mut := true
	if l.diags.len() > 0 {
		for (a, b, m) in &l.diags {
			println("error\t{a}\t{b}\t{field(m)}")
		}
	} else if l.errors.len() > 0 {
		println("fatal\t{field(&l.errors[0])}")
	} else if let Some(e) = dep_err {
		println("fatal\t{field(e.trim())}")
	} else {
		bad = false
	}
	if bad && !want_index {
		return false
	}
	user := ast::File { items: items }
	builtin := resolve::builtin_text(dir)
	pre := resolve::parse_at(&builtin, resolve::BUILTIN_BASE, &mut l.next)
	r := resolve::resolve(&user, &pre.file)
	none := Vec::new()
	facts mut := Vec::new()
	if want_index {
		index::resolve_facts(&r, &builtin, &mut facts)
		if bad || r.errors.len() > 0 {
			if r.errors.len() == 0 {
				index::type_facts(&typeck::typeck_lazy(r), &builtin, &mut facts)
			} else if !bad {
				for e in &r.errors {
					put_diag(&e.message, e.span, &e.help, &none)
				}
			}
			print_facts(facts)
			return false
		}
	}
	if r.errors.len() > 0 {
		for e in &r.errors {
			put_diag(&e.message, e.span, &e.help, &none)
		}
		return false
	}
	c mut := typeck::typeck_lazy(r)
	if want_index {
		index::type_facts(&c, &builtin, &mut facts)
		print_facts(facts)
	}
	if c.errors.len() > 0 {
		for e in &c.errors {
			put_diag(&e.message, e.span, &e.help, &none)
		}
		return false
	}
	ds := borrowck::check(&mut c)
	for d in &ds {
		put_diag(&d.message, d.span, &d.help, &d.notes)
	}
	return ds.len() == 0
}

// `kilnc --build <file.kn> -o <out>`: writes `<out>.ll` and links with clang.
fun fail(msg string) {
	eprintln("error: {msg}")
	os::exit(1)
}

fun write_file(path &str, text &str) {
	if let Err(e) = fs::write(path, text.as_bytes()) {
		fail("cannot write {path}: {e}")
	}
}

fun digits(s &str) usize {
	n mut := 0
	for b in s.as_bytes() {
		if *b < 48 || *b > 57 {
			return 0
		}
		n = n * 10 + (*b - 48) as usize
	}
	return n
}

// Parallel clang jobs for debug builds: `KILNC_JOBS`, else the CPU count.
fun jobs() usize {
	if let Some(j) = os::getenv("KILNC_JOBS") {
		n := digits(&j)
		return if n == 0 { 1 } else { n }
	}
	match os::Command::new("nproc").output() {
		Ok(o) => {
			n := digits(o.stdout_text().trim())
			return if n == 0 { 4 } else { n }
		},
		Err(_) => return 4,
	}
}

fun sh_quote(s &str) string {
	return "'{s.replace("'", "'\\''")}'"
}

// `kilnc --build <file.kn> -o <out>`. A debug build splits the program into
// one LLVM module per job and compiles them at `-O0` in parallel; a release
// build compiles it as one module at `-O3`. The IR goes next to `out`.
fun build(path &str, out &str, dir &str, release bool, tp bool, csrc &Vec<string>, native &string, tests_out &str) {
	cc0 := match os::getenv("KILN_CLANG") {
		Some(c) => c,
		None => "clang".to_string(),
	}
	// Debug builds compile shards while codegen runs (KILNC_NO_STREAM=1
	// builds the whole module first).
	stream := if !release && os::getenv("KILNC_NO_STREAM").is_none() { Some((out.to_string(), cc0, jobs())) } else { None }
	m mut := match emit_llvm(path, dir, release, tp, "{out}.bck", stream, tests_out) {
		Ok(m) => m,
		Err(e) => {
			eprint("{e}")
			os::exit(1)
		},
	}
	t mut := Instant::now()
	rt := match os::getenv("KILN_RT") {
		Some(r) => r,
		None => {
			fail("set KILN_RT to the path of libkiln_rt.a".to_string())
			return
		},
	}
	cc := match os::getenv("KILN_CLANG") {
		Some(c) => c,
		None => "clang".to_string(),
	}
	libs mut := " {sh_quote(&rt)}"
	if m.decls.contains("@kn_tls_") {
		// The TLS library sits next to the runtime library.
		dir_end := match rt.find("libkiln_rt.a") {
			Some(i) => i,
			None => 0,
		}
		libs.push(" {sh_quote("{&rt[..dir_end]}libkiln_tls.a")} -lpthread -ldl -lrt -lutil -lgcc_s")
	}
	libs.push(" -lm -lpthread")
	// `[link]` search paths and libraries (`-L`/`-l`), after Kiln's objects.
	libs.push(native.as_str())
	// `--c-source` files: compiled at -O2 and linked in (kilnc's own allocator).
	cobjs mut := string::new()
	ci mut := 0
	for c in csrc {
		co := "{out}.c{ci}.o"
		cobjs.push("{sh_quote(&cc)} -O2 -w -c {sh_quote(c)} -o {sh_quote(&co)}\n")
		libs = " {sh_quote(&co)}{libs}"
		ci += 1
	}
	script mut := "set -e\n{cobjs}"
	// Release: ThinLTO over parallel shards when lld is installed (cross-shard
	// inlining is kept), else one module at -O3.
	lld := match os::Command::new(&cc).arg("-print-prog-name=ld.lld").output() {
		Ok(o) => fs::is_file(o.stdout_text().trim()),
		Err(_) => false,
	}
	thin := release && lld

	if m.objs.len() > 0 {
		// Streamed: the shards are already compiling.
		failed mut := false
		while m.tasks.len() > 0 {
			tk := m.tasks.pop().unwrap()
			match tk.join() {
				Ok(c) => {
					if c > 0 {
						failed = true
					}
				},
				Err(_) => failed = true,
			}
		}
		if failed {
			fail("clang failed".to_string())
		}
		pass_done(tp, &mut t, "shard-compile")
		objs mut := string::new()
		for o in &m.objs {
			objs.push(" {sh_quote(o)}")
		}
		ld := if lld { " -fuse-ld=lld" } else { "" }
		script.push("{sh_quote(&cc)}{ld}{objs}{libs} -o {sh_quote(out)}\n")
	} else if release && !thin {
		ll := "{out}.ll"
		write_file(&ll, &m.single())
		script.push("{sh_quote(&cc)} -O3 -w {sh_quote(&ll)}{libs} -o {sh_quote(out)}\n")
	} else {
		// Several shards per job, so an edit recompiles little; a shard whose
		// IR is unchanged since the last build keeps its object.
		(opt, ext) := if thin { ("-O3 -flto=thin", "bc") } else { ("-O0", "o") }
		// One `nproc` run per build (it forks this large process).
		nj := jobs()
		n0 := nj * 4
		n := if m.funcs.len() / 64 + 1 < n0 { m.funcs.len() / 64 + 1 } else { n0 }
		objs mut := string::new()
		cmds mut := string::new()
		ncmds mut := 0
		texts := m.shards(n)
		pass_done(tp, &mut t, "shard-text")
		for (k, text) in texts.iter().enumerate() {
			ll := "{out}.{k}.ll"
			o := "{out}.{k}.{ext}"
			objs.push(" {sh_quote(&o)}")
			same := match fs::read_to_string(&ll) {
				Ok(old) => old == *text && fs::is_file(&o),
				Err(_) => false,
			}
			if same {
				continue
			}
			// Remove a stale object first, so a failed build can't reuse it.
			script.push("rm -f {sh_quote(&o)}\n")
			write_file(&ll, text)
			cmds.push("{sh_quote(&cc)} {opt} -w -c {sh_quote(&ll)} -o {sh_quote(&o)}\n")
			ncmds += 1
		}
		pass_done(tp, &mut t, "shard-files")
		// A pool of `nj` compiles (not batches of `nj`, where each batch
		// waits for its slowest shard). xargs fails if any command does.
		if ncmds > 0 {
			cpath := "{out}.cmds"
			write_file(&cpath, &cmds)
			script.push("xargs -d '\\n' -P {nj} -I CMD sh -c CMD < {sh_quote(&cpath)}\n")
		}
		lto := if thin { " -O3 -flto=thin -fuse-ld=lld -Wl,--thinlto-jobs={nj}".to_string() } else if lld { " -fuse-ld=lld".to_string() } else { string::new() }
		script.push("{sh_quote(&cc)}{lto}{objs}{libs} -o {sh_quote(out)}\n")
	}
	sh_path := "{out}.build.sh"
	write_file(&sh_path, &script)
	pass_done(tp, &mut t, "write-ir")
	match os::Command::new("sh").arg(&sh_path).status() {
		Ok(code) => {
			if code != 0 {
				fail("clang failed".to_string())
			}
		},
		Err(e) => fail("cannot run sh: {e}"),
	}
	pass_done(tp, &mut t, "clang")
}

fun main() {
	args := os::args()
	if args.len() > 1 && (args[1] == "--emit-llvm" || args[1] == "--build") {
		dir := match os::getenv("KILNC_RESOLVE_DIR") {
			Some(d) => d,
			None => "crates/kiln_resolve".to_string(),
		}
		if args.len() < 3 {
			eprintln("usage: kilnc --emit-llvm <file.kn> | kilnc --build <file.kn> -o <out>")
			os::exit(2)
		}
		if args[1] == "--build" {
			release mut := false
			tp mut := false
			out mut := "a.out".to_string()
			file mut := string::new()
			csrc mut := Vec::new()
			native mut := string::new()
			tests_out mut := string::new()
			j mut := 2
			while j < args.len() {
				if args[j] == "--release" {
					release = true
				} else if args[j] == "--time-passes" {
					tp = true
				} else if args[j] == "--c-source" && j + 1 < args.len() {
					csrc.push(args[j + 1].clone())
					j += 1
				} else if args[j] == "-o" && j + 1 < args.len() {
					out = args[j + 1].clone()
					j += 1
				} else if args[j] == "--tests" && j + 1 < args.len() {
					tests_out = args[j + 1].clone()
					j += 1
				} else if args[j].starts_with("-l") || args[j].starts_with("-L") {
					native.push(" {sh_quote(&args[j])}")
				} else {
					file = args[j].clone()
				}
				j += 1
			}
			build(&file, &out, &dir, release, tp, &csrc, &native, &tests_out)
			return
		}
		match emit_llvm(&args[2], &dir, false, false, "", None, "") {
			Ok(m) => print("{m.single()}"),
			Err(e) => {
				eprint("{e}")
				os::exit(1)
			},
		}
		return
	}
	if args.len() > 1 && (args[1] == "--check" || args[1] == "--index") {
		dir := match os::getenv("KILNC_RESOLVE_DIR") {
			Some(d) => d,
			None => "crates/kiln_resolve".to_string(),
		}
		overlays mut := Vec::new()
		file mut := string::new()
		j mut := 2
		while j < args.len() {
			if args[j] == "--overlay" && j + 2 < args.len() {
				overlays.push((args[j + 1].clone(), args[j + 2].clone()))
				j += 2
			} else {
				file = args[j].clone()
			}
			j += 1
		}
		if file.len() == 0 {
			eprintln("usage: kilnc --check|--index [--overlay <path> <file>]... <file.kn>")
			os::exit(2)
		}
		if !check(&file, &dir, overlays, args[1] == "--index") {
			os::exit(1)
		}
		return
	}
	ast := args.len() > 1 && args[1] == "--ast"
	der := args.len() > 1 && args[1] == "--derive"
	exp := args.len() > 1 && args[1] == "--ast-expanded"
	res := args.len() > 1 && args[1] == "--resolve"
	tck := args.len() > 1 && args[1] == "--typeck"
	mir := args.len() > 1 && args[1] == "--mir"
	bck := args.len() > 1 && args[1] == "--borrowck"
	first := if ast || der || exp || res || tck || mir || bck { 2 } else { 1 }
	n := args.len() - first
	if n == 0 {
		eprintln("usage: kilnc [--ast | --ast-expanded | --derive | --resolve | --typeck | --mir | --borrowck] <file.kn>...")
		os::exit(2)
	}
	i mut := first
	while i < args.len() {
		match fs::read_to_string(&args[i]) {
			Ok(src) => {
				if n > 1 {
					println("== {args[i]}")
				}
				if res || tck || mir || bck {
					dir := match os::getenv("KILNC_RESOLVE_DIR") {
						Some(d) => d,
						None => "crates/kiln_resolve".to_string(),
					}
					if bck {
						print("{borrowck::dump(&src, &dir)}")
					} else if mir {
						print("{lower::dump(&src, &dir)}")
					} else if tck {
						print("{typeck::dump(&src, &dir)}")
					} else {
						print("{resolve::dump(&src, &dir)}")
					}
				} else if exp {
					print("{dump_expanded(&src)}")
				} else if der {
					print("{dump_derive(&src)}")
				} else if ast {
					print("{dump_ast(&src)}")
				} else {
					print("{dump(&src)}")
				}
			}
			Err(e) => {
				eprintln("error: cannot read {args[i]}: {e}")
				os::exit(1)
			},
		}
		i += 1
	}
}

// `p` made absolute against the working directory (for debug info).
fun abs_path(p &str) string {
	if p.starts_with("/") {
		return p.to_string()
	}
	match os::current_dir() {
		Ok(d) => return "{d}/{p}",
		Err(_) => return p.to_string(),
	}
}
