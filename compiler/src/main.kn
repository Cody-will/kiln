// kilnc: the beginnings of the self-hosted Kiln compiler.
//
// For now it is the lexer plus a driver that prints the canonical token
// dump (the format of `kiln lex --dump`, see crates/kiln_lexer/src/dump.rs)
// for each file given: `kilnc <file.kn>...`. `kilnc --ast <file.kn>...`
// parses instead and prints the canonical AST dump (the format of
// `kiln parse --dump`, see crates/kiln_parser/src/dump.rs). With several
// files, each dump is preceded by a line `== <path>`. `kilnc --derive`
// prints the source generated by derive expansion (`kiln parse
// --dump-derive`).

mod token
mod lexer
mod ast
mod debug
mod parser
mod escape
mod derive
mod resolve
mod ty
mod typeck
mod mir
mod sig
mod borrowck
mod lower
mod codegen

import std::fs
import std::os
import ast::{Item, ItemKind}
import token::{StrPart, TokenKind}

fun esc(b &[u8]) string {
	o mut := string::new()
	for x in b {
		c := *x
		if c > 32 && c < 127 && c != 92 {
			o.push_char(c as char)
		} else {
			o.push("\\x{c:02x}")
		}
	}
	if o.is_empty() {
		o.push("-")
	}
	return o
}

fun opt(s &option<string>) string {
	match s {
		Some(x) => return esc(x.as_bytes()),
		None => return "-".to_string(),
	}
}

fun dump(src &str) string {
	l := lexer::lex(src)
	o mut := string::new()
	for t in &l.tokens {
		o.push("tok {t.start} {t.end} ")
		match &t.kind {
			TokenKind::Ident(s) => o.push("ident {esc(s.as_bytes())}"),
			TokenKind::Keyword(s) => o.push("kw {s}"),
			TokenKind::Lifetime(s) => o.push("life {esc(s.as_bytes())}"),
			TokenKind::Int(v, s) => o.push("int {*v} {opt(s)}"),
			TokenKind::Float(text, s) => o.push("float {esc(text.as_bytes())} {opt(s)}"),
			TokenKind::Str(parts) => {
				o.push("str")
				for p in parts {
					match p {
						StrPart::Text(s) => o.push(" T{esc(s.as_bytes())}"),
						StrPart::Interp(src, off, spec) => {
							o.push(" I{esc(src.as_bytes())}@{off}")
							if let Some((s, at)) = spec {
								o.push(":{esc(s.as_bytes())}@{at}")
							}
						},
					}
				}
			}
			TokenKind::RawStr(s) => o.push("raw {esc(s.as_bytes())}"),
			TokenKind::ByteStr(b) => o.push("bytes {esc(b)}"),
			TokenKind::Char(c) => o.push("char {*c as u32}"),
			TokenKind::Semi(i) => o.push("semi {if *i { 1 } else { 0 }}"),
			TokenKind::Punct(p) => o.push("p {p}"),
			TokenKind::Eof => o.push("eof"),
		}
		o.push("\n")
	}
	for (s, e, text) in &l.docs {
		o.push("doc {s} {e} {esc(text.as_bytes())}\n")
	}
	for e in &l.errors {
		o.push("err {e.start} {e.end} {esc(e.message.as_bytes())}\n")
	}
	return o
}

fun dump_ast(src &str) string {
	p := parser::parse(src)
	o mut := debug::dump_file(&p.file)
	for e in &p.errors {
		o.push("error {e.start}..{e.end}: {e.message}\n")
	}
	return o
}

// The AST dump after derive expansion (`kiln parse --dump-expanded`).
fun dump_expanded(src &str) string {
	p mut := parser::parse(src)
	next mut := derive::DERIVE_BASE
	derive::expand(&mut p.file.items, &mut next, &mut p.errors)
	o mut := debug::dump_file(&p.file)
	for e in &p.errors {
		o.push("error {e.start}..{e.end}: {e.message}\n")
	}
	return o
}

fun dump_derive(src &str) string {
	p := parser::parse(src)
	texts mut := Vec::new()
	errors mut := Vec::new()
	derive::generate(&p.file.items, &mut texts, &mut errors)
	o mut := string::new()
	for t in &texts {
		o.push("-- derive\n")
		o.push(t)
	}
	for e in &errors {
		o.push("error {e.span.start}..{e.span.end}: {e.message}\n")
	}
	return o
}

// Loads a program made of several files (see crates/kiln_parser/src/package.rs):
// `mod name` without a body, in a file whose child modules live in `dir`,
// loads `dir/name.kn` or `dir/name/mod.kn`. The k-th file is parsed at span
// base `k << 32`.
struct Loader {
	files Vec<string>,
	errors Vec<string>,
	next usize,
}

impl Loader {
	fun parse_file(&mut self, path &str, text &str) Vec<Item> {
		base := self.files.len() << 32
		self.files.push(path.to_string())
		p := resolve::parse_at(text, base, &mut self.next)
		for e in &p.errors {
			self.errors.push("{path}: parse error at {e.start - base}..{e.end - base}: {e.message}")
		}
		return p.file.items
	}

	fun expand(&mut self, items &mut Vec<Item>, dir &str) {
		for item in items.iter_mut() {
			(name, has_body) := match &item.kind {
				ItemKind::Mod { name, items: body } => (name.name.clone(), body.is_some()),
				_ => continue,
			}
			if has_body {
				if let ItemKind::Mod { name: _, items: Some(inner) } = &mut item.kind {
					self.expand(inner, "{dir}/{name}")
				}
				continue
			}
			flat := "{dir}/{name}.kn"
			nested := "{dir}/{name}/mod.kn"
			path := if fs::is_file(&flat) {
				flat
			} else if fs::is_file(&nested) {
				nested
			} else {
				self.errors.push("file not found for module `{name}`")
				continue
			}
			text := match fs::read_to_string(&path) {
				Ok(t) => t,
				Err(e) => {
					self.errors.push("cannot read `{path}`: {e}")
					continue
				}
			}
			sub mut := self.parse_file(&path, &text)
			self.expand(&mut sub, "{dir}/{name}")
			if let ItemKind::Mod { name: _, items: body } = &mut item.kind {
				*body = Some(sub)
			}
		}
	}
}

fun dir_of(path &str) string {
	b := path.as_bytes()
	i mut := b.len()
	while i > 0 {
		if b[i - 1] == 47 {
			return path[..i - 1].to_string()
		}
		i -= 1
	}
	return ".".to_string()
}

// Front end plus code generation: the program's LLVM IR, or its errors.
fun emit_llvm(path &str, dir &str, release bool) result<string, string> {
	text := match fs::read_to_string(path) {
		Ok(s) => s,
		Err(e) => return Err("error: cannot read {path}: {e}\n"),
	}
	l mut := Loader { files: Vec::new(), errors: Vec::new(), next: derive::DERIVE_BASE }
	items mut := l.parse_file(path, &text)
	l.expand(&mut items, &dir_of(path))
	if l.errors.len() > 0 {
		return Err("{l.errors[0]}\n")
	}
	user := ast::File { items: items }
	pre := resolve::parse_at(&resolve::builtin_text(dir), resolve::BUILTIN_BASE, &mut l.next)
	r := resolve::resolve(&user, &pre.file)
	if r.errors.len() > 0 {
		e := &r.errors[0]
		return Err("resolve error at {e.span.start}..{e.span.end}: {e.message}")
	}
	c mut := typeck::typeck(r)
	if c.errors.len() > 0 {
		e := &c.errors[0]
		return Err("type error at {e.span.start}..{e.span.end}: {e.message}")
	}
	ds := borrowck::check(&mut c)
	if ds.len() > 0 {
		return Err("borrow error at {ds[0].span.start}..{ds[0].span.end}: {ds[0].message}")
	}
	match codegen::compile(c, !release) {
		Ok(ir) => return Ok(ir),
		Err(es) => {
			o mut := string::new()
			for (m, s) in &es {
				o.push("error at {s.start}..{s.end}: {m}\n")
			}
			return Err(o)
		}
	}
}

// `kilnc --build <file.kn> -o <out>`: writes `<out>.ll` and links with clang.
fun build(path &str, out &str, dir &str, release bool) {
	ir := match emit_llvm(path, dir, release) {
		Ok(ir) => ir,
		Err(e) => {
			eprint("{e}")
			os::exit(1)
		}
	}
	ll := "{out}.ll"
	if let Err(e) = fs::write(&ll, ir.as_bytes()) {
		eprintln("error: cannot write {ll}: {e}")
		os::exit(1)
	}
	rt := match os::getenv("KILN_RT") {
		Some(r) => r,
		None => {
			eprintln("error: set KILN_RT to the path of libkiln_rt.a")
			os::exit(1)
		}
	}
	cc := match os::getenv("KILN_CLANG") {
		Some(c) => c,
		None => "clang".to_string(),
	}
	cmd mut := os::Command::new(&cc)
	cmd = cmd.arg(if release { "-O2" } else { "-O1" }).arg("-w").arg(&ll).arg(&rt)
	if ir.contains("@kn_tls_") {
		// The TLS library sits next to the runtime library.
		dir_end := match rt.find("libkiln_rt.a") {
			Some(i) => i,
			None => 0,
		}
		cmd = cmd.arg("{&rt[..dir_end]}libkiln_tls.a").arg("-lpthread").arg("-ldl").arg("-lrt").arg("-lutil").arg("-lgcc_s")
	}
	cmd = cmd.arg("-o").arg(out).arg("-lm").arg("-lpthread")
	st := cmd.status()
	match st {
		Ok(code) => {
			if code != 0 {
				eprintln("error: clang failed")
				os::exit(1)
			}
		}
		Err(e) => {
			eprintln("error: cannot run {cc}: {e}")
			os::exit(1)
		}
	}
}

fun main() {
	args := os::args()
	if args.len() > 1 && (args[1] == "--emit-llvm" || args[1] == "--build") {
		dir := match os::getenv("KILNC_RESOLVE_DIR") {
			Some(d) => d,
			None => "crates/kiln_resolve".to_string(),
		}
		if args.len() < 3 {
			eprintln("usage: kilnc --emit-llvm <file.kn> | kilnc --build <file.kn> -o <out>")
			os::exit(2)
		}
		if args[1] == "--build" {
			release mut := false
			out mut := "a.out".to_string()
			file mut := string::new()
			j mut := 2
			while j < args.len() {
				if args[j] == "--release" {
					release = true
				} else if args[j] == "-o" && j + 1 < args.len() {
					out = args[j + 1].clone()
					j += 1
				} else {
					file = args[j].clone()
				}
				j += 1
			}
			build(&file, &out, &dir, release)
			return
		}
		match emit_llvm(&args[2], &dir, false) {
			Ok(ir) => print("{ir}"),
			Err(e) => {
				eprint("{e}")
				os::exit(1)
			}
		}
		return
	}
	ast := args.len() > 1 && args[1] == "--ast"
	der := args.len() > 1 && args[1] == "--derive"
	exp := args.len() > 1 && args[1] == "--ast-expanded"
	res := args.len() > 1 && args[1] == "--resolve"
	tck := args.len() > 1 && args[1] == "--typeck"
	mir := args.len() > 1 && args[1] == "--mir"
	bck := args.len() > 1 && args[1] == "--borrowck"
	first := if ast || der || exp || res || tck || mir || bck { 2 } else { 1 }
	n := args.len() - first
	if n == 0 {
		eprintln("usage: kilnc [--ast | --ast-expanded | --derive | --resolve | --typeck | --mir | --borrowck] <file.kn>...")
		os::exit(2)
	}
	i mut := first
	while i < args.len() {
		match fs::read_to_string(&args[i]) {
			Ok(src) => {
				if n > 1 {
					println("== {args[i]}")
				}
				if res || tck || mir || bck {
					dir := match os::getenv("KILNC_RESOLVE_DIR") {
						Some(d) => d,
						None => "crates/kiln_resolve".to_string(),
					}
					if bck {
						print("{borrowck::dump(&src, &dir)}")
					} else if mir {
						print("{lower::dump(&src, &dir)}")
					} else if tck {
						print("{typeck::dump(&src, &dir)}")
					} else {
						print("{resolve::dump(&src, &dir)}")
					}
				} else if exp {
					print("{dump_expanded(&src)}")
				} else if der {
					print("{dump_derive(&src)}")
				} else if ast {
					print("{dump_ast(&src)}")
				} else {
					print("{dump(&src)}")
				}
			}
			Err(e) => {
				eprintln("error: cannot read {args[i]}: {e}")
				os::exit(1)
			},
		}
		i += 1
	}
}
