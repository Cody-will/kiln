// Token definitions for the self-hosted lexer (a port of
// crates/kiln_lexer/src/token.rs).

// One segment of a string literal.
@derive(Clone)
pub enum StrPart {
	// Literal text with escapes processed.
	Text(string),
	// `{src}` at byte `offset`, with an optional format spec and its offset.
	Interp(string, usize, option<(string, usize)>),
}

@derive(Clone)
pub enum TokenKind {
	Ident(string),
	// A keyword, by spelling.
	Keyword(string),
	Lifetime(string),
	Int(u128, option<string>),
	// Source text (digits, `.`, exponent; no `_`) and suffix.
	Float(string, option<string>),
	Str(Vec<StrPart>),
	RawStr(string),
	ByteStr(Vec<u8>),
	Char(char),
	// `true` when inserted at a newline.
	Semi(bool),
	// Punctuation and delimiters, by spelling (`_` included).
	Punct(string),
	Eof,
}

@derive(Clone)
pub struct Token {
	pub kind TokenKind,
	pub start usize,
	pub end usize,
}

pub fun is_keyword(s &str) bool {
	match s {
		"as" | "break" | "chan" | "const" | "continue" | "defer" | "dyn" | "else" | "enum" | "extern" => return true,
		"false" | "fun" | "for" | "spawn" | "if" | "impl" | "import" | "in" | "let" | "loop" => return true,
		"match" | "mod" | "move" | "mut" | "pub" | "return" | "select" | "self" | "Self" | "static" => return true,
		"struct" | "trait" | "true" | "type" | "unsafe" | "use" | "where" | "while" => return true,
		"async" | "await" | "macro" | "yield" | "try" => return true,
		_ => return false,
	}
}

// Whether a newline directly after `k` ends the statement (Go's rule).
pub fun ends_statement(k &TokenKind) bool {
	match k {
		TokenKind::Ident(_) | TokenKind::Lifetime(_) | TokenKind::Int(_, _) | TokenKind::Float(_, _) => return true,
		TokenKind::Str(_) | TokenKind::RawStr(_) | TokenKind::ByteStr(_) | TokenKind::Char(_) => return true,
		TokenKind::Keyword(w) => {
			return w == "break" || w == "continue" || w == "return" || w == "true" || w == "false" || w == "self" || w == "Self"
		}
		TokenKind::Punct(p) => return p == ")" || p == "]" || p == "}}" || p == "?" || p == "_",
		_ => return false,
	}
}
