// The Kiln prelude: built-in types and traits visible in every module.
//
// Functions without bodies are provided by the compiler; the others are
// type-checked like user code and compiled on demand. This file is parsed
// with the normal parser; `impl` blocks on primitive types are only allowed here.

pub enum option<T> {
	Some(T),
	None,
}

pub enum result<T, E> {
	Ok(T),
	Err(E),
}

pub struct string
pub struct Vec<T>
	pub struct Box<T>
	pub struct Range<T>

	pub trait Copy {}
// An explicit copy. `#[derive(Clone)]` clones field by field; implement it
// by hand for types that manage resources (like `Arc`).
pub trait Clone {
	fun clone(&self) Self
}
// Equality, used by `==` and `!=`. `#[derive(Eq)]` (and the built-in types)
// compare field by field; implement `eq` by hand to compare differently.
pub trait Eq {
	fun eq(&self, other &Self) bool {
		return std::cmp::derived_eq(self, other)
	}

	fun ne(&self, other &Self) bool {
		return !self.eq(other)
	}
}

// Total ordering, used by `<`, `<=`, `>`, `>=`, sorting, and `BTreeMap`.
// `#[derive(Ord)]` orders field by field in declaration order (enums by
// variant, then payload); strings and sequences order lexicographically.
pub trait Ord {
	fun cmp(&self, other &Self) Ordering {
		return std::cmp::derived_cmp(self, other)
	}

	fun lt(&self, other &Self) bool {
		return self.cmp(other) == Ordering::Less
	}

	fun le(&self, other &Self) bool {
		return self.cmp(other) != Ordering::Greater
	}

	fun gt(&self, other &Self) bool {
		return self.cmp(other) == Ordering::Greater
	}

	fun ge(&self, other &Self) bool {
		return self.cmp(other) != Ordering::Less
	}
}

// Hashing, used by `HashMap` and `HashSet`. Values that are equal must hash
// the same, so a type that implements `eq` by hand must implement `hash` too.
pub trait Hash {
	fun hash(&self, h &mut std::hash::Hasher) {
		std::hash::derived_hash(self, h)
	}
}

// A type that can be viewed as a `&Q`, used for lookups: a `HashMap<String, V>`
// is searched with a `&str`, without building a `String`. Values must hash and
// compare the same as their borrowed form.
pub trait Borrow<Q> {
	fun borrow(&self) &Q
}

impl<T> Borrow<T> for T {
	fun borrow(&self) &T {
		return self
	}
}

impl Borrow<str> for string {
	fun borrow(&self) &str {
		return self.as_str()
	}
}

impl<T> Borrow<[T]> for Vec<T> {
	fun borrow(&self) &[T] {
		return self.as_slice()
	}
}

// The result of comparing two values.
@derive(Clone, Copy, Eq, Ord, Hash, Debug)
pub enum Ordering {
	Less,
	Equal,
	Greater,
}

impl Ordering {
	pub fun is_eq(self) bool {
		return self == Ordering::Equal
	}

	pub fun is_ne(self) bool {
		return self != Ordering::Equal
	}

	pub fun is_lt(self) bool {
		return self == Ordering::Less
	}

	pub fun is_gt(self) bool {
		return self == Ordering::Greater
	}

	pub fun is_le(self) bool {
		return self != Ordering::Greater
	}

	pub fun is_ge(self) bool {
		return self != Ordering::Less
	}

	// Less becomes Greater and vice versa.
	pub fun reverse(self) Ordering {
		return match self {
			Ordering::Less => Ordering::Greater,
			Ordering::Equal => Ordering::Equal,
			Ordering::Greater => Ordering::Less,
		}
	}

	// `self`, or `other` when `self` is Equal: chains comparisons, as in
	// `a.last.cmp(&b.last).then(a.first.cmp(&b.first))`.
	pub fun then(self, other Ordering) Ordering {
		if self == Ordering::Equal {
			return other
		}
		return self
	}
}
// The programmer-facing form, used by `"{x:?}"`. `#[derive(Debug)]` (and
// the built-in types) print the structure: `Point { x: 1, y: 2 }`,
// `Some("a")`, `[1, 2]`. See `std::fmt` to implement it by hand.
pub trait Debug {
	fun fmt_debug(&self, f &mut std::fmt::Formatter) {
		std::fmt::derived_debug(self, f)
	}
}
// Text form used by string interpolation (`"{x}"`) and `to_string()`.
pub trait Display {
	fun to_string(&self) string
}

pub trait Default {}
pub unsafe trait Send {}
pub unsafe trait Sync {}
// An error value: something that can describe what went wrong. `source`
// gives the lower-level error that caused it, if any, so callers can walk
// the chain. `std::errors::AnyError` holds any error.
pub trait Error: Display {
	fun source(&self) option<&dyn Error> {
		return None
	}
}

// Runs cleanup when a value goes out of scope.
pub trait Drop {
	fun drop(&mut self)
}

// A handle to a task started with `spawn`. `join` waits for the task and gives
// its result; dropping the handle detaches the task.
pub struct Task<T>

	impl<T> Task<T> {
		pub fun join(self) result<T, Panic>
	}

// A task's panic. Panics currently end the whole program, so `join` never
// returns one yet.
pub struct Panic

// Why `tx.try_send(v)` failed; the value is handed back.
pub enum TrySendError<T> {
	Full(T),
	Closed(T),
}

// Why `rx.try_recv()` failed.
pub enum TryRecvError {
	Empty,
	Closed,
}

// Scoped tasks: tasks spawned with `s.spawn(...)` may borrow locals and are
// joined before `scope` returns.
pub struct Scope

impl Scope {
	pub fun spawn(&self, task fun mut())
}

pub fun scope(body fun mut(&Scope))

// `*x`, method calls, and field access look through `Deref` (as for `&T`
// and `Box<T>`): `Arc<T>` derefs to `T`, a `MutexGuard<T>` to the locked `T`.
pub trait Deref<T> {
	fun deref(&self) &T
}

// Mutable access through `Deref` (`*guard = v`, `guard.push(x)`).
pub trait DerefMut<T> {
	fun deref_mut(&mut self) &mut T
}

pub trait From<T> {
	fun from(value T) Self
}

// A sequence of `T` values, produced one at a time by `next`. `for x in it`
// works for any iterator. Adapters such as `map` and `filter` are lazy: nothing
// runs until the iterator is consumed (by `for`, `collect`, `count`, ...).
// The adapter types live in `std::iter`.
pub trait Iterator<T> {
	// The next value, or None when the sequence is done.
	fun next(&mut self) option<T>

	// ----- adapters ---------------------------------------------------------------

	// Each value passed through `f`.
		fun map<U>(self, f fun mut(T) U) std::iter::Map<Self, T, U> {
			return std::iter::Map { inner: self, f: f }
		}

	// Only the values for which `keep` returns true.
	fun filter(self, keep fun mut(&T) bool) std::iter::Filter<Self, T> {
		return std::iter::Filter { inner: self, keep: keep }
	}

	// The `Some` results of `f`, skipping the `None`s.
	fun filter_map<U>(self, f fun mut(T) option<U>) std::iter::FilterMap<Self, T, U> {
		return std::iter::FilterMap { inner: self, f: f }
	}

	// Each value with its position: `(0, a), (1, b), ...`.
	fun enumerate(self) std::iter::Enumerate<Self, T> {
		return std::iter::Enumerate { inner: self, n: 0 }
	}

	// Pairs of values from both iterators; stops when either does.
	fun zip<J: Iterator<U>, U>(self, other J) std::iter::Zip<Self, J, T, U> {
		return std::iter::Zip { a: self, b: other }
	}

	// This iterator's values, then `other`'s.
	fun chain<J: Iterator<T>>(self, other J) std::iter::Chain<Self, J, T> {
		return std::iter::Chain { a: self, b: other, first: true }
	}

	// At most the first `n` values.
	fun take(self, n usize) std::iter::Take<Self, T> {
		return std::iter::Take { inner: self, left: n }
	}

	// All but the first `n` values.
	fun skip(self, n usize) std::iter::Skip<Self, T> {
		return std::iter::Skip { inner: self, n: n }
	}

	// Values while `f` holds; stops at the first that fails.
	fun take_while(self, f fun mut(&T) bool) std::iter::TakeWhile<Self, T> {
		return std::iter::TakeWhile { inner: self, f: f, done: false }
	}

	// Skips values while `f` holds, then yields the rest.
	fun skip_while(self, f fun mut(&T) bool) std::iter::SkipWhile<Self, T> {
		return std::iter::SkipWhile { inner: self, f: f, started: false }
	}

	// Every `n`th value, starting with the first.
	fun step_by(self, n usize) std::iter::StepBy<Self, T> {
		if n == 0 {
			panic("step_by: the step must be positive")
		}
		return std::iter::StepBy { inner: self, step: n, first: true }
	}

	// The values of the iterators `f` returns, one after another.
	fun flat_map<J: Iterator<U>, U>(self, f fun mut(T) J) std::iter::FlatMap<Self, T, J, U> {
		return std::iter::FlatMap { inner: self, f: f, cur: None }
	}

	// An iterator that can look at the next value without taking it.
	fun peekable(self) std::iter::Peekable<Self, T> {
		return std::iter::Peekable { inner: self, peeked: None }
	}

	// Calls `f` on each value as it passes through.
	fun inspect(self, f fun mut(&T)) std::iter::Inspect<Self, T> {
		return std::iter::Inspect { inner: self, f: f }
	}

	// ----- consumers ---------------------------------------------------------------

	// All the values, in a vector.
	fun collect(self) Vec<T> {
		it mut := self
		out mut := Vec::new()
		while let Some(x) = it.next() {
			out.push(x)
		}
		return out
	}

	// How many values there are.
	fun count(self) usize {
		it mut := self
		n mut := 0
		while let Some(_) = it.next() {
			n += 1
		}
		return n
	}

	// The last value.
	fun last(self) option<T> {
		it mut := self
		last mut := None
		while let Some(x) = it.next() {
			last = Some(x)
		}
		return last
	}

	// The value at position `n` (counting from 0), consuming those before it.
	fun nth(&mut self, n usize) option<T> {
		i mut := 0
		while let Some(x) = self.next() {
			if i == n {
				return Some(x)
			}
			i += 1
		}
		return None
	}

	// Combines the values from left to right: `f(f(f(init, a), b), c)`.
	fun fold<A>(self, init A, f fun mut(A, T) A) A {
		it mut := self
		acc mut := init
		while let Some(x) = it.next() {
			acc = f(acc, x)
		}
		return acc
	}

	// Calls `f` on each value.
	fun for_each(self, f fun mut(T)) {
		it mut := self
		while let Some(x) = it.next() {
			f(x)
		}
	}

	// Whether `f` holds for some value (stops at the first).
	fun any(&mut self, f fun mut(T) bool) bool {
		while let Some(x) = self.next() {
			if f(x) {
				return true
			}
		}
		return false
	}

	// Whether `f` holds for every value (stops at the first that fails).
	fun all(&mut self, f fun mut(T) bool) bool {
		while let Some(x) = self.next() {
			if !f(x) {
				return false
			}
		}
		return true
	}

	// The first value for which `f` holds.
	fun find(&mut self, f fun mut(&T) bool) option<T> {
		while let Some(x) = self.next() {
			if f(&x) {
				return Some(x)
			}
		}
		return None
	}

	// The position of the first value for which `f` holds.
	fun position(&mut self, f fun mut(T) bool) option<usize> {
		i mut := 0
		while let Some(x) = self.next() {
			if f(x) {
				return Some(i)
			}
			i += 1
		}
		return None
	}

	// The smallest value (the first of equals).
	fun min(self) option<T> where T: Ord {
		it mut := self
		best mut := it.next()?
		while let Some(x) = it.next() {
			if x < best {
				best = x
			}
		}
		return Some(best)
	}

	// The largest value (the last of equals).
	fun max(self) option<T> where T: Ord {
		it mut := self
		best mut := it.next()?
		while let Some(x) = it.next() {
			if x >= best {
				best = x
			}
		}
		return Some(best)
	}

	// The value for which `key` is smallest (the first of equals).
	fun min_by_key<K: Ord>(self, key fun mut(&T) K) option<T> {
		it mut := self
		best mut := it.next()?
		bk mut := key(&best)
		while let Some(x) = it.next() {
			k := key(&x)
			if k < bk {
				best = x
				bk = k
			}
		}
		return Some(best)
	}

	// The value for which `key` is largest (the last of equals).
	fun max_by_key<K: Ord>(self, key fun mut(&T) K) option<T> {
		it mut := self
		best mut := it.next()?
		bk mut := key(&best)
		while let Some(x) = it.next() {
			k := key(&x)
			if k >= bk {
				best = x
				bk = k
			}
		}
		return Some(best)
	}

	// The total of the values (0 when there are none).
	fun sum(self) T where T: Num {
		it mut := self
		acc mut := T::zero()
		while let Some(x) = it.next() {
			acc = acc.add(x)
		}
		return acc
	}

	// The product of the values (1 when there are none).
	fun product(self) T where T: Num {
		it mut := self
		acc mut := T::one()
		while let Some(x) = it.next() {
			acc = acc.mul(x)
		}
		return acc
	}
}

// Ranges are iterators: `(0..10).map(|i| i * i)`.
impl<T> Iterator<T> for Range<T> {
	fun next(&mut self) option<T>
}

// Numbers, for `sum` and `product` (and generic numeric code).
pub trait Num {
	fun zero() Self
	fun one() Self
	fun add(self, other Self) Self
	fun mul(self, other Self) Self
}

impl<T> option<T> {
	pub fun is_some(&self) bool {
		match self {
			Some(_) => return true,
			None => return false,
		}
	}

	pub fun is_none(&self) bool {
		match self {
			Some(_) => return false,
			None => return true,
		}
	}

	pub fun unwrap(self) T {
		match self {
			Some(v) => return v,
			None => panic("called `Option::unwrap()` on a `None` value"),
		}
	}

	pub fun expect(self, msg &str) T {
		match self {
			Some(v) => return v,
			None => panic(msg),
		}
	}

	pub fun unwrap_or(self, default T) T {
		match self {
			Some(v) => return v,
			None => return default,
		}
	}

	// Takes the value out, leaving None.
	pub fun take(&mut self) option<T> {
		return std::mem::replace(self, None)
	}

	// Puts `value` in, returning the old value.
	pub fun replace(&mut self, value T) option<T> {
		return std::mem::replace(self, Some(value))
	}

	// A reference to the value, if any.
	pub fun as_ref(&self) option<&T> {
		match self {
			Some(x) => return Some(x),
			None => return None,
		}
	}

	// A mutable reference to the value, if any.
	pub fun as_mut(&mut self) option<&mut T> {
		match self {
			Some(x) => return Some(x),
			None => return None,
		}
	}

	// The value, or the result of `f`.
	pub fun unwrap_or_else(self, f fun mut() T) T {
		match self {
			Some(x) => return x,
			None => return f(),
		}
	}

	// The value passed through `f`.
	pub fun map<U>(self, f fun mut(T) U) option<U> {
		match self {
			Some(x) => return Some(f(x)),
			None => return None,
		}
	}

	// `f` of the value, or `default`.
	pub fun map_or<U>(self, default U, f fun mut(T) U) U {
		match self {
			Some(x) => return f(x),
			None => return default,
		}
	}

	// `f` of the value (which may itself be None).
	pub fun and_then<U>(self, f fun mut(T) option<U>) option<U> {
		match self {
			Some(x) => return f(x),
			None => return None,
		}
	}

	// This option if it has a value, otherwise `other`.
	pub fun or(self, other option<T>) option<T> {
		match self {
			Some(x) => return Some(x),
			None => return other,
		}
	}

	// This option if it has a value, otherwise the result of `f`.
	pub fun or_else(self, f fun mut() option<T>) option<T> {
		match self {
			Some(x) => return Some(x),
			None => return f(),
		}
	}

	// The value if `keep` holds for it.
	pub fun filter(self, keep fun mut(&T) bool) option<T> {
		match self {
			Some(x) => {
				if keep(&x) {
					return Some(x)
				}
				return None
			},
			None => return None,
		}
	}

	// `Ok(value)`, or `Err(err)` when there is none.
	pub fun ok_or<E>(self, err E) result<T, E> {
		match self {
			Some(x) => return Ok(x),
			None => return Err(err),
		}
	}

	// `Ok(value)`, or `Err(f())` when there is none.
	pub fun ok_or_else<E>(self, f fun mut() E) result<T, E> {
		match self {
			Some(x) => return Ok(x),
			None => return Err(f()),
		}
	}
}

impl<T, E: std::errors::IntoAnyError> result<T, E> {
	// Wraps the error with a message saying what was being done:
	// `fs::read(p).context("loading {p}")?`.
	pub fun context(self, msg &str) result<T, std::errors::AnyError> {
		match self {
			Ok(v) => return Ok(v),
			Err(e) => return Err(e.into_any().context(msg)),
		}
	}
}

impl<T, E> result<T, E> {
	pub fun is_ok(&self) bool {
		match self {
			Ok(_) => return true,
			Err(_) => return false,
		}
	}

	pub fun is_err(&self) bool {
		match self {
			Ok(_) => return false,
			Err(_) => return true,
		}
	}

	pub fun unwrap(self) T {
		match self {
			Ok(v) => return v,
			Err(_) => panic("called `Result::unwrap()` on an `Err` value"),
		}
	}

	pub fun expect(self, msg &str) T {
		match self {
			Ok(v) => return v,
			Err(_) => panic(msg),
		}
	}

	pub fun unwrap_or(self, default T) T {
		match self {
			Ok(v) => return v,
			Err(_) => return default,
		}
	}

	pub fun ok(self) option<T> {
		match self {
			Ok(v) => return Some(v),
			Err(_) => return None,
		}
	}

	pub fun err(self) option<E> {
		match self {
			Ok(_) => return None,
			Err(e) => return Some(e),
		}
	}

	// The success value passed through `f`.
	pub fun map<U>(self, f fun mut(T) U) result<U, E> {
		match self {
			Ok(x) => return Ok(f(x)),
			Err(e) => return Err(e),
		}
	}

	// The error passed through `f`.
	pub fun map_err<F>(self, f fun mut(E) F) result<T, F> {
		match self {
			Ok(x) => return Ok(x),
			Err(e) => return Err(f(e)),
		}
	}

	// `f` of the success value (which may itself fail).
	pub fun and_then<U>(self, f fun mut(T) result<U, E>) result<U, E> {
		match self {
			Ok(x) => return f(x),
			Err(e) => return Err(e),
		}
	}

	// This result if it succeeded, otherwise `f` of the error.
	pub fun or_else<F>(self, f fun mut(E) result<T, F>) result<T, F> {
		match self {
			Ok(x) => return Ok(x),
			Err(e) => return f(e),
		}
	}

	// The success value, or `f` of the error.
	pub fun unwrap_or_else(self, f fun mut(E) T) T {
		match self {
			Ok(x) => return x,
			Err(e) => return f(e),
		}
	}

	// References to the values.
	pub fun as_ref(&self) result<&T, &E> {
		match self {
			Ok(x) => return Ok(x),
			Err(e) => return Err(e),
		}
	}

	// The error value; panics if the result is Ok.
	pub fun unwrap_err(self) E {
		match self {
			Ok(_) => panic("called `unwrap_err` on an `Ok` value"),
			Err(e) => return e,
		}
	}
}

impl string {
	pub fun new() string
	pub fun with_capacity(n usize) string
	pub fun from(s &str) string
	pub fun len(&self) usize
	pub fun capacity(&self) usize
	pub fun reserve(&mut self, additional usize)
	pub fun is_empty(&self) bool
	pub fun push(&mut self, s &str)
	pub fun as_str(&self) &str
	pub fun as_bytes(&self) &[u8]
	pub fun to_upper(&self) string
	pub fun to_lower(&self) string
	pub fun trim(&self) &str

	// The bytes, without copying.
	pub fun into_bytes(self) Vec<u8>

	// A string from bytes the caller knows are valid UTF-8.
		pub unsafe fun from_utf8_unchecked(bytes Vec<u8>) string

	// The underlying bytes; the caller must keep them valid UTF-8.
	pub unsafe fun as_mut_vec(&mut self) &mut Vec<u8>

	// A string from UTF-8 bytes, or an error saying where they stop being valid.
		pub fun from_utf8(bytes Vec<u8>) result<string, Utf8Error> {
			n := kn_utf8_valid_up_to(bytes.as_slice()) as usize
			if n != bytes.len() {
				return Err(Utf8Error { valid_up_to: n })
			}
			return Ok(unsafe { string::from_utf8_unchecked(bytes) })
		}

	// A string from bytes, replacing invalid UTF-8 with U+FFFD.
	pub fun from_utf8_lossy(bytes &[u8]) string {
		out mut := string::with_capacity(bytes.len())
		rest mut := bytes
		while rest.len() > 0 {
			n := kn_utf8_valid_up_to(rest) as usize
			unsafe {
				out.push(std::ptr::str_from_raw(std::ptr::slice_ptr(rest), n))
			}
			if n == rest.len() {
				break
			}
			out.push("\u{FFFD}")
			rest = &rest[n + 1..]
		}
		return out
	}

	// Appends one character.
	pub fun push_char(&mut self, c char) {
		v := c as u32
		buf mut := [0 as u8; 4]
		n mut := 0
		if v < 0x80 {
			buf[0] = v as u8
			n = 1
		} else if v < 0x800 {
			buf[0] = (0xC0 | (v >> 6)) as u8
			buf[1] = (0x80 | (v & 0x3F)) as u8
			n = 2
		} else if v < 0x10000 {
			buf[0] = (0xE0 | (v >> 12)) as u8
			buf[1] = (0x80 | ((v >> 6) & 0x3F)) as u8
			buf[2] = (0x80 | (v & 0x3F)) as u8
			n = 3
		} else {
			buf[0] = (0xF0 | (v >> 18)) as u8
			buf[1] = (0x80 | ((v >> 12) & 0x3F)) as u8
			buf[2] = (0x80 | ((v >> 6) & 0x3F)) as u8
			buf[3] = (0x80 | (v & 0x3F)) as u8
			n = 4
		}
		unsafe {
			self.as_mut_vec().extend_from_slice(&buf[0..n])
		}
	}

	// Removes all contents, keeping the allocation.
	pub fun clear(&mut self) {
		unsafe {
			self.as_mut_vec().set_len(0)
		}
	}

	// Shortens the string to `n` bytes. Panics if `n` is not on a character boundary.
	pub fun truncate(&mut self, n usize) {
		if n < self.len() {
			x := &self[0..n]
			unsafe {
				self.as_mut_vec().set_len(n)
			}
		}
	}
}

// `String::from_utf8` failed: the bytes are valid only up to `valid_up_to`.
pub struct Utf8Error {
	pub valid_up_to usize,
}

impl Display for Utf8Error {
	fun to_string(&self) string {
		return "invalid UTF-8 after byte {self.valid_up_to}"
	}
}

fun kn_utf8_valid_up_to(b &[u8]) i64

impl str {
	pub fun len(&self) usize
	pub fun is_empty(&self) bool
	pub fun to_string(&self) string
	pub fun to_upper(&self) string
	pub fun to_lower(&self) string
	pub fun trim(&self) &str
	pub fun starts_with(&self, prefix &str) bool
	pub fun ends_with(&self, suffix &str) bool
	pub fun contains(&self, needle &str) bool
	pub fun as_bytes(&self) &[u8]

	// Byte index of the first occurrence of `needle`.
	pub fun find(&self, needle &str) option<usize> {
		h := self.as_bytes()
		n := needle.as_bytes()
		if n.len() > h.len() {
			return None
		}
		for i in 0..h.len() - n.len() + 1 {
			j mut := 0
			while j < n.len() && h[i + j] == n[j] {
				j += 1
			}
			if j == n.len() {
				return Some(i)
			}
		}
		return None
	}

	// The parts before and after the first `sep`.
	pub fun split_once(&self, sep &str) option<(&str, &str)> {
		match self.find(sep) {
			Some(i) => return Some((&self[0..i], &self[i + sep.len()..])),
			None => return None,
		}
	}

	// The pieces between occurrences of `sep` (like Go's strings.Split).
	pub fun split(&self, sep &str) Vec<&str> {
		out mut := Vec::new()
		rest mut := self
		if sep.is_empty() {
			out.push(self)
			return out
		}
		loop {
			match rest.find(sep) {
				Some(i) => {
					out.push(&rest[0..i])
					rest = &rest[i + sep.len()..]
				},
				None => {
					out.push(rest)
					return out
				},
			}
		}
	}

	// The lines, without their `\n` or `\r\n` endings.
	pub fun lines(&self) Vec<&str> {
		out mut := Vec::new()
		if self.is_empty() {
			return out
		}
		for line in self.split("\n") {
			out.push(line.strip_suffix("\r").unwrap_or(line))
		}
		if self.ends_with("\n") {
			out.pop()
		}
		return out
	}

	// The string without `prefix`, if it starts with it.
	pub fun strip_prefix(&self, prefix &str) option<&str> {
		if self.starts_with(prefix) {
			return Some(&self[prefix.len()..])
		}
		return None
	}

	// The string without `suffix`, if it ends with it.
	pub fun strip_suffix(&self, suffix &str) option<&str> {
		if self.ends_with(suffix) {
			return Some(&self[0..self.len() - suffix.len()])
		}
		return None
	}

	// The string without leading whitespace.
	pub fun trim_start(&self) &str {
		b := self.as_bytes()
		i mut := 0
		while i < b.len() && is_space(b[i]) {
			i += 1
		}
		return &self[i..]
	}

	// The string without trailing whitespace.
	pub fun trim_end(&self) &str {
		b := self.as_bytes()
		n mut := b.len()
		while n > 0 && is_space(b[n - 1]) {
			n -= 1
		}
		return &self[0..n]
	}

	// A copy with every `from` replaced by `to`.
	pub fun replace(&self, from &str, to &str) string {
		out mut := string::with_capacity(self.len())
		parts := self.split(from)
		for i in 0..parts.len() {
			if i > 0 {
				out.push(to)
			}
			out.push(parts[i])
		}
		return out
	}

	// The string repeated `n` times.
	pub fun repeat(&self, n usize) string {
		out mut := string::with_capacity(self.len() * n)
		for _ in 0..n {
			out.push(self)
		}
		return out
	}

	// Whether two strings are equal ignoring ASCII case.
	pub fun eq_ignore_ascii_case(&self, other &str) bool {
		a := self.as_bytes()
		b := other.as_bytes()
		if a.len() != b.len() {
			return false
		}
		for i in 0..a.len() {
			if ascii_lower(a[i]) != ascii_lower(b[i]) {
				return false
			}
		}
		return true
	}

	// The characters.
	pub fun chars<'a>(&'a self) std::strings::Chars<'a> {
		return std::strings::Chars { b: self.as_bytes(), front: 0, back: self.len() }
	}

	// The characters with their byte offsets.
	pub fun char_indices<'a>(&'a self) std::strings::CharIndices<'a> {
		return std::strings::CharIndices { b: self.as_bytes(), i: 0 }
	}

	// The bytes.
	pub fun bytes<'a>(&'a self) std::iter::Iter<'a, u8> {
		return self.as_bytes().iter()
	}

	// The number of characters (not bytes).
	pub fun char_count(&self) usize {
		n mut := 0
		for b in self.as_bytes() {
			if *b & 192 != 128 {
				n += 1
			}
		}
		return n
	}

	// Whether byte offset `i` is at the start of a character (or the end).
	pub fun is_char_boundary(&self, i usize) bool {
		if i == 0 || i == self.len() {
			return true
		}
		if i > self.len() {
			return false
		}
		return self.as_bytes()[i] & 192 != 128
	}
}

fun is_space(b u8) bool {
	return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12
}

fun ascii_lower(b u8) u8 {
	if b >= 65 && b <= 90 {
		return b + 32
	}
	return b
}

impl<T> Vec<T> {
	pub fun new() Vec<T>
		pub fun with_capacity(n usize) Vec<T>
		pub fun len(&self) usize
	pub fun is_empty(&self) bool
	pub fun push(&mut self, value T)
	pub fun pop(&mut self) option<T>
		pub fun get(&self, index usize) option<&T>
		pub fun first(&self) option<&T>
		pub fun last(&self) option<&T>
		pub fun clear(&mut self)
	pub fun capacity(&self) usize
	pub fun reserve(&mut self, additional usize)

	// The address of the first element.
	pub fun as_ptr(&self) *mut T

	// Sets the length without touching the elements.
	pub unsafe fun set_len(&mut self, n usize)

	// The elements as a slice.
	pub fun as_slice(&self) &[T] {
		return unsafe { std::ptr::slice_from_raw(self.as_ptr(), self.len()) }
	}

	// The elements as a mutable slice.
	pub fun as_mut_slice(&mut self) &mut [T] {
		return unsafe { std::ptr::slice_from_raw(self.as_ptr(), self.len()) }
	}

	// Drops the elements after the first `n`.
	pub fun truncate(&mut self, n usize) {
		while self.len() > n {
			self.pop()
		}
	}

	// Inserts `value` at `index`, shifting later elements right.
	pub fun insert(&mut self, index usize, value T) {
		n := self.len()
		if index > n {
			panic("insertion index is out of bounds")
		}
		self.reserve(1)
		unsafe {
			p := std::ptr::add(self.as_ptr(), index)
			std::ptr::copy(p, std::ptr::add(p, 1), n - index)
			std::ptr::write(p, value)
			self.set_len(n + 1)
		}
	}

	// Removes and returns the element at `index`, shifting later elements left.
	pub fun remove(&mut self, index usize) T {
		n := self.len()
		if index >= n {
			panic("removal index is out of bounds")
		}
		unsafe {
			p := std::ptr::add(self.as_ptr(), index)
			v := std::ptr::read(p)
			std::ptr::copy(std::ptr::add(p, 1), p, n - index - 1)
			self.set_len(n - 1)
			return v
		}
	}

	// Swaps the elements at `a` and `b`.
	pub fun swap(&mut self, a usize, b usize) {
		if a >= self.len() || b >= self.len() {
			panic("swap index is out of bounds")
		}
		if a != b {
			unsafe {
				std::mem::swap(&mut *std::ptr::add(self.as_ptr(), a), &mut *std::ptr::add(self.as_ptr(), b))
			}
		}
	}
}

impl<T: Clone> Vec<T> {
	// Appends clones of the elements of `s`.
	pub fun extend_from_slice(&mut self, s &[T]) {
		n := self.len()
		self.reserve(s.len())
		unsafe {
			p := self.as_ptr()
			for i in 0..s.len() {
				std::ptr::write(std::ptr::add(p, n + i), s[i].clone())
			}
			self.set_len(n + s.len())
		}
	}
}

impl<T> Box<T> {
	pub fun new(value T) Box<T>

	// Gives up ownership: the caller must later rebuild the box with `from_raw`.
		pub fun into_raw(b Box<T>) *mut T

	// Takes ownership of a pointer made by `into_raw`.
	pub unsafe fun from_raw(p *mut T) Box<T>
}

impl char {
	// The character with scalar value `n`; `n` must be valid (see `from_u32`).
	pub unsafe fun from_u32_unchecked(n u32) char

	// The character with scalar value `n`, if it is one.
	pub fun from_u32(n u32) option<char> {
		if n > 1114111 || (n >= 55296 && n <= 57343) {
			return None
		}
		return Some(unsafe { char::from_u32_unchecked(n) })
	}

	// The digit `d` in base `radix` (2 to 36): `from_digit(11, 16)` is 'b'.
	pub fun from_digit(d u32, radix u32) option<char> {
		if radix < 2 || radix > 36 || d >= radix {
			return None
		}
		if d < 10 {
			return Some(unsafe { char::from_u32_unchecked(48 + d) })
		}
		return Some(unsafe { char::from_u32_unchecked(87 + d) })
	}

	// The value of this digit in base `radix` (2 to 36): '7' is 7, 'f' is 15.
	pub fun to_digit(self, radix u32) option<u32> {
		n := self as u32
		d := if n >= 48 && n <= 57 {
			n - 48
		} else if n >= 97 && n <= 122 {
			n - 87
		} else if n >= 65 && n <= 90 {
			n - 55
		} else {
			99
		}
		if d < radix {
			return Some(d)
		}
		return None
	}

	// Whether this is a digit in base `radix`.
	pub fun is_digit(self, radix u32) bool {
		return self.to_digit(radix).is_some()
	}

	// How many bytes this character takes in UTF-8.
	pub fun len_utf8(self) usize {
		return std::utf8::len(self)
	}

	pub fun is_ascii(self) bool {
		return (self as u32) < 128
	}

	pub fun is_ascii_digit(self) bool {
		n := self as u32
		return n >= 48 && n <= 57
	}

	pub fun is_ascii_hexdigit(self) bool {
		return self.to_digit(16).is_some()
	}

	pub fun is_ascii_uppercase(self) bool {
		n := self as u32
		return n >= 65 && n <= 90
	}

	pub fun is_ascii_lowercase(self) bool {
		n := self as u32
		return n >= 97 && n <= 122
	}

	pub fun is_ascii_alphabetic(self) bool {
		return self.is_ascii_uppercase() || self.is_ascii_lowercase()
	}

	pub fun is_ascii_alphanumeric(self) bool {
		return self.is_ascii_alphabetic() || self.is_ascii_digit()
	}

	// Space, tab, newline, form feed, or carriage return.
	pub fun is_ascii_whitespace(self) bool {
		n := self as u32
		return n == 32 || n == 9 || n == 10 || n == 12 || n == 13
	}

	// One of !"#$%&'()*+,-./:;<=>?@[\]^_`{|}~
	pub fun is_ascii_punctuation(self) bool {
		n := self as u32
		return (n >= 33 && n <= 47) || (n >= 58 && n <= 64) || (n >= 91 && n <= 96) || (n >= 123 && n <= 126)
	}

	pub fun to_ascii_uppercase(self) char {
		if self.is_ascii_lowercase() {
			return unsafe { char::from_u32_unchecked(self as u32 - 32) }
		}
		return self
	}

	pub fun to_ascii_lowercase(self) char {
		if self.is_ascii_uppercase() {
			return unsafe { char::from_u32_unchecked(self as u32 + 32) }
		}
		return self
	}

	// A letter, in any script.
	pub fun is_alphabetic(self) bool {
		return std::unicode::is_letter(self)
	}

	// A number, in any script (see `std::unicode::is_number`).
	pub fun is_numeric(self) bool {
		return std::unicode::is_number(self)
	}

	pub fun is_alphanumeric(self) bool {
		return self.is_alphabetic() || self.is_numeric()
	}

	// Unicode white space.
	pub fun is_whitespace(self) bool {
		return std::unicode::is_space(self)
	}

	pub fun is_uppercase(self) bool {
		return std::unicode::is_upper(self)
	}

	pub fun is_lowercase(self) bool {
		return std::unicode::is_lower(self)
	}

	pub fun is_control(self) bool {
		return std::unicode::is_control(self)
	}

	// The uppercase form when it is one character ('ß' stays 'ß').
	pub fun to_uppercase(self) char {
		return std::unicode::to_upper(self)
	}

	// The lowercase form when it is one character.
	pub fun to_lowercase(self) char {
		return std::unicode::to_lower(self)
	}

	// The character as a one-character string.
	pub fun to_string(self) string {
		s mut := string::new()
		s.push_char(self)
		return s
	}
}

impl f64 {
	pub fun sqrt(self) f64
	pub fun abs(self) f64
	pub fun floor(self) f64
	pub fun ceil(self) f64
	pub fun round(self) f64
	pub fun powi(self, n i32) f64
	pub fun min(self, other f64) f64
	pub fun max(self, other f64) f64

	pub fun sin(self) f64 {
		return std::math::sin(self)
	}
	pub fun cos(self) f64 {
		return std::math::cos(self)
	}
	pub fun tan(self) f64 {
		return std::math::tan(self)
	}
	pub fun asin(self) f64 {
		return std::math::asin(self)
	}
	pub fun acos(self) f64 {
		return std::math::acos(self)
	}
	pub fun atan(self) f64 {
		return std::math::atan(self)
	}
	pub fun sinh(self) f64 {
		return std::math::sinh(self)
	}
	pub fun cosh(self) f64 {
		return std::math::cosh(self)
	}
	pub fun tanh(self) f64 {
		return std::math::tanh(self)
	}
	pub fun asinh(self) f64 {
		return std::math::asinh(self)
	}
	pub fun acosh(self) f64 {
		return std::math::acosh(self)
	}
	pub fun atanh(self) f64 {
		return std::math::atanh(self)
	}
	pub fun exp(self) f64 {
		return std::math::exp(self)
	}
	pub fun exp2(self) f64 {
		return std::math::exp2(self)
	}
	pub fun exp_m1(self) f64 {
		return std::math::exp_m1(self)
	}
	pub fun ln(self) f64 {
		return std::math::ln(self)
	}
	pub fun log2(self) f64 {
		return std::math::log2(self)
	}
	pub fun log10(self) f64 {
		return std::math::log10(self)
	}
	pub fun ln_1p(self) f64 {
		return std::math::ln_1p(self)
	}
	pub fun cbrt(self) f64 {
		return std::math::cbrt(self)
	}
	pub fun trunc(self) f64 {
		return std::math::trunc(self)
	}
	pub fun erf(self) f64 {
		return std::math::erf(self)
	}
	pub fun erfc(self) f64 {
		return std::math::erfc(self)
	}
	pub fun gamma(self) f64 {
		return std::math::gamma(self)
	}
	pub fun ln_gamma(self) f64 {
		return std::math::ln_gamma(self)
	}
	pub fun powf(self, y f64) f64 {
		return std::math::powf(self, y)
	}
	// `self.atan2(x)` is the angle of the point (x, self).
	pub fun atan2(self, x f64) f64 {
		return std::math::atan2(self, x)
	}
	pub fun hypot(self, y f64) f64 {
		return std::math::hypot(self, y)
	}
	pub fun fmod(self, y f64) f64 {
		return std::math::fmod(self, y)
	}
	pub fun copysign(self, y f64) f64 {
		return std::math::copysign(self, y)
	}
	pub fun ieee_remainder(self, y f64) f64 {
		return std::math::ieee_remainder(self, y)
	}
	pub fun next_after(self, y f64) f64 {
		return std::math::next_after(self, y)
	}
	pub fun mul_add(self, y f64, z f64) f64 {
		return std::math::mul_add(self, y, z)
	}

	pub fun log(self, base f64) f64 {
		return std::math::log(self, base)
	}

	pub fun is_nan(self) bool {
		return self != self
	}

	pub fun is_infinite(self) bool {
		return std::math::is_infinite(self)
	}

	pub fun is_finite(self) bool {
		return !self.is_nan() && !self.is_infinite()
	}

	pub fun is_sign_negative(self) bool {
		return self < 0.0 || (self == 0.0 && 1.0 / self < 0.0)
	}

	// The fractional part: `self - self.trunc()`.
	pub fun fract(self) f64 {
		return self - self.trunc()
	}

	// 1.0 for positive (and +0.0), -1.0 for negative (and -0.0), NaN for NaN.
	pub fun signum(self) f64 {
		if self.is_nan() {
			return self
		}
		if self.is_sign_negative() {
			return -1.0
		}
		return 1.0
	}

	pub fun to_degrees(self) f64 {
		return self * 180.0 / std::math::PI
	}

	pub fun to_radians(self) f64 {
		return self * std::math::PI / 180.0
	}

	pub fun recip(self) f64 {
		return 1.0 / self
	}

	// `self` limited to `lo..=hi`.
	pub fun clamp(self, lo f64, hi f64) f64 {
		if self < lo {
			return lo
		}
		if self > hi {
			return hi
		}
		return self
	}
}

