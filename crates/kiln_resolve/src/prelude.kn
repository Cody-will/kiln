	}
	pub fn ln_1p(self) -> f32 {
		return (std::math::ln_1p(self as f64)) as f32
	}
	pub fn cbrt(self) -> f32 {
		return (std::math::cbrt(self as f64)) as f32
	}
	pub fn trunc(self) -> f32 {
		return (std::math::trunc(self as f64)) as f32
	}
	pub fn erf(self) -> f32 {
		return (std::math::erf(self as f64)) as f32
	}
	pub fn erfc(self) -> f32 {
		return (std::math::erfc(self as f64)) as f32
	}
	pub fn gamma(self) -> f32 {
		return (std::math::gamma(self as f64)) as f32
	}
	pub fn ln_gamma(self) -> f32 {
		return (std::math::ln_gamma(self as f64)) as f32
	}
	pub fn powf(self, y: f32) -> f32 {
		return (std::math::powf(self as f64, y as f64)) as f32
	}
	// `self.atan2(x)` is the angle of the point (x, self).
	pub fn atan2(self, x: f32) -> f32 {
		return (std::math::atan2(self as f64, x as f64)) as f32
	}
	pub fn hypot(self, y: f32) -> f32 {
		return (std::math::hypot(self as f64, y as f64)) as f32
	}
	pub fn fmod(self, y: f32) -> f32 {
		return (std::math::fmod(self as f64, y as f64)) as f32
	}
	pub fn copysign(self, y: f32) -> f32 {
		return (std::math::copysign(self as f64, y as f64)) as f32
	}
	pub fn ieee_remainder(self, y: f32) -> f32 {
		return (std::math::ieee_remainder(self as f64, y as f64)) as f32
	}
	pub fn next_after(self, y: f32) -> f32 {
		return (std::math::next_after(self as f64, y as f64)) as f32
	}
	pub fn mul_add(self, y: f32, z: f32) -> f32 {
		return (std::math::mul_add(self as f64, y as f64, z as f64)) as f32
	}

	pub fn log(self, base: f32) -> f32 {
		return (std::math::log(self as f64, base as f64)) as f32
	}

	pub fn is_nan(self) -> bool {
		return self != self
	}

	pub fn is_infinite(self) -> bool {
		return std::math::is_infinite(self as f64)
	}

	pub fn is_finite(self) -> bool {
		return !self.is_nan() && !self.is_infinite()
	}

	pub fn is_sign_negative(self) -> bool {
		return self < 0.0 || (self == 0.0 && 1.0 / self < 0.0)
	}

	// The fractional part: `self - self.trunc()`.
	pub fn fract(self) -> f32 {
		return self - self.trunc()
	}

	// 1.0 for positive (and +0.0), -1.0 for negative (and -0.0), NaN for NaN.
	pub fn signum(self) -> f32 {
		if self.is_nan() {
			return self
		}
		if self.is_sign_negative() {
			return -1.0
		}
		return 1.0
	}

	pub fn to_degrees(self) -> f32 {
		return self * (180.0 / std::math::PI) as f32
	}

	pub fn to_radians(self) -> f32 {
		return self * (std::math::PI / 180.0) as f32
	}

	pub fn recip(self) -> f32 {
		return 1.0 / self
	}

	// `self` limited to `lo..=hi`.
	pub fn clamp(self, lo: f32, hi: f32) -> f32 {
		if self < lo {
			return lo
		}
		if self > hi {
			return hi
		}
		return self
	}
}

pub fn print(s: &str)
pub fn println(s: &str)
pub fn eprint(s: &str)
pub fn eprintln(s: &str)
pub fn panic(msg: &str) -> !
pub fn assert(cond: bool)

impl Num for i8 {
	fn zero() -> i8 {
		return 0
	}

	fn one() -> i8 {
		return 1
	}

	fn add(self, other: i8) -> i8 {
		return self + other
	}

	fn mul(self, other: i8) -> i8 {
		return self * other
	}
}

