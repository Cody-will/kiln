		return (std::math::erfc(self as f64)) as f32
	}
	pub fun gamma(self) f32 {
		return (std::math::gamma(self as f64)) as f32
	}
	pub fun ln_gamma(self) f32 {
		return (std::math::ln_gamma(self as f64)) as f32
	}
	pub fun powf(self, y f32) f32 {
		return (std::math::powf(self as f64, y as f64)) as f32
	}
	// `self.atan2(x)` is the angle of the point (x, self).
	pub fun atan2(self, x f32) f32 {
		return (std::math::atan2(self as f64, x as f64)) as f32
	}
	pub fun hypot(self, y f32) f32 {
		return (std::math::hypot(self as f64, y as f64)) as f32
	}
	pub fun fmod(self, y f32) f32 {
		return (std::math::fmod(self as f64, y as f64)) as f32
	}
	pub fun copysign(self, y f32) f32 {
		return (std::math::copysign(self as f64, y as f64)) as f32
	}
	pub fun ieee_remainder(self, y f32) f32 {
		return (std::math::ieee_remainder(self as f64, y as f64)) as f32
	}
	pub fun next_after(self, y f32) f32 {
		return (std::math::next_after(self as f64, y as f64)) as f32
	}
	pub fun mul_add(self, y f32, z f32) f32 {
		return (std::math::mul_add(self as f64, y as f64, z as f64)) as f32
	}

	pub fun log(self, base f32) f32 {
		return (std::math::log(self as f64, base as f64)) as f32
	}

	pub fun is_nan(self) bool {
		return self != self
	}

	pub fun is_infinite(self) bool {
		return std::math::is_infinite(self as f64)
	}

	pub fun is_finite(self) bool {
		return !self.is_nan() && !self.is_infinite()
	}

	pub fun is_sign_negative(self) bool {
		return self < 0.0 || (self == 0.0 && 1.0 / self < 0.0)
	}

	// The fractional part: `self - self.trunc()`.
	pub fun fract(self) f32 {
		return self - self.trunc()
	}

	// 1.0 for positive (and +0.0), -1.0 for negative (and -0.0), NaN for NaN.
	pub fun signum(self) f32 {
		if self.is_nan() {
			return self
		}
		if self.is_sign_negative() {
			return -1.0
		}
		return 1.0
	}

	pub fun to_degrees(self) f32 {
		return self * (180.0 / std::math::PI) as f32
	}

	pub fun to_radians(self) f32 {
		return self * (std::math::PI / 180.0) as f32
	}

	pub fun recip(self) f32 {
		return 1.0 / self
	}

	// `self` limited to `lo..=hi`.
	pub fun clamp(self, lo f32, hi f32) f32 {
		if self < lo {
			return lo
		}
		if self > hi {
			return hi
		}
		return self
	}
}

pub fun print(s &str)
pub fun println(s &str)
pub fun eprint(s &str)
pub fun eprintln(s &str)
pub fun panic(msg &str) !
pub fun assert(cond bool)

// Panics, showing both values, unless `left == right`.
pub fun assert_eq<T: Eq + Debug>(left T, right T) {
	if left != right {
		panic("assertion `left == right` failed\n  left: {left:?}\n right: {right:?}")
	}
}

// Panics, showing the value, if `left == right`.
pub fun assert_ne<T: Eq + Debug>(left T, right T) {
	if left == right {
		panic("assertion `left != right` failed\n  both: {left:?}")
	}
}

impl Num for i8 {
	fun zero() i8 {
		return 0
	}

	fun one() i8 {
		return 1
	}

	fun add(self, other i8) i8 {
		return self + other
	}

	fun mul(self, other i8) i8 {
		return self * other
	}
}

