// HTTP/2 (RFC 9113) clients and servers, with HPACK header compression
// (RFC 7541).
//
//	// A server: HTTPS where clients that offer "h2" with ALPN get HTTP/2
//	// and the rest HTTP/1.1, from the same router.
//	router mut := http::Router::new()
//	router.get("/hello", hello)
//	srv := tls::ServerConfig::from_files("cert.pem", "key.pem")?
//	http2::serve_tls(TcpListener::bind(":8443")?, srv, router)?
//
//	// A client: one connection, several requests multiplexed on it.
//	c mut := http2::Client::connect("example.com:443", &tls::ClientConfig::new()?)?
//	resp := c.send(http::Request::new("GET", "/"))?
//	all := c.send_all(vec![http::Request::new("GET", "/a"), http::Request::new("GET", "/b")])?
//
// Requests and responses are the `http` module's types. A request's target
// is the path (and query); the client adds `:authority` from the address it
// connected to. Cleartext HTTP/2 with prior knowledge ("h2c") is available
// with `Client::connect_plain` and `serve_h2c`, mainly for tests and
// internal services.
//
// Flow control is honored in both directions. Servers handle the streams of
// one connection in the order their requests complete (handlers run on the
// connection's task), while responses are interleaved as the peer's flow
// control windows allow. Server push and priorities are not supported
// (PRIORITY frames are ignored, as RFC 9113 allows).

import std::collections::HashMap
import std::io
import std::io::{Read, Write}
import std::net::{split_host_port, TcpListener, TcpStream}
import std::net::http
import std::net::tls
import std::sync::Arc

// The client connection preface.
const PREFACE &str = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

// Frame types.
const DATA u8 = 0
const HEADERS u8 = 1
const PRIORITY u8 = 2
const RST_STREAM u8 = 3
const SETTINGS u8 = 4
const PUSH_PROMISE u8 = 5
const PING u8 = 6
const GOAWAY u8 = 7
const WINDOW_UPDATE u8 = 8
const CONTINUATION u8 = 9

// Flags.
const END_STREAM u8 = 1
const ACK u8 = 1
const END_HEADERS u8 = 4
const PADDED u8 = 8
const PRIORITY_FLAG u8 = 32

// Settings identifiers.
const SETTINGS_HEADER_TABLE_SIZE u16 = 1
const SETTINGS_ENABLE_PUSH u16 = 2
const SETTINGS_MAX_CONCURRENT_STREAMS u16 = 3
const SETTINGS_INITIAL_WINDOW_SIZE u16 = 4
const SETTINGS_MAX_FRAME_SIZE u16 = 5

// Error codes.
const NO_ERROR u32 = 0
const PROTOCOL_ERROR u32 = 1
const FLOW_CONTROL_ERROR u32 = 3
const FRAME_SIZE_ERROR u32 = 6
const COMPRESSION_ERROR u32 = 9

const DEFAULT_WINDOW i64 = 65535
// Our receive window: we announce 1 MiB per stream and for the connection,
// and top windows back up as data is consumed.
const RECV_WINDOW i64 = 1048576
const MAX_FRAME usize = 16384
// Largest header block or body we accept (64 MiB).
const MAX_BODY usize = 67108864

fun proto_error(msg &str) io::Error {
	return io::Error::new(io::ErrorKind::InvalidData, "http2: {msg}")
}

// ----- HPACK --------------------------------------------------------------------

// The value of an HPACK integer with an `n`-bit prefix at `b[*at]`.
fun read_int(b &[u8], at &mut usize, n u32) result<u64, io::Error> {
	if *at >= b.len() {
		return Err(proto_error("truncated header block"))
	}
	mask := (1u64 << (n as u64)) - 1
	v mut := (b[*at] as u64) & mask
	*at += 1
	if v < mask {
		return Ok(v)
	}
	shift mut := 0u64
	loop {
		if *at >= b.len() || shift > 56 {
			return Err(proto_error("bad header integer"))
		}
		c := b[*at] as u64
		*at += 1
		v += (c & 127) << shift
		shift += 7
		if c & 128 == 0 {
			return Ok(v)
		}
	}
}

// Appends `v` as an HPACK integer with an `n`-bit prefix; `first` holds the
// bits above the prefix.
fun write_int(out &mut Vec<u8>, first u8, n u32, v u64) {
	mask := (1u64 << (n as u64)) - 1
	if v < mask {
		out.push(first | (v as u8))
		return
	}
	out.push(first | (mask as u8))
	x mut := v - mask
	while x >= 128 {
		out.push(((x & 127) | 128) as u8)
		x = x >> 7
	}
	out.push(x as u8)
}

// Decodes Huffman-coded bytes (RFC 7541 Appendix B).
pub fun huffman_decode(b &[u8]) result<Vec<u8>, io::Error> {
	out mut := Vec::new()
	code mut := 0u64
	len mut := 0u32
	for byte in b {
		bit mut := 7i32
		while bit >= 0 {
			code = (code << 1) | (((*byte as u64) >> (bit as u64)) & 1)
			len += 1
			bit -= 1
			if len >= 5 {
				if let Some(sym) = huff_sym(code, len) {
					if sym == 256 {
						return Err(proto_error("EOS in Huffman string"))
					}
					out.push(sym as u8)
					code = 0
					len = 0
				} else if len > 30 {
					return Err(proto_error("bad Huffman code"))
				}
			}
		}
	}
	// Padding: fewer than 8 bits, all ones (a prefix of EOS).
	if len > 7 || code != (1u64 << (len as u64)) - 1 {
		return Err(proto_error("bad Huffman padding"))
	}
	return Ok(out)
}

// The symbol with Huffman code `code` of length `len` bits, if any.
fun huff_sym(code u64, len u32) option<u32> {
	// EOS: 30 ones.
	if len == 30 && code == 0x3fffffff {
		return Some(256)
	}
	for i in 0..256 {
		if HUFF_LENS[i] as u32 == len && HUFF_CODES[i] as u64 == code {
			return Some(i as u32)
		}
	}
	return None
}

// Huffman-encodes `s`.
pub fun huffman_encode(s &[u8]) Vec<u8> {
	out mut := Vec::new()
	acc mut := 0u64
	bits mut := 0u32
	for c in s {
		l := HUFF_LENS[*c as usize] as u32
		acc = (acc << (l as u64)) | (HUFF_CODES[*c as usize] as u64)
		bits += l
		while bits >= 8 {
			bits -= 8
			out.push(((acc >> (bits as u64)) & 255) as u8)
		}
		acc = acc & ((1u64 << (bits as u64)) - 1)
	}
	if bits > 0 {
		// Pad with the most significant bits of EOS (all ones).
		pad := (8 - bits) as u64
		out.push(((acc << pad) | ((1u64 << pad) - 1)) as u8)
	}
	return out
}

// An HPACK string literal at `b[*at]`.
fun read_str(b &[u8], at &mut usize) result<string, io::Error> {
	if *at >= b.len() {
		return Err(proto_error("truncated header block"))
	}
	huff := b[*at] & 128 != 0
	n := read_int(b, at, 7)? as usize
	if *at + n > b.len() {
		return Err(proto_error("truncated header string"))
	}
	raw := &b[*at..*at + n]
	*at += n
	if huff {
		return Ok(string::from_utf8_lossy(&huffman_decode(raw)?))
	}
	return Ok(string::from_utf8_lossy(raw))
}

// Appends `s` as an HPACK string literal, Huffman-coded when shorter.
fun write_str(out &mut Vec<u8>, s &str) {
	h := huffman_encode(s.as_bytes())
	if h.len() < s.len() {
		write_int(out, 128, 7, h.len() as u64)
		out.extend_from_slice(&h)
	} else {
		write_int(out, 0, 7, s.len() as u64)
		out.extend_from_slice(s.as_bytes())
	}
}

// The receiving side of HPACK: a dynamic table of recently sent fields.
pub struct Decoder {
	// Oldest first; index 1 of the dynamic table is the last entry.
	table Vec<(string, string)>,
	size usize,
	max usize,
}

impl Decoder {
	pub fun new() Decoder {
		return Decoder { table: Vec::new(), size: 0, max: 4096 }
	}

	fun entry(&self, i usize) result<(string, string), io::Error> {
		if i == 0 {
			return Err(proto_error("header index 0"))
		}
		if i <= 61 {
			return Ok((STATIC_NAMES[i - 1].to_string(), STATIC_VALUES[i - 1].to_string()))
		}
		d := i - 62
		if d >= self.table.len() {
			return Err(proto_error("header index out of range"))
		}
		return Ok(self.table[self.table.len() - 1 - d].clone())
	}

	fun evict(&mut self) {
		while self.size > self.max && self.table.len() > 0 {
			(n, v) := self.table.remove(0)
			self.size -= n.len() + v.len() + 32
		}
	}

	fun add(&mut self, name string, value string) {
		self.size += name.len() + value.len() + 32
		self.table.push((name, value))
		self.evict()
	}

	// Decodes a complete header block into (name, value) fields.
	pub fun decode(&mut self, b &[u8]) result<Vec<(string, string)>, io::Error> {
		out mut := Vec::new()
		at mut := 0
		while at < b.len() {
			c := b[at]
			if c & 128 != 0 {
				// Indexed field.
				i := read_int(b, &mut at, 7)? as usize
				out.push(self.entry(i)?)
			} else if c & 64 != 0 {
				// Literal with incremental indexing.
				i := read_int(b, &mut at, 6)? as usize
				name := if i == 0 { read_str(b, &mut at)? } else { self.entry(i)?.0 }
				value := read_str(b, &mut at)?
				self.add(name.clone(), value.clone())
				out.push((name, value))
			} else if c & 32 != 0 {
				// Dynamic table size update.
				m := read_int(b, &mut at, 5)? as usize
				if m > 4096 {
					return Err(proto_error("header table size too large"))
				}
				self.max = m
				self.evict()
			} else {
				// Literal without indexing / never indexed.
				i := read_int(b, &mut at, 4)? as usize
				name := if i == 0 { read_str(b, &mut at)? } else { self.entry(i)?.0 }
				value := read_str(b, &mut at)?
				out.push((name, value))
			}
		}
		return Ok(out)
	}
}

// The sending side of HPACK. Fields go out as literals without indexing
// (so the encoder keeps no state); names, and whole fields where possible,
// come from the static table.
pub fun encode_headers(fields &[(string, string)]) Vec<u8> {
	out mut := Vec::new()
	for (name, value) in fields {
		full mut := 0
		named mut := 0
		for i in 0..61 {
			if STATIC_NAMES[i] == name.as_str() {
				if named == 0 {
					named = i + 1
				}
				if STATIC_VALUES[i] == value.as_str() {
					full = i + 1
					break
				}
			}
		}
		if full > 0 {
			write_int(&mut out, 128, 7, full as u64)
		} else if named > 0 {
			write_int(&mut out, 0, 4, named as u64)
			write_str(&mut out, value)
		} else {
			out.push(0)
			write_str(&mut out, name)
			write_str(&mut out, value)
		}
	}
	return out
}

// ----- frames and connections ----------------------------------------------------

// A frame: type, flags, stream, payload.
pub struct Frame {
	pub kind u8,
	pub flags u8,
	pub stream u32,
	pub payload Vec<u8>,
}

// The transport: TCP (h2c) or TLS.
enum Transport {
	Plain(TcpStream),
	Tls(tls::TlsStream),
}

impl Read for Transport {
	fun read(&mut self, buf &mut [u8]) result<usize, io::Error> {
		match self {
			Transport::Plain(t) => return t.read(buf),
			Transport::Tls(t) => return t.read(buf),
		}
	}
}

impl Write for Transport {
	fun write(&mut self, buf &[u8]) result<usize, io::Error> {
		match self {
			Transport::Plain(t) => return t.write(buf),
			Transport::Tls(t) => return t.write(buf),
		}
	}
}

fun be32(b &[u8]) u32 {
	return ((b[0] as u32) << 24) | ((b[1] as u32) << 16) | ((b[2] as u32) << 8) | (b[3] as u32)
}

fun put32(out &mut Vec<u8>, v u32) {
	out.push((v >> 24) as u8)
	out.push((v >> 16) as u8)
	out.push((v >> 8) as u8)
	out.push(v as u8)
}

// One end of an HTTP/2 connection: framing, settings, flow control, HPACK.
struct Conn {
	io Transport,
	dec Decoder,
	// What the peer allows us to send.
	peer_max_frame usize,
	peer_initial_window i64,
	send_window i64,
	stream_send HashMap<u32, i64>,
	// Data received but not yet credited back with WINDOW_UPDATE.
	recv_unacked i64,
	goaway bool,
}

impl Conn {
	fun new(io Transport) Conn {
		return Conn {
			io: io,
			dec: Decoder::new(),
			peer_max_frame: MAX_FRAME,
			peer_initial_window: DEFAULT_WINDOW,
			send_window: DEFAULT_WINDOW,
			stream_send: HashMap::new(),
			recv_unacked: 0,
			goaway: false,
		}
	}

	fun write_frame(&mut self, kind u8, flags u8, stream u32, payload &[u8]) result<void, io::Error> {
		h mut := Vec::new()
		n := payload.len()
		h.push((n >> 16) as u8)
		h.push((n >> 8) as u8)
		h.push(n as u8)
		h.push(kind)
		h.push(flags)
		put32(&mut h, stream & 0x7fffffff)
		h.extend_from_slice(payload)
		self.io.write_all(&h)?
		return Ok(())
	}

	fun read_frame(&mut self) result<Frame, io::Error> {
		h mut := [0 as u8; 9]
		self.io.read_exact(&mut h)?
		n := ((h[0] as usize) << 16) | ((h[1] as usize) << 8) | (h[2] as usize)
		if n > MAX_FRAME {
			self.write_goaway(FRAME_SIZE_ERROR)
			return Err(proto_error("frame too large"))
		}
		payload mut := Vec::new()
		payload.resize(n, 0 as u8)
		self.io.read_exact(payload.as_mut_slice())?
		return Ok(Frame { kind: h[3], flags: h[4], stream: be32(&h[5..9]) & 0x7fffffff, payload: payload })
	}

	fun write_goaway(&mut self, code u32) {
		p mut := Vec::new()
		put32(&mut p, 0)
		put32(&mut p, code)
		if let Err(_) = self.write_frame(GOAWAY, 0, 0, &p) {
		}
	}

	// Our SETTINGS: no push, a 1 MiB stream window; then the extra
	// connection window.
	fun send_settings(&mut self) result<void, io::Error> {
		p mut := Vec::new()
		p.push(0)
		p.push(SETTINGS_ENABLE_PUSH as u8)
		put32(&mut p, 0)
		p.push(0)
		p.push(SETTINGS_INITIAL_WINDOW_SIZE as u8)
		put32(&mut p, RECV_WINDOW as u32)
		self.write_frame(SETTINGS, 0, 0, &p)?
		w mut := Vec::new()
		put32(&mut w, (RECV_WINDOW - DEFAULT_WINDOW) as u32)
		return self.write_frame(WINDOW_UPDATE, 0, 0, &w)
	}

	// Applies the peer's SETTINGS frame and acknowledges it.
	fun on_settings(&mut self, f &Frame) result<void, io::Error> {
		if f.flags & ACK != 0 {
			return Ok(())
		}
		if f.payload.len() % 6 != 0 {
			return Err(proto_error("bad SETTINGS frame"))
		}
		i mut := 0
		while i < f.payload.len() {
			id := ((f.payload[i] as u16) << 8) | (f.payload[i + 1] as u16)
			v := be32(&f.payload[i + 2..i + 6])
			if id == SETTINGS_INITIAL_WINDOW_SIZE {
				if v > 0x7fffffff {
					return Err(proto_error("window too large"))
				}
				// Adjust open streams by the difference.
				delta := v as i64 - self.peer_initial_window
				self.peer_initial_window = v as i64
				for (_, w) in self.stream_send.iter_mut() {
					*w += delta
				}
			} else if id == SETTINGS_MAX_FRAME_SIZE {
				if v < 16384 || v > 16777215 {
					return Err(proto_error("bad max frame size"))
				}
				// We never need frames above 16 KiB.
				self.peer_max_frame = if (v as usize) < MAX_FRAME { v as usize } else { MAX_FRAME }
			}
			i += 6
		}
		return self.write_frame(SETTINGS, ACK, 0, &Vec::new())
	}

	fun on_window_update(&mut self, f &Frame) result<void, io::Error> {
		if f.payload.len() != 4 {
			return Err(proto_error("bad WINDOW_UPDATE frame"))
		}
		inc := (be32(&f.payload) & 0x7fffffff) as i64
		if f.stream == 0 {
			self.send_window += inc
		} else if let Some(w) = self.stream_send.get_mut(&f.stream) {
			*w += inc
		}
		return Ok(())
	}

	// Handles the frames every endpoint treats the same way; true if `f`
	// was one of them.
	fun common(&mut self, f &Frame) result<bool, io::Error> {
		if f.kind == SETTINGS {
			self.on_settings(f)?
			return Ok(true)
		}
		if f.kind == PING {
			if f.flags & ACK == 0 {
				self.write_frame(PING, ACK, 0, &f.payload)?
			}
			return Ok(true)
		}
		if f.kind == WINDOW_UPDATE {
			self.on_window_update(f)?
			return Ok(true)
		}
		if f.kind == GOAWAY {
			self.goaway = true
			return Ok(true)
		}
		if f.kind == PRIORITY {
			return Ok(true)
		}
		return Ok(false)
	}

	// Credits received DATA back to the peer once half the window is used.
	fun consumed(&mut self, stream u32, n usize) result<void, io::Error> {
		self.recv_unacked += n as i64
		if self.recv_unacked >= RECV_WINDOW / 2 {
			w mut := Vec::new()
			put32(&mut w, self.recv_unacked as u32)
			self.write_frame(WINDOW_UPDATE, 0, 0, &w)?
			if stream != 0 {
				self.write_frame(WINDOW_UPDATE, 0, stream, &w)?
			}
			self.recv_unacked = 0
		}
		return Ok(())
	}

	// Sends a header block, split into HEADERS and CONTINUATION frames.
	fun write_headers(&mut self, stream u32, block &[u8], end_stream bool) result<void, io::Error> {
		max := self.peer_max_frame
		first := if block.len() <= max { block.len() } else { max }
		fl mut := if end_stream { END_STREAM } else { 0 }
		if first == block.len() {
			fl = fl | END_HEADERS
		}
		self.write_frame(HEADERS, fl, stream, &block[..first])?
		at mut := first
		while at < block.len() {
			end := if block.len() - at <= max { block.len() } else { at + max }
			f := if end == block.len() { END_HEADERS } else { 0 }
			self.write_frame(CONTINUATION, f, stream, &block[at..end])?
			at = end
		}
		return Ok(())
	}

	// How much of `want` bytes may go out on `stream` now.
	fun allowance(&self, stream u32, want usize) usize {
		sw := match self.stream_send.get(&stream) {
			Some(w) => *w,
			None => self.peer_initial_window,
		}
		m mut := want as i64
		if self.send_window < m {
			m = self.send_window
		}
		if sw < m {
			m = sw
		}
		if (self.peer_max_frame as i64) < m {
			m = self.peer_max_frame as i64
		}
		return if m < 0 { 0 } else { m as usize }
	}

	// Sends one DATA frame of up to the allowed size from `data[*at..]`.
	// Returns false if flow control blocks it.
	fun write_some(&mut self, stream u32, data &[u8], at &mut usize) result<bool, io::Error> {
		left := data.len() - *at
		n := self.allowance(stream, left)
		if n == 0 && left > 0 {
			return Ok(false)
		}
		end_stream := n == left
		self.write_frame(DATA, if end_stream { END_STREAM } else { 0 }, stream, &data[*at..*at + n])?
		*at += n
		self.send_window -= n as i64
		if let Some(w) = self.stream_send.get_mut(&stream) {
			*w -= n as i64
		}
		return Ok(true)
	}
}

// Strips padding (and priority fields) from a HEADERS or DATA payload.
fun frame_body(f &Frame) result<&[u8], io::Error> {
	p := &f.payload[..]
	start mut := 0
	end mut := p.len()
	if f.flags & PADDED != 0 {
		if p.len() == 0 {
			return Err(proto_error("bad padding"))
		}
		pad := p[0] as usize
		start = 1
		if pad > end - start {
			return Err(proto_error("bad padding"))
		}
		end -= pad
	}
	if f.kind == HEADERS && f.flags & PRIORITY_FLAG != 0 {
		start += 5
	}
	if start > end {
		return Err(proto_error("short frame"))
	}
	return Ok(&p[start..end])
}

// A stream's request or response as it arrives.
struct Incoming {
	block Vec<u8>,
	fields Vec<(string, string)>,
	body Vec<u8>,
	headers_done bool,
	done bool,
	reset option<u32>,
}

fun incoming() Incoming {
	return Incoming { block: Vec::new(), fields: Vec::new(), body: Vec::new(), headers_done: false, done: false, reset: None }
}

impl Conn {
	// Applies a stream frame (HEADERS, CONTINUATION, DATA, RST_STREAM) to
	// `ins`. Trailers are decoded and dropped.
	fun on_stream_frame(&mut self, f &Frame, ins &mut Incoming) result<void, io::Error> {
		if f.kind == HEADERS || f.kind == CONTINUATION {
			b := frame_body(f)?
			ins.block.extend_from_slice(b)
			if ins.block.len() > MAX_BODY {
				return Err(proto_error("header block too large"))
			}
			if f.kind == HEADERS && f.flags & END_STREAM != 0 {
				ins.done = true
			}
			if f.flags & END_HEADERS != 0 {
				fields := self.dec.decode(&ins.block)?
				if !ins.headers_done {
					ins.fields = fields
					ins.headers_done = true
				}
				ins.block.clear()
			}
		} else if f.kind == DATA {
			b := frame_body(f)?
			ins.body.extend_from_slice(b)
			if ins.body.len() > MAX_BODY {
				return Err(proto_error("body too large"))
			}
			if f.flags & END_STREAM != 0 {
				ins.done = true
			}
			self.consumed(if ins.done { 0 } else { f.stream }, f.payload.len())?
		} else if f.kind == RST_STREAM {
			code := if f.payload.len() >= 4 { be32(&f.payload) } else { PROTOCOL_ERROR }
			ins.reset = Some(code)
			ins.done = true
		}
		return Ok(())
	}
}

// ----- client --------------------------------------------------------------------

// An HTTP/2 client connection. Requests on it are multiplexed: `send_all`
// sends every request before reading the responses.
pub struct Client {
	c Conn,
	authority string,
	scheme string,
	next_stream u32,
}

impl Client {
	// Connects to `addr` ("host:port") over TLS, requiring the server to
	// agree on "h2" with ALPN.
	pub fun connect(addr &str, cfg &tls::ClientConfig) result<Client, io::Error> {
		(host, _) := split_host_port(addr)?
		h := match host.strip_prefix("[") {
			Some(x) => x.strip_suffix("]").unwrap_or(x),
			None => host,
		}
		tcp := TcpStream::connect(addr)?
		// Offer only h2 (this sets `cfg`'s ALPN list).
		cfg.set_alpn(&["h2"])
		s := tls::TlsStream::client(tcp, h, cfg)?
		if s.alpn() != "h2" {
			return Err(proto_error("server did not agree on h2 (ALPN)"))
		}
		return Client::start(Transport::Tls(s), addr, "https")
	}

	// Connects to `addr` over cleartext TCP, assuming the server speaks
	// HTTP/2 (prior knowledge; see `serve_h2c`).
	pub fun connect_plain(addr &str) result<Client, io::Error> {
		return Client::start(Transport::Plain(TcpStream::connect(addr)?), addr, "http")
	}

	fun start(io Transport, addr &str, scheme &str) result<Client, io::Error> {
		c mut := Conn::new(io)
		c.io.write_all(PREFACE.as_bytes())?
		c.send_settings()?
		return Ok(Client { c: c, authority: addr.to_string(), scheme: scheme.to_string(), next_stream: 1 })
	}

	// Sends one request and waits for its response.
	pub fun send(&mut self, req http::Request) result<http::Response, io::Error> {
		rs mut := self.send_all(one(req))?
		return Ok(rs.remove(0))
	}

	// Sends the requests concurrently on separate streams and returns the
	// responses in the same order.
	pub fun send_all(&mut self, reqs Vec<http::Request>) result<Vec<http::Response>, io::Error> {
		if self.c.goaway {
			return Err(proto_error("connection is closing (GOAWAY)"))
		}
		let mut ids Vec<u32> = Vec::new()
		let mut bodies Vec<(u32, Vec<u8>, usize)> = Vec::new()
		let mut state HashMap<u32, Incoming> = HashMap::new()
		for r in &reqs {
			id := self.next_stream
			self.next_stream += 2
			fields mut := Vec::new()
			fields.push((":method".to_string(), r.method.clone()))
			fields.push((":scheme".to_string(), self.scheme.clone()))
			fields.push((":authority".to_string(), self.authority.clone()))
			fields.push((":path".to_string(), if r.target.len() == 0 { "/".to_string() } else { r.target.clone() }))
			for (n, v) in r.headers.entries() {
				ln := n.to_lower()
				// Connection-specific fields are not allowed in HTTP/2.
				if ln == "connection" || ln == "keep-alive" || ln == "transfer-encoding" || ln == "upgrade" || ln == "host" {
					continue
				}
				fields.push((ln, v.clone()))
			}
			if r.body.len() > 0 {
				fields.push(("content-length".to_string(), "{r.body.len()}"))
			}
			self.c.stream_send.insert(id, self.c.peer_initial_window)
			self.c.write_headers(id, &encode_headers(&fields), r.body.len() == 0)?
			ids.push(id)
			bodies.push((id, r.body.clone(), 0))
			state.insert(id, incoming())
		}
		// Send bodies as flow control allows, reading frames in between.
		loop {
			progress mut := true
			while progress {
				progress = false
				for k in 0..bodies.len() {
					(id, data, at) := bodies[k].clone()
					if at < data.len() {
						a mut := at
						if self.c.write_some(id, &data, &mut a)? {
							progress = true
						}
						bodies[k] = (id, data, a)
					}
				}
			}
			all_done mut := true
			for id in &ids {
				if !state.get(id).unwrap().done {
					all_done = false
				}
			}
			if all_done {
				break
			}
			f := self.c.read_frame()?
			if self.c.common(&f)? {
				if self.c.goaway {
					return Err(proto_error("server closed the connection (GOAWAY)"))
				}
				continue
			}
			if f.kind == PUSH_PROMISE {
				return Err(proto_error("unexpected PUSH_PROMISE"))
			}
			if let Some(ins) = state.get_mut(&f.stream) {
				self.c.on_stream_frame(&f, ins)?
			}
		}
		out mut := Vec::new()
		for id in &ids {
			self.c.stream_send.remove(id)
			ins := state.remove(id).unwrap()
			if let Some(code) = ins.reset {
				return Err(proto_error("stream reset by the server (error {code})"))
			}
			resp mut := http::Response::new(0)
			for (n, v) in &ins.fields {
				if n == ":status" {
					resp.status = parse_u16(v)
				} else if !n.starts_with(":") {
					resp.headers.add(n, v)
				}
			}
			resp.body = ins.body
			out.push(resp)
		}
		return Ok(out)
	}

	// Tells the server no more requests are coming.
	pub fun close(&mut self) {
		self.c.write_goaway(NO_ERROR)
	}
}

fun one(r http::Request) Vec<http::Request> {
	v mut := Vec::new()
	v.push(r)
	return v
}

fun parse_u16(s &str) u16 {
	n mut := 0u32
	for b in s.as_bytes() {
		if *b < 48 || *b > 57 || n > 6553 {
			return 0
		}
		n = n * 10 + (*b - 48) as u32
	}
	return if n > 65535 { 0 } else { n as u16 }
}

// ----- server --------------------------------------------------------------------

// Serves HTTPS on connections from `listener`: clients that agree on "h2"
// with ALPN get HTTP/2, the rest HTTP/1.1, both routed by `router`.
pub fun serve_tls(listener TcpListener, cfg tls::ServerConfig, router http::Router) result<void, io::Error> {
	srv := Arc::new(http::Server::new(router))
	conf := Arc::new(cfg.with_alpn(&["h2", "http/1.1"]))
	loop {
		conn := listener.accept()?
		s := srv.clone()
		t := conf.clone()
		spawn move {
			match tls::TlsStream::server(conn, &*t) {
				Ok(stream) => {
					if stream.alpn() == "h2" {
						if let Err(e) = serve_conn(Transport::Tls(stream), s.router()) {
						}
					} else {
						http::Server::serve_tls_stream(s, stream)
					}
				},
				Err(_) => return,
			}
		}
	}
}

// Serves cleartext HTTP/2 with prior knowledge on connections from `listener`.
pub fun serve_h2c(listener TcpListener, router http::Router) result<void, io::Error> {
	r := Arc::new(router)
	loop {
		conn := listener.accept()?
		rr := r.clone()
		spawn move {
			if let Err(_) = serve_conn(Transport::Plain(conn), &*rr) {
			}
		}
	}
}

// A response being sent, as flow control allows.
struct Outgoing {
	stream u32,
	body Vec<u8>,
	at usize,
}

// Serves one HTTP/2 connection until the client closes it.
fun serve_conn(io Transport, router &http::Router) result<void, io::Error> {
	c mut := Conn::new(io)
	pre mut := [0 as u8; 24]
	c.io.read_exact(&mut pre)?
	pb := PREFACE.as_bytes()
	for i in 0..24 {
		if pre[i] != pb[i] {
			return Err(proto_error("bad connection preface"))
		}
	}
	c.send_settings()?
	let mut streams HashMap<u32, Incoming> = HashMap::new()
	let mut out Vec<Outgoing> = Vec::new()
	last mut := 0u32
	loop {
		// Send what flow control allows.
		k mut := 0
		while k < out.len() {
			o mut := out.remove(k)
			if o.at < o.body.len() {
				a mut := o.at
				while a < o.body.len() {
					if !c.write_some(o.stream, &o.body, &mut a)? {
						break
					}
				}
				o.at = a
			}
			if o.at < o.body.len() {
				out.insert(k, o)
				k += 1
			} else {
				c.stream_send.remove(&o.stream)
			}
		}
		if c.goaway && out.len() == 0 {
			return Ok(())
		}
		f := match c.read_frame() {
			Ok(f) => f,
			Err(e) => {
				if e.kind() == io::ErrorKind::UnexpectedEof {
					return Ok(())
				}
				return Err(e)
			},
		}
		if c.common(&f)? {
			continue
		}
		if f.stream == 0 || f.stream % 2 == 0 {
			c.write_goaway(PROTOCOL_ERROR)
			return Err(proto_error("bad stream id"))
		}
		if f.kind == HEADERS && !streams.contains_key(&f.stream) {
			if f.stream <= last {
				c.write_goaway(PROTOCOL_ERROR)
				return Err(proto_error("stream id went backwards"))
			}
			last = f.stream
			streams.insert(f.stream, incoming())
			c.stream_send.insert(f.stream, c.peer_initial_window)
		}
		done mut := false
		if let Some(ins) = streams.get_mut(&f.stream) {
			c.on_stream_frame(&f, ins)?
			done = ins.done
		}
		if !done {
			continue
		}
		ins := streams.remove(&f.stream).unwrap()
		if ins.reset.is_some() {
			c.stream_send.remove(&f.stream)
			continue
		}
		req mut := http::Request::new("GET", "/")
		for (n, v) in &ins.fields {
			if n == ":method" {
				req.method = v.clone()
			} else if n == ":path" {
				req.target = v.clone()
			} else if n == ":authority" {
				req.headers.set("Host", v)
			} else if !n.starts_with(":") {
				req.headers.add(n, v)
			}
		}
		req.body = ins.body
		resp := router.route(req)
		fields mut := Vec::new()
		fields.push((":status".to_string(), "{resp.status}"))
		for (n, v) in resp.headers.entries() {
			ln := n.to_lower()
			if ln == "connection" || ln == "keep-alive" || ln == "transfer-encoding" {
				continue
			}
			fields.push((ln, v.clone()))
		}
		fields.push(("content-length".to_string(), "{resp.body.len()}"))
		c.write_headers(f.stream, &encode_headers(&fields), resp.body.len() == 0)?
		if resp.body.len() > 0 {
			out.push(Outgoing { stream: f.stream, body: resp.body, at: 0 })
		} else {
			c.stream_send.remove(&f.stream)
		}
	}
}

