// Memory primitives used to build the rest of the standard library.
// Functions without bodies are provided by the compiler.

// Size of `T` in bytes.
pub fun size_of<T>() usize

// Alignment of `T` in bytes.
pub fun align_of<T>() usize

// Takes ownership of `value` without running its destructor.
pub fun forget<T>(value T)

// Returns `value` unchanged, hiding it from the optimizer (for benchmarks:
// the compiler can't constant-fold through it).
pub fun black_box<T>(value T) T

// Swaps two values.
pub fun swap<T>(a &mut T, b &mut T)

// Replaces `*dest` with `value`, returning the old value.
pub fun replace<T>(dest &mut T, value T) T
