// SHA-256 (FIPS 180-4).
//
//	digest := sha256::sum("abc".as_bytes())    // [u8; 32]
//	println(sha256::hex("abc".as_bytes()))      // "ba7816bf..."
//	h mut := sha256::Sha256::new()              // streaming
//	h.update(part1)
//	h.update(part2)
//	d := h.finish()
//
// `Sha256` implements `io::Write`, so `io::copy(&mut file, &mut h)` hashes a file.

import std::io

const K: [u32; 64] = [
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
]

// Digest size in bytes.
pub const SIZE: usize = 32

// Block size in bytes.
pub const BLOCK_SIZE: usize = 64

// A streaming SHA-256 hasher.
pub struct Sha256 {
	h: [u32; 8],
	buf: [u8; 64],
	nbuf: usize,
	len: u64,
}

impl Sha256 {
	// A fresh hasher.
	pub fn new() -> Sha256 {
		return Sha256 {
			h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],
			buf: [0 as u8; 64],
			nbuf: 0,
			len: 0,
		}
	}

	// Feeds more data.
	pub fn update(&mut self, data: &[u8]) {
		self.len += data.len() as u64
		i mut := 0
		while i < data.len() {
			if self.nbuf == 0 && data.len() - i >= 64 {
				self.block(&data[i..(i + 64)])
				i += 64
			} else {
				self.buf[self.nbuf] = data[i]
				self.nbuf += 1
				i += 1
				if self.nbuf == 64 {
					b := self.buf
					self.block(&b)
					self.nbuf = 0
				}
			}
		}
	}

	// The digest of everything fed so far. The hasher can keep going.
	pub fn finish(&self) -> [u8; 32] {
		d mut := Sha256 { h: self.h, buf: self.buf, nbuf: self.nbuf, len: self.len }
		bits := d.len * 8
		pad mut := [0 as u8; 72]
		pad[0] = 128
		n := if d.nbuf < 56 { 56 - d.nbuf } else { 120 - d.nbuf }
		for i in 0..8 {
			pad[n + i] = (bits >> (56 - 8 * i as u64)) as u8
		}
		d.update(&pad[0..(n + 8)])
		out mut := [0 as u8; 32]
		for i in 0..8 {
			for j in 0..4 {
				out[i * 4 + j] = (d.h[i] >> (24 - 8 * j as u32)) as u8
			}
		}
		return out
	}

	// Starts over.
	pub fn reset(&mut self) {
		*self = Sha256::new()
	}

	fn block(&mut self, p: &[u8]) {
		w mut := [0 as u32; 64]
		for i in 0..16 {
			w[i] = ((p[4 * i] as u32) << 24) | ((p[4 * i + 1] as u32) << 16) | ((p[4 * i + 2] as u32) << 8) | (p[4 * i + 3] as u32)
		}
		for i in 16..64 {
			s0 := w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3)
			s1 := w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10)
			w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1)
		}
		a mut := self.h[0]
		b mut := self.h[1]
		c mut := self.h[2]
		d mut := self.h[3]
		e mut := self.h[4]
		f mut := self.h[5]
		g mut := self.h[6]
		h mut := self.h[7]
		for i in 0..64 {
			s1 := e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25)
			ch := (e & f) ^ (!e & g)
			t1 := h.wrapping_add(s1).wrapping_add(ch).wrapping_add(K[i]).wrapping_add(w[i])
			s0 := a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22)
			maj := (a & b) ^ (a & c) ^ (b & c)
			t2 := s0.wrapping_add(maj)
			h = g
			g = f
			f = e
			e = d.wrapping_add(t1)
			d = c
			c = b
			b = a
			a = t1.wrapping_add(t2)
		}
		self.h[0] = self.h[0].wrapping_add(a)
		self.h[1] = self.h[1].wrapping_add(b)
		self.h[2] = self.h[2].wrapping_add(c)
		self.h[3] = self.h[3].wrapping_add(d)
		self.h[4] = self.h[4].wrapping_add(e)
		self.h[5] = self.h[5].wrapping_add(f)
		self.h[6] = self.h[6].wrapping_add(g)
		self.h[7] = self.h[7].wrapping_add(h)
	}
}

impl io::Write for Sha256 {
	fn write(&mut self, buf: &[u8]) -> Result<usize, io::Error> {
		self.update(buf)
		return Ok(buf.len())
	}
}

// The SHA-256 digest of `data`.
pub fn sum(data: &[u8]) -> [u8; 32] {
	h mut := Sha256::new()
	h.update(data)
	return h.finish()
}

// The SHA-256 digest of `data` as lowercase hex.
pub fn hex(data: &[u8]) -> String {
	d := sum(data)
	return std::encoding::hex::encode(&d)
}
