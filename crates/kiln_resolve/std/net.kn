// TCP and UDP networking.
//
// Sockets are non-blocking underneath: a task that waits to accept, read, or
// write parks until the socket is ready, and the worker runs other tasks.
// Addresses are "host:port" strings: "127.0.0.1:8080", "localhost:80",
// "[::1]:443", or ":8080" (all interfaces, IPv4).
//
//	listener := TcpListener::bind(":8080")?
//	for conn in listener.incoming() {
//		conn := conn?
//		spawn move {
//			conn.write_str("hello\n")
//		}
//	}

import std::io
import std::io::{Read, Write}
import std::time::{Duration, Instant}

// A timeout setting as nanoseconds for the runtime: None is 0 (no timeout);
// a zero duration is an error, as in Rust.
fun timeout_ns(d option<Duration>) result<i64, io::Error> {
	match d {
		None => return Ok(0),
		Some(t) => {
			if t.as_nanos() <= 0 {
				return Err(io::Error::new(io::ErrorKind::InvalidInput, "cannot set a zero or negative timeout"))
			}
			return Ok(t.as_nanos())
		},
	}
}

fun kn_net_listen(host &str, port i64) i64
fun kn_net_accept(h i64) i64
fun kn_net_connect(host &str, port i64, timeout_ns i64) i64
fun kn_net_set_timeout(h i64, which i64, ns i64)
fun kn_net_read(h i64, buf &mut [u8]) i64
fun kn_net_write(h i64, buf &[u8]) i64
fun kn_net_shutdown(h i64, how i64) i64
fun kn_net_close(h i64)
fun kn_net_addr(h i64, peer i64, out &mut string) i64
fun kn_net_udp_bind(host &str, port i64) i64
fun kn_net_send_to(h i64, buf &[u8], host &str, port i64) i64
fun kn_net_recv_from(h i64, buf &mut [u8], from &mut string) i64
fun kn_net_resolve_start(host &str) i64
fun kn_net_resolve_wait(j i64, timeout_ns i64) i64
fun kn_net_resolve_result(j i64, out &mut string) i64
fun kn_net_resolve_free(j i64)

// ----- name lookup --------------------------------------------------------------

// The IP addresses `host` resolves to ("93.184.215.14", "2606:2800::1"),
// IPv6 and IPv4 in the system resolver's order, without duplicates. An IP
// literal resolves to itself. The task parks while the lookup runs.
pub fun lookup_host(host &str) result<Vec<string>, io::Error> {
	return lookup(host, 0, None)
}

// Like `lookup_host`, but fails with `ErrorKind::TimedOut` if the answer
// takes longer than `timeout` (the system resolver has no timeout of its
// own; the abandoned lookup finishes in the background).
pub fun lookup_host_timeout(host &str, timeout Duration) result<Vec<string>, io::Error> {
	return lookup(host, timeout_ns(Some(timeout))?, None)
}

// Like `lookup_host`, but gives up when `ctx` is cancelled (as
// `ErrorKind::Interrupted`) or its deadline passes (`TimedOut`).
pub fun lookup_host_ctx(host &str, ctx &std::context::Context) result<Vec<string>, io::Error> {
	return lookup(host, 0, Some(ctx))
}

fun ctx_error(ctx &std::context::Context, what &str) option<io::Error> {
	return match ctx.err() {
		Some(std::context::Error::DeadlineExceeded) => Some(io::Error::new(io::ErrorKind::TimedOut, "{what}: context deadline exceeded")),
		Some(std::context::Error::Canceled) => Some(io::Error::new(io::ErrorKind::Interrupted, "{what}: context canceled")),
		None => None,
	}
}

fun is_ip_literal(host &str) bool {
	if host.len() == 0 {
		return false
	}
	if host.contains(":") {
		return true
	}
	for c in host.as_bytes() {
		if !((*c >= 48 && *c <= 57) || *c == 46) {
			return false
		}
	}
	return true
}

// `timeout` in ns (0: none); `ctx` is polled every 10ms while waiting.
fun lookup(host &str, timeout i64, ctx option<&std::context::Context>) result<Vec<string>, io::Error> {
	what := "lookup {host}"
	if let Some(c) = ctx {
		if let Some(e) = ctx_error(c, &what) {
			return Err(e)
		}
	}
	h := match host.strip_prefix("[") {
		Some(x) => x.strip_suffix("]").unwrap_or(x),
		None => host,
	}
	if is_ip_literal(h) {
		out mut := Vec::new()
		out.push(h.to_string())
		return Ok(out)
	}
	if h.len() == 0 {
		return Err(io::Error::new(io::ErrorKind::InvalidInput, "lookup: empty host name"))
	}
	j := with_ctx(io::check(kn_net_resolve_start(h)), "lookup", h)?
	start := Instant::now()
	loop {
		slice mut := 0 as i64
		if timeout > 0 {
			slice = timeout - start.elapsed().as_nanos()
			if slice <= 0 {
				kn_net_resolve_free(j)
				return Err(io::Error::new(io::ErrorKind::TimedOut, "{what}: i/o timeout"))
			}
		}
		if let Some(c) = ctx {
			if slice == 0 || slice > 10000000 {
				slice = 10000000
			}
		}
		r := kn_net_resolve_wait(j, slice)
		if r < 0 {
			kn_net_resolve_free(j)
			return Err(io::Error::from_runtime(r).context("lookup {h}"))
		}
		if r == 1 {
			break
		}
		if let Some(c) = ctx {
			if let Some(e) = ctx_error(c, &what) {
				kn_net_resolve_free(j)
				return Err(e)
			}
		}
	}
	text mut := string::new()
	r := kn_net_resolve_result(j, &mut text)
	kn_net_resolve_free(j)
	if r < 0 {
		return Err(io::Error::from_runtime(r).context("lookup {h}"))
	}
	out mut := Vec::new()
	for line in text.split("\n") {
		if line.len() > 0 {
			out.push(line.to_string())
		}
	}
	return Ok(out)
}

// Connects to `host:port` via the addresses `lookup` found, with what is
// left of `timeout` (ns) for each attempt.
fun dial_resolved(addr &str, host &str, port u16, timeout i64, ctx option<&std::context::Context>) result<TcpStream, io::Error> {
	start := Instant::now()
	ips := with_ctx(lookup(host, timeout, ctx), "dial tcp", addr)?
	last mut := io::Error::new(io::ErrorKind::NotFound, "dial tcp {addr}: no addresses")
	for ip in ips.iter() {
		left mut := 0 as i64
		if timeout > 0 {
			left = timeout - start.elapsed().as_nanos()
			if left <= 0 {
				return Err(io::Error::new(io::ErrorKind::TimedOut, "dial tcp {addr}: i/o timeout"))
			}
		}
		if let Some(c) = ctx {
			if let Some(e) = ctx_error(c, &"dial tcp {addr}") {
				return Err(e)
			}
			if let Some(d) = c.remaining() {
				if left == 0 || d.as_nanos() < left {
					left = d.as_nanos()
				}
				if left <= 0 {
					left = 1
				}
			}
		}
		r := kn_net_connect(ip, port as i64, left)
		if r >= 0 {
			return Ok(TcpStream { h: r })
		}
		last = io::Error::from_runtime(r).context("dial tcp {addr}")
	}
	return Err(last)
}

// Splits "host:port" into its parts ("" host means any address).
pub fun split_host_port(addr &str) result<(&str, u16), io::Error> {
	b := addr.as_bytes()
	i mut := b.len()
	while i > 0 && b[i - 1] != 58 {
		i -= 1
	}
	if i == 0 {
		return Err(bad_addr(addr, "missing port"))
	}
	host := &addr[0..i - 1]
	port := &addr[i..]
	if port.is_empty() || port.len() > 5 {
		return Err(bad_addr(addr, "invalid port"))
	}
	n mut := 0
	for c in port.as_bytes() {
		if *c < 48 || *c > 57 {
			return Err(bad_addr(addr, "invalid port"))
		}
		n = n * 10 + (*c - 48) as i64
	}
	if n > 65535 {
		return Err(bad_addr(addr, "invalid port"))
	}
	return Ok((host, n as u16))
}

fun bad_addr(addr &str, why &str) io::Error {
	return io::Error::new(io::ErrorKind::InvalidInput, "address {addr}: {why}")
}

fun with_ctx<T>(r result<T, io::Error>, op &str, addr &str) result<T, io::Error> {
	match r {
		Ok(v) => return Ok(v),
		Err(e) => return Err(e.context("{op} {addr}")),
	}
}

// ----- TCP --------------------------------------------------------------------

// A TCP socket listening for connections. Closed when dropped.
pub struct TcpListener {
	h i64,
}

impl TcpListener {
	// Listens on `addr` ("host:port"; port 0 picks a free port).
	pub fun bind(addr &str) result<TcpListener, io::Error> {
		(host, port) := split_host_port(addr)?
		h := with_ctx(io::check(kn_net_listen(host, port as i64)), "listen tcp", addr)?
		return Ok(TcpListener { h: h })
	}

	// Waits for the next connection.
	pub fun accept(&self) result<TcpStream, io::Error> {
		h := io::check(kn_net_accept(self.h))?
		return Ok(TcpStream { h: h })
	}

	// Makes `accept` fail with `ErrorKind::TimedOut` after waiting `d`
	// (`None`: wait forever, the default).
	pub fun set_accept_timeout(&self, d option<Duration>) result<void, io::Error> {
		kn_net_set_timeout(self.h, 0, timeout_ns(d)?)
		return Ok()
	}

	// The address the listener is bound to, like "127.0.0.1:41234".
	pub fun local_addr(&self) result<string, io::Error> {
		s mut := string::new()
		io::check(kn_net_addr(self.h, 0, &mut s))?
		return Ok(s)
	}

	// The port the listener is bound to.
	pub fun port(&self) result<u16, io::Error> {
		a := self.local_addr()?
		(_, p) := split_host_port(&a)?
		return Ok(p)
	}

	// Accepted connections as a channel, for `for conn in listener.incoming()`.
	// A task accepts in the background; it stops after an accept error.
	pub fun incoming(self) <-chan result<TcpStream, io::Error> {
		(tx, rx) := chan::<result<TcpStream, io::Error>>(0)
		spawn move {
			loop {
				r := self.accept()
				failed := r.is_err()
				tx <- r
				if failed {
					return
				}
			}
		}
		return rx
	}
}

impl Drop for TcpListener {
	fun drop(&mut self) {
		kn_net_close(self.h)
	}
}

// Which halves of a connection `shutdown` closes.
pub enum Shutdown {
	Read,
	Write,
	Both,
}

// A TCP connection. Reading and writing work through a shared reference
// (`&TcpStream`), so one task can read while another writes. Closed when dropped.
pub struct TcpStream {
	h i64,
}

impl TcpStream {
	// Connects to `addr` ("host:port"), trying each address the host resolves to.
	pub fun connect(addr &str) result<TcpStream, io::Error> {
		(host, port) := split_host_port(addr)?
		h := with_ctx(io::check(kn_net_connect(host, port as i64, 0)), "dial tcp", addr)?
		return Ok(TcpStream { h: h })
	}

	// Like `connect`, but fails with `ErrorKind::TimedOut` if resolving the
	// host and connecting (to each address in turn) take longer than
	// `timeout` altogether.
	pub fun connect_timeout(addr &str, timeout Duration) result<TcpStream, io::Error> {
		(host, port) := split_host_port(addr)?
		ns := timeout_ns(Some(timeout))?
		if host.len() == 0 || is_ip_literal(host) {
			h := with_ctx(io::check(kn_net_connect(host, port as i64, ns)), "dial tcp", addr)?
			return Ok(TcpStream { h: h })
		}
		return dial_resolved(addr, host, port, ns, None)
	}

	// Dials `addr` within `ctx`: the lookup and the connection give up when
	// it is cancelled (`ErrorKind::Interrupted`) or its deadline passes
	// (`TimedOut`).
	pub fun connect_ctx(addr &str, ctx &std::context::Context) result<TcpStream, io::Error> {
		if let Some(e) = ctx_error(ctx, &"dial tcp {addr}") {
			return Err(e)
		}
		(host, port) := split_host_port(addr)?
		if host.len() == 0 || is_ip_literal(host) {
			match ctx.remaining() {
				Some(d) => return TcpStream::connect_timeout(addr, d),
				None => return TcpStream::connect(addr),
			}
		}
		return dial_resolved(addr, host, port, 0, Some(ctx))
	}

	// Makes each read that waits longer than `d` fail with
	// `ErrorKind::TimedOut` (`None`: wait forever, the default). The
	// connection stays usable after a timeout.
	pub fun set_read_timeout(&self, d option<Duration>) result<void, io::Error> {
		kn_net_set_timeout(self.h, 0, timeout_ns(d)?)
		return Ok()
	}

	// Makes each write that waits longer than `d` fail with `ErrorKind::TimedOut`.
	pub fun set_write_timeout(&self, d option<Duration>) result<void, io::Error> {
		kn_net_set_timeout(self.h, 1, timeout_ns(d)?)
		return Ok()
	}

	// Reads up to `buf.len()` bytes; 0 means the peer closed the connection.
	pub fun read(&self, buf &mut [u8]) result<usize, io::Error> {
		return Ok(io::check(kn_net_read(self.h, buf))? as usize)
	}

	// Writes some of `buf`; returns how many bytes were sent.
	pub fun write(&self, buf &[u8]) result<usize, io::Error> {
		return Ok(io::check(kn_net_write(self.h, buf))? as usize)
	}

	// Writes all of `buf`.
	pub fun write_all(&self, buf &[u8]) result<void, io::Error> {
		done mut := 0
		while done < buf.len() {
			done += self.write(&buf[done..])?
		}
		return Ok()
	}

	// Writes all of `s`.
	pub fun write_str(&self, s &str) result<void, io::Error> {
		return self.write_all(s.as_bytes())
	}

	// Closes the reading half, the writing half, or both.
	pub fun shutdown(&self, how Shutdown) result<void, io::Error> {
		n := match how {
			Shutdown::Read => 0,
			Shutdown::Write => 1,
			Shutdown::Both => 2,
		}
		io::check(kn_net_shutdown(self.h, n))?
		return Ok()
	}

	// This end's address.
	pub fun local_addr(&self) result<string, io::Error> {
		s mut := string::new()
		io::check(kn_net_addr(self.h, 0, &mut s))?
		return Ok(s)
	}

	// The other end's address.
	pub fun peer_addr(&self) result<string, io::Error> {
		s mut := string::new()
		io::check(kn_net_addr(self.h, 1, &mut s))?
		return Ok(s)
	}
}

impl Read for TcpStream {
	fun read(&mut self, buf &mut [u8]) result<usize, io::Error> {
		return Ok(io::check(kn_net_read(self.h, buf))? as usize)
	}
}

impl Write for TcpStream {
	fun write(&mut self, buf &[u8]) result<usize, io::Error> {
		return Ok(io::check(kn_net_write(self.h, buf))? as usize)
	}
}

impl Read for &TcpStream {
	fun read(&mut self, buf &mut [u8]) result<usize, io::Error> {
		return Ok(io::check(kn_net_read(self.h, buf))? as usize)
	}
}

impl Write for &TcpStream {
	fun write(&mut self, buf &[u8]) result<usize, io::Error> {
		return Ok(io::check(kn_net_write(self.h, buf))? as usize)
	}
}

impl Drop for TcpStream {
	fun drop(&mut self) {
		kn_net_close(self.h)
	}
}

// ----- UDP ----------------------------------------------------------------------

// A UDP socket. Closed when dropped.
pub struct UdpSocket {
	h i64,
}

impl UdpSocket {
	// Binds to `addr` ("host:port"; port 0 picks a free port).
	pub fun bind(addr &str) result<UdpSocket, io::Error> {
		(host, port) := split_host_port(addr)?
		h := with_ctx(io::check(kn_net_udp_bind(host, port as i64)), "listen udp", addr)?
		return Ok(UdpSocket { h: h })
	}

	// Sends one datagram to `addr`; returns the bytes sent.
	pub fun send_to(&self, buf &[u8], addr &str) result<usize, io::Error> {
		(host, port) := split_host_port(addr)?
		return Ok(io::check(kn_net_send_to(self.h, buf, host, port as i64))? as usize)
	}

	// Waits for one datagram; returns its length and the sender's address.
	pub fun recv_from(&self, buf &mut [u8]) result<(usize, string), io::Error> {
		from mut := string::new()
		n := io::check(kn_net_recv_from(self.h, buf, &mut from))?
		return Ok((n as usize, from))
	}

	// The address the socket is bound to.
	pub fun local_addr(&self) result<string, io::Error> {
		s mut := string::new()
		io::check(kn_net_addr(self.h, 0, &mut s))?
		return Ok(s)
	}

	// Makes `recv_from` fail with `ErrorKind::TimedOut` after waiting `d`.
	pub fun set_read_timeout(&self, d option<Duration>) result<void, io::Error> {
		kn_net_set_timeout(self.h, 0, timeout_ns(d)?)
		return Ok()
	}

	// Makes `send_to` fail with `ErrorKind::TimedOut` after waiting `d`.
	pub fun set_write_timeout(&self, d option<Duration>) result<void, io::Error> {
		kn_net_set_timeout(self.h, 1, timeout_ns(d)?)
		return Ok()
	}
}

impl Drop for UdpSocket {
	fun drop(&mut self) {
		kn_net_close(self.h)
	}
}
