// Comma-separated values (RFC 4180), like Go's `encoding/csv`.
//
//	rows := csv::parse("name,age\n\"Smith, J\",42\n")?   // Vec<Vec<String>>
//	r mut := csv::Reader::new(file)
//	while let Some(rec) = r.next_record()? { ... }
//	w mut := csv::Writer::new(io::stdout())
//	w.write_record(&["a", "b,c"])?                        // a,"b,c"
//
// Fields may be quoted with `"`; a quoted field can hold the delimiter,
// newlines, and `""` for a literal quote. Lines may end in `\n` or `\r\n`.
// By default every record must have as many fields as the first one.

import std::io
import std::io::{BufReader, Read, Write}
import super::super::super::Error as ErrorTrait

// Why reading CSV failed.
#[derive(Debug)]
pub enum Error {
	// The underlying reader failed.
	Io(io::Error),
	// Malformed input at a 1-based line and column (in bytes).
	Parse(usize, usize, String),
	// Record on this line has a different number of fields than the first.
	FieldCount(usize, usize, usize),
}

impl Display for Error {
	fn to_string(&self) -> String {
		match self {
			Error::Io(e) => return "csv: {e}",
			Error::Parse(l, c, m) => {
				if *c == 0 {
					return "csv: line {l}: {m}"
				}
				return "csv: line {l}, column {c}: {m}"
			},
			Error::FieldCount(l, got, want) => return "csv: line {l}: record has {got} fields, expected {want}",
		}
	}
}

impl ErrorTrait for Error {}

impl From<io::Error> for Error {
	fn from(e: io::Error) -> Error {
		return Error::Io(e)
	}
}

// Reads records from any `io::Read`.
pub struct Reader<R: Read> {
	r: BufReader<R>,
	line: usize,
	want: Option<usize>,
	// Field separator (default `,`).
	pub delimiter: u8,
	// Lines starting with this byte are skipped (default none, Go's `Comment`).
	pub comment: Option<u8>,
	// Skip the field-count check (Go's `FieldsPerRecord = -1`).
	pub flexible: bool,
	// Remove leading spaces from unquoted fields.
	pub trim_leading_space: bool,
}

impl<R: Read> Reader<R> {
	// A reader with the default settings.
	pub fn new(r: R) -> Reader<R> {
		return Reader {
			r: BufReader::new(r),
			line: 0,
			want: None,
			delimiter: 44,
			comment: None,
			flexible: false,
			trim_leading_space: false,
		}
	}

	// The 1-based line where the last record started (0 before reading).
	pub fn line(&self) -> usize {
		return self.line
	}

	// The next record, or `None` at the end of the input. Empty lines are skipped.
	pub fn next_record(&mut self) -> Result<Option<Vec<String>>, Error> {
		line mut := Vec::new()
		loop {
			line.clear()
			n := self.r.read_until(10, &mut line)?
			if n == 0 {
				return Ok(None)
			}
			self.line += 1
			strip_eol(&mut line)
			if line.len() == 0 {
				continue
			}
			if let Some(c) = self.comment {
				if line[0] == c {
					continue
				}
			}
			break
		}
		start := self.line
		fields mut := Vec::new()
		field mut := Vec::new()
		i mut := 0
		loop {
			// Start of a field.
			if self.trim_leading_space {
				while i < line.len() && (line[i] == 32 || line[i] == 9) {
					i += 1
				}
			}
			if i < line.len() && line[i] == 34 {
				// Quoted field: may continue onto following lines.
				i += 1
				loop {
					if i >= line.len() {
						// Newline inside quotes.
						more mut := Vec::new()
						n := self.r.read_until(10, &mut more)?
						if n == 0 {
							return Err(Error::Parse(start, 0, "unterminated quoted field".to_string()))
						}
						self.line += 1
						field.push(10)
						strip_eol(&mut more)
						line = more
						i = 0
						continue
					}
					c := line[i]
					if c == 34 {
						if i + 1 < line.len() && line[i + 1] == 34 {
							field.push(34)
							i += 2
							continue
						}
						i += 1
						break
					}
					field.push(c)
					i += 1
				}
				if i < line.len() && line[i] != self.delimiter {
					return Err(Error::Parse(self.line, i + 1, "extraneous or missing \" in quoted field".to_string()))
				}
			} else {
				while i < line.len() && line[i] != self.delimiter {
					if line[i] == 34 {
						return Err(Error::Parse(self.line, i + 1, "bare \" in non-quoted field".to_string()))
					}
					field.push(line[i])
					i += 1
				}
			}
			fields.push(to_text(field, self.line)?)
			field = Vec::new()
			if i >= line.len() {
				break
			}
			i += 1
			if i == line.len() {
				// Trailing delimiter: one more empty field.
				fields.push(String::new())
				break
			}
		}
		if !self.flexible {
			match self.want {
				Some(w) => {
					if w != fields.len() {
						return Err(Error::FieldCount(start, fields.len(), w))
					}
				},
				None => {
					self.want = Some(fields.len())
				},
			}
		}
		return Ok(Some(fields))
	}

	// All remaining records.
	pub fn read_all(&mut self) -> Result<Vec<Vec<String>>, Error> {
		out mut := Vec::new()
		while let Some(rec) = self.next_record()? {
			out.push(rec)
		}
		return Ok(out)
	}
}

fn strip_eol(line: &mut Vec<u8>) {
	if line.len() > 0 && line[line.len() - 1] == 10 {
		line.pop()
		if line.len() > 0 && line[line.len() - 1] == 13 {
			line.pop()
		}
	}
}

fn to_text(b: Vec<u8>, line: usize) -> Result<String, Error> {
	match String::from_utf8(b) {
		Ok(s) => return Ok(s),
		Err(_) => return Err(Error::Parse(line, 0, "invalid UTF-8".to_string())),
	}
}

// Parses a whole CSV document held in memory.
pub fn parse(text: &str) -> Result<Vec<Vec<String>>, Error> {
	r mut := Reader::new(io::Cursor::from_str(text))
	return r.read_all()
}

// Writes records to any `io::Write`. Fields are quoted only when needed.
pub struct Writer<W: Write> {
	w: W,
	// Field separator (default `,`).
	pub delimiter: u8,
	// End lines with `\r\n` instead of `\n`.
	pub use_crlf: bool,
}

impl<W: Write> Writer<W> {
	// A writer with the default settings.
	pub fn new(w: W) -> Writer<W> {
		return Writer { w: w, delimiter: 44, use_crlf: false }
	}

	// Writes one record.
	pub fn write_record(&mut self, fields: &[&str]) -> Result<(), io::Error> {
		out mut := Vec::new()
		for i in 0..fields.len() {
			if i > 0 {
				out.push(self.delimiter)
			}
			quote_field(&mut out, fields[i], self.delimiter)
		}
		if self.use_crlf {
			out.push(13)
		}
		out.push(10)
		return self.w.write_all(&out)
	}

	// Writes one record of owned strings.
	pub fn write_strings(&mut self, fields: &[String]) -> Result<(), io::Error> {
		refs mut := Vec::with_capacity(fields.len())
		for f in fields.iter() {
			refs.push(f.as_str())
		}
		return self.write_record(&refs)
	}

	// Flushes the underlying writer.
	pub fn flush(&mut self) -> Result<(), io::Error> {
		return self.w.flush()
	}

	// The underlying writer.
	pub fn into_inner(self) -> W {
		return self.w
	}
}

fn quote_field(out: &mut Vec<u8>, f: &str, delim: u8) {
	b := f.as_bytes()
	needs mut := b.len() > 0 && (b[0] == 32 || b[0] == 9)
	for c in b.iter() {
		if *c == delim || *c == 34 || *c == 10 || *c == 13 {
			needs = true
		}
	}
	if !needs {
		out.extend_from_slice(b)
		return
	}
	out.push(34)
	for c in b.iter() {
		if *c == 34 {
			out.push(34)
		}
		out.push(*c)
	}
	out.push(34)
}

// Formats records as a CSV document.
pub fn format(rows: &[Vec<String>]) -> String {
	w mut := Writer::new(Vec::new())
	for r in rows.iter() {
		w.write_strings(r).unwrap()
	}
	return String::from_utf8(w.into_inner()).unwrap()
}
