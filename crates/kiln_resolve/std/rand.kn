// Random numbers.
//
//	n := rand::range(1, 7)            // a die roll, 1 to 6
//	x := rand::next_f64()             // in [0, 1)
//	rand::shuffle(&mut cards)
//	pick := rand::choose(&names)      // Option<&String>
//
//	r mut := rand::Rng::with_seed(42) // reproducible sequences
//	r.range(0, 100)
//
// The free functions share one generator seeded from the operating system;
// they are safe to call from any task. `Rng` is a fast generator
// (xoshiro256**) for one task's use; with a fixed seed it repeats exactly.
// Neither is suitable for keys or tokens: use `rand::secure_fill`, which
// reads the operating system's cryptographic random source.

import std::sync::{AtomicBool, AtomicI64}

fun kn_random_bytes(buf *mut u8, n usize) i32

const GAMMA u64 = 0x9E3779B97F4A7C15
const SIGN u64 = 0x8000000000000000

static STATE AtomicI64 = AtomicI64::new(0)
static SEEDED AtomicBool = AtomicBool::new(false)

// Fills `buf` from the operating system's cryptographically secure random
// source. Use this for keys, tokens, and nonces.
pub fun secure_fill(buf &mut [u8]) {
	if buf.len() == 0 {
		return
	}
	n := buf.len()
	p := std::ptr::slice_ptr(buf)
	unsafe {
		if kn_random_bytes(p, n) == 0 {
			panic("rand::secure_fill: the operating system random source failed")
		}
	}
}

// A cryptographically secure random u64.
pub fun secure_u64() u64 {
	b mut := [0u8; 8]
	secure_fill(&mut b)
	let mut x u64 = 0
	for v in b.iter() {
		x = (x << 8) | (*v as u64)
	}
	return x
}

// The splitmix64 output function.
fun mix(z0 u64) u64 {
	z mut := z0
	z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9)
	z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB)
	return z ^ (z >> 31)
}

// A random u64 from the shared generator.
pub fun next_u64() u64 {
	if !SEEDED.load() {
		STATE.compare_and_swap(0, secure_u64() as i64)
		SEEDED.store(true)
	}
	return mix(STATE.add(GAMMA as i64) as u64)
}

// A random u32 from the shared generator.
pub fun next_u32() u32 {
	return (next_u64() >> 32) as u32
}

// A random number in [0, 1).
pub fun next_f64() f64 {
	return (next_u64() >> 11) as f64 * (1.0 / 9007199254740992.0)
}

// A random bool.
pub fun next_bool() bool {
	return next_u64() >> 63 == 1
}

// True with probability `p`.
pub fun chance(p f64) bool {
	return next_f64() < p
}

// A uniform value below `n` (n > 0), without modulo bias.
fun below(n u64, src fun mut() u64) u64 {
	if n & (n - 1) == 0 {
		return src() & (n - 1)
	}
	threshold := (0u64).wrapping_sub(n) % n
	loop {
		r := src()
		if r >= threshold {
			return r % n
		}
	}
}

// A random integer in `lo..hi` (`hi` excluded). Panics if the range is empty.
pub fun range<T: SampleInt>(lo T, hi T) T {
	return sample(lo, hi, || next_u64())
}

fun sample<T: SampleInt>(lo T, hi T, src fun mut() u64) T {
	(a, b) := (lo.to_ord(), hi.to_ord())
	if b <= a {
		panic("rand::range: empty range")
	}
	return T::from_ord(a.wrapping_add(below(b - a, src)))
}

// Shuffles `s` uniformly (Fisher-Yates).
pub fun shuffle<T>(s &mut [T]) {
	i mut := s.len()
	while i > 1 {
		j := below(i as u64, || next_u64()) as usize
		i -= 1
		s.swap(i, j)
	}
}

// A random element of `s`, or None if it is empty.
pub fun choose<'a, T>(s &'a [T]) option<&'a T> {
	if s.len() == 0 {
		return None
	}
	return s.get(below(s.len() as u64, || next_u64()) as usize)
}

// Integers that `range` can produce.
pub trait SampleInt {
	// Maps the value to u64, preserving order.
	fun to_ord(self) u64
	fun from_ord(x u64) Self
}

impl SampleInt for i8 {
	fun to_ord(self) u64 {
		return (self as i64 as u64) ^ SIGN
	}

	fun from_ord(x u64) i8 {
		return (x ^ SIGN) as i64 as i8
	}
}

impl SampleInt for i16 {
	fun to_ord(self) u64 {
		return (self as i64 as u64) ^ SIGN
	}

	fun from_ord(x u64) i16 {
		return (x ^ SIGN) as i64 as i16
	}
}

impl SampleInt for i32 {
	fun to_ord(self) u64 {
		return (self as i64 as u64) ^ SIGN
	}

	fun from_ord(x u64) i32 {
		return (x ^ SIGN) as i64 as i32
	}
}

impl SampleInt for i64 {
	fun to_ord(self) u64 {
		return (self as i64 as u64) ^ SIGN
	}

	fun from_ord(x u64) i64 {
		return (x ^ SIGN) as i64 as i64
	}
}

impl SampleInt for isize {
	fun to_ord(self) u64 {
		return (self as i64 as u64) ^ SIGN
	}

	fun from_ord(x u64) isize {
		return (x ^ SIGN) as i64 as isize
	}
}

impl SampleInt for u8 {
	fun to_ord(self) u64 {
		return self as u64
	}

	fun from_ord(x u64) u8 {
		return x as u8
	}
}

impl SampleInt for u16 {
	fun to_ord(self) u64 {
		return self as u64
	}

	fun from_ord(x u64) u16 {
		return x as u16
	}
}

impl SampleInt for u32 {
	fun to_ord(self) u64 {
		return self as u64
	}

	fun from_ord(x u64) u32 {
		return x as u32
	}
}

impl SampleInt for u64 {
	fun to_ord(self) u64 {
		return self as u64
	}

	fun from_ord(x u64) u64 {
		return x as u64
	}
}

impl SampleInt for usize {
	fun to_ord(self) u64 {
		return self as u64
	}

	fun from_ord(x u64) usize {
		return x as usize
	}
}

// A seedable random number generator (xoshiro256**). Fast, with good
// statistical quality, but not cryptographically secure.
pub struct Rng {
	s0 u64,
	s1 u64,
	s2 u64,
	s3 u64,
}

impl Rng {
	// A generator seeded from the operating system.
	pub fun new() Rng {
		return Rng::with_seed(secure_u64())
	}

	// A generator that always produces the same sequence for `seed`.
	pub fun with_seed(seed u64) Rng {
		x mut := seed
		x = x.wrapping_add(GAMMA)
		a := mix(x)
		x = x.wrapping_add(GAMMA)
		b := mix(x)
		x = x.wrapping_add(GAMMA)
		c := mix(x)
		x = x.wrapping_add(GAMMA)
		d := mix(x)
		return Rng { s0: a, s1: b, s2: c, s3: d }
	}

	// The next random u64.
	pub fun next_u64(&mut self) u64 {
		result := self.s1.wrapping_mul(5).rotate_left(7).wrapping_mul(9)
		t := self.s1 << 17
		self.s2 ^= self.s0
		self.s3 ^= self.s1
		self.s1 ^= self.s2
		self.s0 ^= self.s3
		self.s2 ^= t
		self.s3 = self.s3.rotate_left(45)
		return result
	}

	pub fun next_u32(&mut self) u32 {
		return (self.next_u64() >> 32) as u32
	}

	// A random number in [0, 1).
	pub fun next_f64(&mut self) f64 {
		return (self.next_u64() >> 11) as f64 * (1.0 / 9007199254740992.0)
	}

	pub fun next_bool(&mut self) bool {
		return self.next_u64() >> 63 == 1
	}

	// True with probability `p`.
	pub fun chance(&mut self, p f64) bool {
		return self.next_f64() < p
	}

	// A random integer in `lo..hi` (`hi` excluded).
	pub fun range<T: SampleInt>(&mut self, lo T, hi T) T {
		return sample(lo, hi, || self.next_u64())
	}

	// A normally distributed number with mean 0 and standard deviation 1.
	pub fun normal(&mut self) f64 {
		// Box-Muller; 1 - u keeps the logarithm finite.
		u := 1.0 - self.next_f64()
		v := self.next_f64()
		return (-2.0 * u.ln()).sqrt() * (std::math::TAU * v).cos()
	}

	// An exponentially distributed number with rate 1.
	pub fun exponential(&mut self) f64 {
		return -(1.0 - self.next_f64()).ln()
	}

	// Shuffles `s` uniformly.
	pub fun shuffle<T>(&mut self, s &mut [T]) {
		i mut := s.len()
		while i > 1 {
			j := below(i as u64, || self.next_u64()) as usize
			i -= 1
			s.swap(i, j)
		}
	}

	// A random element of `s`.
	pub fun choose<'a, T>(&mut self, s &'a [T]) option<&'a T> {
		if s.len() == 0 {
			return None
		}
		return s.get(below(s.len() as u64, || self.next_u64()) as usize)
	}

	// Fills `buf` with random bytes (not secure; see `secure_fill`).
	pub fun fill(&mut self, buf &mut [u8]) {
		i mut := 0
		while i < buf.len() {
			x := self.next_u64()
			k mut := 0
			while k < 8 && i < buf.len() {
				buf[i] = (x >> (k * 8)) as u8
				i += 1
				k += 1
			}
		}
	}
}
