// SHA-1 (FIPS 180-4). Broken for security: use it only for checksums and
// protocols that require it (Git object ids, WebSocket handshakes).
//
//	println(sha1::hex("abc".as_bytes()))   // "a9993e36..."
//
// `Sha1` streams like `sha256::Sha256` and implements `io::Write`.

import std::io

// Digest size in bytes.
pub const SIZE usize = 20

// Block size in bytes.
pub const BLOCK_SIZE usize = 64

// A streaming SHA-1 hasher.
pub struct Sha1 {
	h [u32; 5],
	buf [u8; 64],
	nbuf usize,
	len u64,
}

impl Sha1 {
	// A fresh hasher.
	pub fun new() Sha1 {
		return Sha1 {
			h: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0],
			buf: [0 as u8; 64],
			nbuf: 0,
			len: 0,
		}
	}

	// Feeds more data.
	pub fun update(&mut self, data &[u8]) {
		self.len += data.len() as u64
		i mut := 0
		while i < data.len() {
			if self.nbuf == 0 && data.len() - i >= 64 {
				self.block(&data[i..(i + 64)])
				i += 64
			} else {
				self.buf[self.nbuf] = data[i]
				self.nbuf += 1
				i += 1
				if self.nbuf == 64 {
					b := self.buf
					self.block(&b)
					self.nbuf = 0
				}
			}
		}
	}

	// The digest of everything fed so far. The hasher can keep going.
	pub fun finish(&self) [u8; 20] {
		d mut := Sha1 { h: self.h, buf: self.buf, nbuf: self.nbuf, len: self.len }
		bits := d.len * 8
		pad mut := [0 as u8; 72]
		pad[0] = 128
		n := if d.nbuf < 56 { 56 - d.nbuf } else { 120 - d.nbuf }
		for i in 0..8 {
			pad[n + i] = (bits >> (56 - 8 * i as u64)) as u8
		}
		d.update(&pad[0..(n + 8)])
		out mut := [0 as u8; 20]
		for i in 0..5 {
			for j in 0..4 {
				out[i * 4 + j] = (d.h[i] >> (24 - 8 * j as u32)) as u8
			}
		}
		return out
	}

	// Starts over.
	pub fun reset(&mut self) {
		*self = Sha1::new()
	}

	fun block(&mut self, p &[u8]) {
		w mut := [0 as u32; 80]
		for i in 0..16 {
			w[i] = ((p[4 * i] as u32) << 24) | ((p[4 * i + 1] as u32) << 16) | ((p[4 * i + 2] as u32) << 8) | (p[4 * i + 3] as u32)
		}
		for i in 16..80 {
			w[i] = (w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]).rotate_left(1)
		}
		a mut := self.h[0]
		b mut := self.h[1]
		c mut := self.h[2]
		d mut := self.h[3]
		e mut := self.h[4]
		for i in 0..80 {
			f mut := 0 as u32
			k mut := 0 as u32
			if i < 20 {
				f = (b & c) | (!b & d)
				k = 0x5a827999
			} else if i < 40 {
				f = b ^ c ^ d
				k = 0x6ed9eba1
			} else if i < 60 {
				f = (b & c) | (b & d) | (c & d)
				k = 0x8f1bbcdc
			} else {
				f = b ^ c ^ d
				k = 0xca62c1d6
			}
			t := a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(w[i])
			e = d
			d = c
			c = b.rotate_left(30)
			b = a
			a = t
		}
		self.h[0] = self.h[0].wrapping_add(a)
		self.h[1] = self.h[1].wrapping_add(b)
		self.h[2] = self.h[2].wrapping_add(c)
		self.h[3] = self.h[3].wrapping_add(d)
		self.h[4] = self.h[4].wrapping_add(e)
	}
}

impl io::Write for Sha1 {
	fun write(&mut self, buf &[u8]) result<usize, io::Error> {
		self.update(buf)
		return Ok(buf.len())
	}
}

// The SHA-1 digest of `data`.
pub fun sum(data &[u8]) [u8; 20] {
	h mut := Sha1::new()
	h.update(data)
	return h.finish()
}

// The SHA-1 digest of `data` as lowercase hex.
pub fun hex(data &[u8]) string {
	d := sum(data)
	return std::encoding::hex::encode(&d)
}
