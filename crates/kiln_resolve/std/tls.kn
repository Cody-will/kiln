// TLS (HTTPS's transport): encrypted streams over TCP.
//
//	cfg := tls::ClientConfig::new()?
//	conn mut := tls::TlsStream::connect("example.com:443", &cfg)?
//	conn.write_all(b"GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")?
//
//	srv := tls::ServerConfig::from_files("cert.pem", "key.pem")?
//	conn := tls::TlsStream::server(listener.accept()?, &srv)?
//
// The protocol is rustls (TLS 1.2 and 1.3 with safe defaults, ring
// cryptography), linked into programs that use this module. Clients trust
// the Mozilla root certificates (webpki-roots) and check the server's name;
// add private roots with `ClientConfig::with_roots_pem`, or trust the
// operating system's store with `ClientConfig::system()`. Mutual TLS:
// `ClientConfig::with_client_cert` presents a certificate and
// `ServerConfig::with_client_auth` asks for (and checks) one; the other
// side's leaf is `TlsStream::peer_certificate()`. Socket I/O stays
// in Kiln, so waits park only the task and the TCP stream's timeouts apply
// (`stream.tcp().set_read_timeout(...)`).

import std::fs
import std::io
import std::io::{Read, Write}
import std::net::{split_host_port, TcpStream}
import std::os

fun kn_tls_client_config(extra &[u8], insecure i32, err &mut [u8]) i64
fun kn_tls_client_config_free(c i64)
fun kn_tls_server_config(cert &[u8], key &[u8], err &mut [u8]) i64
fun kn_tls_server_config_free(s i64)
fun kn_tls_client(cfg i64, host &[u8], err &mut [u8]) i64
fun kn_tls_server(cfg i64) i64
fun kn_tls_free(c i64)
fun kn_tls_read_tls(c i64, buf &[u8]) i64
fun kn_tls_write_tls(c i64, buf &mut [u8]) i64
fun kn_tls_wants_write(c i64) i32
fun kn_tls_handshaking(c i64) i32
fun kn_tls_read(c i64, buf &mut [u8]) i64
fun kn_tls_write(c i64, buf &[u8]) i64
fun kn_tls_close(c i64)
fun kn_tls_error(c i64, out &mut [u8]) usize
fun kn_tls_version(c i64) i32
fun kn_tls_client_config_alpn(c i64, list &[u8])
fun kn_tls_server_config_alpn(s i64, list &[u8])
fun kn_tls_alpn(c i64, out &mut [u8]) usize
fun kn_tls_client_config2(roots &[u8], flags i32, cert &[u8], key &[u8], err &mut [u8]) i64
fun kn_tls_server_config2(cert &[u8], key &[u8], client_ca &[u8], require i32, err &mut [u8]) i64
fun kn_tls_peer_cert(c i64, out &mut [u8]) usize

// Where the operating system keeps its trusted roots, most common first
// (Debian/Ubuntu/Arch/Alpine, Fedora/RHEL, openSUSE, macOS and the BSDs).
const SYSTEM_BUNDLES [&str; 8] = ["/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt", "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem", "/etc/ssl/ca-bundle.pem", "/etc/ssl/cert.pem", "/usr/local/etc/ssl/cert.pem", "/usr/local/share/certs/ca-root-nss.crt", "/etc/certs/ca-certificates.crt"]

// The operating system's trusted root certificates as one PEM bundle.
// `SSL_CERT_FILE` (a bundle) and `SSL_CERT_DIR` (a directory of `.pem` /
// `.crt` files) override the defaults, as with OpenSSL. Unix only: on
// other systems set `SSL_CERT_FILE` or use the Mozilla roots.
pub fun system_roots_pem() result<Vec<u8>, io::Error> {
	if let Some(f) = os::getenv("SSL_CERT_FILE") {
		if f.len() > 0 {
			return fs::read(&f)
		}
	}
	if let Some(d) = os::getenv("SSL_CERT_DIR") {
		if d.len() > 0 {
			return pem_dir(&d)
		}
	}
	for f in SYSTEM_BUNDLES.iter() {
		if fs::is_file(*f) {
			return fs::read(*f)
		}
	}
	return pem_dir("/etc/ssl/certs")
}

fun pem_dir(dir &str) result<Vec<u8>, io::Error> {
	out mut := Vec::new()
	for e in fs::read_dir(dir)?.iter() {
		if (e.name.ends_with(".pem") || e.name.ends_with(".crt")) && !e.is_dir() {
			if let Ok(b) = fs::read(&e.path) {
				out.extend_from_slice(&b)
				out.push(10 as u8)
			}
		}
	}
	if out.len() == 0 {
		return Err(io::Error::new(io::ErrorKind::NotFound, "tls: no system trust store found (set SSL_CERT_FILE)"))
	}
	return Ok(out)
}

// What a client trusts and presents, for `ClientConfig::from_options`.
pub struct ClientOptions {
	// Trust the Mozilla roots bundled into the program (default true).
	pub mozilla_roots bool,
	// Trust the operating system's roots (`system_roots_pem`).
	pub system_roots bool,
	// Extra trusted roots (PEM).
	pub roots_pem Vec<u8>,
	// A client certificate chain and key (PEM) for mutual TLS.
	pub cert_pem Vec<u8>,
	pub key_pem Vec<u8>,
	// Accept any server certificate. Only for tests.
	pub insecure_skip_verify bool,
}

impl ClientOptions {
	// The defaults: Mozilla roots, no client certificate.
	pub fun new() ClientOptions {
		return ClientOptions { mozilla_roots: true, system_roots: false, roots_pem: Vec::new(), cert_pem: Vec::new(), key_pem: Vec::new(), insecure_skip_verify: false }
	}
}

// `protos` as the shim's ALPN list: names joined by commas.
fun alpn_text(protos &[&str]) string {
	o mut := string::new()
	for (i, p) in protos.iter().enumerate() {
		if i > 0 {
			o.push(",")
		}
		o.push(p)
	}
	return o
}

fun tls_error(msg &str) io::Error {
	return io::Error::new(io::ErrorKind::InvalidData, "tls: {msg}")
}

// A buffer for an error message from the TLS library.
fun errbuf() Vec<u8> {
	b mut := Vec::new()
	b.resize(512, 0 as u8)
	return b
}

fun message(buf &[u8]) string {
	end mut := 0
	while end < buf.len() && buf[end] != 0 {
		end += 1
	}
	return string::from_utf8_lossy(&buf[0..end])
}

// What a client trusts.
pub struct ClientConfig {
	h i64,
}

impl ClientConfig {
	// Trusts the Mozilla root certificates.
	pub fun new() result<ClientConfig, io::Error> {
		return ClientConfig::make(b"", 0)
	}

	// Trusts the Mozilla roots plus the PEM certificates in `pem` (for
	// private certificate authorities and self-signed servers).
	pub fun with_roots_pem(pem &[u8]) result<ClientConfig, io::Error> {
		return ClientConfig::make(pem, 0)
	}

	// Accepts any certificate without checking it. Only for tests: it makes
	// the connection open to interception.
	pub fun insecure_skip_verify() result<ClientConfig, io::Error> {
		return ClientConfig::make(b"", 1)
	}

	// Trusts only the operating system's root certificates.
	pub fun system() result<ClientConfig, io::Error> {
		o mut := ClientOptions::new()
		o.mozilla_roots = false
		o.system_roots = true
		return ClientConfig::from_options(&o)
	}

	// Trusts the Mozilla roots and presents `cert` (a PEM chain, leaf
	// first) with its PEM `key` to servers that ask (mutual TLS).
	pub fun with_client_cert(cert &[u8], key &[u8]) result<ClientConfig, io::Error> {
		o mut := ClientOptions::new()
		o.cert_pem = cert.to_vec()
		o.key_pem = key.to_vec()
		return ClientConfig::from_options(&o)
	}

	// A config from explicit options. With `system_roots`, unusable
	// certificates in the system bundle are skipped.
	pub fun from_options(o &ClientOptions) result<ClientConfig, io::Error> {
		flags mut := 0
		roots mut := Vec::new()
		if o.mozilla_roots {
			flags = flags | 1
		}
		if o.insecure_skip_verify {
			flags = flags | 2
		}
		if o.system_roots {
			roots = system_roots_pem()?
			roots.push(10 as u8)
			flags = flags | 4
		}
		roots.extend_from_slice(&o.roots_pem)
		if o.cert_pem.len() > 0 && o.key_pem.len() == 0 {
			return Err(tls_error("a client certificate needs its private key"))
		}
		e mut := errbuf()
		h := kn_tls_client_config2(&roots, flags, &o.cert_pem, &o.key_pem, e.as_mut_slice())
		if h == 0 {
			return Err(tls_error(&message(&e)))
		}
		return Ok(ClientConfig { h: h })
	}

	fun make(pem &[u8], insecure i32) result<ClientConfig, io::Error> {
		e mut := errbuf()
		h := kn_tls_client_config(pem, insecure, e.as_mut_slice())
		if h == 0 {
			return Err(tls_error(&message(&e)))
		}
		return Ok(ClientConfig { h: h })
	}
}

impl Drop for ClientConfig {
	fun drop(&mut self) {
		kn_tls_client_config_free(self.h)
	}
}

impl ClientConfig {
	// Offers these application protocols with ALPN, most preferred first
	// (the default is `["http/1.1"]`; HTTP/2 clients use `["h2"]`).
	pub fun with_alpn(self, protos &[&str]) ClientConfig {
		self.set_alpn(protos)
		return self
	}

	// Sets the protocols offered with ALPN on this config (connections made
	// with it afterwards use them).
	pub fun set_alpn(&self, protos &[&str]) {
		kn_tls_client_config_alpn(self.h, alpn_text(protos).as_bytes())
	}
}

// A server's certificate chain and private key.
pub struct ServerConfig {
	h i64,
}

impl ServerConfig {
	// From a PEM certificate chain (leaf first) and a PEM private key
	// (PKCS#8, PKCS#1, or SEC1).
	pub fun from_pem(cert &[u8], key &[u8]) result<ServerConfig, io::Error> {
		e mut := errbuf()
		h := kn_tls_server_config(cert, key, e.as_mut_slice())
		if h == 0 {
			return Err(tls_error(&message(&e)))
		}
		return Ok(ServerConfig { h: h })
	}

	// Like `from_pem`, also asking each client for a certificate signed by
	// one of the PEM roots in `client_ca` (mutual TLS). With `required`,
	// clients without one are refused; otherwise a certificate is optional
	// but checked when sent. See `TlsStream::peer_certificate`.
	pub fun with_client_auth(cert &[u8], key &[u8], client_ca &[u8], required bool) result<ServerConfig, io::Error> {
		if client_ca.len() == 0 {
			return Err(tls_error("client authentication needs a client CA"))
		}
		e mut := errbuf()
		req := if required { 1 } else { 0 }
		h := kn_tls_server_config2(cert, key, client_ca, req, e.as_mut_slice())
		if h == 0 {
			return Err(tls_error(&message(&e)))
		}
		return Ok(ServerConfig { h: h })
	}

	// Reads the certificate chain and key from PEM files.
	pub fun from_files(cert_path &str, key_path &str) result<ServerConfig, io::Error> {
		cert := fs::read(cert_path)?
		key := fs::read(key_path)?
		return ServerConfig::from_pem(&cert, &key)
	}
}

impl Drop for ServerConfig {
	fun drop(&mut self) {
		kn_tls_server_config_free(self.h)
	}
}

impl ServerConfig {
	// Accepts these application protocols with ALPN, most preferred first
	// (the default is `["http/1.1"]`; see `http2::serve_tls`).
	pub fun with_alpn(self, protos &[&str]) ServerConfig {
		self.set_alpn(protos)
		return self
	}

	// Sets the protocols accepted with ALPN on this config.
	pub fun set_alpn(&self, protos &[&str]) {
		kn_tls_server_config_alpn(self.h, alpn_text(protos).as_bytes())
	}
}

// An encrypted stream over a TCP connection. Reads and writes need
// `&mut self`, since both drive one protocol state machine.
pub struct TlsStream {
	tcp TcpStream,
	c i64,
	scratch Vec<u8>,
	// Ciphertext read from the socket but not yet taken by the protocol
	// (it takes no more while decrypted data waits to be read).
	inbuf Vec<u8>,
	in_at usize,
}

impl TlsStream {
	// Connects to `addr` ("host:port") and completes the handshake,
	// checking the certificate against `host`.
	pub fun connect(addr &str, cfg &ClientConfig) result<TlsStream, io::Error> {
		(host, _) := split_host_port(addr)?
		h := match host.strip_prefix("[") {
			Some(x) => x.strip_suffix("]").unwrap_or(x),
			None => host,
		}
		tcp := TcpStream::connect(addr)?
		return TlsStream::client(tcp, h, cfg)
	}

	// Runs the client side of the handshake over `tcp`; `host` is the name
	// the certificate must match (and is sent as SNI).
	pub fun client(tcp TcpStream, host &str, cfg &ClientConfig) result<TlsStream, io::Error> {
		e mut := errbuf()
		c := kn_tls_client(cfg.h, host.as_bytes(), e.as_mut_slice())
		if c == 0 {
			return Err(tls_error(&message(&e)))
		}
		s mut := TlsStream::wrap(tcp, c)
		s.handshake()?
		return Ok(s)
	}

	// Runs the server side of the handshake over an accepted `tcp`.
	pub fun server(tcp TcpStream, cfg &ServerConfig) result<TlsStream, io::Error> {
		c := kn_tls_server(cfg.h)
		if c == 0 {
			return Err(tls_error("could not start a server connection"))
		}
		s mut := TlsStream::wrap(tcp, c)
		s.handshake()?
		return Ok(s)
	}

	fun wrap(tcp TcpStream, c i64) TlsStream {
		scratch mut := Vec::new()
		scratch.resize(18432, 0 as u8)
		return TlsStream { tcp: tcp, c: c, scratch: scratch, inbuf: Vec::new(), in_at: 0 }
	}

	// The underlying TCP stream (for timeouts and addresses).
	pub fun tcp(&self) &TcpStream {
		return &self.tcp
	}

	// The negotiated version: 12 for TLS 1.2, 13 for TLS 1.3.
	pub fun version(&self) i32 {
		return kn_tls_version(self.c)
	}

	// The application protocol agreed with ALPN ("h2", "http/1.1"), or ""
	// if none was.
	pub fun alpn(&self) string {
		b mut := Vec::new()
		b.resize(64, 0 as u8)
		n := kn_tls_alpn(self.c, b.as_mut_slice())
		if n < b.len() {
			b.truncate(n)
		}
		return string::from_utf8_lossy(&b)
	}

	// The peer's leaf certificate (DER), if it sent one: always for a
	// client's view of the server, and for a server when the client
	// presented one (mutual TLS).
	pub fun peer_certificate(&self) option<Vec<u8>> {
		b mut := Vec::new()
		b.resize(4096, 0 as u8)
		n := kn_tls_peer_cert(self.c, b.as_mut_slice())
		if n == 0 {
			return None
		}
		if n > b.len() {
			b.resize(n, 0 as u8)
			kn_tls_peer_cert(self.c, b.as_mut_slice())
		}
		b.truncate(n)
		return Some(b)
	}

	fun last_error(&self) io::Error {
		e mut := errbuf()
		n := kn_tls_error(self.c, e.as_mut_slice())
		if n < e.len() {
			e.truncate(n)
		}
		return tls_error(&string::from_utf8_lossy(&e))
	}

	// Sends any ciphertext the protocol has queued.
	fun flush_tls(&mut self) result<void, io::Error> {
		while kn_tls_wants_write(self.c) != 0 {
			n := kn_tls_write_tls(self.c, self.scratch.as_mut_slice())
			if n < 0 {
				return Err(self.last_error())
			}
			self.tcp.write_all(&self.scratch[0..n as usize])?
		}
		return Ok()
	}

	// Reads ciphertext from the socket into the protocol. False at EOF.
	fun fill_tls(&mut self) result<bool, io::Error> {
		if self.in_at >= self.inbuf.len() {
			self.inbuf.resize(18432, 0 as u8)
			m := self.tcp.read(self.inbuf.as_mut_slice())?
			if m == 0 {
				self.inbuf.clear()
				self.in_at = 0
				return Ok(false)
			}
			self.inbuf.truncate(m)
			self.in_at = 0
		}
		while self.in_at < self.inbuf.len() {
			if kn_tls_wants_write(self.c) != 0 {
				// The protocol takes no input while its output waits.
				self.flush_tls()?
			}
			k := kn_tls_read_tls(self.c, &self.inbuf[self.in_at..])
			if k == -1 {
				// Full: the rest waits until the plaintext is read.
				break
			}
			if k < 0 {
				err := self.last_error()
				// Send the alert that explains the failure, if possible.
				self.flush_tls().unwrap_or(())
				return Err(err)
			}
			self.in_at += k as usize
		}
		return Ok(true)
	}

	fun handshake(&mut self) result<void, io::Error> {
		while kn_tls_handshaking(self.c) != 0 {
			if kn_tls_wants_write(self.c) != 0 {
				self.flush_tls()?
				continue
			}
			if !self.fill_tls()? {
				return Err(io::Error::new(io::ErrorKind::UnexpectedEof, "tls: connection closed during the handshake"))
			}
		}
		return self.flush_tls()
	}

	// Sends close_notify, telling the peer no more data follows.
	pub fun close(&mut self) result<void, io::Error> {
		kn_tls_close(self.c)
		return self.flush_tls()
	}
}

impl Read for TlsStream {
	// Reads decrypted data; 0 once the peer has closed with close_notify.
	// A peer that drops the connection without close_notify gives an
	// `UnexpectedEof` error (the data may have been cut short).
	fun read(&mut self, buf &mut [u8]) result<usize, io::Error> {
		if buf.len() == 0 {
			return Ok(0)
		}
		loop {
			n := kn_tls_read(self.c, buf)
			if n >= 0 {
				return Ok(n as usize)
			}
			if n == -2 {
				return Err(self.last_error())
			}
			self.flush_tls()?
			if !self.fill_tls()? {
				return Err(io::Error::new(io::ErrorKind::UnexpectedEof, "tls: connection closed without close_notify"))
			}
		}
	}
}

impl Write for TlsStream {
	fun write(&mut self, buf &[u8]) result<usize, io::Error> {
		n := kn_tls_write(self.c, buf)
		if n < 0 {
			return Err(self.last_error())
		}
		self.flush_tls()?
		return Ok(n as usize)
	}
}

impl Drop for TlsStream {
	fun drop(&mut self) {
		kn_tls_free(self.c)
	}
}
