// Collections: HashMap, HashSet, BTreeMap, BTreeSet, VecDeque.
//
//	counts mut := HashMap::new()
//	for w in text.split_whitespace() {
//		*counts.entry(w.to_string()).or_insert(0) += 1
//	}
//	if let Some(n) = counts.get("the") { ... }
//
// HashMap and HashSet need keys that implement Hash and Eq; lookups take any
// borrowed form of the key (a `&str` for `String` keys). Hash tables are
// seeded randomly per process. Iteration order of a HashMap is unspecified
// (today it is insertion order until something is removed); use BTreeMap
// when you need keys in sorted order.

// ===== HashMap ====================================================================

struct Bucket<K, V> {
	hash u64,
	key K,
	value V,
}

// Index slot markers: 0 is empty; TOMB is a removed entry; anything else is
// an index into `entries` plus one in the low IDX_BITS bits, with the top
// bits of the entry's hash above them. Probes compare those bits first, so
// they rarely touch an entry that does not match.
const TOMB usize = usize::MAX
const IDX_BITS usize = 40
const IDX_MASK usize = (1 << 40) - 1

fun slot_of(idx usize, h u64) usize {
	return (((h >> 40) << 40) as usize) | (idx + 1)
}

fun slot_idx(s usize) usize {
	return (s & IDX_MASK) - 1
}

// A hash table mapping keys to values.
pub struct HashMap<K, V> {
	entries Vec<Bucket<K, V>>,
	slots Vec<usize>,
	used usize,
}

impl<K, V> HashMap<K, V> {
	// An empty map. It allocates nothing until the first insert.
	pub fun new() HashMap<K, V> {
		return HashMap { entries: Vec::new(), slots: Vec::new(), used: 0 }
	}

	// The number of entries.
	pub fun len(&self) usize {
		return self.entries.len()
	}

	pub fun is_empty(&self) bool {
		return self.entries.len() == 0
	}

	// Removes every entry, keeping the allocated space.
	pub fun clear(&mut self) {
		self.entries.clear()
		i mut := 0
		while i < self.slots.len() {
			self.slots[i] = 0
			i += 1
		}
		self.used = 0
	}

	// The entries as `(&key, &value)` pairs.
	pub fun iter<'a>(&'a self) Iter<'a, K, V> {
		return Iter { inner: self.entries.iter() }
	}

	// The entries as `(&key, &mut value)` pairs.
	pub fun iter_mut<'a>(&'a mut self) IterMut<'a, K, V> {
		return IterMut { inner: self.entries.iter_mut() }
	}

	// The keys.
	pub fun keys<'a>(&'a self) Keys<'a, K, V> {
		return Keys { inner: self.entries.iter() }
	}

	// The values.
	pub fun values<'a>(&'a self) Values<'a, K, V> {
		return Values { inner: self.entries.iter() }
	}

	// The values, mutably.
	pub fun values_mut<'a>(&'a mut self) ValuesMut<'a, K, V> {
		return ValuesMut { inner: self.entries.iter_mut() }
	}

	// The entries as `(key, value)` pairs, consuming the map.
	pub fun into_iter(self) IntoIter<K, V> {
		return IntoIter { inner: self.entries.into_iter() }
	}

	// The keys, consuming the map.
	pub fun into_keys(self) IntoKeys<K, V> {
		return IntoKeys { inner: self.entries.into_iter() }
	}

	// The values, consuming the map.
	pub fun into_values(self) IntoValues<K, V> {
		return IntoValues { inner: self.entries.into_iter() }
	}

	// Removes and returns every entry, leaving the map empty.
	pub fun drain(&mut self) IntoIter<K, V> {
		i mut := 0
		while i < self.slots.len() {
			self.slots[i] = 0
			i += 1
		}
		self.used = 0
		entries mut := Vec::new()
		std::mem::swap(&mut self.entries, &mut entries)
		return IntoIter { inner: entries.into_iter() }
	}
}

impl<K: Hash + Eq, V> HashMap<K, V> {
	// An empty map with room for `n` entries before it grows.
	pub fun with_capacity(n usize) HashMap<K, V> {
		m mut := HashMap::new()
		m.reserve(n)
		return m
	}

	// A map of the pairs from `items`; later duplicates win.
	pub fun from_iter<I: Iterator<(K, V)>>(items I) HashMap<K, V> {
		m mut := HashMap::new()
		m.extend(items)
		return m
	}

	// How many entries fit before the table grows.
	pub fun capacity(&self) usize {
		return self.slots.len() / 8 * 7
	}

	// Makes room for `n` more entries.
	pub fun reserve(&mut self, n usize) {
		if (self.used + n) * 8 <= self.slots.len() * 7 {
			return
		}
		need := self.entries.len() + n
		size mut := 8
		while size * 7 < need * 8 {
			size *= 2
		}
		self.rehash(size)
	}

	// Rebuilds the index with `size` slots (a power of two), dropping tombstones.
	fun rehash(&mut self, size usize) {
		slots mut := Vec::with_capacity(size)
		i mut := 0
		while i < size {
			slots.push(0)
			i += 1
		}
		mask := size - 1
		j mut := 0
		while j < self.entries.len() {
			k mut := (self.entries[j].hash as usize) & mask
			while slots[k] != 0 {
				k = (k + 1) & mask
			}
			slots[k] = slot_of(j, self.entries[j].hash)
			j += 1
		}
		self.slots = slots
		self.used = self.entries.len()
	}

	// The slot holding `key`, if present.
	fun find<Q: Eq>(&self, h u64, key &Q) option<usize> where K: Borrow<Q> {
		if self.slots.len() == 0 {
			return None
		}
		mask := self.slots.len() - 1
		i mut := (h as usize) & mask
		loop {
			s := self.slots[i]
			if s == 0 {
				return None
			}
			if s != TOMB && (s >> IDX_BITS) == ((h >> 40) as usize) {
				e := &self.entries[(s & IDX_MASK) - 1]
				if e.hash == h && Borrow::borrow(&e.key) == key {
					return Some(i)
				}
			}
			i = (i + 1) & mask
		}
	}

	// Adds an entry known to be absent; returns its index.
	fun push_new(&mut self, h u64, key K, value V) usize {
		self.reserve(1)
		mask := self.slots.len() - 1
		i mut := (h as usize) & mask
		while self.slots[i] != 0 && self.slots[i] != TOMB {
			i = (i + 1) & mask
		}
		if self.slots[i] == 0 {
			self.used += 1
		}
		self.entries.push(Bucket { hash: h, key: key, value: value })
		self.slots[i] = slot_of(self.entries.len() - 1, h)
		return self.entries.len() - 1
	}

	// Sets `key` to `value`, returning the old value if there was one.
	pub fun insert(&mut self, key K, value V) option<V> {
		h := std::hash::hash(&key)
		if let Some(i) = self.find(h, &key) {
			idx := slot_idx(self.slots[i])
			return Some(std::mem::replace(&mut self.entries[idx].value, value))
		}
		self.push_new(h, key, value)
		return None
	}

	// The value for `key`.
	pub fun get<Q: Hash + Eq>(&self, key &Q) option<&V> where K: Borrow<Q> {
		match self.find(std::hash::hash(key), key) {
			Some(i) => return Some(&self.entries[slot_idx(self.slots[i])].value),
			None => return None,
		}
	}

	// The value for `key`, mutably.
	pub fun get_mut<Q: Hash + Eq>(&mut self, key &Q) option<&mut V> where K: Borrow<Q> {
		match self.find(std::hash::hash(key), key) {
			Some(i) => {
				idx := slot_idx(self.slots[i])
				return Some(&mut self.entries[idx].value)
			}
			None => return None,
		}
	}

	// The stored key and value for `key`.
	pub fun get_key_value<Q: Hash + Eq>(&self, key &Q) option<(&K, &V)> where K: Borrow<Q> {
		match self.find(std::hash::hash(key), key) {
			Some(i) => {
				e := &self.entries[slot_idx(self.slots[i])]
				return Some((&e.key, &e.value))
			}
			None => return None,
		}
	}

	// Whether the map has an entry for `key`.
	pub fun contains_key<Q: Hash + Eq>(&self, key &Q) bool where K: Borrow<Q> {
		return self.find(std::hash::hash(key), key).is_some()
	}

	// Removes `key`, returning its value.
	pub fun remove<Q: Hash + Eq>(&mut self, key &Q) option<V> where K: Borrow<Q> {
		match self.remove_entry(key) {
			Some((_, v)) => return Some(v),
			None => return None,
		}
	}

	// Removes `key`, returning the stored key and value.
	pub fun remove_entry<Q: Hash + Eq>(&mut self, key &Q) option<(K, V)> where K: Borrow<Q> {
		match self.find(std::hash::hash(key), key) {
			Some(i) => return Some(self.take_slot(i)),
			None => return None,
		}
	}

	// Removes the entry in slot `i`. The last entry moves into its place in
	// `entries`, so its slot is updated.
	fun take_slot(&mut self, i usize) (K, V) {
		idx := slot_idx(self.slots[i])
		self.slots[i] = TOMB
		last := self.entries.len() - 1
		if idx != last {
			mask := self.slots.len() - 1
			j mut := (self.entries[last].hash as usize) & mask
			while self.slots[j] == TOMB || (self.slots[j] & IDX_MASK) != last + 1 {
				j = (j + 1) & mask
			}
			self.slots[j] = slot_of(idx, self.entries[last].hash)
		}
		b := self.entries.swap_remove(idx)
		return (b.key, b.value)
	}

	// The entry for `key`, for inserting or updating in place:
	// `*m.entry(k).or_insert(0) += 1`.
	pub fun entry<'a>(&'a mut self, key K) Entry<'a, K, V> {
		h := std::hash::hash(&key)
		idx := match self.find(h, &key) {
			Some(i) => Some(slot_idx(self.slots[i])),
			None => None,
		}
		return Entry { map: self, key: key, hash: h, idx: idx }
	}

	// Keeps only the entries for which `keep` returns true.
	pub fun retain(&mut self, keep fun mut(&K, &mut V) bool) {
		old mut := Vec::new()
		std::mem::swap(&mut self.entries, &mut old)
		for b in old.into_iter() {
			e mut := b
			if keep(&e.key, &mut e.value) {
				self.entries.push(e)
			}
		}
		size := self.slots.len()
		if size > 0 {
			self.rehash(size)
		}
	}

	// Inserts every pair from `items`.
	pub fun extend<I: Iterator<(K, V)>>(&mut self, items I) {
		it mut := items
		while let Some((k, v)) = it.next() {
			self.insert(k, v)
		}
	}
}

impl<K: Hash + Eq, V: Eq> Eq for HashMap<K, V> {
	// Maps are equal when they have the same keys with equal values, in any order.
	fun eq(&self, other &HashMap<K, V>) bool {
		if self.len() != other.len() {
			return false
		}
		for e in self.entries.iter() {
			match other.get(&e.key) {
				Some(v) => {
					if !(v == &e.value) {
						return false
					}
				}
				None => return false,
			}
		}
		return true
	}
}

impl<K: Clone, V: Clone> Clone for HashMap<K, V> {
	fun clone(&self) HashMap<K, V> {
		entries mut := Vec::with_capacity(self.entries.len())
		for e in self.entries.iter() {
			entries.push(Bucket { hash: e.hash, key: e.key.clone(), value: e.value.clone() })
		}
		return HashMap { entries: entries, slots: self.slots.clone(), used: self.used }
	}
}

impl<K: Debug, V: Debug> Debug for HashMap<K, V> {
	fun fmt_debug(&self, f &mut std::fmt::Formatter) {
		f.begin("{{")
		first mut := true
		for e in self.entries.iter() {
			f.item(first)
			f.debug(&e.key)
			f.write(": ")
			f.debug(&e.value)
			first = false
		}
		f.end("}}", first, false)
	}
}

// A place in a map for one key, which may or may not hold a value.
pub struct Entry<'a, K, V> {
	map &'a mut HashMap<K, V>,
	key K,
	hash u64,
	idx option<usize>,
}

impl<'a, K: Hash + Eq, V> Entry<'a, K, V> {
	// The key this entry is for.
	pub fun key(&self) &K {
		return &self.key
	}

	// Whether the map already has a value for the key.
	pub fun is_occupied(&self) bool {
		return self.idx.is_some()
	}

	// The value, inserting `default` first if there is none.
	pub fun or_insert(self, default V) &'a mut V {
		e mut := self
		idx := match e.idx {
			Some(i) => i,
			None => e.map.push_new(e.hash, e.key, default),
		}
		return &mut e.map.entries[idx].value
	}

	// The value, inserting `make()` first if there is none.
	pub fun or_insert_with(self, make fun mut() V) &'a mut V {
		e mut := self
		idx := match e.idx {
			Some(i) => i,
			None => e.map.push_new(e.hash, e.key, make()),
		}
		return &mut e.map.entries[idx].value
	}

	// Calls `f` on the value if there is one, then returns the entry.
	pub fun and_modify(self, f fun mut(&mut V)) Entry<'a, K, V> {
		e mut := self
		if let Some(i) = e.idx {
			f(&mut e.map.entries[i].value)
		}
		return e
	}
}

pub struct Iter<'a, K, V> {
	inner std::iter::Iter<'a, Bucket<K, V>>,
}

impl<'a, K, V> Iterator<(&'a K, &'a V)> for Iter<'a, K, V> {
	fun next(&mut self) option<(&'a K, &'a V)> {
		match self.inner.next() {
			Some(b) => return Some((&b.key, &b.value)),
			None => return None,
		}
	}
}

pub struct IterMut<'a, K, V> {
	inner std::iter::IterMut<'a, Bucket<K, V>>,
}

impl<'a, K, V> Iterator<(&'a K, &'a mut V)> for IterMut<'a, K, V> {
	fun next(&mut self) option<(&'a K, &'a mut V)> {
		match self.inner.next() {
			Some(b) => return Some((&b.key, &mut b.value)),
			None => return None,
		}
	}
}

pub struct Keys<'a, K, V> {
	inner std::iter::Iter<'a, Bucket<K, V>>,
}

impl<'a, K, V> Iterator<&'a K> for Keys<'a, K, V> {
	fun next(&mut self) option<&'a K> {
		match self.inner.next() {
			Some(b) => return Some(&b.key),
			None => return None,
		}
	}
}

pub struct Values<'a, K, V> {
	inner std::iter::Iter<'a, Bucket<K, V>>,
}

impl<'a, K, V> Iterator<&'a V> for Values<'a, K, V> {
	fun next(&mut self) option<&'a V> {
		match self.inner.next() {
			Some(b) => return Some(&b.value),
			None => return None,
		}
	}
}

pub struct ValuesMut<'a, K, V> {
	inner std::iter::IterMut<'a, Bucket<K, V>>,
}

impl<'a, K, V> Iterator<&'a mut V> for ValuesMut<'a, K, V> {
	fun next(&mut self) option<&'a mut V> {
		match self.inner.next() {
			Some(b) => return Some(&mut b.value),
			None => return None,
		}
	}
}

pub struct IntoIter<K, V> {
	inner std::iter::IntoIter<Bucket<K, V>>,
}

impl<K, V> Iterator<(K, V)> for IntoIter<K, V> {
	fun next(&mut self) option<(K, V)> {
		match self.inner.next() {
			Some(b) => return Some((b.key, b.value)),
			None => return None,
		}
	}
}

pub struct IntoKeys<K, V> {
	inner std::iter::IntoIter<Bucket<K, V>>,
}

impl<K, V> Iterator<K> for IntoKeys<K, V> {
	fun next(&mut self) option<K> {
		match self.inner.next() {
			Some(b) => return Some(b.key),
			None => return None,
		}
	}
}

pub struct IntoValues<K, V> {
	inner std::iter::IntoIter<Bucket<K, V>>,
}

impl<K, V> Iterator<V> for IntoValues<K, V> {
	fun next(&mut self) option<V> {
		match self.inner.next() {
			Some(b) => return Some(b.value),
			None => return None,
		}
	}
}

// ===== HashSet ====================================================================

// A set of distinct values, stored in a hash table.
pub struct HashSet<T> {
	map HashMap<T, void>,
}

impl<T> HashSet<T> {
	// An empty set.
	pub fun new() HashSet<T> {
		return HashSet { map: HashMap::new() }
	}

	pub fun len(&self) usize {
		return self.map.len()
	}

	pub fun is_empty(&self) bool {
		return self.map.len() == 0
	}

	pub fun clear(&mut self) {
		self.map.clear()
	}

	// The values.
	pub fun iter<'a>(&'a self) Keys<'a, T, void> {
		return self.map.keys()
	}

	// The values, consuming the set.
	pub fun into_iter(self) IntoKeys<T, void> {
		return self.map.into_keys()
	}

	// Removes and returns every value.
	pub fun drain(&mut self) IntoKeys<T, void> {
		return IntoKeys { inner: self.map.drain().inner }
	}
}

impl<T: Hash + Eq> HashSet<T> {
	// An empty set with room for `n` values.
	pub fun with_capacity(n usize) HashSet<T> {
		return HashSet { map: HashMap::with_capacity(n) }
	}

	// A set of the values from `items`.
	pub fun from_iter<I: Iterator<T>>(items I) HashSet<T> {
		s mut := HashSet::new()
		s.extend(items)
		return s
	}

	pub fun reserve(&mut self, n usize) {
		self.map.reserve(n)
	}

	// Adds `value`; returns false if it was already present.
	pub fun insert(&mut self, value T) bool {
		return self.map.insert(value, ()).is_none()
	}

	// Whether `value` is in the set.
	pub fun contains<Q: Hash + Eq>(&self, value &Q) bool where T: Borrow<Q> {
		return self.map.contains_key(value)
	}

	// The stored value equal to `value`.
	pub fun get<Q: Hash + Eq>(&self, value &Q) option<&T> where T: Borrow<Q> {
		match self.map.get_key_value(value) {
			Some((k, _)) => return Some(k),
			None => return None,
		}
	}

	// Removes `value`; returns whether it was present.
	pub fun remove<Q: Hash + Eq>(&mut self, value &Q) bool where T: Borrow<Q> {
		return self.map.remove(value).is_some()
	}

	// Removes and returns the stored value equal to `value`.
	pub fun take<Q: Hash + Eq>(&mut self, value &Q) option<T> where T: Borrow<Q> {
		match self.map.remove_entry(value) {
			Some((k, _)) => return Some(k),
			None => return None,
		}
	}

	// Keeps only the values for which `keep` returns true.
	pub fun retain(&mut self, keep fun mut(&T) bool) {
		self.map.retain(|k, _v| keep(k))
	}

	// Adds every value from `items`.
	pub fun extend<I: Iterator<T>>(&mut self, items I) {
		it mut := items
		while let Some(x) = it.next() {
			self.map.insert(x, ())
		}
	}

	// Whether every value of this set is in `other`.
	pub fun is_subset(&self, other &HashSet<T>) bool {
		if self.len() > other.len() {
			return false
		}
		for x in self.iter() {
			if !other.contains(x) {
				return false
			}
		}
		return true
	}

	// Whether every value of `other` is in this set.
	pub fun is_superset(&self, other &HashSet<T>) bool {
		return other.is_subset(self)
	}

	// Whether the sets have no values in common.
	pub fun is_disjoint(&self, other &HashSet<T>) bool {
		for x in self.iter() {
			if other.contains(x) {
				return false
			}
		}
		return true
	}

	// The values in both sets, as references into this one.
	pub fun intersection<'a>(&'a self, other &HashSet<T>) Vec<&'a T> {
		out mut := Vec::new()
		for x in self.iter() {
			if other.contains(x) {
				out.push(x)
			}
		}
		return out
	}

	// The values in this set but not in `other`.
	pub fun difference<'a>(&'a self, other &HashSet<T>) Vec<&'a T> {
		out mut := Vec::new()
		for x in self.iter() {
			if !other.contains(x) {
				out.push(x)
			}
		}
		return out
	}

	// The values in either set (each once).
	pub fun union<'a>(&'a self, other &'a HashSet<T>) Vec<&'a T> {
		out mut := Vec::new()
		for x in self.iter() {
			out.push(x)
		}
		for x in other.iter() {
			if !self.contains(x) {
				out.push(x)
			}
		}
		return out
	}

	// The values in exactly one of the sets.
	pub fun symmetric_difference<'a>(&'a self, other &'a HashSet<T>) Vec<&'a T> {
		out mut := self.difference(other)
		for x in other.iter() {
			if !self.contains(x) {
				out.push(x)
			}
		}
		return out
	}
}

impl<T: Hash + Eq> Eq for HashSet<T> {
	fun eq(&self, other &HashSet<T>) bool {
		return self.len() == other.len() && self.is_subset(other)
	}
}

impl<T: Clone> Clone for HashSet<T> {
	fun clone(&self) HashSet<T> {
		return HashSet { map: self.map.clone() }
	}
}

impl<T: Debug> Debug for HashSet<T> {
	fun fmt_debug(&self, f &mut std::fmt::Formatter) {
		f.begin("{{")
		first mut := true
		for e in self.map.entries.iter() {
			f.item(first)
			f.debug(&e.key)
			first = false
		}
		f.end("}}", first, false)
	}
}

// ===== VecDeque ===================================================================

// A double-ended queue: a growable ring buffer with fast pushes and pops at
// both ends.
pub struct VecDeque<T> {
	buf Vec<option<T>>,
	head usize,
	len usize,
}

impl<T> VecDeque<T> {
	// An empty queue. It allocates nothing until the first push.
	pub fun new() VecDeque<T> {
		return VecDeque { buf: Vec::new(), head: 0, len: 0 }
	}

	// An empty queue with room for `n` values.
	pub fun with_capacity(n usize) VecDeque<T> {
		q mut := VecDeque::new()
		q.grow_to(n)
		return q
	}

	// A queue of the values from `items`, front to back.
	pub fun from_iter<I: Iterator<T>>(items I) VecDeque<T> {
		q mut := VecDeque::new()
		q.extend(items)
		return q
	}

	// A queue holding the values of `v`, front to back.
	pub fun from_vec(v Vec<T>) VecDeque<T> {
		return VecDeque::from_iter(v.into_iter())
	}

	pub fun len(&self) usize {
		return self.len
	}

	pub fun is_empty(&self) bool {
		return self.len == 0
	}

	// How many values fit before the buffer grows.
	pub fun capacity(&self) usize {
		return self.buf.len()
	}

	// The buffer index of logical position `i`.
	fun slot(&self, i usize) usize {
		j := self.head + i
		if j >= self.buf.len() {
			return j - self.buf.len()
		}
		return j
	}

	// Reallocates to `cap` slots, moving the values to the front.
	fun grow_to(&mut self, cap usize) {
		if cap <= self.buf.len() {
			return
		}
		next mut := Vec::with_capacity(cap)
		i mut := 0
		while i < self.len {
			s := self.slot(i)
			next.push(self.buf[s].take())
			i += 1
		}
		while next.len() < cap {
			next.push(None)
		}
		self.buf = next
		self.head = 0
	}

	// Makes room for `n` more values.
	pub fun reserve(&mut self, n usize) {
		if self.len + n > self.buf.len() {
			cap mut := self.buf.len() * 2
			if cap < 4 {
				cap = 4
			}
			while cap < self.len + n {
				cap *= 2
			}
			self.grow_to(cap)
		}
	}

	// Adds a value at the back.
	pub fun push_back(&mut self, value T) {
		self.reserve(1)
		s := self.slot(self.len)
		self.buf[s] = Some(value)
		self.len += 1
	}

	// Adds a value at the front.
	pub fun push_front(&mut self, value T) {
		self.reserve(1)
		if self.head == 0 {
			self.head = self.buf.len() - 1
		} else {
			self.head -= 1
		}
		h := self.head
		self.buf[h] = Some(value)
		self.len += 1
	}

	// Removes and returns the back value.
	pub fun pop_back(&mut self) option<T> {
		if self.len == 0 {
			return None
		}
		self.len -= 1
		s := self.slot(self.len)
		return self.buf[s].take()
	}

	// Removes and returns the front value.
	pub fun pop_front(&mut self) option<T> {
		if self.len == 0 {
			return None
		}
		h := self.head
		v := self.buf[h].take()
		self.head += 1
		if self.head == self.buf.len() {
			self.head = 0
		}
		self.len -= 1
		return v
	}

	// The value at position `i` from the front.
	pub fun get(&self, i usize) option<&T> {
		if i >= self.len {
			return None
		}
		return self.buf[self.slot(i)].as_ref()
	}

	// The value at position `i`, mutably.
	pub fun get_mut(&mut self, i usize) option<&mut T> {
		if i >= self.len {
			return None
		}
		s := self.slot(i)
		return self.buf[s].as_mut()
	}

	pub fun front(&self) option<&T> {
		return self.get(0)
	}

	pub fun back(&self) option<&T> {
		if self.len == 0 {
			return None
		}
		return self.get(self.len - 1)
	}

	pub fun front_mut(&mut self) option<&mut T> {
		return self.get_mut(0)
	}

	pub fun back_mut(&mut self) option<&mut T> {
		if self.len == 0 {
			return None
		}
		n := self.len - 1
		return self.get_mut(n)
	}

	// Swaps the values at positions `i` and `j`.
	pub fun swap(&mut self, i usize, j usize) {
		if i >= self.len || j >= self.len {
			panic("VecDeque::swap: index out of bounds")
		}
		a := self.slot(i)
		b := self.slot(j)
		self.buf.swap(a, b)
	}

	// Removes every value.
	pub fun clear(&mut self) {
		while self.len > 0 {
			self.pop_back()
		}
		self.head = 0
	}

	// Keeps the first `n` values, dropping the rest.
	pub fun truncate(&mut self, n usize) {
		while self.len > n {
			self.pop_back()
		}
	}

	// Inserts `value` at position `i`, shifting later values back.
	pub fun insert(&mut self, i usize, value T) {
		if i > self.len {
			panic("VecDeque::insert: index out of bounds")
		}
		self.push_back(value)
		j mut := self.len - 1
		while j > i {
			self.swap(j, j - 1)
			j -= 1
		}
	}

	// Removes and returns the value at position `i`.
	pub fun remove(&mut self, i usize) option<T> {
		if i >= self.len {
			return None
		}
		j mut := i
		while j + 1 < self.len {
			self.swap(j, j + 1)
			j += 1
		}
		return self.pop_back()
	}

	// Moves the first `n` values to the back.
	pub fun rotate_left(&mut self, n usize) {
		i mut := 0
		while i < n {
			match self.pop_front() {
				Some(x) => self.push_back(x),
				None => return,
			}
			i += 1
		}
	}

	// Moves the last `n` values to the front.
	pub fun rotate_right(&mut self, n usize) {
		i mut := 0
		while i < n {
			match self.pop_back() {
				Some(x) => self.push_front(x),
				None => return,
			}
			i += 1
		}
	}

	// Keeps only the values for which `keep` returns true, in order.
	pub fun retain(&mut self, keep fun mut(&T) bool) {
		n := self.len
		i mut := 0
		while i < n {
			x := self.pop_front().unwrap()
			if keep(&x) {
				self.push_back(x)
			}
			i += 1
		}
	}

	// Adds every value from `items` at the back.
	pub fun extend<I: Iterator<T>>(&mut self, items I) {
		it mut := items
		while let Some(x) = it.next() {
			self.push_back(x)
		}
	}

	// Moves the values to the start of the buffer, so `iter_mut` and
	// `as_slices` see them in order.
	fun make_contiguous(&mut self) {
		if self.head != 0 {
			h := self.head
			self.buf.rotate_left(h)
			self.head = 0
		}
	}

	// The values, front to back.
	pub fun iter<'a>(&'a self) DequeIter<'a, T> {
		return DequeIter { q: self, front: 0, back: self.len }
	}

	// The values, mutably, front to back.
	pub fun iter_mut<'a>(&'a mut self) DequeIterMut<'a, T> {
		self.make_contiguous()
		n := self.len
		return DequeIterMut { inner: self.buf.iter_mut(), left: n }
	}

	// The values, front to back, consuming the queue.
	pub fun into_iter(self) DequeIntoIter<T> {
		return DequeIntoIter { q: self }
	}

	// Removes and returns every value.
	pub fun drain(&mut self) DequeIntoIter<T> {
		q mut := VecDeque::new()
		std::mem::swap(self, &mut q)
		return DequeIntoIter { q: q }
	}
}

impl<T: Eq> VecDeque<T> {
	// Whether some value equals `x`.
	pub fun contains(&self, x &T) bool {
		for y in self.iter() {
			if y == x {
				return true
			}
		}
		return false
	}
}

impl<T: Clone> VecDeque<T> {
	// The values, front to back, in a vector.
	pub fun to_vec(&self) Vec<T> {
		out mut := Vec::with_capacity(self.len)
		for x in self.iter() {
			out.push(x.clone())
		}
		return out
	}
}

impl<T: Eq> Eq for VecDeque<T> {
	fun eq(&self, other &VecDeque<T>) bool {
		if self.len != other.len {
			return false
		}
		i mut := 0
		while i < self.len {
			if !(self.get(i).unwrap() == other.get(i).unwrap()) {
				return false
			}
			i += 1
		}
		return true
	}
}

impl<T: Clone> Clone for VecDeque<T> {
	fun clone(&self) VecDeque<T> {
		return VecDeque::from_vec(self.to_vec())
	}
}

impl<T: Debug> Debug for VecDeque<T> {
	fun fmt_debug(&self, f &mut std::fmt::Formatter) {
		f.list(self.iter())
	}
}

pub struct DequeIter<'a, T> {
	q &'a VecDeque<T>,
	front usize,
	back usize,
}

impl<'a, T> Iterator<&'a T> for DequeIter<'a, T> {
	fun next(&mut self) option<&'a T> {
		if self.front == self.back {
			return None
		}
		i := self.front
		self.front += 1
		return self.q.get(i)
	}
}

impl<'a, T> std::iter::DoubleEndedIterator<&'a T> for DequeIter<'a, T> {
	fun next_back(&mut self) option<&'a T> {
		if self.front == self.back {
			return None
		}
		self.back -= 1
		return self.q.get(self.back)
	}
}

pub struct DequeIterMut<'a, T> {
	inner std::iter::IterMut<'a, option<T>>,
	left usize,
}

impl<'a, T> Iterator<&'a mut T> for DequeIterMut<'a, T> {
	fun next(&mut self) option<&'a mut T> {
		if self.left == 0 {
			return None
		}
		self.left -= 1
		match self.inner.next() {
			Some(slot) => return slot.as_mut(),
			None => return None,
		}
	}
}

pub struct DequeIntoIter<T> {
	q VecDeque<T>,
}

impl<T> Iterator<T> for DequeIntoIter<T> {
	fun next(&mut self) option<T> {
		return self.q.pop_front()
	}
}

impl<T> std::iter::DoubleEndedIterator<T> for DequeIntoIter<T> {
	fun next_back(&mut self) option<T> {
		return self.q.pop_back()
	}
}

// ===== BTreeMap ===================================================================

// Minimum degree: nodes other than the root hold B-1 to 2B-1 keys.
const B usize = 6

struct Node<K, V> {
	keys Vec<K>,
	vals Vec<V>,
	// Child node indices; empty for a leaf.
	kids Vec<usize>,
}

// A map with keys kept in sorted order, stored in a B-tree. Keys need Ord.
// Iteration visits keys in ascending order, and `range` visits a slice of them.
pub struct BTreeMap<K, V> {
	nodes Vec<Node<K, V>>,
	free Vec<usize>,
	root option<usize>,
	len usize,
}

impl<K, V> BTreeMap<K, V> {
	// An empty map.
	pub fun new() BTreeMap<K, V> {
		return BTreeMap { nodes: Vec::new(), free: Vec::new(), root: None, len: 0 }
	}

	pub fun len(&self) usize {
		return self.len
	}

	pub fun is_empty(&self) bool {
		return self.len == 0
	}

	// Removes every entry.
	pub fun clear(&mut self) {
		self.nodes.clear()
		self.free.clear()
		self.root = None
		self.len = 0
	}

	// The entries in key order, as `(&key, &value)` pairs.
	pub fun iter<'a>(&'a self) BTreeIter<'a, K, V> {
		it mut := BTreeIter { nodes: &self.nodes, stack: Vec::new(), left: self.len }
		if let Some(r) = self.root {
			it.descend(r)
		}
		return it
	}

	// The keys in order.
	pub fun keys<'a>(&'a self) BTreeKeys<'a, K, V> {
		return BTreeKeys { inner: self.iter() }
	}

	// The values in key order.
	pub fun values<'a>(&'a self) BTreeValues<'a, K, V> {
		return BTreeValues { inner: self.iter() }
	}

	// The values in key order, mutably.
	pub fun values_mut<'a>(&'a mut self) BTreeValuesMut<'a, K, V> {
		ptrs mut := Vec::with_capacity(self.len)
		{
			it mut := self.iter()
			while let Some((_, v)) = it.next() {
				ptrs.push(v as *const V as *mut V)
			}
		}
		return BTreeValuesMut { ptrs: ptrs.into_iter(), owner: self }
	}

	// The entries in key order, consuming the map.
	pub fun into_iter(self) BTreeIntoIter<K, V> {
		return BTreeIntoIter { map: self }
	}

	// The first (smallest) entry.
	pub fun first_key_value(&self) option<(&K, &V)> {
		n mut := self.root?
		while self.nodes[n].kids.len() > 0 {
			n = self.nodes[n].kids[0]
		}
		return Some((&self.nodes[n].keys[0], &self.nodes[n].vals[0]))
	}

	// The last (largest) entry.
	pub fun last_key_value(&self) option<(&K, &V)> {
		n mut := self.root?
		while self.nodes[n].kids.len() > 0 {
			k := self.nodes[n].kids.len() - 1
			n = self.nodes[n].kids[k]
		}
		i := self.nodes[n].keys.len() - 1
		return Some((&self.nodes[n].keys[i], &self.nodes[n].vals[i]))
	}

	// Removes and returns the first entry.
	pub fun pop_first(&mut self) option<(K, V)> {
		r := self.root?
		out := self.remove_end(r, false)
		self.len -= 1
		self.shrink_root()
		return Some(out)
	}

	// Removes and returns the last entry.
	pub fun pop_last(&mut self) option<(K, V)> {
		r := self.root?
		out := self.remove_end(r, true)
		self.len -= 1
		self.shrink_root()
		return Some(out)
	}

	fun new_node(&mut self, node Node<K, V>) usize {
		match self.free.pop() {
			Some(i) => {
				self.nodes[i] = node
				return i
			}
			None => {
				self.nodes.push(node)
				return self.nodes.len() - 1
			},
		}
	}

	fun is_leaf(&self, n usize) bool {
		return self.nodes[n].kids.len() == 0
	}

	fun nkeys(&self, n usize) usize {
		return self.nodes[n].keys.len()
	}

	// Splits the full child `i` of `x` around its median key.
	fun split_child(&mut self, x usize, i usize) {
		y := self.nodes[x].kids[i]
		keys := self.nodes[y].keys.split_off(B)
		vals := self.nodes[y].vals.split_off(B)
		kids mut := Vec::new()
		if !self.is_leaf(y) {
			kids = self.nodes[y].kids.split_off(B)
		}
		mk := self.nodes[y].keys.pop().unwrap()
		mv := self.nodes[y].vals.pop().unwrap()
		z := self.new_node(Node { keys: keys, vals: vals, kids: kids })
		self.nodes[x].keys.insert(i, mk)
		self.nodes[x].vals.insert(i, mv)
		self.nodes[x].kids.insert(i + 1, z)
	}

	// Merges child `i + 1` of `x` and the key between them into child `i`.
	fun merge(&mut self, x usize, i usize) {
		y := self.nodes[x].kids[i]
		z := self.nodes[x].kids.remove(i + 1)
		k := self.nodes[x].keys.remove(i)
		v := self.nodes[x].vals.remove(i)
		self.nodes[y].keys.push(k)
		self.nodes[y].vals.push(v)
		zk mut := Vec::new()
		zv mut := Vec::new()
		zc mut := Vec::new()
		std::mem::swap(&mut zk, &mut self.nodes[z].keys)
		std::mem::swap(&mut zv, &mut self.nodes[z].vals)
		std::mem::swap(&mut zc, &mut self.nodes[z].kids)
		self.nodes[y].keys.append(&mut zk)
		self.nodes[y].vals.append(&mut zv)
		self.nodes[y].kids.append(&mut zc)
		self.free.push(z)
	}

	// Makes sure child `i` of `x` has at least B keys before descending into
	// it, by borrowing from a sibling or merging. Returns the child's new index.
	fun fill_child(&mut self, x usize, i usize) usize {
		c := self.nodes[x].kids[i]
		if self.nkeys(c) >= B {
			return i
		}
		n := self.nkeys(x)
		if i > 0 && self.nkeys(self.nodes[x].kids[i - 1]) >= B {
			// Rotate right: the separator moves down into c, and the left
			// sibling's last key moves up.
			l := self.nodes[x].kids[i - 1]
			lk := self.nodes[l].keys.pop().unwrap()
			lv := self.nodes[l].vals.pop().unwrap()
			sk := std::mem::replace(&mut self.nodes[x].keys[i - 1], lk)
			sv := std::mem::replace(&mut self.nodes[x].vals[i - 1], lv)
			self.nodes[c].keys.insert(0, sk)
			self.nodes[c].vals.insert(0, sv)
			if !self.is_leaf(l) {
				lc := self.nodes[l].kids.pop().unwrap()
				self.nodes[c].kids.insert(0, lc)
			}
			return i
		}
		if i < n && self.nkeys(self.nodes[x].kids[i + 1]) >= B {
			// Rotate left.
			r := self.nodes[x].kids[i + 1]
			rk := self.nodes[r].keys.remove(0)
			rv := self.nodes[r].vals.remove(0)
			sk := std::mem::replace(&mut self.nodes[x].keys[i], rk)
			sv := std::mem::replace(&mut self.nodes[x].vals[i], rv)
			self.nodes[c].keys.push(sk)
			self.nodes[c].vals.push(sv)
			if !self.is_leaf(r) {
				rc := self.nodes[r].kids.remove(0)
				self.nodes[c].kids.push(rc)
			}
			return i
		}
		if i < n {
			self.merge(x, i)
			return i
		}
		self.merge(x, i - 1)
		return i - 1
	}

	// Removes the last (or first) entry of the subtree at `x`, which has at
	// least B keys or is the root.
	fun remove_end(&mut self, x usize, last bool) (K, V) {
		n mut := x
		loop {
			if self.is_leaf(n) {
				if last {
					return (self.nodes[n].keys.pop().unwrap(), self.nodes[n].vals.pop().unwrap())
				}
				return (self.nodes[n].keys.remove(0), self.nodes[n].vals.remove(0))
			}
			i mut := 0
			if last {
				i = self.nkeys(n)
			}
			i = self.fill_child(n, i)
			n = self.nodes[n].kids[i]
		}
	}

	// After a removal: an empty root is replaced by its only child (or none).
	fun shrink_root(&mut self) {
		if let Some(r) = self.root {
			if self.nkeys(r) == 0 {
				if self.is_leaf(r) {
					self.clear()
				} else {
					self.root = Some(self.nodes[r].kids.pop().unwrap())
					self.free.push(r)
				}
			}
		}
	}
}

// The position of `q` among `keys`: (index, found).
fun search<K: Borrow<Q>, Q: Ord>(keys &Vec<K>, q &Q) (usize, bool) {
	i mut := 0
	while i < keys.len() {
		let kb &Q = Borrow::borrow(&keys[i])
		match kb.cmp(q) {
			Ordering::Less => {}
			Ordering::Equal => return (i, true),
			Ordering::Greater => return (i, false),
		}
		i += 1
	}
	return (i, false)
}

impl<K: Ord, V> BTreeMap<K, V> {
	// A map of the pairs from `items`; later duplicates win.
	pub fun from_iter<I: Iterator<(K, V)>>(items I) BTreeMap<K, V> {
		m mut := BTreeMap::new()
		m.extend(items)
		return m
	}

	// The node and index holding `key`.
	fun locate<Q: Ord>(&self, key &Q) option<(usize, usize)> where K: Borrow<Q> {
		n mut := self.root?
		loop {
			(i, found) := search(&self.nodes[n].keys, key)
			if found {
				return Some((n, i))
			}
			if self.is_leaf(n) {
				return None
			}
			n = self.nodes[n].kids[i]
		}
	}

	// The value for `key`.
	pub fun get<Q: Ord>(&self, key &Q) option<&V> where K: Borrow<Q> {
		(n, i) := self.locate(key)?
		return Some(&self.nodes[n].vals[i])
	}

	// The value for `key`, mutably.
	pub fun get_mut<Q: Ord>(&mut self, key &Q) option<&mut V> where K: Borrow<Q> {
		(n, i) := self.locate(key)?
		return Some(&mut self.nodes[n].vals[i])
	}

	// The stored key and value for `key`.
	pub fun get_key_value<Q: Ord>(&self, key &Q) option<(&K, &V)> where K: Borrow<Q> {
		(n, i) := self.locate(key)?
		return Some((&self.nodes[n].keys[i], &self.nodes[n].vals[i]))
	}

	// Whether the map has an entry for `key`.
	pub fun contains_key<Q: Ord>(&self, key &Q) bool where K: Borrow<Q> {
		return self.locate(key).is_some()
	}

	// Sets `key` to `value`, returning the old value if there was one.
	pub fun insert(&mut self, key K, value V) option<V> {
		if let Some((n, i)) = self.locate(&key) {
			return Some(std::mem::replace(&mut self.nodes[n].vals[i], value))
		}
		self.len += 1
		r := match self.root {
			Some(r) => r,
			None => {
				r := self.new_node(Node { keys: Vec::new(), vals: Vec::new(), kids: Vec::new() })
				self.root = Some(r)
				r
			},
		}
		if self.nkeys(r) == 2 * B - 1 {
			kids mut := Vec::new()
			kids.push(r)
			top := self.new_node(Node { keys: Vec::new(), vals: Vec::new(), kids: kids })
			self.root = Some(top)
			self.split_child(top, 0)
		}
		n mut := self.root.unwrap()
		loop {
			(i0, _) := search(&self.nodes[n].keys, &key)
			if self.is_leaf(n) {
				self.nodes[n].keys.insert(i0, key)
				self.nodes[n].vals.insert(i0, value)
				return None
			}
			i mut := i0
			c := self.nodes[n].kids[i]
			if self.nkeys(c) == 2 * B - 1 {
				self.split_child(n, i)
				if self.nodes[n].keys[i] < key {
					i += 1
				}
			}
			n = self.nodes[n].kids[i]
		}
	}

	// Removes `key`, returning its value.
	pub fun remove<Q: Ord>(&mut self, key &Q) option<V> where K: Borrow<Q> {
		match self.remove_entry(key) {
			Some((_, v)) => return Some(v),
			None => return None,
		}
	}

	// Removes `key`, returning the stored key and value.
	pub fun remove_entry<Q: Ord>(&mut self, key &Q) option<(K, V)> where K: Borrow<Q> {
		if !self.contains_key(key) {
			return None
		}
		n mut := self.root.unwrap()
		loop {
			(i, found) := search(&self.nodes[n].keys, key)
			if found && self.is_leaf(n) {
				out := (self.nodes[n].keys.remove(i), self.nodes[n].vals.remove(i))
				self.finish_remove()
				return Some(out)
			}
			if found {
				y := self.nodes[n].kids[i]
				z := self.nodes[n].kids[i + 1]
				if self.nkeys(y) >= B {
					(pk, pv) := self.remove_end(y, true)
					k := std::mem::replace(&mut self.nodes[n].keys[i], pk)
					v := std::mem::replace(&mut self.nodes[n].vals[i], pv)
					self.finish_remove()
					return Some((k, v))
				}
				if self.nkeys(z) >= B {
					(sk, sv) := self.remove_end(z, false)
					k := std::mem::replace(&mut self.nodes[n].keys[i], sk)
					v := std::mem::replace(&mut self.nodes[n].vals[i], sv)
					self.finish_remove()
					return Some((k, v))
				}
				// Both neighbors are minimal: merge them around the key and
				// continue in the merged node, where the key now lives.
				self.merge(n, i)
				if n == self.root.unwrap() && self.nkeys(n) == 0 {
					self.root = Some(y)
					self.free.push(n)
				}
				n = y
				continue
			}
			c := self.fill_child(n, i)
			next := self.nodes[n].kids[c]
			if n == self.root.unwrap() && self.nkeys(n) == 0 {
				self.root = Some(next)
				self.free.push(n)
			}
			n = next
		}
	}

	fun finish_remove(&mut self) {
		self.len -= 1
		self.shrink_root()
	}

	// The entries with keys in `from..to` (`to` excluded), in order.
	pub fun range<'a, Q: Ord>(&'a self, from &Q, to &'a Q) BTreeRange<'a, K, V, Q> where K: Borrow<Q> {
		return BTreeRange { inner: self.iter_from(from), end: Some(to) }
	}

	// The entries with keys from `from` on, in order.
	pub fun range_from<'a, Q: Ord>(&'a self, from &Q) BTreeRange<'a, K, V, Q> where K: Borrow<Q> {
		return BTreeRange { inner: self.iter_from(from), end: None }
	}

	// An iterator starting at the first key not less than `from`.
	fun iter_from<'a, Q: Ord>(&'a self, from &Q) BTreeIter<'a, K, V> where K: Borrow<Q> {
		it mut := BTreeIter { nodes: &self.nodes, stack: Vec::new(), left: self.len }
		if let Some(r) = self.root {
			n mut := r
			loop {
				(i, found) := search(&self.nodes[n].keys, from)
				it.stack.push((n, i))
				if found || self.is_leaf(n) {
					break
				}
				n = self.nodes[n].kids[i]
			}
		}
		return it
	}

	// Keeps only the entries for which `keep` returns true.
	pub fun retain(&mut self, keep fun mut(&K, &mut V) bool) {
		old mut := BTreeMap::new()
		std::mem::swap(self, &mut old)
		for (k, v) in old.into_iter() {
			value mut := v
			if keep(&k, &mut value) {
				self.insert(k, value)
			}
		}
	}

	// Inserts every pair from `items`.
	pub fun extend<I: Iterator<(K, V)>>(&mut self, items I) {
		it mut := items
		while let Some((k, v)) = it.next() {
			self.insert(k, v)
		}
	}

	// Moves every entry with a key at or after `key` into a new map.
	pub fun split_off<Q: Ord>(&mut self, key &Q) BTreeMap<K, V> where K: Borrow<Q> {
		out mut := BTreeMap::new()
		loop {
			match self.last_key_value() {
				Some((k, _)) => {
					let kb &Q = Borrow::borrow(k)
					if kb < key {
						break
					}
				}
				None => break,
			}
			(k, v) := self.pop_last().unwrap()
			out.insert(k, v)
		}
		return out
	}
}

impl<K: Eq, V: Eq> Eq for BTreeMap<K, V> {
	fun eq(&self, other &BTreeMap<K, V>) bool {
		if self.len != other.len {
			return false
		}
		a mut := self.iter()
		b mut := other.iter()
		while let Some((ka, va)) = a.next() {
			(kb, vb) := b.next().unwrap()
			if !(ka == kb) || !(va == vb) {
				return false
			}
		}
		return true
	}
}

impl<K: Clone, V: Clone> Clone for BTreeMap<K, V> {
	fun clone(&self) BTreeMap<K, V> {
		nodes mut := Vec::with_capacity(self.nodes.len())
		for n in self.nodes.iter() {
			nodes.push(Node { keys: n.keys.clone(), vals: n.vals.clone(), kids: n.kids.clone() })
		}
		return BTreeMap { nodes: nodes, free: self.free.clone(), root: self.root, len: self.len }
	}
}

impl<K: Debug, V: Debug> Debug for BTreeMap<K, V> {
	fun fmt_debug(&self, f &mut std::fmt::Formatter) {
		f.begin("{{")
		first mut := true
		for (k, v) in self.iter() {
			f.item(first)
			f.debug(k)
			f.write(": ")
			f.debug(v)
			first = false
		}
		f.end("}}", first, false)
	}
}

// In-order traversal. Each stack entry `(node, i)` means: the next key to
// yield from `node` is `i` (its left subtree is done).
pub struct BTreeIter<'a, K, V> {
	nodes &'a Vec<Node<K, V>>,
	stack Vec<(usize, usize)>,
	left usize,
}

impl<'a, K, V> BTreeIter<'a, K, V> {
	fun descend(&mut self, from usize) {
		n mut := from
		loop {
			self.stack.push((n, 0))
			if self.nodes[n].kids.len() == 0 {
				return
			}
			n = self.nodes[n].kids[0]
		}
	}
}

impl<'a, K, V> Iterator<(&'a K, &'a V)> for BTreeIter<'a, K, V> {
	fun next(&mut self) option<(&'a K, &'a V)> {
		loop {
			(n, i) := *self.stack.last()?
			nodes := self.nodes
			node := &nodes[n]
			if i < node.keys.len() {
				self.stack.pop()
				self.stack.push((n, i + 1))
				if node.kids.len() > 0 {
					self.descend(node.kids[i + 1])
				}
				if self.left > 0 {
					self.left -= 1
				}
				return Some((&node.keys[i], &node.vals[i]))
			}
			self.stack.pop()
		}
	}
}

pub struct BTreeRange<'a, K, V, Q> {
	inner BTreeIter<'a, K, V>,
	end option<&'a Q>,
}

impl<'a, K: Borrow<Q>, V, Q: Ord> Iterator<(&'a K, &'a V)> for BTreeRange<'a, K, V, Q> {
	fun next(&mut self) option<(&'a K, &'a V)> {
		(k, v) := self.inner.next()?
		if let Some(e) = self.end {
			let kb &Q = Borrow::borrow(k)
			if !(kb < e) {
				self.inner.stack.clear()
				return None
			}
		}
		return Some((k, v))
	}
}

pub struct BTreeKeys<'a, K, V> {
	inner BTreeIter<'a, K, V>,
}

impl<'a, K, V> Iterator<&'a K> for BTreeKeys<'a, K, V> {
	fun next(&mut self) option<&'a K> {
		(k, _) := self.inner.next()?
		return Some(k)
	}
}

pub struct BTreeValues<'a, K, V> {
	inner BTreeIter<'a, K, V>,
}

impl<'a, K, V> Iterator<&'a V> for BTreeValues<'a, K, V> {
	fun next(&mut self) option<&'a V> {
		(_, v) := self.inner.next()?
		return Some(v)
	}
}

// Pointers to each value, collected in order while the map is mutably
// borrowed by `owner`, so each `&mut V` is handed out once.
pub struct BTreeValuesMut<'a, K, V> {
	ptrs std::iter::IntoIter<*mut V>,
	owner &'a mut BTreeMap<K, V>,
}

impl<'a, K, V> Iterator<&'a mut V> for BTreeValuesMut<'a, K, V> {
	fun next(&mut self) option<&'a mut V> {
		p := self.ptrs.next()?
		unsafe {
			return Some(&mut *p)
		}
	}
}

pub struct BTreeIntoIter<K, V> {
	map BTreeMap<K, V>,
}

impl<K, V> Iterator<(K, V)> for BTreeIntoIter<K, V> {
	fun next(&mut self) option<(K, V)> {
		return self.map.pop_first()
	}
}

impl<K, V> std::iter::DoubleEndedIterator<(K, V)> for BTreeIntoIter<K, V> {
	fun next_back(&mut self) option<(K, V)> {
		return self.map.pop_last()
	}
}

// ===== BTreeSet ===================================================================

// A set of values kept in sorted order.
pub struct BTreeSet<T> {
	map BTreeMap<T, void>,
}

impl<T> BTreeSet<T> {
	pub fun new() BTreeSet<T> {
		return BTreeSet { map: BTreeMap::new() }
	}

	pub fun len(&self) usize {
		return self.map.len()
	}

	pub fun is_empty(&self) bool {
		return self.map.len() == 0
	}

	pub fun clear(&mut self) {
		self.map.clear()
	}

	// The values in ascending order.
	pub fun iter<'a>(&'a self) BTreeKeys<'a, T, void> {
		return self.map.keys()
	}

	// The values in order, consuming the set.
	pub fun into_iter(self) BTreeSetIntoIter<T> {
		return BTreeSetIntoIter { inner: self.map.into_iter() }
	}

	// The smallest value.
	pub fun first(&self) option<&T> {
		(k, _) := self.map.first_key_value()?
		return Some(k)
	}

	// The largest value.
	pub fun last(&self) option<&T> {
		(k, _) := self.map.last_key_value()?
		return Some(k)
	}

	pub fun pop_first(&mut self) option<T> {
		(k, _) := self.map.pop_first()?
		return Some(k)
	}

	pub fun pop_last(&mut self) option<T> {
		(k, _) := self.map.pop_last()?
		return Some(k)
	}
}

impl<T: Ord> BTreeSet<T> {
	pub fun from_iter<I: Iterator<T>>(items I) BTreeSet<T> {
		s mut := BTreeSet::new()
		s.extend(items)
		return s
	}

	// Adds `value`; returns false if it was already present.
	pub fun insert(&mut self, value T) bool {
		return self.map.insert(value, ()).is_none()
	}

	pub fun contains<Q: Ord>(&self, value &Q) bool where T: Borrow<Q> {
		return self.map.contains_key(value)
	}

	// Removes `value`; returns whether it was present.
	pub fun remove<Q: Ord>(&mut self, value &Q) bool where T: Borrow<Q> {
		return self.map.remove(value).is_some()
	}

	// The values in `from..to`, in order.
	pub fun range<'a, Q: Ord>(&'a self, from &Q, to &'a Q) BTreeSetRange<'a, T, Q> where T: Borrow<Q> {
		return BTreeSetRange { inner: self.map.range(from, to) }
	}

	pub fun retain(&mut self, keep fun mut(&T) bool) {
		self.map.retain(|k, _v| keep(k))
	}

	pub fun extend<I: Iterator<T>>(&mut self, items I) {
		it mut := items
		while let Some(x) = it.next() {
			self.map.insert(x, ())
		}
	}

	pub fun is_subset(&self, other &BTreeSet<T>) bool {
		for x in self.iter() {
			if !other.contains(x) {
				return false
			}
		}
		return true
	}

	// The values in both sets, in order.
	pub fun intersection<'a>(&'a self, other &BTreeSet<T>) Vec<&'a T> {
		out mut := Vec::new()
		for x in self.iter() {
			if other.contains(x) {
				out.push(x)
			}
		}
		return out
	}

	// The values in this set but not `other`, in order.
	pub fun difference<'a>(&'a self, other &BTreeSet<T>) Vec<&'a T> {
		out mut := Vec::new()
		for x in self.iter() {
			if !other.contains(x) {
				out.push(x)
			}
		}
		return out
	}

	// The values in either set, in order, each once.
	pub fun union<'a>(&'a self, other &'a BTreeSet<T>) Vec<&'a T> {
		out mut := Vec::new()
		a mut := self.iter().peekable()
		b mut := other.iter().peekable()
		loop {
			take_a := match (a.peek(), b.peek()) {
				(None, None) => break,
				(Some(_), None) => 0,
				(None, Some(_)) => 1,
				(Some(x), Some(y)) => match (**x).cmp(*y) {
					Ordering::Less => 0,
					Ordering::Greater => 1,
					Ordering::Equal => 2,
				},
			}
			if take_a == 0 {
				out.push(a.next().unwrap())
			} else if take_a == 1 {
				out.push(b.next().unwrap())
			} else {
				out.push(a.next().unwrap())
				b.next()
			}
		}
		return out
	}
}

impl<T: Eq> Eq for BTreeSet<T> {
	fun eq(&self, other &BTreeSet<T>) bool {
		return self.map == other.map
	}
}

impl<T: Clone> Clone for BTreeSet<T> {
	fun clone(&self) BTreeSet<T> {
		return BTreeSet { map: self.map.clone() }
	}
}

impl<T: Debug> Debug for BTreeSet<T> {
	fun fmt_debug(&self, f &mut std::fmt::Formatter) {
		f.list(self.iter())
	}
}

pub struct BTreeSetRange<'a, T, Q> {
	inner BTreeRange<'a, T, void, Q>,
}

impl<'a, T: Borrow<Q>, Q: Ord> Iterator<&'a T> for BTreeSetRange<'a, T, Q> {
	fun next(&mut self) option<&'a T> {
		(k, _) := self.inner.next()?
		return Some(k)
	}
}

pub struct BTreeSetIntoIter<T> {
	inner BTreeIntoIter<T, void>,
}

impl<T> Iterator<T> for BTreeSetIntoIter<T> {
	fun next(&mut self) option<T> {
		(k, _) := self.inner.next()?
		return Some(k)
	}
}
