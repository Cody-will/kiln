// Collections: HashMap, HashSet, BTreeMap, BTreeSet, VecDeque.
//
//	counts mut := HashMap::new()
//	for w in text.split_whitespace() {
//		*counts.entry(w.to_string()).or_insert(0) += 1
//	}
//	if let Some(n) = counts.get("the") { ... }
//
// HashMap and HashSet need keys that implement Hash and Eq; lookups take any
// borrowed form of the key (a `&str` for `String` keys). Hash tables are
// seeded randomly per process. Iteration order of a HashMap is unspecified
// (today it is insertion order until something is removed); use BTreeMap
// when you need keys in sorted order.

// ===== HashMap ====================================================================

struct Bucket<K, V> {
	hash: u64,
	key: K,
	value: V,
}

// Index slot markers: 0 is empty; TOMB is a removed entry; anything else is
// an index into `entries` plus one.
const TOMB: usize = usize::MAX

// A hash table mapping keys to values.
pub struct HashMap<K, V> {
	entries: Vec<Bucket<K, V>>,
	slots: Vec<usize>,
	used: usize,
}

impl<K, V> HashMap<K, V> {
	// An empty map. It allocates nothing until the first insert.
	pub fn new() -> HashMap<K, V> {
		return HashMap { entries: Vec::new(), slots: Vec::new(), used: 0 }
	}

	// The number of entries.
	pub fn len(&self) -> usize {
		return self.entries.len()
	}

	pub fn is_empty(&self) -> bool {
		return self.entries.len() == 0
	}

	// Removes every entry, keeping the allocated space.
	pub fn clear(&mut self) {
		self.entries.clear()
		i mut := 0
		while i < self.slots.len() {
			self.slots[i] = 0
			i += 1
		}
		self.used = 0
	}

	// The entries as `(&key, &value)` pairs.
	pub fn iter<'a>(&'a self) -> Iter<'a, K, V> {
		return Iter { inner: self.entries.iter() }
	}

	// The entries as `(&key, &mut value)` pairs.
	pub fn iter_mut<'a>(&'a mut self) -> IterMut<'a, K, V> {
		return IterMut { inner: self.entries.iter_mut() }
	}

	// The keys.
	pub fn keys<'a>(&'a self) -> Keys<'a, K, V> {
		return Keys { inner: self.entries.iter() }
	}

	// The values.
	pub fn values<'a>(&'a self) -> Values<'a, K, V> {
		return Values { inner: self.entries.iter() }
	}

	// The values, mutably.
	pub fn values_mut<'a>(&'a mut self) -> ValuesMut<'a, K, V> {
		return ValuesMut { inner: self.entries.iter_mut() }
	}

	// The entries as `(key, value)` pairs, consuming the map.
	pub fn into_iter(self) -> IntoIter<K, V> {
		return IntoIter { inner: self.entries.into_iter() }
	}

	// The keys, consuming the map.
	pub fn into_keys(self) -> IntoKeys<K, V> {
		return IntoKeys { inner: self.entries.into_iter() }
	}

	// The values, consuming the map.
	pub fn into_values(self) -> IntoValues<K, V> {
		return IntoValues { inner: self.entries.into_iter() }
	}

	// Removes and returns every entry, leaving the map empty.
	pub fn drain(&mut self) -> IntoIter<K, V> {
		i mut := 0
		while i < self.slots.len() {
			self.slots[i] = 0
			i += 1
		}
		self.used = 0
		entries mut := Vec::new()
		std::mem::swap(&mut self.entries, &mut entries)
		return IntoIter { inner: entries.into_iter() }
	}
}

impl<K: Hash + Eq, V> HashMap<K, V> {
	// An empty map with room for `n` entries before it grows.
	pub fn with_capacity(n: usize) -> HashMap<K, V> {
		m mut := HashMap::new()
		m.reserve(n)
		return m
	}

	// A map of the pairs from `items`; later duplicates win.
	pub fn from_iter<I: Iterator<(K, V)>>(items: I) -> HashMap<K, V> {
		m mut := HashMap::new()
		m.extend(items)
		return m
	}

	// How many entries fit before the table grows.
	pub fn capacity(&self) -> usize {
		return self.slots.len() / 8 * 7
	}

	// Makes room for `n` more entries.
	pub fn reserve(&mut self, n: usize) {
		if (self.used + n) * 8 <= self.slots.len() * 7 {
			return
		}
		need := self.entries.len() + n
		size mut := 8
		while size * 7 < need * 8 {
			size *= 2
		}
		self.rehash(size)
	}

	// Rebuilds the index with `size` slots (a power of two), dropping tombstones.
	fn rehash(&mut self, size: usize) {
		slots mut := Vec::with_capacity(size)
		i mut := 0
		while i < size {
			slots.push(0)
			i += 1
		}
		mask := size - 1
		j mut := 0
		while j < self.entries.len() {
			k mut := (self.entries[j].hash as usize) & mask
			while slots[k] != 0 {
				k = (k + 1) & mask
			}
			slots[k] = j + 1
			j += 1
		}
		self.slots = slots
		self.used = self.entries.len()
	}

	// The slot holding `key`, if present.
	fn find<Q: Eq>(&self, h: u64, key: &Q) -> Option<usize> where K: Borrow<Q> {
		if self.slots.len() == 0 {
			return None
		}
		mask := self.slots.len() - 1
		i mut := (h as usize) & mask
		loop {
			s := self.slots[i]
			if s == 0 {
				return None
			}
			if s != TOMB {
				e := &self.entries[s - 1]
				if e.hash == h && Borrow::borrow(&e.key) == key {
					return Some(i)
				}
			}
			i = (i + 1) & mask
		}
	}

	// Adds an entry known to be absent; returns its index.
	fn push_new(&mut self, h: u64, key: K, value: V) -> usize {
		self.reserve(1)
		mask := self.slots.len() - 1
		i mut := (h as usize) & mask
		while self.slots[i] != 0 && self.slots[i] != TOMB {
			i = (i + 1) & mask
		}
		if self.slots[i] == 0 {
			self.used += 1
		}
		self.entries.push(Bucket { hash: h, key: key, value: value })
		self.slots[i] = self.entries.len()
		return self.entries.len() - 1
	}

	// Sets `key` to `value`, returning the old value if there was one.
	pub fn insert(&mut self, key: K, value: V) -> Option<V> {
		h := std::hash::hash(&key)
		if let Some(i) = self.find(h, &key) {
			idx := self.slots[i] - 1
			return Some(std::mem::replace(&mut self.entries[idx].value, value))
		}
		self.push_new(h, key, value)
		return None
	}

	// The value for `key`.
	pub fn get<Q: Hash + Eq>(&self, key: &Q) -> Option<&V> where K: Borrow<Q> {
		match self.find(std::hash::hash(key), key) {
			Some(i) => return Some(&self.entries[self.slots[i] - 1].value),
			None => return None,
		}
	}

	// The value for `key`, mutably.
	pub fn get_mut<Q: Hash + Eq>(&mut self, key: &Q) -> Option<&mut V> where K: Borrow<Q> {
		match self.find(std::hash::hash(key), key) {
			Some(i) => {
				idx := self.slots[i] - 1
				return Some(&mut self.entries[idx].value)
			}
			None => return None,
		}
	}

	// The stored key and value for `key`.
	pub fn get_key_value<Q: Hash + Eq>(&self, key: &Q) -> Option<(&K, &V)> where K: Borrow<Q> {
		match self.find(std::hash::hash(key), key) {
			Some(i) => {
				e := &self.entries[self.slots[i] - 1]
				return Some((&e.key, &e.value))
			}
			None => return None,
		}
	}

	// Whether the map has an entry for `key`.
	pub fn contains_key<Q: Hash + Eq>(&self, key: &Q) -> bool where K: Borrow<Q> {
		return self.find(std::hash::hash(key), key).is_some()
	}

	// Removes `key`, returning its value.
	pub fn remove<Q: Hash + Eq>(&mut self, key: &Q) -> Option<V> where K: Borrow<Q> {
		match self.remove_entry(key) {
			Some((_, v)) => return Some(v),
			None => return None,
		}
	}

	// Removes `key`, returning the stored key and value.
	pub fn remove_entry<Q: Hash + Eq>(&mut self, key: &Q) -> Option<(K, V)> where K: Borrow<Q> {
		match self.find(std::hash::hash(key), key) {
			Some(i) => return Some(self.take_slot(i)),
			None => return None,
		}
	}

	// Removes the entry in slot `i`. The last entry moves into its place in
	// `entries`, so its slot is updated.
	fn take_slot(&mut self, i: usize) -> (K, V) {
		idx := self.slots[i] - 1
		self.slots[i] = TOMB
		last := self.entries.len() - 1
		if idx != last {
			mask := self.slots.len() - 1
			j mut := (self.entries[last].hash as usize) & mask
			while self.slots[j] != last + 1 {
				j = (j + 1) & mask
			}
			self.slots[j] = idx + 1
		}
		b := self.entries.swap_remove(idx)
		return (b.key, b.value)
	}

	// The entry for `key`, for inserting or updating in place:
	// `*m.entry(k).or_insert(0) += 1`.
	pub fn entry<'a>(&'a mut self, key: K) -> Entry<'a, K, V> {
		h := std::hash::hash(&key)
		idx := match self.find(h, &key) {
			Some(i) => Some(self.slots[i] - 1),
			None => None,
		}
		return Entry { map: self, key: key, hash: h, idx: idx }
	}

	// Keeps only the entries for which `keep` returns true.
	pub fn retain(&mut self, keep: fn mut(&K, &mut V) -> bool) {
		old mut := Vec::new()
		std::mem::swap(&mut self.entries, &mut old)
		for b in old.into_iter() {
			e mut := b
			if keep(&e.key, &mut e.value) {
				self.entries.push(e)
			}
		}
		size := self.slots.len()
		if size > 0 {
			self.rehash(size)
		}
	}

	// Inserts every pair from `items`.
	pub fn extend<I: Iterator<(K, V)>>(&mut self, items: I) {
		it mut := items
		while let Some((k, v)) = it.next() {
			self.insert(k, v)
		}
	}
}

impl<K: Hash + Eq, V: Eq> Eq for HashMap<K, V> {
	// Maps are equal when they have the same keys with equal values, in any order.
	fn eq(&self, other: &HashMap<K, V>) -> bool {
		if self.len() != other.len() {
			return false
		}
		for e in self.entries.iter() {
			match other.get(&e.key) {
				Some(v) => {
					if !(v == &e.value) {
						return false
					}
				}
				None => return false,
			}
		}
		return true
	}
}

impl<K: Clone, V: Clone> Clone for HashMap<K, V> {
	fn clone(&self) -> HashMap<K, V> {
		entries mut := Vec::with_capacity(self.entries.len())
		for e in self.entries.iter() {
			entries.push(Bucket { hash: e.hash, key: e.key.clone(), value: e.value.clone() })
		}
		return HashMap { entries: entries, slots: self.slots.clone(), used: self.used }
	}
}

impl<K: Debug, V: Debug> Debug for HashMap<K, V> {
	fn fmt_debug(&self, f: &mut std::fmt::Formatter) {
		f.begin("{{")
		first mut := true
		for e in self.entries.iter() {
			f.item(first)
			f.debug(&e.key)
			f.write(": ")
			f.debug(&e.value)
			first = false
		}
		f.end("}}", first, false)
	}
}

// A place in a map for one key, which may or may not hold a value.
pub struct Entry<'a, K, V> {
	map: &'a mut HashMap<K, V>,
	key: K,
	hash: u64,
	idx: Option<usize>,
}

impl<'a, K: Hash + Eq, V> Entry<'a, K, V> {
	// The key this entry is for.
	pub fn key(&self) -> &K {
		return &self.key
	}

	// Whether the map already has a value for the key.
	pub fn is_occupied(&self) -> bool {
		return self.idx.is_some()
	}

	// The value, inserting `default` first if there is none.
	pub fn or_insert(self, default: V) -> &'a mut V {
		e mut := self
		idx := match e.idx {
			Some(i) => i,
			None => e.map.push_new(e.hash, e.key, default),
		}
		return &mut e.map.entries[idx].value
	}

	// The value, inserting `make()` first if there is none.
	pub fn or_insert_with(self, make: fn mut() -> V) -> &'a mut V {
		e mut := self
		idx := match e.idx {
			Some(i) => i,
			None => e.map.push_new(e.hash, e.key, make()),
		}
		return &mut e.map.entries[idx].value
	}

	// Calls `f` on the value if there is one, then returns the entry.
	pub fn and_modify(self, f: fn mut(&mut V)) -> Entry<'a, K, V> {
		e mut := self
		if let Some(i) = e.idx {
			f(&mut e.map.entries[i].value)
		}
		return e
	}
}

pub struct Iter<'a, K, V> {
	inner: std::iter::Iter<'a, Bucket<K, V>>,
}

impl<'a, K, V> Iterator<(&'a K, &'a V)> for Iter<'a, K, V> {
	fn next(&mut self) -> Option<(&'a K, &'a V)> {
		match self.inner.next() {
			Some(b) => return Some((&b.key, &b.value)),
			None => return None,
		}
	}
}

pub struct IterMut<'a, K, V> {
	inner: std::iter::IterMut<'a, Bucket<K, V>>,
}

impl<'a, K, V> Iterator<(&'a K, &'a mut V)> for IterMut<'a, K, V> {
	fn next(&mut self) -> Option<(&'a K, &'a mut V)> {
		match self.inner.next() {
			Some(b) => return Some((&b.key, &mut b.value)),
			None => return None,
		}
	}
}

pub struct Keys<'a, K, V> {
	inner: std::iter::Iter<'a, Bucket<K, V>>,
}

impl<'a, K, V> Iterator<&'a K> for Keys<'a, K, V> {
	fn next(&mut self) -> Option<&'a K> {
		match self.inner.next() {
			Some(b) => return Some(&b.key),
			None => return None,
		}
	}
}

pub struct Values<'a, K, V> {
	inner: std::iter::Iter<'a, Bucket<K, V>>,
}

impl<'a, K, V> Iterator<&'a V> for Values<'a, K, V> {
	fn next(&mut self) -> Option<&'a V> {
		match self.inner.next() {
			Some(b) => return Some(&b.value),
			None => return None,
		}
	}
}

pub struct ValuesMut<'a, K, V> {
	inner: std::iter::IterMut<'a, Bucket<K, V>>,
}

impl<'a, K, V> Iterator<&'a mut V> for ValuesMut<'a, K, V> {
	fn next(&mut self) -> Option<&'a mut V> {
		match self.inner.next() {
			Some(b) => return Some(&mut b.value),
			None => return None,
		}
	}
}

pub struct IntoIter<K, V> {
	inner: std::iter::IntoIter<Bucket<K, V>>,
}

impl<K, V> Iterator<(K, V)> for IntoIter<K, V> {
	fn next(&mut self) -> Option<(K, V)> {
		match self.inner.next() {
			Some(b) => return Some((b.key, b.value)),
			None => return None,
		}
	}
}

pub struct IntoKeys<K, V> {
	inner: std::iter::IntoIter<Bucket<K, V>>,
}

impl<K, V> Iterator<K> for IntoKeys<K, V> {
	fn next(&mut self) -> Option<K> {
		match self.inner.next() {
			Some(b) => return Some(b.key),
			None => return None,
		}
	}
}

pub struct IntoValues<K, V> {
	inner: std::iter::IntoIter<Bucket<K, V>>,
}

impl<K, V> Iterator<V> for IntoValues<K, V> {
	fn next(&mut self) -> Option<V> {
		match self.inner.next() {
			Some(b) => return Some(b.value),
			None => return None,
		}
	}
}

// ===== HashSet ====================================================================

// A set of distinct values, stored in a hash table.
pub struct HashSet<T> {
	map: HashMap<T, ()>,
}

impl<T> HashSet<T> {
	// An empty set.
	pub fn new() -> HashSet<T> {
		return HashSet { map: HashMap::new() }
	}

	pub fn len(&self) -> usize {
		return self.map.len()
	}

	pub fn is_empty(&self) -> bool {
		return self.map.len() == 0
	}

	pub fn clear(&mut self) {
		self.map.clear()
	}

	// The values.
	pub fn iter<'a>(&'a self) -> Keys<'a, T, ()> {
		return self.map.keys()
	}

	// The values, consuming the set.
	pub fn into_iter(self) -> IntoKeys<T, ()> {
		return self.map.into_keys()
	}

	// Removes and returns every value.
	pub fn drain(&mut self) -> IntoKeys<T, ()> {
		return IntoKeys { inner: self.map.drain().inner }
	}
}

impl<T: Hash + Eq> HashSet<T> {
	// An empty set with room for `n` values.
	pub fn with_capacity(n: usize) -> HashSet<T> {
		return HashSet { map: HashMap::with_capacity(n) }
	}

	// A set of the values from `items`.
	pub fn from_iter<I: Iterator<T>>(items: I) -> HashSet<T> {
		s mut := HashSet::new()
		s.extend(items)
		return s
	}

	pub fn reserve(&mut self, n: usize) {
		self.map.reserve(n)
	}

	// Adds `value`; returns false if it was already present.
	pub fn insert(&mut self, value: T) -> bool {
		return self.map.insert(value, ()).is_none()
	}

	// Whether `value` is in the set.
	pub fn contains<Q: Hash + Eq>(&self, value: &Q) -> bool where T: Borrow<Q> {
		return self.map.contains_key(value)
	}

	// The stored value equal to `value`.
	pub fn get<Q: Hash + Eq>(&self, value: &Q) -> Option<&T> where T: Borrow<Q> {
		match self.map.get_key_value(value) {
			Some((k, _)) => return Some(k),
			None => return None,
		}
	}

	// Removes `value`; returns whether it was present.
	pub fn remove<Q: Hash + Eq>(&mut self, value: &Q) -> bool where T: Borrow<Q> {
		return self.map.remove(value).is_some()
	}

	// Removes and returns the stored value equal to `value`.
	pub fn take<Q: Hash + Eq>(&mut self, value: &Q) -> Option<T> where T: Borrow<Q> {
		match self.map.remove_entry(value) {
			Some((k, _)) => return Some(k),
			None => return None,
		}
	}

	// Keeps only the values for which `keep` returns true.
	pub fn retain(&mut self, keep: fn mut(&T) -> bool) {
		self.map.retain(|k, _v| keep(k))
	}

	// Adds every value from `items`.
	pub fn extend<I: Iterator<T>>(&mut self, items: I) {
		it mut := items
		while let Some(x) = it.next() {
			self.map.insert(x, ())
		}
	}

	// Whether every value of this set is in `other`.
	pub fn is_subset(&self, other: &HashSet<T>) -> bool {
		if self.len() > other.len() {
			return false
		}
		for x in self.iter() {
			if !other.contains(x) {
				return false
			}
		}
		return true
	}

	// Whether every value of `other` is in this set.
	pub fn is_superset(&self, other: &HashSet<T>) -> bool {
		return other.is_subset(self)
	}

	// Whether the sets have no values in common.
	pub fn is_disjoint(&self, other: &HashSet<T>) -> bool {
		for x in self.iter() {
			if other.contains(x) {
				return false
			}
		}
		return true
	}

	// The values in both sets, as references into this one.
	pub fn intersection<'a>(&'a self, other: &HashSet<T>) -> Vec<&'a T> {
		out mut := Vec::new()
		for x in self.iter() {
			if other.contains(x) {
				out.push(x)
			}
		}
		return out
	}

	// The values in this set but not in `other`.
	pub fn difference<'a>(&'a self, other: &HashSet<T>) -> Vec<&'a T> {
		out mut := Vec::new()
		for x in self.iter() {
			if !other.contains(x) {
				out.push(x)
			}
		}
		return out
	}

	// The values in either set (each once).
	pub fn union<'a>(&'a self, other: &'a HashSet<T>) -> Vec<&'a T> {
		out mut := Vec::new()
		for x in self.iter() {
			out.push(x)
		}
		for x in other.iter() {
			if !self.contains(x) {
				out.push(x)
			}
		}
		return out
	}

	// The values in exactly one of the sets.
	pub fn symmetric_difference<'a>(&'a self, other: &'a HashSet<T>) -> Vec<&'a T> {
		out mut := self.difference(other)
		for x in other.iter() {
			if !self.contains(x) {
				out.push(x)
			}
		}
		return out
	}
}

impl<T: Hash + Eq> Eq for HashSet<T> {
	fn eq(&self, other: &HashSet<T>) -> bool {
		return self.len() == other.len() && self.is_subset(other)
	}
}

impl<T: Clone> Clone for HashSet<T> {
	fn clone(&self) -> HashSet<T> {
		return HashSet { map: self.map.clone() }
	}
}

impl<T: Debug> Debug for HashSet<T> {
	fn fmt_debug(&self, f: &mut std::fmt::Formatter) {
		f.begin("{{")
		first mut := true
		for e in self.map.entries.iter() {
			f.item(first)
			f.debug(&e.key)
			first = false
		}
		f.end("}}", first, false)
	}
}

// ===== VecDeque ===================================================================

// A double-ended queue: a growable ring buffer with fast pushes and pops at
// both ends.
pub struct VecDeque<T> {
	buf: Vec<Option<T>>,
	head: usize,
	len: usize,
}

impl<T> VecDeque<T> {
	// An empty queue. It allocates nothing until the first push.
	pub fn new() -> VecDeque<T> {
		return VecDeque { buf: Vec::new(), head: 0, len: 0 }
	}

	// An empty queue with room for `n` values.
	pub fn with_capacity(n: usize) -> VecDeque<T> {
		q mut := VecDeque::new()
		q.grow_to(n)
		return q
	}

	// A queue of the values from `items`, front to back.
	pub fn from_iter<I: Iterator<T>>(items: I) -> VecDeque<T> {
		q mut := VecDeque::new()
		q.extend(items)
		return q
	}

	// A queue holding the values of `v`, front to back.
	pub fn from_vec(v: Vec<T>) -> VecDeque<T> {
		return VecDeque::from_iter(v.into_iter())
	}

	pub fn len(&self) -> usize {
		return self.len
	}

	pub fn is_empty(&self) -> bool {
		return self.len == 0
	}

	// How many values fit before the buffer grows.
	pub fn capacity(&self) -> usize {
		return self.buf.len()
	}

	// The buffer index of logical position `i`.
	fn slot(&self, i: usize) -> usize {
		j := self.head + i
		if j >= self.buf.len() {
			return j - self.buf.len()
		}
		return j
	}

	// Reallocates to `cap` slots, moving the values to the front.
	fn grow_to(&mut self, cap: usize) {
		if cap <= self.buf.len() {
			return
		}
		next mut := Vec::with_capacity(cap)
		i mut := 0
		while i < self.len {
			s := self.slot(i)
			next.push(self.buf[s].take())
			i += 1
		}
		while next.len() < cap {
			next.push(None)
		}
		self.buf = next
		self.head = 0
	}

	// Makes room for `n` more values.
	pub fn reserve(&mut self, n: usize) {
		if self.len + n > self.buf.len() {
			cap mut := self.buf.len() * 2
			if cap < 4 {
				cap = 4
			}
			while cap < self.len + n {
				cap *= 2
			}
			self.grow_to(cap)
		}
	}

	// Adds a value at the back.
	pub fn push_back(&mut self, value: T) {
		self.reserve(1)
		s := self.slot(self.len)
		self.buf[s] = Some(value)
		self.len += 1
	}

	// Adds a value at the front.
	pub fn push_front(&mut self, value: T) {
		self.reserve(1)
		if self.head == 0 {
			self.head = self.buf.len() - 1
		} else {
			self.head -= 1
		}
		h := self.head
		self.buf[h] = Some(value)
		self.len += 1
	}

	// Removes and returns the back value.
	pub fn pop_back(&mut self) -> Option<T> {
		if self.len == 0 {
			return None
		}
		self.len -= 1
		s := self.slot(self.len)
		return self.buf[s].take()
	}

	// Removes and returns the front value.
	pub fn pop_front(&mut self) -> Option<T> {
		if self.len == 0 {
			return None
		}
		h := self.head
		v := self.buf[h].take()
		self.head += 1
		if self.head == self.buf.len() {
			self.head = 0
		}
		self.len -= 1
		return v
	}

	// The value at position `i` from the front.
	pub fn get(&self, i: usize) -> Option<&T> {
		if i >= self.len {
			return None
		}
		return self.buf[self.slot(i)].as_ref()
	}

	// The value at position `i`, mutably.
	pub fn get_mut(&mut self, i: usize) -> Option<&mut T> {
		if i >= self.len {
			return None
		}
		s := self.slot(i)
		return self.buf[s].as_mut()
	}

	pub fn front(&self) -> Option<&T> {
		return self.get(0)
	}

	pub fn back(&self) -> Option<&T> {
		if self.len == 0 {
			return None
		}
		return self.get(self.len - 1)
	}

	pub fn front_mut(&mut self) -> Option<&mut T> {
		return self.get_mut(0)
	}

	pub fn back_mut(&mut self) -> Option<&mut T> {
		if self.len == 0 {
			return None
		}
		n := self.len - 1
		return self.get_mut(n)
	}

	// Swaps the values at positions `i` and `j`.
	pub fn swap(&mut self, i: usize, j: usize) {
		if i >= self.len || j >= self.len {
			panic("VecDeque::swap: index out of bounds")
		}
		a := self.slot(i)
		b := self.slot(j)
		self.buf.swap(a, b)
	}

	// Removes every value.
	pub fn clear(&mut self) {
		while self.len > 0 {
			self.pop_back()
		}
		self.head = 0
	}

	// Keeps the first `n` values, dropping the rest.
	pub fn truncate(&mut self, n: usize) {
		while self.len > n {
			self.pop_back()
		}
	}

	// Inserts `value` at position `i`, shifting later values back.
	pub fn insert(&mut self, i: usize, value: T) {
		if i > self.len {
			panic("VecDeque::insert: index out of bounds")
		}
		self.push_back(value)
		j mut := self.len - 1
		while j > i {
			self.swap(j, j - 1)
			j -= 1
		}
	}

	// Removes and returns the value at position `i`.
	pub fn remove(&mut self, i: usize) -> Option<T> {
		if i >= self.len {
			return None
		}
		j mut := i
		while j + 1 < self.len {
			self.swap(j, j + 1)
			j += 1
		}
		return self.pop_back()
	}

	// Moves the first `n` values to the back.
	pub fn rotate_left(&mut self, n: usize) {
		i mut := 0
		while i < n {
			match self.pop_front() {
				Some(x) => self.push_back(x),
				None => return,
			}
			i += 1
		}
	}

	// Moves the last `n` values to the front.
	pub fn rotate_right(&mut self, n: usize) {
		i mut := 0
		while i < n {
			match self.pop_back() {
				Some(x) => self.push_front(x),
				None => return,
			}
			i += 1
		}
	}

	// Keeps only the values for which `keep` returns true, in order.
	pub fn retain(&mut self, keep: fn mut(&T) -> bool) {
		n := self.len
		i mut := 0
		while i < n {
			x := self.pop_front().unwrap()
			if keep(&x) {
				self.push_back(x)
			}
			i += 1
		}
	}

	// Adds every value from `items` at the back.
	pub fn extend<I: Iterator<T>>(&mut self, items: I) {
		it mut := items
		while let Some(x) = it.next() {
			self.push_back(x)
		}
	}

	// Moves the values to the start of the buffer, so `iter_mut` and
	// `as_slices` see them in order.
	fn make_contiguous(&mut self) {
		if self.head != 0 {
			h := self.head
			self.buf.rotate_left(h)
			self.head = 0
		}
	}

	// The values, front to back.
	pub fn iter<'a>(&'a self) -> DequeIter<'a, T> {
		return DequeIter { q: self, front: 0, back: self.len }
	}

	// The values, mutably, front to back.
	pub fn iter_mut<'a>(&'a mut self) -> DequeIterMut<'a, T> {
		self.make_contiguous()
		n := self.len
		return DequeIterMut { inner: self.buf.iter_mut(), left: n }
	}

	// The values, front to back, consuming the queue.
	pub fn into_iter(self) -> DequeIntoIter<T> {
		return DequeIntoIter { q: self }
	}

	// Removes and returns every value.
	pub fn drain(&mut self) -> DequeIntoIter<T> {
		q mut := VecDeque::new()
		std::mem::swap(self, &mut q)
		return DequeIntoIter { q: q }
	}
}

impl<T: Eq> VecDeque<T> {
	// Whether some value equals `x`.
	pub fn contains(&self, x: &T) -> bool {
		for y in self.iter() {
			if y == x {
				return true
			}
		}
		return false
	}
}

impl<T: Clone> VecDeque<T> {
	// The values, front to back, in a vector.
	pub fn to_vec(&self) -> Vec<T> {
		out mut := Vec::with_capacity(self.len)
		for x in self.iter() {
			out.push(x.clone())
		}
		return out
	}
}

impl<T: Eq> Eq for VecDeque<T> {
	fn eq(&self, other: &VecDeque<T>) -> bool {
		if self.len != other.len {
			return false
		}
		i mut := 0
		while i < self.len {
			if !(self.get(i).unwrap() == other.get(i).unwrap()) {
				return false
			}
			i += 1
		}
		return true
	}
}

impl<T: Clone> Clone for VecDeque<T> {
	fn clone(&self) -> VecDeque<T> {
		return VecDeque::from_vec(self.to_vec())
	}
}

impl<T: Debug> Debug for VecDeque<T> {
	fn fmt_debug(&self, f: &mut std::fmt::Formatter) {
		f.list(self.iter())
	}
}

pub struct DequeIter<'a, T> {
	q: &'a VecDeque<T>,
	front: usize,
	back: usize,
}

impl<'a, T> Iterator<&'a T> for DequeIter<'a, T> {
	fn next(&mut self) -> Option<&'a T> {
		if self.front == self.back {
			return None
		}
		i := self.front
		self.front += 1
		return self.q.get(i)
	}
}

impl<'a, T> std::iter::DoubleEndedIterator<&'a T> for DequeIter<'a, T> {
	fn next_back(&mut self) -> Option<&'a T> {
		if self.front == self.back {
			return None
		}
		self.back -= 1
		return self.q.get(self.back)
	}
}

pub struct DequeIterMut<'a, T> {
	inner: std::iter::IterMut<'a, Option<T>>,
	left: usize,
}

impl<'a, T> Iterator<&'a mut T> for DequeIterMut<'a, T> {
	fn next(&mut self) -> Option<&'a mut T> {
		if self.left == 0 {
			return None
		}
		self.left -= 1
		match self.inner.next() {
			Some(slot) => return slot.as_mut(),
			None => return None,
		}
	}
}

pub struct DequeIntoIter<T> {
	q: VecDeque<T>,
}

impl<T> Iterator<T> for DequeIntoIter<T> {
	fn next(&mut self) -> Option<T> {
		return self.q.pop_front()
	}
}

impl<T> std::iter::DoubleEndedIterator<T> for DequeIntoIter<T> {
	fn next_back(&mut self) -> Option<T> {
		return self.q.pop_back()
	}
}
