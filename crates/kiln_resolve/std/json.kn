// JSON (RFC 8259).
//
// Typed: derive `Json` and convert directly.
//
//	#[derive(Json)]
//	struct User {
//		name: String,
//		age: u32,
//		email: Option<String>,   // missing or null -> None
//	}
//
//	let u: User = json::from_str(text)?
//	out := json::to_string(&u)      // {"age":36,"email":null,"name":"Ada"}
//
// Untyped: parse into a `Value` and look inside.
//
//	v := json::parse(text)?
//	name := v.get("name").and_then(|n| n.as_str())
//
// A derived struct is an object with its field names as keys; a tuple
// struct is an array (a one-field tuple struct is its field's value). An
// enum's unit variants are strings ("Red"); other variants are an object
// with one key, the variant name, holding the payload. Objects keep
// insertion order: derived structs write fields in declaration order, and
// parsed objects keep the document's order. A missing `Option` field reads
// as `None`.

import std::collections::{BTreeMap, HashMap}
import super::super::super::Error as ErrorTrait

// A JSON object.
// A JSON object: string keys in insertion order. Parsing keeps the
// document's order and `#[derive(Json)]` writes fields in declaration
// order. Lookups go through a hash index.
@derive(Clone)
pub struct Map {
	entries Vec<Entry>,
	index HashMap<string, usize>,
}

@derive(Clone)
struct Entry {
	key string,
	value Value,
}

impl Map {
	// An empty object.
	pub fun new() Map {
		return Map { entries: Vec::new(), index: HashMap::new() }
	}

	// Number of members.
	pub fun len(&self) usize {
		return self.entries.len()
	}

	// Whether there are no members.
	pub fun is_empty(&self) bool {
		return self.entries.len() == 0
	}

	// The value for `key`.
	pub fun get(&self, key &str) option<&Value> {
		match self.index.get(key) {
			Some(i) => return Some(&self.entries[*i].value),
			None => return None,
		}
	}

	// The value for `key`, mutably.
	pub fun get_mut(&mut self, key &str) option<&mut Value> {
		match self.index.get(key) {
			Some(i) => {
				k := *i
				return Some(&mut self.entries[k].value)
			},
			None => return None,
		}
	}

	// Whether `key` is present.
	pub fun contains_key(&self, key &str) bool {
		return self.index.get(key).is_some()
	}

	// Sets `key`. A new key goes at the end; an existing key keeps its
	// place and the old value is returned.
	pub fun insert(&mut self, key string, value Value) option<Value> {
		match self.index.get(key.as_str()) {
			Some(i) => {
				k := *i
				return Some(std::mem::replace(&mut self.entries[k].value, value))
			},
			None => {},
		}
		self.index.insert(key.clone(), self.entries.len())
		self.entries.push(Entry { key: key, value: value })
		return None
	}

	// Removes `key`, keeping the order of the others.
	pub fun remove(&mut self, key &str) option<Value> {
		i := match self.index.remove(key) {
			Some(i) => i,
			None => return None,
		}
		e := self.entries.remove(i)
		for j in i..self.entries.len() {
			k := self.entries[j].key.clone()
			self.index.insert(k, j)
		}
		return Some(e.value)
	}

	// The members as `(&key, &value)` pairs, in order.
	pub fun iter<'a>(&'a self) MapIter<'a> {
		return MapIter { inner: self.entries.iter() }
	}

	// The keys, in order.
	pub fun keys(&self) Vec<&string> {
		out mut := Vec::new()
		for e in self.entries.iter() {
			out.push(&e.key)
		}
		return out
	}

	// The first member.
	pub fun first_key_value(&self) option<(&string, &Value)> {
		match self.entries.first() {
			Some(e) => return Some((&e.key, &e.value)),
			None => return None,
		}
	}
}

// Iterator over a `Map`'s members.
pub struct MapIter<'a> {
	inner std::iter::Iter<'a, Entry>,
}

impl<'a> Iterator<(&'a string, &'a Value)> for MapIter<'a> {
	fun next(&mut self) option<(&'a string, &'a Value)> {
		match self.inner.next() {
			Some(e) => return Some((&e.key, &e.value)),
			None => return None,
		}
	}
}

// Objects are equal when they have the same members, in any order.
impl Eq for Map {
	fun eq(&self, other &Map) bool {
		if self.len() != other.len() {
			return false
		}
		for e in self.entries.iter() {
			match other.get(&e.key) {
				Some(v) => {
					if v != &e.value {
						return false
					}
				},
				None => return false,
			}
		}
		return true
	}
}

impl Debug for Map {
	fun fmt_debug(&self, f &mut std::fmt::Formatter) {
		f.begin("{{")
		first mut := true
		for e in self.entries.iter() {
			f.item(first)
			f.debug(&e.key)
			f.write(": ")
			f.debug(&e.value)
			first = false
		}
		f.end("}}", first, false)
	}
}

// Any JSON value. Integers that fit in i64 are kept exactly as `Int`.
@derive(Clone, Debug, Eq)
pub enum Value {
	Null,
	Bool(bool),
	Int(i64),
	Float(f64),
	String(string),
	Array(Vec<Value>),
	Object(Map),
}

// A JSON syntax error (with its position) or a type mismatch.
@derive(Clone, Debug, Eq)
pub struct Error {
	msg string,
	// 1-based position of a syntax error; 0 for conversion errors.
	line usize,
	column usize,
}

impl Error {
	// A conversion error with a message.
	pub fun new(msg &str) Error {
		return Error { msg: msg.to_string(), line: 0, column: 0 }
	}

	// "expected T, found <kind of v>".
	pub fun mismatch(want &str, v &Value) Error {
		return Error::new("expected {want}, found {v.kind()}")
	}

	// The message, without position.
	pub fun message(&self) &str {
		return &self.msg
	}

	// The line of a syntax error (1-based), or 0.
	pub fun line(&self) usize {
		return self.line
	}

	// The column of a syntax error (1-based), or 0.
	pub fun column(&self) usize {
		return self.column
	}

	// The same error, prefixed with where it happened: `field "user"`.
	pub fun within(self, place &str) Error {
		return Error { msg: "{place}: {self.msg}", line: self.line, column: self.column }
	}
}

impl Display for Error {
	fun to_string(&self) string {
		if self.line > 0 {
			return "json: {self.msg} at line {self.line}, column {self.column}"
		}
		return "json: {self.msg}"
	}
}

impl ErrorTrait for Error {}

// ----- Value -----------------------------------------------------------------------

impl Value {
	// The kind of value, for messages: "null", "bool", "number", "string",
	// "array", or "object".
	pub fun kind(&self) &str {
		match self {
			Value::Null => return "null",
			Value::Bool(_) => return "bool",
			Value::Int(_) => return "number",
			Value::Float(_) => return "number",
			Value::String(_) => return "string",
			Value::Array(_) => return "array",
			Value::Object(_) => return "object",
		}
	}

	// The member `key` of an object.
	pub fun get(&self, key &str) option<&Value> {
		match self {
			Value::Object(m) => return m.get(key),
			_ => return None,
		}
	}

	// The element `i` of an array.
	pub fun at(&self, i usize) option<&Value> {
		match self {
			Value::Array(a) => return a.get(i),
			_ => return None,
		}
	}

	// Follows a path of object keys and array indices: `v.pointer("/a/0/b")`
	// (RFC 6901, with `~0` for `~` and `~1` for `/`).
	pub fun pointer(&self, path &str) option<&Value> {
		if path.len() == 0 {
			return Some(self)
		}
		if !path.starts_with("/") {
			return None
		}
		cur mut := self
		for raw in path[1..].split("/") {
			key := raw.replace("~1", "/").replace("~0", "~")
			next := match cur {
				Value::Object(m) => m.get(key.as_str()),
				Value::Array(a) => match usize::parse(&key) {
					Ok(i) => a.get(i),
					Err(_) => None,
				},
				_ => None,
			}
			cur = next?
		}
		return Some(cur)
	}

	pub fun is_null(&self) bool {
		match self {
			Value::Null => return true,
			_ => return false,
		}
	}

	pub fun as_bool(&self) option<bool> {
		match self {
			Value::Bool(b) => return Some(*b),
			_ => return None,
		}
	}

	// The number as i64, if it is an integer that fits.
	pub fun as_i64(&self) option<i64> {
		match self {
			Value::Int(n) => return Some(*n),
			Value::Float(f) => {
				if f.fract() == 0.0 && *f >= -9223372036854775808.0 && *f < 9223372036854775808.0 {
					return Some(*f as i64)
				}
				return None
			}
			_ => return None,
		}
	}

	// The number as f64.
	pub fun as_f64(&self) option<f64> {
		match self {
			Value::Int(n) => return Some(*n as f64),
			Value::Float(f) => return Some(*f),
			_ => return None,
		}
	}

	pub fun as_str(&self) option<&str> {
		match self {
			Value::String(s) => return Some(s.as_str()),
			_ => return None,
		}
	}

	pub fun as_array(&self) option<&Vec<Value>> {
		match self {
			Value::Array(a) => return Some(a),
			_ => return None,
		}
	}

	pub fun as_array_mut(&mut self) option<&mut Vec<Value>> {
		match self {
			Value::Array(a) => return Some(a),
			_ => return None,
		}
	}

	pub fun as_object(&self) option<&Map> {
		match self {
			Value::Object(m) => return Some(m),
			_ => return None,
		}
	}

	pub fun as_object_mut(&mut self) option<&mut Map> {
		match self {
			Value::Object(m) => return Some(m),
			_ => return None,
		}
	}

	// Compact JSON text.
	pub fun encode(&self) string {
		out mut := string::new()
		write_value(&mut out, self, 0, false)
		return out
	}

	// Indented JSON text (two spaces).
	pub fun pretty(&self) string {
		out mut := string::new()
		write_value(&mut out, self, 0, true)
		return out
	}
}

impl Display for Value {
	fun to_string(&self) string {
		return self.encode()
	}
}

// An empty object.
pub fun object() Value {
	return Value::Object(Map::new())
}

// ----- writing ---------------------------------------------------------------------

fun write_str(out &mut string, s &str) {
	// Copies runs of bytes that need no escaping in one push; only the
	// escaped bytes (all ASCII, so never inside a UTF-8 sequence) are
	// handled one at a time.
	out.push_char('"')
	b := s.as_bytes()
	n := b.len()
	start mut := 0
	i mut := 0
	while i < n {
		c := b[i]
		if c >= 32 && c != 34 && c != 92 {
			i += 1
			continue
		}
		if start < i {
			out.push(&s[start..i])
		}
		if c == 34 {
			out.push("\\\"")
		} else if c == 92 {
			out.push("\\\\")
		} else if c == 10 {
			out.push("\\n")
		} else if c == 13 {
			out.push("\\r")
		} else if c == 9 {
			out.push("\\t")
		} else {
			out.push("\\u{c as u32:04x}")
		}
		i += 1
		start = i
	}
	if start < n {
		out.push(&s[start..n])
	}
	out.push_char('"')
}

fun indent(out &mut string, depth usize) {
	out.push_char('\n')
	i mut := 0
	while i < depth {
		out.push("  ")
		i += 1
	}
}

fun write_value(out &mut string, v &Value, depth usize, pretty bool) {
	match v {
		Value::Null => out.push("null"),
		Value::Bool(b) => {
			if *b {
				out.push("true")
			} else {
				out.push("false")
			}
		}
		Value::Int(n) => std::strconv::append_int(out, *n),
		Value::Float(f) => {
			// JSON has no NaN or infinity.
			if f.is_finite() {
				std::strconv::append_float(out, *f)
			} else {
				out.push("null")
			}
		}
		Value::String(s) => write_str(out, s),
		Value::Array(a) => {
			if a.len() == 0 {
				out.push("[]")
				return
			}
			out.push_char('[')
			first mut := true
			for x in a.iter() {
				if !first {
					out.push_char(',')
				}
				if pretty {
					indent(out, depth + 1)
				}
				write_value(out, x, depth + 1, pretty)
				first = false
			}
			if pretty {
				indent(out, depth)
			}
			out.push_char(']')
		}
		Value::Object(m) => {
			if m.len() == 0 {
				out.push("{{}}")
				return
			}
			out.push_char('{')
			first mut := true
			for (k, x) in m.iter() {
				if !first {
					out.push_char(',')
				}
				if pretty {
					indent(out, depth + 1)
				}
				write_str(out, k)
				out.push_char(':')
				if pretty {
					out.push_char(' ')
				}
				write_value(out, x, depth + 1, pretty)
				first = false
			}
			if pretty {
				indent(out, depth)
			}
			out.push_char('}')
		},
	}
}

// ----- parsing ---------------------------------------------------------------------

const MAX_DEPTH usize = 512

// The JSON reader. `@derive(Json)` code uses it to decode straight from the
// text into a type, without building a `Value` tree first.
pub struct Parser<'a> {
	s &'a str,
	b &'a [u8],
	pos usize,
	depth usize,
	// The current object key: `s[key_start..key_end]`, or `key_buf` when
	// it had escapes.
	key_start usize,
	key_end usize,
	key_buf string,
	key_owned bool,
}

fun new_parser<'a>(text &'a str) Parser<'a> {
	return Parser { s: text, b: text.as_bytes(), pos: 0, depth: 0, key_start: 0, key_end: 0, key_buf: string::new(), key_owned: false }
}

// Parses JSON text into a Value.
pub fun parse(text &str) result<Value, Error> {
	p mut := new_parser(text)
	p.skip_ws()
	v := p.value()?
	p.skip_ws()
	if p.pos < p.b.len() {
		return Err(p.error("trailing characters after the value"))
	}
	return Ok(v)
}

impl<'a> Parser<'a> {
	// ----- used by derived `read_json` -----

	// Whether the next value is an object.
	pub fun at_object(&mut self) bool {
		self.skip_ws()
		return self.peek() == 123
	}

	// Whether the next value is an array.
	pub fun at_array(&mut self) bool {
		self.skip_ws()
		return self.peek() == 91
	}

	// Whether the next value is a string.
	pub fun at_string(&mut self) bool {
		self.skip_ws()
		return self.peek() == 34
	}

	// Whether the next value is `null` (consuming it if so).
	pub fun eat_null(&mut self) bool {
		self.skip_ws()
		if self.s[self.pos..].starts_with("null") {
			self.pos += 4
			return true
		}
		return false
	}

	// Enters the object or array at the cursor (after `at_object` / `at_array`).
	pub fun begin(&mut self) result<void, Error> {
		self.enter()?
		self.pos += 1
		return Ok()
	}

	// Moves to the next member of the current object: false at its end;
	// otherwise the key is in `key()` and the cursor is at the value.
	pub fun next_key(&mut self, first bool) result<bool, Error> {
		self.skip_ws()
		c := self.peek()
		if c == 125 {
			if first {
				self.pos += 1
				self.depth -= 1
				return Ok(false)
			}
		}
		if !first {
			if c == 44 {
				self.pos += 1
				self.skip_ws()
			} else if c == 125 {
				self.pos += 1
				self.depth -= 1
				return Ok(false)
			} else {
				return Err(self.error("expected `,` or `}}`"))
			}
		}
		if self.peek() != 34 {
			return Err(self.error("expected a string key"))
		}
		// Fast path: a key without escapes is borrowed from the text.
		i mut := self.pos + 1
		while i < self.b.len() && self.b[i] != 34 && self.b[i] != 92 && self.b[i] >= 32 {
			i += 1
		}
		if i < self.b.len() && self.b[i] == 34 {
			self.key_start = self.pos + 1
			self.key_end = i
			self.key_owned = false
			self.pos = i + 1
		} else {
			self.key_buf = self.string()?
			self.key_owned = true
		}
		self.skip_ws()
		if self.peek() != 58 {
			return Err(self.error("expected `:`"))
		}
		self.pos += 1
		self.skip_ws()
		return Ok(true)
	}

	// The key of the current object member.
	pub fun key(&self) &str {
		if self.key_owned {
			return &self.key_buf
		}
		return &self.s[self.key_start..self.key_end]
	}

	// Whether the current key is `k`.
	pub fun is_key(&self, k &str) bool {
		// Length first: derived structs try several keys per member.
		key := self.key()
		if key.len() != k.len() {
			return false
		}
		return key == k
	}

	// Moves to the next element of the current array: false at its end.
	pub fun next_elem(&mut self, first bool) result<bool, Error> {
		self.skip_ws()
		c := self.peek()
		if first {
			if c == 93 {
				self.pos += 1
				self.depth -= 1
				return Ok(false)
			}
			return Ok(true)
		}
		if c == 44 {
			self.pos += 1
			self.skip_ws()
			return Ok(true)
		}
		if c == 93 {
			self.pos += 1
			self.depth -= 1
			return Ok(false)
		}
		return Err(self.error("expected `,` or `]`"))
	}

	// Skips the value at the cursor.
	pub fun skip(&mut self) result<void, Error> {
		self.value()?
		return Ok()
	}

	// Reads the value at the cursor as a tree.
	pub fun read_value(&mut self) result<Value, Error> {
		self.skip_ws()
		return self.value()
	}

	// Reads a bool without building a `Value`.
	pub fun read_bool(&mut self) result<bool, Error> {
		self.skip_ws()
		if self.s[self.pos..].starts_with("true") {
			self.pos += 4
			return Ok(true)
		}
		if self.s[self.pos..].starts_with("false") {
			self.pos += 5
			return Ok(false)
		}
		v := self.value()?
		return bool::from_json(&v)
	}

	// Reads a number as f64 without going through `value`.
	pub fun read_f64(&mut self) result<f64, Error> {
		self.skip_ws()
		c := self.peek()
		if c == 45 || (c >= 48 && c <= 57) {
			match self.number()? {
				Value::Float(f) => return Ok(f),
				v => return f64::from_json(&v),
			}
		}
		v := self.value()?
		return f64::from_json(&v)
	}

	// Reads a number as i64 without going through `value`.
	pub fun read_i64(&mut self) result<i64, Error> {
		self.skip_ws()
		c := self.peek()
		if c == 45 || (c >= 48 && c <= 57) {
			match self.number()? {
				Value::Int(n) => return Ok(n),
				v => return i64::from_json(&v),
			}
		}
		v := self.value()?
		return i64::from_json(&v)
	}

	// Reads the string at the cursor (after `at_string`).
	pub fun read_string(&mut self) result<string, Error> {
		return self.string()
	}

	fun error(&self, msg &str) Error {
		line mut := 1
		col mut := 1
		i mut := 0
		while i < self.pos && i < self.b.len() {
			if self.b[i] == 10 {
				line += 1
				col = 1
			} else if self.b[i] < 128 || self.b[i] >= 192 {
				col += 1
			}
			i += 1
		}
		return Error { msg: msg.to_string(), line: line, column: col }
	}

	fun skip_ws(&mut self) {
		while self.pos < self.b.len() {
			c := self.b[self.pos]
			if c == 32 || c == 9 || c == 10 || c == 13 {
				self.pos += 1
			} else {
				return
			}
		}
	}

	fun peek(&self) u8 {
		if self.pos < self.b.len() {
			return self.b[self.pos]
		}
		return 0
	}

	fun literal(&mut self, word &str, v Value) result<Value, Error> {
		if self.s[self.pos..].starts_with(word) {
			self.pos += word.len()
			return Ok(v)
		}
		return Err(self.error("invalid literal"))
	}

	fun value(&mut self) result<Value, Error> {
		c := self.peek()
		if c == 123 {
			return self.object()
		}
		if c == 91 {
			return self.array()
		}
		if c == 34 {
			return Ok(Value::String(self.string()?))
		}
		if c == 116 {
			return self.literal("true", Value::Bool(true))
		}
		if c == 102 {
			return self.literal("false", Value::Bool(false))
		}
		if c == 110 {
			return self.literal("null", Value::Null)
		}
		if c == 45 || (c >= 48 && c <= 57) {
			return self.number()
		}
		if self.pos >= self.b.len() {
			return Err(self.error("unexpected end of input"))
		}
		return Err(self.error("expected a value"))
	}

	fun enter(&mut self) result<void, Error> {
		self.depth += 1
		if self.depth > MAX_DEPTH {
			return Err(self.error("nesting too deep"))
		}
		return Ok()
	}

	fun array(&mut self) result<Value, Error> {
		self.enter()?
		self.pos += 1
		out mut := Vec::new()
		self.skip_ws()
		if self.peek() == 93 {
			self.pos += 1
			self.depth -= 1
			return Ok(Value::Array(out))
		}
		loop {
			self.skip_ws()
			out.push(self.value()?)
			self.skip_ws()
			c := self.peek()
			if c == 44 {
				self.pos += 1
			} else if c == 93 {
				self.pos += 1
				self.depth -= 1
				return Ok(Value::Array(out))
			} else {
				return Err(self.error("expected `,` or `]`"))
			}
		}
	}

	fun object(&mut self) result<Value, Error> {
		self.enter()?
		self.pos += 1
		m mut := Map::new()
		self.skip_ws()
		if self.peek() == 125 {
			self.pos += 1
			self.depth -= 1
			return Ok(Value::Object(m))
		}
		loop {
			self.skip_ws()
			if self.peek() != 34 {
				return Err(self.error("expected a string key"))
			}
			k := self.string()?
			self.skip_ws()
			if self.peek() != 58 {
				return Err(self.error("expected `:`"))
			}
			self.pos += 1
			self.skip_ws()
			v := self.value()?
			m.insert(k, v)
			self.skip_ws()
			c := self.peek()
			if c == 44 {
				self.pos += 1
			} else if c == 125 {
				self.pos += 1
				self.depth -= 1
				return Ok(Value::Object(m))
			} else {
				return Err(self.error("expected `,` or `}}`"))
			}
		}
	}

	fun hex4(&mut self) result<u32, Error> {
		if self.pos + 4 > self.b.len() {
			return Err(self.error("truncated \\u escape"))
		}
		let mut n u32 = 0
		i mut := 0
		while i < 4 {
			c := self.b[self.pos + i]
			d := if c >= 48 && c <= 57 {
				(c - 48) as u32
			} else if c >= 97 && c <= 102 {
				(c - 87) as u32
			} else if c >= 65 && c <= 70 {
				(c - 55) as u32
			} else {
				return Err(self.error("invalid \\u escape"))
			}
			n = n * 16 + d
			i += 1
		}
		self.pos += 4
		return Ok(n)
	}

	fun string(&mut self) result<string, Error> {
		self.pos += 1
		// Fast path: no escapes — one exact-sized allocation.
		i mut := self.pos
		while i < self.b.len() && self.b[i] != 34 && self.b[i] != 92 && self.b[i] >= 32 {
			i += 1
		}
		if i < self.b.len() && self.b[i] == 34 {
			out := self.s[self.pos..i].to_string()
			self.pos = i + 1
			return Ok(out)
		}
		out mut := string::with_capacity(i - self.pos + 8)
		start mut := self.pos
		loop {
			if self.pos >= self.b.len() {
				return Err(self.error("unterminated string"))
			}
			c := self.b[self.pos]
			if c == 34 {
				out.push(&self.s[start..self.pos])
				self.pos += 1
				return Ok(out)
			}
			if c < 32 {
				return Err(self.error("control character in string"))
			}
			if c != 92 {
				self.pos += 1
				continue
			}
			out.push(&self.s[start..self.pos])
			self.pos += 1
			e := self.peek()
			self.pos += 1
			if e == 34 {
				out.push_char('"')
			} else if e == 92 {
				out.push_char('\\')
			} else if e == 47 {
				out.push_char('/')
			} else if e == 98 {
				out.push_char('\u{8}')
			} else if e == 102 {
				out.push_char('\u{c}')
			} else if e == 110 {
				out.push_char('\n')
			} else if e == 114 {
				out.push_char('\r')
			} else if e == 116 {
				out.push_char('\t')
			} else if e == 117 {
				hi := self.hex4()?
				cp mut := hi
				if hi >= 0xD800 && hi < 0xDC00 {
					// A surrogate pair.
					if self.peek() != 92 || self.pos + 1 >= self.b.len() || self.b[self.pos + 1] != 117 {
						return Err(self.error("unpaired surrogate in \\u escape"))
					}
					self.pos += 2
					lo := self.hex4()?
					if lo < 0xDC00 || lo >= 0xE000 {
						return Err(self.error("invalid low surrogate in \\u escape"))
					}
					cp = 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
				} else if hi >= 0xDC00 && hi < 0xE000 {
					return Err(self.error("unpaired surrogate in \\u escape"))
				}
				match char::from_u32(cp) {
					Some(ch) => out.push_char(ch),
					None => return Err(self.error("invalid \\u escape")),
				}
			} else {
				self.pos -= 1
				return Err(self.error("invalid escape"))
			}
			start = self.pos
		}
	}

	fun digits(&mut self) usize {
		n mut := 0
		while self.pos < self.b.len() && self.b[self.pos] >= 48 && self.b[self.pos] <= 57 {
			self.pos += 1
			n += 1
		}
		return n
	}

	fun number(&mut self) result<Value, Error> {
		start := self.pos
		neg := self.peek() == 45
		if neg {
			self.pos += 1
		}
		first := self.peek()
		// Fast path: up to 19 significant digits accumulate in `m`, with
		// the value m * 10^e10; anything else uses the general parsers.
		let mut m u64 = 0
		nd mut := 0
		e10 mut := 0
		while self.pos < self.b.len() && self.b[self.pos] >= 48 && self.b[self.pos] <= 57 {
			if nd < 19 {
				m = m * 10 + (self.b[self.pos] - 48) as u64
			}
			nd += 1
			self.pos += 1
		}
		n := nd
		if n == 0 {
			return Err(self.error("expected digits"))
		}
		if first == 48 && n > 1 {
			return Err(self.error("leading zeros are not allowed"))
		}
		is_float mut := false
		if self.peek() == 46 {
			self.pos += 1
			is_float = true
			fd mut := 0
			while self.pos < self.b.len() && self.b[self.pos] >= 48 && self.b[self.pos] <= 57 {
				if nd < 19 {
					m = m * 10 + (self.b[self.pos] - 48) as u64
					e10 -= 1
				}
				nd += 1
				fd += 1
				self.pos += 1
			}
			if fd == 0 {
				return Err(self.error("expected digits after `.`"))
			}
		}
		if self.peek() == 101 || self.peek() == 69 {
			self.pos += 1
			is_float = true
			eneg mut := false
			if self.peek() == 43 || self.peek() == 45 {
				eneg = self.peek() == 45
				self.pos += 1
			}
			ev mut := 0
			ed mut := 0
			while self.pos < self.b.len() && self.b[self.pos] >= 48 && self.b[self.pos] <= 57 {
				if ev < 100000 {
					ev = ev * 10 + (self.b[self.pos] - 48) as i64
				}
				ed += 1
				self.pos += 1
			}
			if ed == 0 {
				return Err(self.error("expected exponent digits"))
			}
			if eneg {
				e10 -= ev
			} else {
				e10 += ev
			}
		}
		if !is_float && nd <= 18 {
			v := m as i64
			if neg {
				return Ok(Value::Int(-v))
			}
			return Ok(Value::Int(v))
		}
		if is_float && nd <= 19 && m <= 9007199254740992 && e10 >= -22 && e10 <= 22 {
			// Both m and 10^|e10| are exact doubles, so one correctly
			// rounded multiply or divide gives the exact result.
			let mut p f64 = 1.0
			k mut := if e10 < 0 { -e10 } else { e10 }
			while k > 0 {
				p *= 10.0
				k -= 1
			}
			f mut := m as f64
			if e10 < 0 {
				f = f / p
			} else {
				f = f * p
			}
			if neg {
				f = -f
			}
			return Ok(Value::Float(f))
		}
		text := &self.s[start..self.pos]
		if !is_float {
			match i64::parse(text) {
				Ok(v) => return Ok(Value::Int(v)),
				Err(_) => {},
			}
		}
		match std::strconv::parse_float(text) {
			Ok(f) => return Ok(Value::Float(f)),
			Err(_) => return Err(self.error("invalid number")),
		}
	}
}

// ----- typed conversion -----------------------------------------------------------

// Types that convert to JSON.
pub trait ToJson {
	fun to_json(&self) Value

	// Appends compact JSON for `self` to `out`. Derived and standard impls
	// write directly; the default goes through `to_json`.
	fun write_json(&self, out &mut string) {
		write_value(out, &self.to_json(), 0, false)
	}
}

// Types that convert from JSON.
pub trait FromJson {
	fun from_json(v &Value) result<Self, Error>

	// Reads `Self` from the JSON at the cursor. Derived structs and the
	// standard containers read directly from the text; the default parses a
	// `Value` and converts it.
	fun read_json<'p>(p &mut Parser<'p>) result<Self, Error> {
		v := p.read_value()?
		return Self::from_json(&v)
	}

	// The value for a missing object member (`Option` gives `None`; other
	// types make the member required).
	fun from_missing() option<Self> {
		return None
	}
}

// Compact JSON for `v`.
pub fun to_string<T: ToJson>(v &T) string {
	out mut := string::with_capacity(256)
	v.write_json(&mut out)
	return out
}

// Indented JSON for `v`.
pub fun to_string_pretty<T: ToJson>(v &T) string {
	return v.to_json().pretty()
}

// Parses `text` and converts it to `T`.
pub fun from_str<T: FromJson>(text &str) result<T, Error> {
	p mut := new_parser(text)
	p.skip_ws()
	match T::read_json(&mut p) {
		Ok(x) => {
			p.skip_ws()
			if p.pos < p.b.len() {
				return Err(p.error("trailing characters after the value"))
			}
			return Ok(x)
		}
		Err(e) => {
			if e.line > 0 {
				return Err(e)
			}
		},
	}
	// A conversion error: report exactly what converting the whole
	// document reports (syntax errors first, fields in declaration order).
	v := parse(text)?
	return T::from_json(&v)
}

// The value of a member read by derived `read_json`, or its value when missing.
pub fun finish_field<T: FromJson>(v option<T>, key &str) result<T, Error> {
	match v {
		Some(x) => return Ok(x),
		None => match T::from_missing() {
			Some(x) => return Ok(x),
			None => return Err(Error::new("missing field \"{key}\"")),
		},
	}
}

// Writes a string as JSON (for derived `write_json`).
pub fun write_string(out &mut string, s &str) {
	write_str(out, s)
}

// Converts a parsed Value to `T`.
pub fun from_value<T: FromJson>(v &Value) result<T, Error> {
	return T::from_json(v)
}

// ----- helpers used by #[derive(Json)] ---------------------------------------------

pub fun expect_object<'a>(v &'a Value, ty &str) result<&'a Map, Error> {
	match v {
		Value::Object(m) => return Ok(m),
		_ => return Err(Error::mismatch("an object for {ty}", v)),
	}
}

pub fun expect_array<'a>(v &'a Value, n usize, ty &str) result<&'a Vec<Value>, Error> {
	match v {
		Value::Array(a) => {
			if a.len() != n {
				return Err(Error::new("expected {n} elements for {ty}, found {a.len()}"))
			}
			return Ok(a)
		}
		_ => return Err(Error::mismatch("an array for {ty}", v)),
	}
}

// The member `key` of `m`, converted.
pub fun field<T: FromJson>(m &Map, key &str) result<T, Error> {
	match m.get(key) {
		Some(v) => {
			match T::from_json(v) {
				Ok(x) => return Ok(x),
				Err(e) => return Err(e.within("field \"{key}\"")),
			}
		}
		None => match T::from_missing() {
			Some(x) => return Ok(x),
			None => return Err(Error::new("missing field \"{key}\"")),
		},
	}
}

// Element `i` of `a`, converted.
pub fun elem<T: FromJson>(a &Vec<Value>, i usize) result<T, Error> {
	match T::from_json(&a[i]) {
		Ok(x) => return Ok(x),
		Err(e) => return Err(e.within("element {i}")),
	}
}

// An enum value: its variant name and payload (none for unit variants).
pub fun variant<'a>(v &'a Value, ty &str) result<(&'a str, option<&'a Value>), Error> {
	match v {
		Value::String(s) => return Ok((s.as_str(), None)),
		Value::Object(m) => {
			if m.len() == 1 {
				(k, x) := m.first_key_value().unwrap()
				return Ok((k.as_str(), Some(x)))
			}
		}
		_ => {},
	}
	return Err(Error::mismatch("a variant of {ty}", v))
}

pub fun unknown_variant(name &str, ty &str) Error {
	return Error::new("unknown variant \"{name}\" of {ty}")
}

pub fun payload<'a>(p option<&'a Value>, name &str) result<&'a Value, Error> {
	match p {
		Some(v) => return Ok(v),
		None => return Err(Error::new("variant \"{name}\" needs a value")),
	}
}

// ----- impls for standard types ----------------------------------------------------

impl ToJson for Value {
	fun to_json(&self) Value {
		return self.clone()
	}

	fun write_json(&self, out &mut string) {
		write_value(out, self, 0, false)
	}
}

impl FromJson for Value {
	fun from_json(v &Value) result<Value, Error> {
		return Ok(v.clone())
	}

	fun read_json<'p>(p &mut Parser<'p>) result<Self, Error> {
		return p.read_value()
	}
}

impl ToJson for bool {
	fun to_json(&self) Value {
		return Value::Bool(*self)
	}

	fun write_json(&self, out &mut string) {
		if *self {
			out.push("true")
		} else {
			out.push("false")
		}
	}
}

impl FromJson for bool {
	fun from_json(v &Value) result<bool, Error> {
		match v {
			Value::Bool(b) => return Ok(*b),
			_ => return Err(Error::mismatch("bool", v)),
		}
	}

	fun read_json<'p>(p &mut Parser<'p>) result<Self, Error> {
		return p.read_bool()
	}
}

impl ToJson for f64 {
	fun to_json(&self) Value {
		return Value::Float(*self)
	}

	fun write_json(&self, out &mut string) {
		f := *self as f64
		if f.is_finite() {
			std::strconv::append_float(out, f)
		} else {
			out.push("null")
		}
	}
}

impl FromJson for f64 {
	fun from_json(v &Value) result<f64, Error> {
		match v.as_f64() {
			Some(f) => return Ok(f),
			None => return Err(Error::mismatch("a number", v)),
		}
	}

	fun read_json<'p>(p &mut Parser<'p>) result<Self, Error> {
		return p.read_f64()
	}
}

impl ToJson for f32 {
	fun to_json(&self) Value {
		return Value::Float(*self as f64)
	}

	fun write_json(&self, out &mut string) {
		f := *self as f64
		if f.is_finite() {
			std::strconv::append_float(out, f)
		} else {
			out.push("null")
		}
	}
}

impl FromJson for f32 {
	fun from_json(v &Value) result<f32, Error> {
		match v.as_f64() {
			Some(f) => return Ok(f as f32),
			None => return Err(Error::mismatch("a number", v)),
		}
	}
}

impl ToJson for char {
	fun to_json(&self) Value {
		return Value::String(self.to_string())
	}

	fun write_json(&self, out &mut string) {
		write_str(out, &self.to_string())
	}
}

impl ToJson for string {
	fun to_json(&self) Value {
		return Value::String(self.clone())
	}

	fun write_json(&self, out &mut string) {
		write_str(out, self)
	}
}

impl FromJson for string {
	fun from_json(v &Value) result<string, Error> {
		match v {
			Value::String(s) => return Ok(s.clone()),
			_ => return Err(Error::mismatch("string", v)),
		}
	}

	fun read_json<'p>(p &mut Parser<'p>) result<Self, Error> {
		if !p.at_string() {
			v := p.read_value()?
			return Self::from_json(&v)
		}
		return p.read_string()
	}
}

impl ToJson for str {
	fun to_json(&self) Value {
		return Value::String(self.to_string())
	}

	fun write_json(&self, out &mut string) {
		write_str(out, self)
	}
}

impl<T: ToJson> ToJson for Vec<T> {
	fun to_json(&self) Value {
		out mut := Vec::with_capacity(self.len())
		for x in self.iter() {
			out.push(x.to_json())
		}
		return Value::Array(out)
	}

	fun write_json(&self, out &mut string) {
		// Rough lower bound: brackets, commas, and a few bytes per element.
		out.reserve(self.len() * 64 + 2)
		out.push_char('[')
		first mut := true
		for x in self.iter() {
			if !first {
				out.push_char(',')
			}
			x.write_json(out)
			first = false
		}
		out.push_char(']')
	}
}

impl<T: ToJson> ToJson for [T] {
	fun to_json(&self) Value {
		out mut := Vec::with_capacity(self.len())
		for x in self.iter() {
			out.push(x.to_json())
		}
		return Value::Array(out)
	}

	fun write_json(&self, out &mut string) {
		out.push_char('[')
		first mut := true
		for x in self.iter() {
			if !first {
				out.push_char(',')
			}
			x.write_json(out)
			first = false
		}
		out.push_char(']')
	}
}

impl<T: FromJson> FromJson for Vec<T> {
	fun from_json(v &Value) result<Vec<T>, Error> {
		match v {
			Value::Array(a) => {
				out mut := Vec::with_capacity(a.len())
				i mut := 0
				while i < a.len() {
					out.push(elem(a, i)?)
					i += 1
				}
				return Ok(out)
			}
			_ => return Err(Error::mismatch("array", v)),
		}
	}

	fun read_json<'p>(p &mut Parser<'p>) result<Self, Error> {
		if !p.at_array() {
			v := p.read_value()?
			return Self::from_json(&v)
		}
		p.begin()?
		out mut := Vec::with_capacity(8)
		first mut := true
		start := p.pos
		while p.next_elem(first)? {
			first = false
			out.push(T::read_json(p)?)
			// After a few elements, estimate the rest from bytes/element so
			// large arrays (JSON bench: 50k records) avoid repeated realloc.
			if out.len() == 8 {
				consumed := p.pos - start
				if consumed > 0 {
					rem := p.b.len() - p.pos
					// rem / (bytes per element) ~ remaining elements.
					est := (rem * 8) / consumed
					if est > 0 {
						out.reserve(est)
					}
				}
			}
		}
		return Ok(out)
	}
}

impl<T: ToJson> ToJson for option<T> {
	fun to_json(&self) Value {
		match self {
			Some(x) => return x.to_json(),
			None => return Value::Null,
		}
	}

	fun write_json(&self, out &mut string) {
		match self {
			Some(x) => x.write_json(out),
			None => out.push("null"),
		}
	}
}

impl<T: FromJson> FromJson for option<T> {
	fun from_json(v &Value) result<option<T>, Error> {
		if v.is_null() {
			return Ok(None)
		}
		return Ok(Some(T::from_json(v)?))
	}

	fun from_missing() option<option<T>> {
		return Some(None)
	}

	fun read_json<'p>(p &mut Parser<'p>) result<Self, Error> {
		if p.eat_null() {
			return Ok(None)
		}
		return Ok(Some(T::read_json(p)?))
	}
}

impl<T: ToJson> ToJson for Box<T> {
	fun to_json(&self) Value {
		return (**self).to_json()
	}

	fun write_json(&self, out &mut string) {
		(**self).write_json(out)
	}
}

impl<T: FromJson> FromJson for Box<T> {
	fun from_json(v &Value) result<Box<T>, Error> {
		return Ok(Box::new(T::from_json(v)?))
	}

	fun read_json<'p>(p &mut Parser<'p>) result<Self, Error> {
		return Ok(Box::new(T::read_json(p)?))
	}
}

impl<T: ToJson> ToJson for BTreeMap<string, T> {
	fun to_json(&self) Value {
		m mut := Map::new()
		for (k, v) in self.iter() {
			m.insert(k.clone(), v.to_json())
		}
		return Value::Object(m)
	}
}

impl<T: FromJson> FromJson for BTreeMap<string, T> {
	fun from_json(v &Value) result<BTreeMap<string, T>, Error> {
		m := expect_object(v, "a map")?
		out mut := BTreeMap::new()
		for (k, _) in m.iter() {
			out.insert(k.clone(), field(m, k)?)
		}
		return Ok(out)
	}
}

impl<T: ToJson> ToJson for HashMap<string, T> {
	fun to_json(&self) Value {
		m mut := Map::new()
		for (k, v) in self.iter() {
			m.insert(k.clone(), v.to_json())
		}
		return Value::Object(m)
	}
}

impl<T: FromJson> FromJson for HashMap<string, T> {
	fun from_json(v &Value) result<HashMap<string, T>, Error> {
		m := expect_object(v, "a map")?
		out mut := HashMap::new()
		for (k, _) in m.iter() {
			out.insert(k.clone(), field(m, k)?)
		}
		return Ok(out)
	}
}

impl ToJson for i8 {
	fun to_json(&self) Value {
		return Value::Int(*self as i64)
	}

	fun write_json(&self, out &mut string) {
		std::strconv::append_int(out, *self as i64)
	}
}

impl FromJson for i8 {
	fun from_json(v &Value) result<i8, Error> {
		match v {
			Value::Int(n) => {
				if *n >= (i8::MIN as i64) && *n <= (i8::MAX as i64) {
					return Ok(*n as i8)
				}
			}
			_ => {},
		}
