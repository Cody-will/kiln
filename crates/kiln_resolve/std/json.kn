impl ToJson for u64 {
	fn to_json(&self) -> Value {
		if (*self as u64) <= 9223372036854775807 {
			return Value::Int(*self as i64)
		}
		return Value::Float(*self as f64)
	}
}

impl FromJson for u64 {
	fn from_json(v: &Value) -> Result<u64, Error> {
		match v {
			Value::Int(n) => {
				if *n >= 0 {
					return Ok(*n as u64)
				}
			}
			Value::Float(f) => {
				if *f >= 0.0 && *f <= 18446744073709551615.0 && f.fract() == 0.0 {
					return Ok(*f as u64)
				}
			}
			_ => {}
		}
		return Err(Error::mismatch("u64", v))
	}
}

impl ToJson for usize {
	fn to_json(&self) -> Value {
		if (*self as u64) <= 9223372036854775807 {
			return Value::Int(*self as i64)
		}
		return Value::Float(*self as f64)
	}
}

impl FromJson for usize {
	fn from_json(v: &Value) -> Result<usize, Error> {
		match v {
			Value::Int(n) => {
				if *n >= 0 {
					return Ok(*n as usize)
				}
			}
			Value::Float(f) => {
				if *f >= 0.0 && *f <= 18446744073709551615.0 && f.fract() == 0.0 {
					return Ok(*f as usize)
				}
			}
			_ => {}
		}
		return Err(Error::mismatch("usize", v))
	}
}
