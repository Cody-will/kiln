// Unicode character classes and case mapping (Unicode 15.1). ASCII is
// answered inline; other characters use tables in the C runtime
// (kiln_unicode.c, generated by tools/gen_unicode.py).
//
//	unicode::is_letter('é')   // true
//	unicode::to_upper('ß')    // 'ß' (no single-character uppercase)

fun kn_unicode_is(c i64, class i64) i64
fun kn_unicode_to(c i64, upper i64) i64

// The version of Unicode the tables come from.
pub const VERSION &str = "15.1.0"

fun class(c char, k i64) bool {
	return kn_unicode_is(c as i64, k) != 0
}

// A letter (categories L and Nl).
pub fun is_letter(c char) bool {
	if c.is_ascii() {
		return c.is_ascii_alphabetic()
	}
	return class(c, 0)
}

// The Alphabetic property: letters plus letter-like marks and numbers
// (what Rust's `char::is_alphabetic` tests).
pub fun is_alphabetic(c char) bool {
	if c.is_ascii() {
		return c.is_ascii_alphabetic()
	}
	return class(c, 10)
}

// A decimal digit (category Nd), in any script.
pub fun is_digit(c char) bool {
	if c.is_ascii() {
		return c.is_ascii_digit()
	}
	return class(c, 1)
}

// Any number (category N): digits, Roman numerals, fractions, ...
pub fun is_number(c char) bool {
	if c.is_ascii() {
		return c.is_ascii_digit()
	}
	return class(c, 2)
}

// An uppercase or titlecase letter (Lu, Lt).
pub fun is_upper(c char) bool {
	if c.is_ascii() {
		return c.is_ascii_uppercase()
	}
	return class(c, 3)
}

// A lowercase letter (Ll).
pub fun is_lower(c char) bool {
	if c.is_ascii() {
		return c.is_ascii_lowercase()
	}
	return class(c, 4)
}

// Punctuation (category P).
pub fun is_punct(c char) bool {
	if c.is_ascii() {
		return c.is_ascii_punctuation() && !is_symbol(c)
	}
	return class(c, 5)
}

// A symbol (category S): math, currency, modifiers, other.
pub fun is_symbol(c char) bool {
	return class(c, 6)
}

// A combining mark (category M).
pub fun is_mark(c char) bool {
	return !c.is_ascii() && class(c, 7)
}

// A control character (Cc).
pub fun is_control(c char) bool {
	n := c as u32
	return n < 32 || (n >= 127 && n < 160)
}

// White space (the Unicode White_Space property).
pub fun is_space(c char) bool {
	if c.is_ascii() {
		return c.is_ascii_whitespace() || c as u32 == 11
	}
	return class(c, 9)
}

// The uppercase form of `c` when it is a single character, else `c`.
pub fun to_upper(c char) char {
	if c.is_ascii() {
		return c.to_ascii_uppercase()
	}
	return unsafe { char::from_u32_unchecked(kn_unicode_to(c as i64, 1) as u32) }
}

// The lowercase form of `c` when it is a single character, else `c`.
pub fun to_lower(c char) char {
	if c.is_ascii() {
		return c.to_ascii_lowercase()
	}
	return unsafe { char::from_u32_unchecked(kn_unicode_to(c as i64, 0) as u32) }
}
