		match self.checked_pow(exp) {
			Some(r) => return r,
			None => panic("attempt to raise to a power with overflow"),
		}
	}

	pub fun checked_pow(self, exp u32) option<u128> {
		let mut r u128 = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.checked_mul(base)?
			}
			e >>= 1
			if e > 0 {
				base = base.checked_mul(base)?
			}
		}
		return Some(r)
	}

	pub fun wrapping_pow(self, exp u32) u128 {
		let mut r u128 = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.wrapping_mul(base)
			}
			e >>= 1
			base = base.wrapping_mul(base)
		}
		return r
	}

	pub fun saturating_pow(self, exp u32) u128 {
		match self.checked_pow(exp) {
			Some(r) => return r,
			None => {
				return u128::MAX
			},
		}
	}

	pub fun min(self, b u128) u128 {
		if b < self {
			return b
		}
		return self
	}

	pub fun max(self, b u128) u128 {
		if b > self {
			return b
		}
		return self
	}

	// `self` limited to `lo..=hi`.
	pub fun clamp(self, lo u128, hi u128) u128 {
		if self < lo {
			return lo
		}
		if self > hi {
			return hi
		}
		return self
	}

	// The distance between `self` and `b`, which never overflows.
	pub fun abs_diff(self, b u128) u128 {
		if self < b {
			return (b as u128).wrapping_sub(self as u128)
		}
		return (self as u128).wrapping_sub(b as u128)
	}

	pub fun div_euclid(self, b u128) u128 {
		return self / b
	}

	pub fun rem_euclid(self, b u128) u128 {
		return self % b
	}

	// Whether the value is a power of two (0 is not).
	pub fun is_power_of_two(self) bool {
		return self != 0 && self & (self - 1) == 0
	}

	// The smallest power of two that is at least `self`. Panics on
	// overflow in debug builds.
	pub fun next_power_of_two(self) u128 {
		if self <= 1 {
			return 1
		}
		shift := 128 - (self - 1).leading_zeros()
		if shift >= 128 {
			panic("next_power_of_two overflowed")
		}
		return (1 as u128) << shift
	}

	// The base-2 logarithm, rounded down. Panics if `self <= 0`.
	pub fun ilog2(self) u32 {
		if self <= 0 {
			panic("ilog2 of a non-positive number")
		}
		return 127 - self.leading_zeros()
	}

	// The base-10 logarithm, rounded down. Panics if `self <= 0`.
	pub fun ilog10(self) u32 {
		if self <= 0 {
			panic("ilog10 of a non-positive number")
		}
		n mut := 0
		v mut := self
		while v >= 10 {
			v /= 10
			n += 1
		}
		return n
	}

	// The integer square root, rounded down. Panics if negative.
	pub fun isqrt(self) u128 {
		if self < 0 {
			panic("isqrt of a negative number")
		}
		if self < 2 {
			return self
		}
		// Newton's method from an overestimate.
		x mut := (1 as u128) << ((self.ilog2() / 2) + 1)
		while true {
			y := (x + self / x) / 2
			if y >= x {
				return x
			}
			x = y
		}
		return x
	}

	// The decimal text of the number.
	pub fun to_string(self) string {
		return "{self}"
	}

	// Parses decimal text, like `strconv::parse_int`.
	pub fun parse(s &str) result<u128, std::strconv::ParseError> {
		return u128::from_str_radix(s, 10)
	}

	// Parses text in base `radix` (2 to 36), with an optional sign
	// (and `_` separators between digits).
	pub fun from_str_radix(s &str, radix u32) result<u128, std::strconv::ParseError> {
		v := std::strconv::parse_digits128(s, radix, false, 128)?
		return Ok(v as u128)
	}
}
