		if o {
			return None
		}
		return Some(r)
	}

	// `None` if `b` is zero.
	pub fn checked_div(self, b: u64) -> Option<u64> {
		if b == 0 {
			return None
		}
		return Some(self / b)
	}

	// `None` if `b` is zero.
	pub fn checked_rem(self, b: u64) -> Option<u64> {
		if b == 0 {
			return None
		}
		return Some(self % b)
	}

	pub fn checked_neg(self) -> Option<u64> {
		if self != 0 {
			return None
		}
		return Some(0)
	}

	// Arithmetic that stops at MIN or MAX instead of overflowing.
	pub fn saturating_add(self, b: u64) -> u64 {
		(r, o) := self.overflowing_add(b)
		if !o {
			return r
		}
		return u64::MAX
	}

	pub fn saturating_sub(self, b: u64) -> u64 {
		(r, o) := self.overflowing_sub(b)
		if !o {
			return r
		}
		return u64::MIN
	}

	pub fn saturating_mul(self, b: u64) -> u64 {
		(r, o) := self.overflowing_mul(b)
		if !o {
			return r
		}
		return u64::MAX
	}

	// `self` to the power `exp`. Panics on overflow (see `checked_pow`).
	pub fn pow(self, exp: u32) -> u64 {
		match self.checked_pow(exp) {
			Some(r) => return r,
			None => panic("attempt to raise to a power with overflow"),
		}
	}

	pub fn checked_pow(self, exp: u32) -> Option<u64> {
		let mut r: u64 = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.checked_mul(base)?
			}
			e >>= 1
			if e > 0 {
				base = base.checked_mul(base)?
			}
		}
		return Some(r)
	}

	pub fn wrapping_pow(self, exp: u32) -> u64 {
		let mut r: u64 = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.wrapping_mul(base)
			}
			e >>= 1
			base = base.wrapping_mul(base)
		}
		return r
	}

	pub fn saturating_pow(self, exp: u32) -> u64 {
		match self.checked_pow(exp) {
			Some(r) => return r,
			None => {
				return u64::MAX
			}
		}
	}

	pub fn min(self, b: u64) -> u64 {
		if b < self {
			return b
		}
		return self
	}

	pub fn max(self, b: u64) -> u64 {
		if b > self {
			return b
		}
		return self
	}

	// `self` limited to `lo..=hi`.
	pub fn clamp(self, lo: u64, hi: u64) -> u64 {
		if self < lo {
			return lo
		}
		if self > hi {
			return hi
		}
		return self
	}

	// The distance between `self` and `b`, which never overflows.
	pub fn abs_diff(self, b: u64) -> u64 {
		if self < b {
			return (b as u64).wrapping_sub(self as u64)
		}
		return (self as u64).wrapping_sub(b as u64)
	}

	pub fn div_euclid(self, b: u64) -> u64 {
		return self / b
	}

	pub fn rem_euclid(self, b: u64) -> u64 {
		return self % b
	}

	// Whether the value is a power of two (0 is not).
	pub fn is_power_of_two(self) -> bool {
		return self != 0 && self & (self - 1) == 0
	}

	// The smallest power of two that is at least `self`. Panics on
	// overflow in debug builds.
	pub fn next_power_of_two(self) -> u64 {
		if self <= 1 {
			return 1
		}
		shift := 64 - (self - 1).leading_zeros()
		if shift >= 64 {
			panic("next_power_of_two overflowed")
		}
		return (1 as u64) << shift
	}

	// The base-2 logarithm, rounded down. Panics if `self <= 0`.
	pub fn ilog2(self) -> u32 {
		if self <= 0 {
			panic("ilog2 of a non-positive number")
		}
		return 63 - self.leading_zeros()
	}

	// The base-10 logarithm, rounded down. Panics if `self <= 0`.
	pub fn ilog10(self) -> u32 {
		if self <= 0 {
			panic("ilog10 of a non-positive number")
		}
		n mut := 0
		v mut := self
		while v >= 10 {
			v /= 10
			n += 1
		}
		return n
	}

	// The integer square root, rounded down. Panics if negative.
	pub fn isqrt(self) -> u64 {
		if self < 0 {
			panic("isqrt of a negative number")
		}
		if self < 2 {
			return self
		}
		// Newton's method from an overestimate.
		x mut := (1 as u64) << ((self.ilog2() / 2) + 1)
		while true {
			y := (x + self / x) / 2
			if y >= x {
				return x
			}
			x = y
		}
		return x
	}

	// The decimal text of the number.
	pub fn to_string(self) -> String {
		return "{self}"
	}

	// Parses decimal text, like `strconv::parse_int`.
	pub fn parse(s: &str) -> Result<u64, std::strconv::ParseError> {
		return u64::from_str_radix(s, 10)
	}

	// Parses text in base `radix` (2 to 36), with an optional sign
	// (and `_` separators between digits).
	pub fn from_str_radix(s: &str, radix: u32) -> Result<u64, std::strconv::ParseError> {
		v := std::strconv::parse_digits(s, radix, false, 64)?
		return Ok(v as u64)
	}
}

impl usize {
	// The smallest value.
	pub const MIN: usize = 0
	// The largest value.
	pub const MAX: usize = 18446744073709551615
	// The size in bits.
	pub const BITS: u32 = 64

	// Arithmetic that wraps around at the ends of the range instead of
	// panicking on overflow.
	pub fn wrapping_add(self, b: usize) -> usize
	pub fn wrapping_sub(self, b: usize) -> usize
	pub fn wrapping_mul(self, b: usize) -> usize
	pub fn wrapping_neg(self) -> usize
	// Shifts by `n % BITS`.
	pub fn wrapping_shl(self, n: u32) -> usize
	pub fn wrapping_shr(self, n: u32) -> usize

	// The wrapped result and whether it overflowed.
	pub fn overflowing_add(self, b: usize) -> (usize, bool)
	pub fn overflowing_sub(self, b: usize) -> (usize, bool)
	pub fn overflowing_mul(self, b: usize) -> (usize, bool)

	// Bit operations.
	pub fn count_ones(self) -> u32
	pub fn leading_zeros(self) -> u32
	pub fn trailing_zeros(self) -> u32
	pub fn rotate_left(self, n: u32) -> usize
	pub fn rotate_right(self, n: u32) -> usize
	pub fn swap_bytes(self) -> usize
	pub fn reverse_bits(self) -> usize

	pub fn count_zeros(self) -> u32 {
		return 64 - self.count_ones()
	}

	// `None` on overflow.
	pub fn checked_add(self, b: usize) -> Option<usize> {
		(r, o) := self.overflowing_add(b)
		if o {
			return None
		}
		return Some(r)
	}

	// `None` on overflow.
	pub fn checked_sub(self, b: usize) -> Option<usize> {
		(r, o) := self.overflowing_sub(b)
		if o {
			return None
		}
		return Some(r)
	}

	// `None` on overflow.
	pub fn checked_mul(self, b: usize) -> Option<usize> {
		(r, o) := self.overflowing_mul(b)
		if o {
			return None
		}
		return Some(r)
	}

	// `None` if `b` is zero.
	pub fn checked_div(self, b: usize) -> Option<usize> {
		if b == 0 {
			return None
		}
		return Some(self / b)
	}

	// `None` if `b` is zero.
	pub fn checked_rem(self, b: usize) -> Option<usize> {
		if b == 0 {
			return None
		}
		return Some(self % b)
	}

	pub fn checked_neg(self) -> Option<usize> {
		if self != 0 {
			return None
		}
		return Some(0)
	}

	// Arithmetic that stops at MIN or MAX instead of overflowing.
	pub fn saturating_add(self, b: usize) -> usize {
		(r, o) := self.overflowing_add(b)
		if !o {
			return r
		}
		return usize::MAX
	}

	pub fn saturating_sub(self, b: usize) -> usize {
		(r, o) := self.overflowing_sub(b)
		if !o {
			return r
		}
		return usize::MIN
	}

	pub fn saturating_mul(self, b: usize) -> usize {
		(r, o) := self.overflowing_mul(b)
		if !o {
			return r
		}
		return usize::MAX
	}

	// `self` to the power `exp`. Panics on overflow (see `checked_pow`).
	pub fn pow(self, exp: u32) -> usize {
		match self.checked_pow(exp) {
			Some(r) => return r,
			None => panic("attempt to raise to a power with overflow"),
		}
	}

	pub fn checked_pow(self, exp: u32) -> Option<usize> {
		let mut r: usize = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.checked_mul(base)?
			}
			e >>= 1
			if e > 0 {
				base = base.checked_mul(base)?
			}
		}
		return Some(r)
	}

	pub fn wrapping_pow(self, exp: u32) -> usize {
		let mut r: usize = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.wrapping_mul(base)
			}
			e >>= 1
			base = base.wrapping_mul(base)
		}
		return r
	}

	pub fn saturating_pow(self, exp: u32) -> usize {
		match self.checked_pow(exp) {
			Some(r) => return r,
			None => {
				return usize::MAX
			}
		}
	}

	pub fn min(self, b: usize) -> usize {
		if b < self {
			return b
		}
		return self
	}

	pub fn max(self, b: usize) -> usize {
		if b > self {
			return b
		}
		return self
	}

	// `self` limited to `lo..=hi`.
	pub fn clamp(self, lo: usize, hi: usize) -> usize {
		if self < lo {
			return lo
		}
		if self > hi {
			return hi
		}
		return self
	}

	// The distance between `self` and `b`, which never overflows.
	pub fn abs_diff(self, b: usize) -> usize {
		if self < b {
			return (b as usize).wrapping_sub(self as usize)
		}
		return (self as usize).wrapping_sub(b as usize)
	}

	pub fn div_euclid(self, b: usize) -> usize {
		return self / b
	}

	pub fn rem_euclid(self, b: usize) -> usize {
		return self % b
	}

	// Whether the value is a power of two (0 is not).
	pub fn is_power_of_two(self) -> bool {
		return self != 0 && self & (self - 1) == 0
	}

	// The smallest power of two that is at least `self`. Panics on
	// overflow in debug builds.
	pub fn next_power_of_two(self) -> usize {
		if self <= 1 {
			return 1
		}
		shift := 64 - (self - 1).leading_zeros()
		if shift >= 64 {
			panic("next_power_of_two overflowed")
		}
		return (1 as usize) << shift
	}

	// The base-2 logarithm, rounded down. Panics if `self <= 0`.
	pub fn ilog2(self) -> u32 {
		if self <= 0 {
			panic("ilog2 of a non-positive number")
		}
		return 63 - self.leading_zeros()
	}

	// The base-10 logarithm, rounded down. Panics if `self <= 0`.
	pub fn ilog10(self) -> u32 {
		if self <= 0 {
			panic("ilog10 of a non-positive number")
		}
		n mut := 0
		v mut := self
		while v >= 10 {
			v /= 10
			n += 1
		}
		return n
	}

	// The integer square root, rounded down. Panics if negative.
	pub fn isqrt(self) -> usize {
		if self < 0 {
			panic("isqrt of a negative number")
		}
		if self < 2 {
			return self
		}
		// Newton's method from an overestimate.
		x mut := (1 as usize) << ((self.ilog2() / 2) + 1)
		while true {
			y := (x + self / x) / 2
			if y >= x {
				return x
			}
			x = y
		}
		return x
	}

	// The decimal text of the number.
	pub fn to_string(self) -> String {
		return "{self}"
	}

	// Parses decimal text, like `strconv::parse_int`.
	pub fn parse(s: &str) -> Result<usize, std::strconv::ParseError> {
		return usize::from_str_radix(s, 10)
	}

	// Parses text in base `radix` (2 to 36), with an optional sign
	// (and `_` separators between digits).
	pub fn from_str_radix(s: &str, radix: u32) -> Result<usize, std::strconv::ParseError> {
		v := std::strconv::parse_digits(s, radix, false, 64)?
		return Ok(v as usize)
	}
}
