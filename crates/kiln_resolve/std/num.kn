		if o {
			return None
		}
		return Some(r)
	}

	// `None` if `b` is zero.
	pub fn checked_div(self, b: u8) -> Option<u8> {
		if b == 0 {
			return None
		}
		return Some(self / b)
	}

	// `None` if `b` is zero.
	pub fn checked_rem(self, b: u8) -> Option<u8> {
		if b == 0 {
			return None
		}
		return Some(self % b)
	}

	pub fn checked_neg(self) -> Option<u8> {
		if self != 0 {
			return None
		}
		return Some(0)
	}

	// Arithmetic that stops at MIN or MAX instead of overflowing.
	pub fn saturating_add(self, b: u8) -> u8 {
		(r, o) := self.overflowing_add(b)
		if !o {
			return r
		}
		return u8::MAX
	}

	pub fn saturating_sub(self, b: u8) -> u8 {
		(r, o) := self.overflowing_sub(b)
		if !o {
			return r
		}
		return u8::MIN
	}

	pub fn saturating_mul(self, b: u8) -> u8 {
		(r, o) := self.overflowing_mul(b)
		if !o {
			return r
		}
		return u8::MAX
	}

	// `self` to the power `exp`. Panics on overflow (see `checked_pow`).
	pub fn pow(self, exp: u32) -> u8 {
		match self.checked_pow(exp) {
			Some(r) => return r,
			None => panic("attempt to raise to a power with overflow"),
		}
	}

	pub fn checked_pow(self, exp: u32) -> Option<u8> {
		let mut r: u8 = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.checked_mul(base)?
			}
			e >>= 1
			if e > 0 {
				base = base.checked_mul(base)?
			}
		}
		return Some(r)
	}

	pub fn wrapping_pow(self, exp: u32) -> u8 {
		let mut r: u8 = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.wrapping_mul(base)
			}
			e >>= 1
			base = base.wrapping_mul(base)
		}
		return r
	}

	pub fn saturating_pow(self, exp: u32) -> u8 {
		match self.checked_pow(exp) {
			Some(r) => return r,
			None => {
				return u8::MAX
			}
		}
	}

	pub fn min(self, b: u8) -> u8 {
		if b < self {
			return b
		}
		return self
	}

	pub fn max(self, b: u8) -> u8 {
		if b > self {
			return b
		}
		return self
	}

	// `self` limited to `lo..=hi`.
	pub fn clamp(self, lo: u8, hi: u8) -> u8 {
		if self < lo {
			return lo
		}
		if self > hi {
			return hi
		}
		return self
	}

	// The distance between `self` and `b`, which never overflows.
	pub fn abs_diff(self, b: u8) -> u8 {
		if self < b {
			return (b as u8).wrapping_sub(self as u8)
		}
		return (self as u8).wrapping_sub(b as u8)
	}

	pub fn div_euclid(self, b: u8) -> u8 {
		return self / b
	}

	pub fn rem_euclid(self, b: u8) -> u8 {
		return self % b
	}

	// Whether the value is a power of two (0 is not).
	pub fn is_power_of_two(self) -> bool {
		return self != 0 && self & (self - 1) == 0
	}

	// The smallest power of two that is at least `self`. Panics on
	// overflow in debug builds.
	pub fn next_power_of_two(self) -> u8 {
		if self <= 1 {
			return 1
		}
		shift := 8 - (self - 1).leading_zeros()
		if shift >= 8 {
			panic("next_power_of_two overflowed")
		}
		return (1 as u8) << shift
	}

	// The base-2 logarithm, rounded down. Panics if `self <= 0`.
	pub fn ilog2(self) -> u32 {
		if self <= 0 {
			panic("ilog2 of a non-positive number")
		}
		return 7 - self.leading_zeros()
	}

	// The base-10 logarithm, rounded down. Panics if `self <= 0`.
	pub fn ilog10(self) -> u32 {
		if self <= 0 {
			panic("ilog10 of a non-positive number")
		}
		n mut := 0
		v mut := self
		while v >= 10 {
			v /= 10
			n += 1
		}
		return n
	}

	// The integer square root, rounded down. Panics if negative.
	pub fn isqrt(self) -> u8 {
		if self < 0 {
			panic("isqrt of a negative number")
		}
		if self < 2 {
			return self
		}
		// Newton's method from an overestimate.
		x mut := (1 as u8) << ((self.ilog2() / 2) + 1)
		while true {
			y := (x + self / x) / 2
			if y >= x {
				return x
			}
			x = y
		}
		return x
	}

	// The decimal text of the number.
	pub fn to_string(self) -> String {
		return "{self}"
	}

	// Parses decimal text, like `strconv::parse_int`.
	pub fn parse(s: &str) -> Result<u8, std::strconv::ParseError> {
		return u8::from_str_radix(s, 10)
	}

	// Parses text in base `radix` (2 to 36), with an optional sign
	// (and `_` separators between digits).
	pub fn from_str_radix(s: &str, radix: u32) -> Result<u8, std::strconv::ParseError> {
		v := std::strconv::parse_digits(s, radix, false, 8)?
		return Ok(v as u8)
	}
}

