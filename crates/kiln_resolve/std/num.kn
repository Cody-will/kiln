		}
		return 15 - self.leading_zeros()
	}

	// The base-10 logarithm, rounded down. Panics if `self <= 0`.
	pub fun ilog10(self) u32 {
		if self <= 0 {
			panic("ilog10 of a non-positive number")
		}
		n mut := 0
		v mut := self
		while v >= 10 {
			v /= 10
			n += 1
		}
		return n
	}

