		let mut r u16 = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.wrapping_mul(base)
			}
			e >>= 1
			base = base.wrapping_mul(base)
		}
		return r
	}

	pub fun saturating_pow(self, exp u32) u16 {
		match self.checked_pow(exp) {
