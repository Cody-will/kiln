	}

	// `self` to the power `exp`. Panics on overflow (see `checked_pow`).
	pub fun pow(self, exp u32) u8 {
		match self.checked_pow(exp) {
			Some(r) => return r,
			None => panic("attempt to raise to a power with overflow"),
		}
	}

	pub fun checked_pow(self, exp u32) option<u8> {
		let mut r u8 = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.checked_mul(base)?
			}
			e >>= 1
			if e > 0 {
				base = base.checked_mul(base)?
			}
		}
		return Some(r)
	}

	pub fun wrapping_pow(self, exp u32) u8 {
		let mut r u8 = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.wrapping_mul(base)
			}
			e >>= 1
			base = base.wrapping_mul(base)
		}
		return r
	}

	pub fun saturating_pow(self, exp u32) u8 {
		match self.checked_pow(exp) {
			Some(r) => return r,
			None => {
				return u8::MAX
			},
		}
	}

	pub fun min(self, b u8) u8 {
		if b < self {
			return b
		}
		return self
	}

	pub fun max(self, b u8) u8 {
		if b > self {
			return b
		}
		return self
	}

	// `self` limited to `lo..=hi`.
	pub fun clamp(self, lo u8, hi u8) u8 {
		if self < lo {
			return lo
		}
		if self > hi {
			return hi
		}
		return self
	}

	// The distance between `self` and `b`, which never overflows.
	pub fun abs_diff(self, b u8) u8 {
		if self < b {
			return (b as u8).wrapping_sub(self as u8)
		}
		return (self as u8).wrapping_sub(b as u8)
	}

	pub fun div_euclid(self, b u8) u8 {
		return self / b
	}

	pub fun rem_euclid(self, b u8) u8 {
		return self % b
	}

	// Whether the value is a power of two (0 is not).
	pub fun is_power_of_two(self) bool {
		return self != 0 && self & (self - 1) == 0
	}

	// The smallest power of two that is at least `self`. Panics on
	// overflow in debug builds.
	pub fun next_power_of_two(self) u8 {
		if self <= 1 {
			return 1
		}
		shift := 8 - (self - 1).leading_zeros()
		if shift >= 8 {
			panic("next_power_of_two overflowed")
		}
		return (1 as u8) << shift
	}

	// The base-2 logarithm, rounded down. Panics if `self <= 0`.
	pub fun ilog2(self) u32 {
		if self <= 0 {
			panic("ilog2 of a non-positive number")
		}
		return 7 - self.leading_zeros()
	}

	// The base-10 logarithm, rounded down. Panics if `self <= 0`.
	pub fun ilog10(self) u32 {
		if self <= 0 {
			panic("ilog10 of a non-positive number")
		}
		n mut := 0
		v mut := self
		while v >= 10 {
			v /= 10
			n += 1
		}
		return n
	}

	// The integer square root, rounded down. Panics if negative.
	pub fun isqrt(self) u8 {
		if self < 0 {
			panic("isqrt of a negative number")
		}
		if self < 2 {
			return self
		}
		// Newton's method from an overestimate.
		x mut := (1 as u8) << ((self.ilog2() / 2) + 1)
		while true {
			y := (x + self / x) / 2
			if y >= x {
				return x
			}
			x = y
		}
		return x
	}

	// The decimal text of the number.
	pub fun to_string(self) string {
		return "{self}"
	}

	// Parses decimal text, like `strconv::parse_int`.
	pub fun parse(s &str) result<u8, std::strconv::ParseError> {
		return u8::from_str_radix(s, 10)
	}

	// Parses text in base `radix` (2 to 36), with an optional sign
	// (and `_` separators between digits).
	pub fun from_str_radix(s &str, radix u32) result<u8, std::strconv::ParseError> {
		v := std::strconv::parse_digits(s, radix, false, 8)?
		return Ok(v as u8)
	}
}

impl u16 {
	// The smallest value.
	pub const MIN u16 = 0
	// The largest value.
	pub const MAX u16 = 65535
	// The size in bits.
	pub const BITS u32 = 16

	// Arithmetic that wraps around at the ends of the range instead of
	// panicking on overflow.
	pub fun wrapping_add(self, b u16) u16
	pub fun wrapping_sub(self, b u16) u16
	pub fun wrapping_mul(self, b u16) u16
	pub fun wrapping_neg(self) u16
	// Shifts by `n % BITS`.
	pub fun wrapping_shl(self, n u32) u16
	pub fun wrapping_shr(self, n u32) u16

	// The wrapped result and whether it overflowed.
	pub fun overflowing_add(self, b u16) (u16, bool)
	pub fun overflowing_sub(self, b u16) (u16, bool)
	pub fun overflowing_mul(self, b u16) (u16, bool)

	// Bit operations.
	pub fun count_ones(self) u32
	pub fun leading_zeros(self) u32
	pub fun trailing_zeros(self) u32
	pub fun rotate_left(self, n u32) u16
	pub fun rotate_right(self, n u32) u16
	pub fun swap_bytes(self) u16
	pub fun reverse_bits(self) u16

	pub fun count_zeros(self) u32 {
		return 16 - self.count_ones()
	}

	// `None` on overflow.
	pub fun checked_add(self, b u16) option<u16> {
		(r, o) := self.overflowing_add(b)
		if o {
			return None
		}
		return Some(r)
	}

	// `None` on overflow.
	pub fun checked_sub(self, b u16) option<u16> {
		(r, o) := self.overflowing_sub(b)
		if o {
			return None
		}
		return Some(r)
	}

	// `None` on overflow.
	pub fun checked_mul(self, b u16) option<u16> {
		(r, o) := self.overflowing_mul(b)
		if o {
			return None
		}
		return Some(r)
