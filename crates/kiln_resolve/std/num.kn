	}

	// `self` limited to `lo..=hi`.
	pub fn clamp(self, lo: i32, hi: i32) -> i32 {
		if self < lo {
			return lo
		}
		if self > hi {
			return hi
		}
		return self
	}

	// The distance between `self` and `b`, which never overflows.
	pub fn abs_diff(self, b: i32) -> u32 {
		if self < b {
			return (b as u32).wrapping_sub(self as u32)
		}
		return (self as u32).wrapping_sub(b as u32)
	}

	// The absolute value. Panics for MIN in debug builds.
	pub fn abs(self) -> i32 {
		if self < 0 {
			return -self
		}
		return self
	}

	// The absolute value as an unsigned number (never overflows).
	pub fn unsigned_abs(self) -> u32 {
		if self < 0 {
			return (0 as u32).wrapping_sub(self as u32)
		}
		return self as u32
	}

	// -1, 0, or 1.
	pub fn signum(self) -> i32 {
		if self < 0 {
			return -1
		}
		if self > 0 {
			return 1
		}
		return 0
	}

	pub fn is_negative(self) -> bool {
		return self < 0
	}

	pub fn is_positive(self) -> bool {
		return self > 0
	}

	// Euclidean division: the quotient for which the remainder is never
	// negative (`-7.div_euclid(2)` is -4).
	pub fn div_euclid(self, b: i32) -> i32 {
		q := self / b
		if self % b < 0 {
			if b > 0 {
				return q - 1
			}
			return q + 1
		}
		return q
	}

	// The remainder of Euclidean division, in `0..b.abs()`.
	pub fn rem_euclid(self, b: i32) -> i32 {
		r := self % b
		if r < 0 {
			return r + b.abs()
		}
		return r
	}

	// The base-2 logarithm, rounded down. Panics if `self <= 0`.
	pub fn ilog2(self) -> u32 {
		if self <= 0 {
			panic("ilog2 of a non-positive number")
		}
		return 31 - self.leading_zeros()
	}

	// The base-10 logarithm, rounded down. Panics if `self <= 0`.
	pub fn ilog10(self) -> u32 {
		if self <= 0 {
			panic("ilog10 of a non-positive number")
		}
		n mut := 0
		v mut := self
		while v >= 10 {
			v /= 10
			n += 1
		}
		return n
	}

	// The integer square root, rounded down. Panics if negative.
	pub fn isqrt(self) -> i32 {
		if self < 0 {
			panic("isqrt of a negative number")
		}
		if self < 2 {
			return self
		}
		// Newton's method from an overestimate.
		x mut := (1 as i32) << ((self.ilog2() / 2) + 1)
		while true {
			y := (x + self / x) / 2
			if y >= x {
				return x
			}
			x = y
		}
		return x
	}

	// The decimal text of the number.
	pub fn to_string(self) -> String {
		return "{self}"
	}

	// Parses decimal text, like `strconv::parse_int`.
	pub fn parse(s: &str) -> Result<i32, std::strconv::ParseError> {
		return i32::from_str_radix(s, 10)
	}

	// Parses text in base `radix` (2 to 36), with an optional sign
	// (and `_` separators between digits).
	pub fn from_str_radix(s: &str, radix: u32) -> Result<i32, std::strconv::ParseError> {
		v := std::strconv::parse_digits(s, radix, true, 32)?
		return Ok(v as i32)
	}
}

impl i64 {
	// The smallest value: -2^63.
	pub const MIN: i64 = -9223372036854775807 - 1
	// The largest value.
	pub const MAX: i64 = 9223372036854775807
	// The size in bits.
	pub const BITS: u32 = 64

	// Arithmetic that wraps around at the ends of the range instead of
	// panicking on overflow.
	pub fn wrapping_add(self, b: i64) -> i64
	pub fn wrapping_sub(self, b: i64) -> i64
	pub fn wrapping_mul(self, b: i64) -> i64
	pub fn wrapping_neg(self) -> i64
	// Shifts by `n % BITS`.
	pub fn wrapping_shl(self, n: u32) -> i64
	pub fn wrapping_shr(self, n: u32) -> i64

	// The wrapped result and whether it overflowed.
	pub fn overflowing_add(self, b: i64) -> (i64, bool)
	pub fn overflowing_sub(self, b: i64) -> (i64, bool)
	pub fn overflowing_mul(self, b: i64) -> (i64, bool)

	// Bit operations.
	pub fn count_ones(self) -> u32
	pub fn leading_zeros(self) -> u32
	pub fn trailing_zeros(self) -> u32
	pub fn rotate_left(self, n: u32) -> i64
	pub fn rotate_right(self, n: u32) -> i64
	pub fn swap_bytes(self) -> i64
	pub fn reverse_bits(self) -> i64

	pub fn count_zeros(self) -> u32 {
		return 64 - self.count_ones()
	}

	// `None` on overflow.
	pub fn checked_add(self, b: i64) -> Option<i64> {
		(r, o) := self.overflowing_add(b)
		if o {
			return None
		}
		return Some(r)
	}

	// `None` on overflow.
	pub fn checked_sub(self, b: i64) -> Option<i64> {
		(r, o) := self.overflowing_sub(b)
		if o {
			return None
		}
		return Some(r)
	}

	// `None` on overflow.
	pub fn checked_mul(self, b: i64) -> Option<i64> {
		(r, o) := self.overflowing_mul(b)
		if o {
			return None
		}
		return Some(r)
	}

	// `None` if `b` is zero or the result overflows.
	pub fn checked_div(self, b: i64) -> Option<i64> {
		if b == 0 || (self == i64::MIN && b == -1) {
			return None
		}
		return Some(self / b)
	}

	// `None` if `b` is zero or the result overflows.
	pub fn checked_rem(self, b: i64) -> Option<i64> {
		if b == 0 || (self == i64::MIN && b == -1) {
			return None
		}
		return Some(self % b)
	}

	pub fn checked_neg(self) -> Option<i64> {
		if self == i64::MIN {
			return None
		}
		return Some(-self)
	}

	// Arithmetic that stops at MIN or MAX instead of overflowing.
	pub fn saturating_add(self, b: i64) -> i64 {
		(r, o) := self.overflowing_add(b)
		if !o {
			return r
		}
		if b < 0 {
			return i64::MIN
		}
		return i64::MAX
	}

	pub fn saturating_sub(self, b: i64) -> i64 {
		(r, o) := self.overflowing_sub(b)
		if !o {
			return r
		}
		if b < 0 {
			return i64::MAX
		}
		return i64::MIN
	}

	pub fn saturating_mul(self, b: i64) -> i64 {
		(r, o) := self.overflowing_mul(b)
		if !o {
			return r
		}
		if (self < 0) != (b < 0) {
			return i64::MIN
		}
		return i64::MAX
	}

	// `self` to the power `exp`. Panics on overflow (see `checked_pow`).
	pub fn pow(self, exp: u32) -> i64 {
		match self.checked_pow(exp) {
			Some(r) => return r,
			None => panic("attempt to raise to a power with overflow"),
		}
	}

	pub fn checked_pow(self, exp: u32) -> Option<i64> {
		let mut r: i64 = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.checked_mul(base)?
			}
			e >>= 1
			if e > 0 {
				base = base.checked_mul(base)?
			}
		}
		return Some(r)
	}

	pub fn wrapping_pow(self, exp: u32) -> i64 {
		let mut r: i64 = 1
		base mut := self
		e mut := exp
		while e > 0 {
			if e & 1 == 1 {
				r = r.wrapping_mul(base)
			}
			e >>= 1
			base = base.wrapping_mul(base)
		}
		return r
	}

	pub fn saturating_pow(self, exp: u32) -> i64 {
		match self.checked_pow(exp) {
			Some(r) => return r,
			None => {
				if self < 0 && exp % 2 == 1 {
					return i64::MIN
				}
				return i64::MAX
			}
		}
	}

	pub fn min(self, b: i64) -> i64 {
		if b < self {
			return b
		}
		return self
	}

	pub fn max(self, b: i64) -> i64 {
		if b > self {
			return b
		}
		return self
	}

	// `self` limited to `lo..=hi`.
	pub fn clamp(self, lo: i64, hi: i64) -> i64 {
		if self < lo {
			return lo
		}
		if self > hi {
			return hi
		}
		return self
	}

	// The distance between `self` and `b`, which never overflows.
	pub fn abs_diff(self, b: i64) -> u64 {
		if self < b {
			return (b as u64).wrapping_sub(self as u64)
		}
		return (self as u64).wrapping_sub(b as u64)
	}

	// The absolute value. Panics for MIN in debug builds.
	pub fn abs(self) -> i64 {
		if self < 0 {
			return -self
		}
		return self
	}

	// The absolute value as an unsigned number (never overflows).
	pub fn unsigned_abs(self) -> u64 {
		if self < 0 {
			return (0 as u64).wrapping_sub(self as u64)
		}
		return self as u64
	}

	// -1, 0, or 1.
	pub fn signum(self) -> i64 {
		if self < 0 {
			return -1
		}
		if self > 0 {
			return 1
		}
		return 0
	}

	pub fn is_negative(self) -> bool {
		return self < 0
	}

	pub fn is_positive(self) -> bool {
		return self > 0
	}

	// Euclidean division: the quotient for which the remainder is never
	// negative (`-7.div_euclid(2)` is -4).
	pub fn div_euclid(self, b: i64) -> i64 {
		q := self / b
		if self % b < 0 {
			if b > 0 {
				return q - 1
			}
			return q + 1
		}
		return q
	}

	// The remainder of Euclidean division, in `0..b.abs()`.
	pub fn rem_euclid(self, b: i64) -> i64 {
		r := self % b
		if r < 0 {
			return r + b.abs()
		}
		return r
	}

	// The base-2 logarithm, rounded down. Panics if `self <= 0`.
	pub fn ilog2(self) -> u32 {
		if self <= 0 {
			panic("ilog2 of a non-positive number")
		}
		return 63 - self.leading_zeros()
	}

	// The base-10 logarithm, rounded down. Panics if `self <= 0`.
	pub fn ilog10(self) -> u32 {
		if self <= 0 {
			panic("ilog10 of a non-positive number")
		}
		n mut := 0
		v mut := self
		while v >= 10 {
			v /= 10
			n += 1
		}
		return n
	}

	// The integer square root, rounded down. Panics if negative.
	pub fn isqrt(self) -> i64 {
		if self < 0 {
			panic("isqrt of a negative number")
		}
		if self < 2 {
			return self
		}
		// Newton's method from an overestimate.
		x mut := (1 as i64) << ((self.ilog2() / 2) + 1)
		while true {
			y := (x + self / x) / 2
			if y >= x {
				return x
			}
			x = y
		}
		return x
	}

	// The decimal text of the number.
	pub fn to_string(self) -> String {
		return "{self}"
	}

	// Parses decimal text, like `strconv::parse_int`.
	pub fn parse(s: &str) -> Result<i64, std::strconv::ParseError> {
		return i64::from_str_radix(s, 10)
	}

	// Parses text in base `radix` (2 to 36), with an optional sign
	// (and `_` separators between digits).
	pub fn from_str_radix(s: &str, radix: u32) -> Result<i64, std::strconv::ParseError> {
		v := std::strconv::parse_digits(s, radix, true, 64)?
		return Ok(v as i64)
	}
}

