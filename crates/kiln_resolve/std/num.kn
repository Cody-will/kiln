		if self < b {
			return (b as u16).wrapping_sub(self as u16)
		}
		return (self as u16).wrapping_sub(b as u16)
	}

	pub fun div_euclid(self, b u16) u16 {
		return self / b
	}

	pub fun rem_euclid(self, b u16) u16 {
		return self % b
	}

	// Whether the value is a power of two (0 is not).
