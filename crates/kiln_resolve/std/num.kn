	// `None` if `b` is zero.
	pub fun checked_div(self, b u16) option<u16> {
		if b == 0 {
			return None
		}
		return Some(self / b)
	}

	// `None` if `b` is zero.
	pub fun checked_rem(self, b u16) option<u16> {
		if b == 0 {
			return None
		}
		return Some(self % b)
	}

	pub fun checked_neg(self) option<u16> {
		if self != 0 {
			return None
		}
		return Some(0)
	}

	// Arithmetic that stops at MIN or MAX instead of overflowing.
	pub fun saturating_add(self, b u16) u16 {
		(r, o) := self.overflowing_add(b)
		if !o {
			return r
		}
		return u16::MAX
	}

	pub fun saturating_sub(self, b u16) u16 {
		(r, o) := self.overflowing_sub(b)
		if !o {
			return r
		}
		return u16::MIN
	}

	pub fun saturating_mul(self, b u16) u16 {
		(r, o) := self.overflowing_mul(b)
		if !o {
			return r
		}
		return u16::MAX
