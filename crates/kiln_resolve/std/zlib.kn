// The zlib format (RFC 1950): a 2-byte header, raw DEFLATE, and an
// Adler-32 trailer. HTTP's `Content-Encoding: deflate` uses it.
//
//	z := zlib::compress(data, compress::DEFAULT)
//	plain := zlib::decompress(&z)?

import std::io
import std::io::{Read, Write}
import super::{adler32, adler32_update, error, flate, Error}

// Compresses `data` into a zlib stream.
pub fun compress(data &[u8], level u32) Vec<u8> {
	cmf := 120u32
	lv := if level == 0 || level == 1 {
		0u32
	} else if level < 6 {
		1u32
	} else if level == 6 {
		2u32
	} else {
		3u32
	}
	flg0 := lv << 6
	flg := flg0 + (31 - ((cmf * 256 + flg0) % 31)) % 31
	out mut := Vec::new()
	out.push(cmf as u8)
	out.push(flg as u8)
	out.extend_from_slice(&flate::compress(data, level))
	a := adler32(data)
	out.push((a >> 24) as u8)
	out.push(((a >> 16) & 255) as u8)
	out.push(((a >> 8) & 255) as u8)
	out.push((a & 255) as u8)
	return out
}

// Decompresses a zlib stream, checking the header and Adler-32.
pub fun decompress(data &[u8]) result<Vec<u8>, Error> {
	return decompress_limit(data, 0)
}

// Like `decompress`, failing once the output would exceed `max` bytes
// (0 = no limit).
pub fun decompress_limit(data &[u8], max usize) result<Vec<u8>, Error> {
	if data.len() < 6 {
		return Err(error("zlib: stream too short"))
	}
	cmf := data[0] as u32
	flg := data[1] as u32
	if cmf & 15 != 8 || (cmf >> 4) > 7 {
		return Err(error("zlib: unsupported compression method"))
	}
	if (cmf * 256 + flg) % 31 != 0 {
		return Err(error("zlib: header checksum mismatch"))
	}
	if flg & 32 != 0 {
		return Err(error("zlib: preset dictionaries are not supported"))
	}
	(out, used) := flate::inflate(&data[2..], max)?
	t := 2 + used
	if t + 4 > data.len() {
		return Err(error("zlib: missing Adler-32 trailer"))
	}
	want := ((data[t] as u32) << 24) | ((data[t + 1] as u32) << 16) | ((data[t + 2] as u32) << 8) | (data[t + 3] as u32)
	if adler32(&out) != want {
		return Err(error("zlib: Adler-32 mismatch"))
	}
	return Ok(out)
}

// Compresses what is written into a zlib stream on the inner writer,
// 64 KiB at a time (memory stays bounded). `flush` pushes out everything
// written so far (a sync flush); `finish` ends the stream.
pub struct Writer<W: Write> {
	inner W,
	buf Vec<u8>,
	level u32,
	started bool,
	adler u32,
}

const CHUNK usize = 65536

impl<W: Write> Writer<W> {
	pub fun new(inner W, level u32) Writer<W> {
		return Writer { inner: inner, buf: Vec::new(), level: level, started: false, adler: 1 }
	}

	fun emit(&mut self, last bool) result<void, io::Error> {
		if !self.started {
			z := compress(&self.buf[0..0], self.level)
			self.inner.write_all(&z[0..2])?
			self.started = true
		}
		self.adler = adler32_update(self.adler, &self.buf)
		self.inner.write_all(&flate::compress_chunk(&self.buf, self.level, last))?
		self.buf.clear()
		return Ok(())
	}

	// Compresses and writes the rest and the trailer; returns the inner writer.
	pub fun finish(self) result<W, io::Error> {
		me mut := self
		me.emit(true)?
		a := me.adler
		t := [(a >> 24) as u8, ((a >> 16) & 255) as u8, ((a >> 8) & 255) as u8, (a & 255) as u8]
		me.inner.write_all(&t)?
		me.inner.flush()?
		return Ok(me.inner)
	}
}

impl<W: Write> Write for Writer<W> {
	fun write(&mut self, b &[u8]) result<usize, io::Error> {
		self.buf.extend_from_slice(b)
		if self.buf.len() >= CHUNK {
			self.emit(false)?
		}
		return Ok(b.len())
	}

	fun flush(&mut self) result<void, io::Error> {
		if self.buf.len() > 0 {
			self.emit(false)?
		}
		return self.inner.flush()
	}
}
