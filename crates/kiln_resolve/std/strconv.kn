// Converting numbers and booleans to and from text.
//
//	n := strconv::parse_int("-42")?          // i64
//	b := u8::from_str_radix("ff", 16)?       // 255
//	x := strconv::parse_float("2.5e3")?      // 2500.0
//	s := strconv::format_int(255, 16)        // "ff"
//
// Every integer type also has `T::parse(s)` and `T::from_str_radix(s, radix)`.
// Parsing accepts an optional `+` (or `-` for signed types) and `_` between
// digits; it rejects surrounding spaces (trim first).

fun kn_parse_f64(p *const u8, n usize, out *mut f64) i32

// Why parsing failed.
@derive(Clone, Copy, Eq, Debug)
pub enum ParseErrorKind {
	// The input was empty (or only a sign).
	Empty,
	// A character is not a digit of the radix, or the syntax is wrong.
	InvalidDigit,
	// The number is too large for the type.
	PosOverflow,
	// The number is too small (too negative) for the type.
	NegOverflow,
}

// A failed number or boolean parse.
@derive(Clone, Debug)
pub struct ParseError {
	kind ParseErrorKind,
	what &'static str,
}

impl ParseError {
	pub fun kind(&self) ParseErrorKind {
		return self.kind
	}
}

impl Display for ParseError {
	fun to_string(&self) string {
		return match self.kind {
			ParseErrorKind::Empty => "cannot parse {self.what} from empty string",
			ParseErrorKind::InvalidDigit => "invalid {self.what} literal",
			ParseErrorKind::PosOverflow => "number too large to fit in target type".to_string(),
			ParseErrorKind::NegOverflow => "number too small to fit in target type".to_string(),
		}
	}
}

impl Error for ParseError {}

fun err<T>(kind ParseErrorKind, what &'static str) result<T, ParseError> {
	return Err(ParseError { kind: kind, what: what })
}

fun digit_value(b u8) u32 {
	if b >= 48 && b <= 57 {
		return (b - 48) as u32
	}
	if b >= 97 && b <= 122 {
		return (b - 87) as u32
	}
	if b >= 65 && b <= 90 {
		return (b - 55) as u32
	}
	return 99
}

// Parses an integer of `bits` bits (signed or not) in base `radix`; returns
// its two's-complement bits, which the caller casts to the target type.
// (Used by `T::from_str_radix`.)
pub fun parse_digits(s &str, radix u32, signed bool, bits u32) result<u64, ParseError> {
	if radix < 2 || radix > 36 {
		panic("from_str_radix: radix must be in 2..=36, got {radix}")
	}
	b := s.as_bytes()
	i mut := 0
	neg mut := false
	if b.len() > 0 && (b[0] == 43 || b[0] == 45) {
		neg = b[0] == 45
		i = 1
		if neg && !signed {
			if b.len() == 1 {
				return err(ParseErrorKind::InvalidDigit, "integer")
			}
			// "-0" is fine for unsigned types; anything else is too small.
			all_zero mut := true
			for j in 1..b.len() {
				if b[j] != 48 && b[j] != 95 {
					all_zero = false
				}
			}
			if all_zero {
				return Ok(0)
			}
			return err(ParseErrorKind::NegOverflow, "integer")
		}
	}
	if i == b.len() {
		if i == 0 {
			return err(ParseErrorKind::Empty, "integer")
		}
		return err(ParseErrorKind::InvalidDigit, "integer")
	}
	// The largest magnitude allowed.
	let limit u64 = if signed {
		if neg {
			(1 as u64) << (bits - 1)
		} else {
			((1 as u64) << (bits - 1)) - 1
		}
	} else if bits == 64 {
		u64::MAX
	} else {
		((1 as u64) << bits) - 1
	}
	let mut v u64 = 0
	prev_digit mut := false
	while i < b.len() {
		c := b[i]
		i += 1
		if c == 95 {
			// `_` only between digits.
			if !prev_digit || i == b.len() {
				return err(ParseErrorKind::InvalidDigit, "integer")
			}
			prev_digit = false
			continue
		}
		d := digit_value(c)
		if d >= radix {
			return err(ParseErrorKind::InvalidDigit, "integer")
		}
		prev_digit = true
		over := match v.checked_mul(radix as u64) {
			Some(m) => match m.checked_add(d as u64) {
				Some(n) => {
					v = n
					n > limit
				}
				None => true,
			},
			None => true,
		}
		if over {
			// Keep scanning so bad digits are reported first.
			while i < b.len() {
				if b[i] != 95 && digit_value(b[i]) >= radix {
					return err(ParseErrorKind::InvalidDigit, "integer")
				}
				i += 1
			}
			if neg {
				return err(ParseErrorKind::NegOverflow, "integer")
			}
			return err(ParseErrorKind::PosOverflow, "integer")
		}
	}
	if neg {
		return Ok((0 as u64).wrapping_sub(v))
	}
	return Ok(v)
}

// `parse_digits` for 128-bit types: parses an integer of `bits` bits (signed or not) in base `radix`; returns
// its two's-complement bits, which the caller casts to the target type.
// (Used by `T::from_str_radix`.)
pub fun parse_digits128(s &str, radix u32, signed bool, bits u32) result<u128, ParseError> {
	if radix < 2 || radix > 36 {
		panic("from_str_radix: radix must be in 2..=36, got {radix}")
	}
	b := s.as_bytes()
	i mut := 0
	neg mut := false
	if b.len() > 0 && (b[0] == 43 || b[0] == 45) {
		neg = b[0] == 45
		i = 1
		if neg && !signed {
			if b.len() == 1 {
				return err(ParseErrorKind::InvalidDigit, "integer")
			}
			// "-0" is fine for unsigned types; anything else is too small.
			all_zero mut := true
			for j in 1..b.len() {
				if b[j] != 48 && b[j] != 95 {
					all_zero = false
				}
			}
			if all_zero {
				return Ok(0)
			}
			return err(ParseErrorKind::NegOverflow, "integer")
		}
	}
	if i == b.len() {
		if i == 0 {
			return err(ParseErrorKind::Empty, "integer")
		}
		return err(ParseErrorKind::InvalidDigit, "integer")
	}
	// The largest magnitude allowed.
	let limit u128 = if signed {
		if neg {
			(1 as u128) << (bits - 1)
		} else {
			((1 as u128) << (bits - 1)) - 1
		}
	} else if bits == 128 {
		u128::MAX
	} else {
		((1 as u128) << bits) - 1
	}
	let mut v u128 = 0
	prev_digit mut := false
	while i < b.len() {
		c := b[i]
		i += 1
		if c == 95 {
			// `_` only between digits.
			if !prev_digit || i == b.len() {
				return err(ParseErrorKind::InvalidDigit, "integer")
			}
			prev_digit = false
			continue
		}
		d := digit_value(c)
		if d >= radix {
			return err(ParseErrorKind::InvalidDigit, "integer")
		}
		prev_digit = true
		over := match v.checked_mul(radix as u128) {
			Some(m) => match m.checked_add(d as u128) {
				Some(n) => {
					v = n
					n > limit
				}
				None => true,
			},
			None => true,
		}
		if over {
			// Keep scanning so bad digits are reported first.
			while i < b.len() {
				if b[i] != 95 && digit_value(b[i]) >= radix {
					return err(ParseErrorKind::InvalidDigit, "integer")
				}
				i += 1
			}
			if neg {
				return err(ParseErrorKind::NegOverflow, "integer")
			}
			return err(ParseErrorKind::PosOverflow, "integer")
		}
	}
	if neg {
		return Ok((0 as u128).wrapping_sub(v))
	}
	return Ok(v)
}

// Parses a decimal `i64`.
pub fun parse_int(s &str) result<i64, ParseError> {
	return i64::parse(s)
}

// Parses a decimal `u64`.
pub fun parse_uint(s &str) result<u64, ParseError> {
	return u64::parse(s)
}

// Parses a floating-point number: `3`, `-2.5`, `.5`, `1e-9`, `inf`, `NaN`.
// The result is the closest `f64` to the decimal value.
pub fun parse_float(s &str) result<f64, ParseError> {
	if s.len() == 0 {
		return err(ParseErrorKind::Empty, "float")
	}
	let mut out f64 = 0.0
	ok := kn_parse_f64(std::ptr::str_ptr(s) as *const u8, s.len(), &mut out as *mut f64)
	if ok == 0 {
		return err(ParseErrorKind::InvalidDigit, "float")
	}
	return Ok(out)
}

// Parses `true` or `false`.
pub fun parse_bool(s &str) result<bool, ParseError> {
	if s == "true" {
		return Ok(true)
	}
	if s == "false" {
		return Ok(false)
	}
	if s.len() == 0 {
		return err(ParseErrorKind::Empty, "bool")
	}
	return err(ParseErrorKind::InvalidDigit, "bool")
}

// The text of `v` in base `radix` (2 to 36), with lowercase letters.
pub fun format_int(v i64, radix u32) string {
	if v < 0 {
		s mut := "-".to_string()
		s.push(&format_uint(v.unsigned_abs(), radix))
		return s
	}
	return format_uint(v as u64, radix)
}

// The text of `v` in base `radix` (2 to 36), with lowercase letters.
pub fun format_uint(v u64, radix u32) string {
	if radix < 2 || radix > 36 {
		panic("format_uint: radix must be in 2..=36, got {radix}")
	}
	if v == 0 {
		return "0".to_string()
	}
	let mut buf Vec<u8> = Vec::with_capacity(64)
	n mut := v
	while n > 0 {
		d := (n % radix as u64) as u8
		buf.push(if d < 10 {
			48 + d
		} else {
			87 + d
		})
		n /= radix as u64
	}
	buf.reverse()
	return unsafe { string::from_utf8_unchecked(buf) }
}

// The shortest text that parses back to exactly `v`.
pub fun format_float(v f64) string {
	return "{v}"
}

// `s` as a double-quoted string literal, with `"`, `\`, and control
// characters escaped: `quote("a\"b\n")` is `"a\"b\n"` (with the escapes).
pub fun quote(s &str) string {
	out mut := string::with_capacity(s.len() + 2)
	out.push_char('"')
	for c in s.chars() {
		match c {
			'"' => out.push("\\\""),
			'\\' => out.push("\\\\"),
			'\n' => out.push("\\n"),
			'\r' => out.push("\\r"),
			'\t' => out.push("\\t"),
			_ => {
				if c.is_control() {
					out.push("\\u{{")
					out.push(&format_uint(c as u64, 16))
					out.push_char('}')
				} else {
					out.push_char(c)
				}
			},
		}
	}
	out.push_char('"')
	return out
}

// Appends `v` in decimal to `out` (like `out.push("{v}")`, without a
// temporary string).
pub fun append_int(out &mut string, v i64)

// Appends `v` in decimal to `out`.
pub fun append_uint(out &mut string, v u64)

// Appends `v` to `out` in its shortest round-trip form, keeping `.0` on
// whole numbers (like `out.push("{v:?}")`).
pub fun append_float(out &mut string, v f64)
