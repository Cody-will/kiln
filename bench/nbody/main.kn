// n-body (Computer Language Benchmarks Game), 5 bodies.
import std::math

@derive(Copy, Clone)
struct Body {
	x f64,
	y f64,
	z f64,
	vx f64,
	vy f64,
	vz f64,
	m f64,
}

fun energy(b &Vec<Body>) f64 {
	e mut := 0.0
	for i in 0..b.len() {
		e += 0.5 * b[i].m * (b[i].vx * b[i].vx + b[i].vy * b[i].vy + b[i].vz * b[i].vz)
		for j in i + 1..b.len() {
			dx := b[i].x - b[j].x
			dy := b[i].y - b[j].y
			dz := b[i].z - b[j].z
			e -= b[i].m * b[j].m / math::sqrt(dx * dx + dy * dy + dz * dz)
		}
	}
	return e
}

fun advance(b &mut Vec<Body>, dt f64) {
	n := b.len()
	for i in 0..n {
		for j in i + 1..n {
			dx := b[i].x - b[j].x
			dy := b[i].y - b[j].y
			dz := b[i].z - b[j].z
			d2 := dx * dx + dy * dy + dz * dz
			mag := dt / (d2 * math::sqrt(d2))
			mj := b[j].m
			mi := b[i].m
			b[i].vx -= dx * mj * mag
			b[i].vy -= dy * mj * mag
			b[i].vz -= dz * mj * mag
			b[j].vx += dx * mi * mag
			b[j].vy += dy * mi * mag
			b[j].vz += dz * mi * mag
		}
	}
	for i in 0..n {
		b[i].x += dt * b[i].vx
		b[i].y += dt * b[i].vy
		b[i].z += dt * b[i].vz
	}
}

fun main() {
	pi := 3.141592653589793
	sm := 4.0 * pi * pi
	dp := 365.24
	b mut := Vec::new()
	b.push(Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, m: sm })
	b.push(Body { x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01, vx: 1.66007664274403694e-03 * dp, vy: 7.69901118419740425e-03 * dp, vz: -6.90460016972063023e-05 * dp, m: 9.54791938424326609e-04 * sm })
	b.push(Body { x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01, vx: -2.76742510726862411e-03 * dp, vy: 4.99852801234917238e-03 * dp, vz: 2.30417297573763929e-05 * dp, m: 2.85885980666130812e-04 * sm })
	b.push(Body { x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01, vx: 2.96460137564761618e-03 * dp, vy: 2.37847173959480950e-03 * dp, vz: -2.96589568540237556e-05 * dp, m: 4.36624404335156298e-05 * sm })
	b.push(Body { x: 1.53796971148509165e+01, y: -2.59193146099879641e+01, z: 1.79258772950371181e-01, vx: 2.68067772490389322e-03 * dp, vy: 1.62824170038242295e-03 * dp, vz: -9.51592254519715870e-05 * dp, m: 5.15138902046611451e-05 * sm })
	px mut := 0.0
	py mut := 0.0
	pz mut := 0.0
	for i in 0..b.len() {
		px += b[i].vx * b[i].m
		py += b[i].vy * b[i].m
		pz += b[i].vz * b[i].m
	}
	b[0].vx = -px / sm
	b[0].vy = -py / sm
	b[0].vz = -pz / sm
	println("{energy(&b):.9}")
	for _ in 0..5000000 {
		advance(&mut b, 0.01)
	}
	println("{energy(&b):.9}")
}
