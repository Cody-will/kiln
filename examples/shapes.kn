import std::fmt::{self, Display}

/// A point in 2D space.
@derive(Debug, Clone, Copy)
pub struct Point {
	pub x f64,
	pub y f64,
}

impl Point {
	pub fun new(x f64, y f64) Point {
		return Point { x, y }
	}

	pub fun len(&self) f64 {
		return (self.x * self.x + self.y * self.y).sqrt()
	}

	pub fun scale(&mut self, k f64) {
		self.x *= k
		self.y *= k
	}
}

enum Shape {
	Circle(f64),
	Rect { w f64, h f64 },
	Empty,
}

trait Describe {
	fun describe(&self) string

	fun shout(&self) string {
		return self.describe().to_upper()
	}
}

impl Describe for Point {
	fun describe(&self) string {
		return "({self.x}, {self.y})"
	}
}

fun area(s &Shape) f64 {
	return match s {
		Shape::Circle(r) => 3.14159 * r * r,
		Shape::Rect { w, h } => w * h,
		Shape::Empty => 0.0,
	}
}

fun largest<T>(xs &[T]) option<&T> where T: Ord {
	best mut := None
	for x in xs {
		if best.is_none() || x > best.unwrap() {
			best = Some(x)
		}
	}
	return best
}

fun longest<'a>(a &'a str, b &'a str) &'a str {
	if a.len() > b.len() {
		return a
	}
	return b
}

fun sign(n i32) &'static str {
	label := if n < 0 { "neg" } else if n == 0 { "zero" } else { "pos" }
	return label
}

fun main() {
	p mut := Point::new(3.0, 4.0)
	p.scale(2.0)
	shapes := [Shape::Circle(1.0), Shape::Rect { w: 2.0, h: 3.0 }]
	total mut := 0.0
	for s in &shapes {
		total += area(s)
	}
	(a, b mut) := (1, 2)
	b += a
	let limit u64 = 10
	for i in 0..limit {
		println("{i}: {p.describe()} {sign(i as i32)}")
	}
}
