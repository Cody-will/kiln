import std::time

struct Job {
	id: u64,
	payload: String,
}

struct Output {
	worker: u32,
	job: u64,
	bytes: usize,
}

fn process(worker: u32, job: Job) -> Output {
	return Output { worker: worker, job: job.id, bytes: job.payload.len() }
}

fn load_jobs() -> Vec<Job> {
	jobs mut := Vec::new()
	for i in 0..10 {
		jobs.push(Job { id: i, payload: "job {i}" })
	}
	return jobs
}

fn worker(id: u32, jobs: <-chan Job, results: chan<- Output) {
	for job in jobs {
		results <- process(id, job)
	}
}

fn main() {
	(jobs_tx, jobs_rx) := chan::<Job>(100)
	(res_tx, res_rx) := chan::<Output>(100)
	for id in 0..4 {
		go worker(id, jobs_rx.clone(), res_tx.clone())
	}
	for j in load_jobs() {
		jobs_tx <- j
	}
	drop(jobs_tx)

	timeout := time::after(time::secs(5))
	done mut := 0
	while done < 10 {
		select {
			r := <-res_rx => {
				println("worker {r.worker} finished job {r.job} ({r.bytes} bytes)")
				done += 1
			},
			<-timeout => {
				eprintln("timed out")
				break
			},
		}
	}
}
