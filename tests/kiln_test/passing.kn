// Fixture for `kiln test` (crates/kiln_cli/tests/cli.rs): every test passes.
import std::strconv

fun add(a i64, b i64) i64 {
	return a + b
}

fun main() {
	println("main is replaced by the test harness")
}

@test
fun adds() {
	assert_eq(add(2, 2), 4)
	assert_ne(add(2, 2), 5)
}

@test
fun returns_ok() result<void, strconv::ParseError> {
	n := i64::parse("42")?
	assert_eq(n, 42)
	return Ok()
}

@test
@should_panic(expected = "divide by zero")
fun divides_by_zero() {
	z := 0
	println("{10 / z}")
}

@test
@ignore
fun slow() {
	panic("ignored tests do not run")
}

mod inner {
	@test
	fun nested() {
		assert("a" < "b")
	}
}
