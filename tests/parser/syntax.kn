static mut S [u8; 4] = [0; 4]
type F<T> = fun mut(T, &&T) option<T>
type G = (i32,)
type H = (i32)
type V = void
type P = *const *mut u8
type Ch = (chan<- i32, <-chan i32, Vec<<-chan i32>, !, _, impl Fn + Send)
mod inner {
	pub fun x() {}
}
mod outer

extern "C" {
	fun puts(s *const u8) i32
}

