// Parser corpus: every syntactic form, for the self-hosted parser diff test
// (crates/kiln_cli/tests/parser_diff.rs). It is parsed, never compiled.

/// Doc comment
/// on two lines.
@derive(Debug, Clone)
@test
pub struct Point<T: Ord + ?Sized, 'a: 'b, const N usize, U = i32> where T: Clone, 'a: 'b {
	pub x T,
	pub(pkg) y &'a mut [T; N],
}

struct Unit
struct Pair(pub i32, string) where i32: Copy

enum Shape<T> {
	Dot,
	Circle(f64),
	Rect { w f64, h f64 },
	Num = 3,
}

unsafe trait Tr<T>: Send + 'static {
	type Item
	const N usize
	fun f(&self) Self::Item
	fun g(&'a mut self, x i32)
	fun h(mut self)
}

unsafe impl<T> Tr<T> for Point<T> where T: Clone,
{
	type Item = T
	fun spawn(&self) {}
}

impl dyn Tr<i32, Item = u8> {}

