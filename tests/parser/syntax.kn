	w := x as u8 as i64 + 1
	r := (.., a.., ..b, a..b, a..=b, ..=b)
	t := t.0.1 + t.2 + v[i][j] + s.field + s.method::<i32>(1, 2) + f()? + Ok()
	g := Vec::<i32>::new() + chan::<Job>(4) + Self::X + self.y
	lit := (1u8, 0x_ff, 1_000i64, 1.5e3, 2.0f32, 'a', '\n', "s", r"raw\n", r#"x"#, b"by\x00", b'c', true, false, 340282366920938463463374607431768211455u128)
	s := "a {x} b {y:>8.2} {z:?} {w:#x} {q:_^+#010.3e} {{lit}}"
	arr := [1, 2, 3,]
	e := []
