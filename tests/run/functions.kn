fun add(a i32, b i32) i32 {
	return a + b
}

fun fib(n u64) u64 {
	if n < 2 {
		return n
	}
	return fib(n - 1) + fib(n - 2)
}

fun divmod(a i64, b i64) (i64, i64) {
	return (a / b, a % b)
}

fun main() {
	println("{add(2, 3)}")
	println("fib(20) = {fib(20)}")
	(q, r) := divmod(17, 5)
	println("17 / 5 = {q} rem {r}")
	total mut := 0
	for i in 0..10 {
		if i % 2 == 0 {
			continue
		}
		total += i
	}
	println("sum of odd numbers below 10: {total}")
	n mut := 0
	while n < 3 {
		n += 1
	}
	x := 2.5
	y := x * 4.0
	println("n = {n}, y = {y}, neg = {-x}, ok = {n == 3 && y > 9.0}")
	c := 'k'
	println("char {c}, cast {65 as u8 as char}, float {7 as f64 / 2.0}")
	label := if n > 2 { "big" } else { "small" }
	println(label)
}
