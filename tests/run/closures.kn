fun apply(f fun(i32) i32, x i32) i32 {
	return f(x)
}

fun double(x i32) i32 {
	return x * 2
}

fun make_adder(n i32) fun(i32) i32 {
	return move |x i32| x + n
}

fun main() {
	offset := 10
	add := |x i32| x + offset
	println("{add(5)}")
	println("{apply(double, 21)}")
	println("{apply(|x i32| x * x, 7)}")
	add3 := make_adder(3)
	println("{add3(4)}")
	count mut := 0
	inc := || {
		count += 1
	}
	inc()
	inc()
	println("count = {count}")
	name := string::from("kiln")
	greet := move || println("hello, {name}")
	greet()
}
