import std::encoding::csv
import std::io

fn main() -> Result<(), csv::Error> {
	text := "name,age,note\n\"Smith, J\",42,\"said \"\"hi\"\"\"\r\nLee,7,\"two\nlines\"\n\nlast,1,\n"
	rows := csv::parse(text)?
	for r in rows.iter() {
		println("{r:?}")
	}
	println(csv::format(&rows))

	r mut := csv::Reader::new(io::Cursor::from_str("# comment\na; b ;c\n"))
	r.delimiter = 59
	r.comment = Some(35)
	r.trim_leading_space = true
	println("{r.read_all()?:?} line {r.line()}")

	for bad in ["a,b\nc\n", "a,\"b\n", "a,b\"c\n", "\"a\"x,b\n"].iter() {
		match csv::parse(bad) {
			Ok(v) => println("unexpected {v:?}"),
			Err(e) => println("{e}"),
		}
	}
	w mut := csv::Writer::new(io::stdout())
	w.use_crlf = false
	w.write_record(&["plain", " lead", "q\"uote", ""])?
	return Ok(())
}
