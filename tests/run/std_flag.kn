import std::flag
import std::time

fun strs(a &[&str]) Vec<string> {
	out mut := Vec::new()
	for s in a.iter() {
		out.push(s.to_string())
	}
	return out
}

fun setup() flag::FlagSet {
	fs mut := flag::FlagSet::new("server")
	fs.string("addr", ":8080", "address to listen on")
	fs.int("workers", 4, "number of worker tasks")
	fs.float("ratio", 0.5, "sampling ratio")
	fs.bool("v", false, "verbose logging")
	fs.string("name", "", "instance name")
	fs.duration("timeout", time::secs(30), "request timeout")
	return fs
}

fun main() {
	fs mut := setup()
	match fs.parse(&strs(&["-v", "--addr=:9000", "-workers", "0x10", "--ratio", "2.5", "file.txt", "-x"])) {
		Ok() => {},
		Err(e) => println("error {e}"),
	}
	println("{fs.get_string("addr")} {fs.get_int("workers")} {fs.get_float("ratio")} {fs.get_bool("v")} {fs.args():?}")
	println("{fs.is_set("addr")} {fs.is_set("name")}")

	fs2 mut := setup()
	fs2.parse(&strs(&["-v=false", "--", "-workers"])).unwrap()
	println("{fs2.get_bool("v")} {fs2.get_int("workers")} {fs2.args():?}")

	for bad in [["-nope"].to_vec(), ["-workers", "ten"].to_vec(), ["-addr"].to_vec(), ["-v=maybe"].to_vec(), ["-h"].to_vec()].iter() {
		fs3 mut := setup()
		match fs3.parse(&strs(bad)) {
			Ok() => println("unexpected ok"),
			Err(e) => println("{e}"),
		}
	}
	fs4 mut := setup()
	fs4.parse(&strs(&["-timeout", "1m30s"])).unwrap()
	println("{fs4.get_duration("timeout")} {fs.get_duration("timeout")}")
	fs5 mut := setup()
	match fs5.parse(&strs(&["-timeout=soon"])) {
		Ok() => println("unexpected ok"),
		Err(e) => println("{e}"),
	}
	print(fs.usage())
}
