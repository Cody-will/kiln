import std::bytes

fn magic() -> &'static [u8] {
	return b"\x89PNG\r\n"
}

fn main() {
	b := b"hello\n"
	println("{b.len()} {b[0]} {b[5]}")
	println("{magic():?}")
	println("{b'a'} {b'\n'} {b'\xff'}")
	raw := br"a\nb"
	println("{raw.len()} {raw:?}")
	println("{bytes::contains(b, b"ll")} {bytes::equal(b, "hello\n".as_bytes())}")
	println("{pair(b"ab", b"xyz")}")
	v := b"abc".to_vec()
	println("{v:?}")
}

fn pair(a: &[u8], b: &[u8]) -> usize {
	return a.len() * 10 + b.len()
}
