struct N {
	id i32,
}

impl Drop for N {
	fun drop(&mut self) {
		println("drop {self.id}")
	}
}

fun make(id i32) N {
	return N { id: id }
}

fun main() {
	a := N { id: 1 }
	b := N { id: 2 }
	t := spawn move {
		println("task sees {a.id}")
	}
	t.join()
	println("after join")
	t2 := spawn make(3)
	match t2.join() {
		Ok(n) => println("joined {n.id}"),
		Err(_) => println("panic"),
	}
	(tx, rx) := chan::<N>(4)
	tx <- N { id: 4 }
	tx <- N { id: 5 }
	first := <-rx
	println("received {first.id}")
	drop(tx)
	drop(rx)
	println("end")
}
