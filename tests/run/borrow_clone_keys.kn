import std::collections::BTreeMap

fun a(v &BTreeMap<string, i32>) Vec<string> {
	out mut := Vec::new()
	for (k, _) in v.iter() {
		out.push(k.clone())
	}
	return out
}

fun b(v &BTreeMap<string, i32>) Vec<string> {
	out mut := Vec::new()
	for k in v.keys() {
		out.push(k.clone())
	}
	return out
}

fun c(v &Vec<string>) Vec<string> {
	out mut := Vec::new()
	for k in v.iter() {
		out.push(k.clone())
	}
	return out
}

fun d(v &BTreeMap<string, i32>) string {
	(k, _) := v.first_key_value().unwrap()
	return k.clone()
}

fun main() {}
