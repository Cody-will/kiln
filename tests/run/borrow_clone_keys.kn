import std::collections::BTreeMap

fn a(v: &BTreeMap<String, i32>) -> Vec<String> {
    out mut := Vec::new()
    for (k, _) in v.iter() {
        out.push(k.clone())
    }
    return out
}

fn b(v: &BTreeMap<String, i32>) -> Vec<String> {
    out mut := Vec::new()
    for k in v.keys() {
        out.push(k.clone())
    }
    return out
}

fn c(v: &Vec<String>) -> Vec<String> {
    out mut := Vec::new()
    for k in v.iter() {
        out.push(k.clone())
    }
    return out
}

fn d(v: &BTreeMap<String, i32>) -> String {
    (k, _) := v.first_key_value().unwrap()
    return k.clone()
}

fn main() {}
