fun square(x i64) i64 {
	return x * x
}

fun main() {
	t := spawn square(7)
	r := t.join()
	match r {
		Ok(v) => println("square: {v}"),
		Err(_) => println("panicked"),
	}
	(tx, rx) := chan::<i32>(0)
	spawn move {
		for i in 0..5 {
			tx <- i
		}
	}
	for v in rx {
		println("got {v}")
	}
	println("done")
}
