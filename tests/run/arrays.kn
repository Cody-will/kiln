struct N {
	id i32,
}

impl Drop for N {
	fun drop(&mut self) {
		println("drop {self.id}")
	}
}

fun sum(xs &[i32]) i32 {
	t mut := 0
	for x in xs {
		t += *x
	}
	return t
}

fun main() {
	a mut := [1, 2, 3, 4, 5]
	a[0] = 10
	println("len {a.len()} first {a[0]} sum {sum(&a)}")
	zeros := [0u8; 16]
	println("zeros {zeros.len()} {zeros[15]}")
	for x in &a {
		print("{x} ")
	}
	println("")
	ns := [N { id: 1 }, N { id: 2 }, N { id: 3 }]
	for n in ns {
		if n.id == 2 {
			break
		}
		println("saw {n.id}")
	}
	grid := [[1, 2], [3, 4]]
	println("grid {grid[1][0]}")
	println("end")
}
