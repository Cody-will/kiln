@derive(Clone, Copy)
struct Body {
	pos [f64; 3],
	vel [f64; 3],
}

fun sum(a [f64; 3]) f64 {
	s mut := 0.0
	for x in a {
		s += x
	}
	return s
}

fun bump(a &mut [f64; 3]) {
	for i in 0..3 {
		a[i] += 1.0
	}
}

fun total(a &[f64; 3]) f64 {
	s mut := 0.0
	for x in a {
		s += *x
	}
	return s + a.len() as f64
}

fun main() {
	a mut := [1.0, 2.0, 3.0]
	b mut := a
	b[0] = 10.0
	println("{a[0]} {b[0]} {sum(a)} {sum(b)}")
	bump(&mut a)
	println("{a:?} {total(&a)}")
	bs mut := [Body { pos: [0.0; 3], vel: [1.0, 2.0, 3.0] }; 2]
	bs[1].pos[2] = 5.0
	c := bs[1]
	bs[1].pos[2] = 6.0
	println("{c.pos[2]} {bs[1].pos[2]} {bs.len()}")
	m mut := [[0; 4]; 4]
	for i in 0..4 {
		m[i][i] = i
	}
	println("{m:?}")
	eq := [1, 2] == [1, 2]
	println("{eq}")
}
