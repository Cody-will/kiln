BBNxWWza1aKk
-----END CERTIFICATE-----"
const CERT: &str = r"-----BEGIN CERTIFICATE-----
MIIBrTCCAVOgAwIBAgIUHQN4MbVrOlqORiOFhTJxbNXjQU4wCgYIKoZIzj0EAwIw
FzEVMBMGA1UEAwwMS2lsbiBUZXN0IENBMCAXDTI2MTAxMDIyNTEwMVoYDzIxMjYw
OTE2MjI1MTAxWjAUMRIwEAYDVQQDDAlsb2NhbGhvc3QwWTATBgcqhkjOPQIBBggq
hkjOPQMBBwNCAASxosX0bhvQt6T5CVB3mapqRQt429y5iOTxfJpxSfDL89PFK+Mi
ymSaokUIdHdM0km1+bMr/fU7RiPmsBl5ZcDjo34wfDAaBgNVHREEEzARgglsb2Nh
bGhvc3SHBH8AAAEwCQYDVR0TBAIwADATBgNVHSUEDDAKBggrBgEFBQcDATAdBgNV
HQ4EFgQUBmJhmBZINO3xIHHY36iBHtBpO3EwHwYDVR0jBBgwFoAUGSWIXE0GBs5u
fAekxmgu3YDnLzMwCgYIKoZIzj0EAwIDSAAwRQIhAJIeCYPeWquZdRDipdEekbtW
