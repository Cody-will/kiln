import std::fmt

#[derive(Debug, Clone)]
struct Point {
	x: i32,
	y: f64,
}

#[derive(Debug)]
enum Shape {
	Dot,
	Circle(Point, f64),
	Named { name: String, tags: Vec<&'static str> },
}

struct Secret {
	key: String,
}

impl fmt::Debug for Secret {
	fn fmt_debug(&self, f: &mut fmt::Formatter) {
		f.write("Secret(..)")
	}
}

#[derive(Debug)]
struct Wrap {
	s: Secret,
	n: Option<i32>,
}

fn main() {
	n := 42
	f := 3.14159
	s := "hi"
	println("[{n:5}] [{n:<5}] [{n:^5}] [{n:*>6}] [{n:05}] [{-n:05}] [{n:+}] [{n:x}] [{n:#X}] [{n:#010b}] [{n:o}]")
	println("[{f:.2}] [{f:8.3}] [{f:<8.1}] [{f:+.0}] [{f:e}] [{1500.0:E}] [{0.00012:.2e}] [{-1 as i8:x}] [{255 as u8:#x}]")
	println("[{s:6}] [{s:>6}] [{s:^7}] [{"hello":.3}] [{s:?}] [{'a':?}] [{"q\"\n":?}] [{2.0:?}] [{true:5}]")
	p := Point { x: 1, y: 2.0 }
	println("{p:?}")
	v := [Shape::Dot, Shape::Circle(p.clone(), 1.5), Shape::Named { name: "n".to_string(), tags: ["a", "b"].to_vec() }]
	println("{v:?}")
	println("{Some(3):?} {None::<i32>.is_none()} {(1, "x", 'c'):?} {Wrap { s: Secret { key: "k".to_string() }, n: Some(5) }:?}")
	println("{p:#?}")
	println("{fmt::debug(&(0..3))} [{p:>30?}]")
}
