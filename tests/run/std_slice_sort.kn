@derive(Clone, Debug)
struct P {
	name string,
	age i32,
}

fun lcg(s &mut u64) u64 {
	*s = (*s).wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)
	return *s >> 33
}

fun show<T: Display>(v &[T]) string {
	out mut := "[".to_string()
	for (i, x) in v.iter().enumerate() {
		if i > 0 {
			out.push(", ")
		}
		out.push(&x.to_string())
	}
	out.push("]")
	return out
}

fun main() {
	v mut := Vec::new()
	for x in [5, 3, 9, 1, 5, 7, 2] {
		v.push(x)
	}
	v.sort()
	println("{show(&v)}")
	v.sort_by(|a, b| b.cmp(a))
	println("{show(&v)} {v.contains(&9)} {v.contains(&4)}")
	v.reverse()
	println("{v.binary_search(&5).is_ok()} {v.binary_search(&4).unwrap_err()} {v.is_sorted()}")
	v.dedup()
	println("{show(&v)}")
	v.retain(|x| *x % 2 == 1)
	println("{show(&v)} {v.swap_remove(0)} {show(&v)}")
	ps mut := Vec::new()
	ps.push(P { name: "c".to_string(), age: 30 })
	ps.push(P { name: "a".to_string(), age: 25 })
	ps.push(P { name: "b".to_string(), age: 30 })
	ps.push(P { name: "d".to_string(), age: 25 })
	ps.sort_by_key(|p| p.age)
	for p in ps.iter() {
		print("{p.name}{p.age} ")
	}
	println("")
	// Big random sorts, checked against each other.
	let mut seed u64 = 42
	big mut := Vec::new()
	for i in 0..100000 {
		big.push(((lcg(&mut seed) % 1000) as i64, i))
	}
	a mut := big.clone()
	a.sort_by(|x, y| x.0.cmp(&y.0))
	stable mut := true
	for i in 1..a.len() {
		if a[i - 1].0 == a[i].0 && a[i - 1].1 > a[i].1 {
			stable = false
		}
	}
	b mut := big.clone()
	b.sort_unstable()
	c mut := big.clone()
	c.sort()
	println("{stable} {a.is_sorted_by(|x, y| x.0.cmp(&y.0))} {b.is_sorted()} {b == c}")
	strs mut := Vec::new()
	for w in "the quick brown fox jumps over the lazy dog".split(" ") {
		strs.push(w.to_string())
	}
	strs.sort_unstable()
	strs.dedup()
	println("{strs.len()} {strs[0]} {strs[strs.len() - 1]}")
	arr mut := [4, 2, 8, 6]
	arr.sort()
	println("{show(&arr)} {arr[..].first().unwrap()} {arr.last().unwrap()}")
	r mut := Vec::new()
	r.extend(1..=6)
	r.rotate_left(2)
	println("{show(&r)} {r.chunks(4).len()} {r.windows(5).len()} {r.max_elem().unwrap()}")
	t := r.split_off(4)
	d := r.drain(1, 3)
	println("{show(&r)} {show(&t)} {show(&d)}")
	f mut := Vec::new()
	f.resize(3, "x".to_string())
	println("{f.len()} {f[2]} {[1, 2, 3].starts_with(&[1, 2])} {[1, 2, 3].to_vec().len()}")
}
