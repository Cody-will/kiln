import std::collections::BTreeMap

fun f(m &BTreeMap<string, i32>, key string) option<&i32> {
	x := m.get(key.as_str())
	return x
}

fun g(m &BTreeMap<string, i32>, key string) option<&i32> {
	v := match 1 {
		1 => m.get(key.as_str()),
		_ => None,
	}
	return v
}

fun main() {
	m mut := BTreeMap::new()
	m.insert("k".to_string(), 7)
	println("{f(&m, "k".to_string()):?} {g(&m, "z".to_string()):?}")
}
