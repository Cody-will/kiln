enum ParseError {
	Empty,
	Bad(string),
}

struct AppError {
	msg string,
}

impl From<ParseError> for AppError {
	fun from(e ParseError) AppError {
		return match e {
			ParseError::Empty => AppError { msg: string::from("empty input") },
			ParseError::Bad(s) => AppError { msg: "bad input: {s}" },
		}
	}
}

fun parse_digit(s &str) result<i32, ParseError> {
	if s.is_empty() {
		return Err(ParseError::Empty)
	}
	if s == "1" {
		return Ok(1)
	}
	if s == "2" {
		return Ok(2)
	}
	return Err(ParseError::Bad(s.to_string()))
}

fun sum(a &str, b &str) result<i32, AppError> {
	x := parse_digit(a)?
	y := parse_digit(b)?
	return Ok(x + y)
}

fun half(n i32) option<i32> {
	if n % 2 == 0 {
		return Some(n / 2)
	}
	return None
}

fun quarter(n i32) option<i32> {
	h := half(n)?
	return half(h)
}

fun report(r result<i32, AppError>) {
	match r {
		Ok(v) => println("ok: {v}"),
		Err(e) => println("error: {e.msg}"),
	}
}

fun main() {
	report(sum("1", "2"))
	report(sum("", "2"))
	report(sum("1", "x"))
	println("{quarter(8).unwrap_or(-1)} {quarter(6).unwrap_or(-1)}")
	println("{parse_digit("2").is_ok()} {parse_digit("9").is_err()}")
}
