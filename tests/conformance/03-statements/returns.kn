// SPEC §3.1/§3.2: explicit return; value-producing if and match.
enum Shape {
	Circle(f64),
	Rect { w f64, h f64 },
}

fun sign(n i32) &'static str {
	label := if n < 0 {
		"neg"
	} else if n == 0 {
		"zero"
	} else {
		"pos"
	}
	return label
}

fun area(s &Shape) f64 {
	return match s {
		Shape::Circle(r) => 3.0 * r * r,
		Shape::Rect { w, h } => w * h,
	}
}

fun nothing() {
	if true {
		return
	}
	println("unreachable")
}

fun main() {
	println("{sign(-2)} {sign(0)} {sign(5)}")
	println("{area(&Shape::Circle(2.0))} {area(&Shape::Rect { w: 2.0, h: 3.5 })}")
	nothing()
	add := |x i32| x + 1
	blk := |x i32| {
		return x * 2
	}
	println("{add(1)} {blk(4)}")
}
