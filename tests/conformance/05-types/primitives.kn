// SPEC §5: primitive types, integer methods, casts, chars, tuples, arrays.
fun main() {
	println("{i8::MAX} {u8::MAX} {i64::MIN} {u32::BITS}")
	println("{200u8.checked_add(100).is_none()} {200u8.wrapping_add(100)} {200u8.saturating_add(100)}")
	println("{(-7i32).rem_euclid(3)} {2i64.pow(10)} {(-5i32).abs()} {17i32.isqrt()}")
	println("{300 as u8} {-1i32 as u32} {3.9 as i32} {65u8 as char}")
	println("{'a'.is_alphabetic()} {'Z'.to_lowercase()} {'7'.to_digit(10).unwrap()}")
	t := (1, "two", 3.0)
	println("{t.0} {t.1} {t.2}")
	a := [1, 2, 3, 4]
	println("{a.len()} {a[1..3].len()} {a.contains(&3)}")
	s mut := [5, 3, 9, 1]
	s.sort()
	println("{s:?}")
	println("{i32::parse("12").unwrap() + 1}")
}
