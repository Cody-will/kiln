// SPEC §4/§5: structs, methods, traits, generics, dyn, impl Trait, associated types.
trait Shape {
	fun area(&self) f64
	fun name(&self) string {
		return "shape".to_string()
	}
}

struct Sq {
	s f64,
}

struct Circle {
	r f64,
}

impl Shape for Sq {
	fun area(&self) f64 {
		return self.s * self.s
	}

	fun name(&self) string {
		return "square".to_string()
	}
}

impl Shape for Circle {
	fun area(&self) f64 {
		return 3.0 * self.r * self.r
	}
}

fun total<T: Shape>(xs &[T]) f64 {
	t mut := 0.0
	for x in xs {
		t += x.area()
	}
	return t
}

fun evens(n i32) impl Iterator<i32> {
	return (0..n).filter(|x| *x % 2 == 0)
}

struct Count {
	n i32,
}

impl Iterator for Count {
	type Item = i32

	fun next(&mut self) option<i32> {
		if self.n == 0 {
			return None
		}
		self.n -= 1
		return Some(self.n)
	}
}

fun main() {
	println(total(&[Sq { s: 2.0 }, Sq { s: 3.0 }]))
	let mut shapes Vec<Box<dyn Shape>> = Vec::new()
	shapes.push(Box::new(Sq { s: 1.0 }))
	shapes.push(Box::new(Circle { r: 1.0 }))
	for s in shapes.iter() {
		println("{s.name()} {s.area()}")
	}
	v := evens(7).collect()
	println("{v:?}")
	c := Count { n: 3 }
	for x in c {
		print("{x} ")
	}
	println("")
}
